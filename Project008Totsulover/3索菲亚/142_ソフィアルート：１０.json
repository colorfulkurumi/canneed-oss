[
 {
  "name": "森道",
  "message": "「好了，大家，都回座位上坐好」"
 },
 {
  "name": "索菲娅",
  "message": "「！老师」"
 },
 {
  "name": "索菲娅",
  "message": "「夏……铃宫，有联系您吗……？」"
 },
 {
  "name": "森道",
  "message": "「他今天还是没来吗」"
 },
 {
  "message": "我点了点头，老师看起来也有些为难。"
 },
 {
  "name": "索菲娅",
  "message": "（这已经是他第二天无故不来学院了……）"
 },
 {
  "message": "他向来很认真，不像是会翘课的人。就算身体不舒服，也会打个招呼才对。"
 },
 {
  "name": "索菲娅",
  "message": "（……难道是出什么事了吗）"
 },
 {
  "message": "总觉得心里有些七上八下的。"
 },
 {
  "message": "总觉得，有什么可怕的事情，正在我不知道的地方发生。"
 },
 {
  "name": "澪",
  "message": "「兰、兰开斯特！」"
 },
 {
  "name": "索菲娅",
  "message": "「……嗯？」"
 },
 {
  "name": "澪",
  "message": "「今天，那个……要不要一起……？就是……」"
 },
 {
  "name": "澪",
  "message": "「去……铃子家看看？」"
 },
 {
  "name": "索菲娅",
  "message": "「！」"
 },
 {
  "name": "澪",
  "message": "「他连着不来，实在太奇怪了……是不是，出了什么事啊」"
 },
 {
  "name": "索菲娅",
  "message": "「真是太巧了……！跟我想的一模一样！」"
 },
 {
  "name": "索菲娅",
  "message": "「不过才过了两天，是不是我太大惊小怪了啊——！」"
 },
 {
  "name": "澪",
  "message": "「啊，这样啊……欸嘿嘿，有点开心」"
 },
 {
  "name": "澪",
  "message": "「……说不定只是感冒了，我们过去看看……应该没关系吧」"
 },
 {
  "name": "索菲娅",
  "message": "「对啊对啊！」"
 },
 {
  "name": "索菲娅",
  "message": "「不过，稍微等我一下哦，在那之前，我得去学生会办点事情」"
 },
 {
  "name": "澪",
  "message": "「嗯、嗯……！」"
 },
 {
  "name": "樱",
  "message": "「……嗯，我知道了，你去看看他吧」"
 },
 {
  "name": "索菲娅",
  "message": "「非常感谢！」"
 },
 {
  "message": "本来今天放学后学生会有工作的——不过。"
 },
 {
  "message": "因为放心不下铃宫，我过来请假。"
 },
 {
  "name": "樱",
  "message": "「我记得铃宫住的公寓……好像和海漫是同一栋？」"
 },
 {
  "name": "索菲娅",
  "message": "「是啊」"
 },
 {
  "name": "樱",
  "message": "「那……麻烦你顺便看看海漫」"
 },
 {
  "name": "索菲娅",
  "message": "「……欸？啊，说起来她也是，昨天就没来上学，难道，今天也没来？」"
 },
 {
  "name": "樱",
  "message": "「嗯，而且怎么也联系不上她」"
 },
 {
  "name": "索菲娅",
  "message": "「……确实，很担心呢」"
 },
 {
  "message": "如果只是感冒还没好，去探望一下就了事了。"
 },
 {
  "message": "又或者，是出了什么事。总得去看一下才行。"
 },
 {
  "name": "索菲娅",
  "message": "「明白了，那我去看看他们两个什么情况吧」"
 },
 {
  "name": "樱",
  "message": "「麻烦了，我会帮大家把学生会的工作处理了」"
 },
 {
  "name": "索菲娅",
  "message": "「非常感谢，那就拜托你咯，会长♪」"
 },
 {
  "name": "樱",
  "message": "「……嗯」"
 },
 {
  "message": "见她点头应允，我便走出了学生会办公室。"
 },
 {
  "name": "索菲娅",
  "message": "「好了，那么！出发去夏家——！」"
 },
 {
  "name": "澪",
  "message": "「哦、哦～～」"
 },
 {
  "name": "澪",
  "message": "「啊，不过兰开斯特，你知道铃子家在哪吗？」"
 },
 {
  "name": "索菲娅",
  "message": "「嗯，我去他家玩过嘛」"
 },
 {
  "name": "澪",
  "message": "「欸？」"
 },
 {
  "name": "澪",
  "message": "「啊，欸，是这样啊。果然那个，你们……」"
 },
 {
  "name": "索菲娅",
  "message": "「不、不是！是学生会的大家一起去的！还有就是……带他熟悉这座城的时候」"
 },
 {
  "name": "索菲娅",
  "message": "「我从来没有单独进过男生的房间哦！」"
 },
 {
  "name": "澪",
  "message": "「……这样啊」"
 },
 {
  "name": "索菲娅",
  "message": "「……是啊？」"
 },
 {
  "name": "澪",
  "message": "「呵呵，那，我们走吧，去铃子家」"
 },
 {
  "name": "索菲娅",
  "message": "「……嗯！」"
 },
 {
  "name": "澪",
  "message": "「这、这、这这这、这里就是铃子的家……」"
 },
 {
  "name": "澪",
  "message": "「……必须把这里标成圣地打个五星好评，再加个地点收藏」"
 },
 {
  "name": "索菲娅",
  "message": "「别这样，正常点」"
 },
 {
  "message": "我们立刻按响了他家的门铃。"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "name": "澪",
  "message": "「……没反应？是不是还在睡觉」"
 },
 {
  "name": "索菲娅",
  "message": "「身体不舒服的话，倒是有这个可能……」"
 },
 {
  "message": "我试着拧了下门把手，发出咔嗒一声。"
 },
 {
  "name": "澪",
  "message": "「兰、兰开斯特？！」"
 },
 {
  "name": "索菲娅",
  "message": "「搞不好他昏倒了呢，哪还管得了那么多」"
 },
 {
  "name": "索菲娅",
  "message": "「对了，还得去看看海漫」"
 },
 {
  "message": "我来到海漫的房间门前。"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "name": "澪",
  "message": "「她也……不在……？」"
 },
 {
  "message": "我拧了拧门把手。"
 },
 {
  "name": "索菲娅",
  "message": "「……啊」"
 },
 {
  "name": "澪",
  "message": "「欸？」"
 },
 {
  "message": "——门没锁。"
 },
 {
  "name": "索菲娅",
  "message": "「……我们进去看看吧」"
 },
 {
  "message": "怀着一丝不祥的预感，我走进了她的房间。"
 },
 {
  "name": "索菲娅",
  "message": "「哇，好可爱的房间啊」"
 },
 {
  "message": "满屋子都是软乎乎的小物件，一看就是喜欢可爱东东的她。"
 },
 {
  "name": "澪",
  "message": "「……？地上好像掉了什么东西」"
 },
 {
  "message": "羽鸟捡起掉在地上的东西。"
 },
 {
  "name": "澪",
  "message": "「这是……报纸碎片？」"
 },
 {
  "name": "索菲娅",
  "message": "「……欸？」"
 },
 {
  "name": "澪",
  "message": "「没、没事，没什么，比起这个……」"
 },
 {
  "name": "澪",
  "message": "「……那个，海漫？她……好像不在家啊……？」"
 },
 {
  "name": "索菲娅",
  "message": "「……是啊」"
 },
 {
  "name": "澪",
  "message": "「房间也很整洁，可能只是碰巧出门了」"
 },
 {
  "name": "索菲娅",
  "message": "「稍微等我一下」"
 },
 {
  "name": "澪",
  "message": "「欸？」"
 },
 {
  "message": "我打开阳台的窗户，穿着袜子踩了出去。"
 },
 {
  "name": "澪",
  "message": "「你、你要做什么？！」"
 },
 {
  "message": "我沿着墙壁，跳到了隔壁——他房间的阳台上。"
 },
 {
  "name": "澪",
  "message": "「呀！」"
 },
 {
  "name": "索菲娅",
  "message": "「……夏！夏——！」"
 },
 {
  "message": "无人应答。"
 },
 {
  "message": "我凑近窗户朝里张望。"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "message": "感觉不到有人在。"
 },
 {
  "message": "看来他也不在家。"
 },
 {
  "name": "索菲娅",
  "message": "（嗯？那是……）"
 },
 {
  "name": "索菲娅",
  "message": "「我回来了」"
 },
 {
  "name": "澪",
  "message": "「兰、兰开斯特，行动力十足啊～～」"
 },
 {
  "name": "澪",
  "message": "「结果怎么样？有什么发现吗？」"
 },
 {
  "name": "索菲娅",
  "message": "「……嗯，那个啊，他不在家，不过呢……我发现了一样奇怪的东西」"
 },
 {
  "name": "澪",
  "message": "「奇怪的东西？」"
 },
 {
  "name": "索菲娅",
  "message": "「……鞋子」"
 },
 {
  "name": "澪",
  "message": "「鞋子……发现了鞋子？这不是，很正常吗……欸，不是吗？」"
 },
 {
  "name": "索菲娅",
  "message": "「他这人，无论是在学院还是平时，基本只穿一双鞋」"
 },
 {
  "name": "索菲娅",
  "message": "「是双很轻便的运动鞋。想必是方便随时跑动吧」"
 },
 {
  "message": "虽说学院有统一配发的鞋，但他却总是雷打不动地穿着那双运动鞋。"
 },
 {
  "name": "澪",
  "message": "「那双运动鞋……在房间里？难、难道说……」"
 },
 {
  "name": "索菲娅",
  "message": "「——你不觉得这很奇怪吗？」"
 },
 {
  "name": "索菲娅",
  "message": "「毕竟，哪有不穿鞋就出门的人呀」"
 },
 {
  "message": "这可不像是出门了那么简单。"
 },
 {
  "message": "肯定是出了什么事。"
 },
 {
  "name": "索菲娅",
  "message": "「夏出了『什么事』，而且，海漫也……？」"
 },
 {
  "name": "澪",
  "message": "「可是……到底，出了什么事呢？」"
 },
 {
  "name": "索菲娅",
  "message": "「查查看吧」"
 },
 {
  "message": "想查线索的话，最简单的入手点应该就是这间房了。"
 },
 {
  "name": "澪",
  "message": "「说得对，那，海漫的鞋子呢……？」"
 },
 {
  "message": "羽鸟走向玄关。"
 },
 {
  "name": "澪",
  "message": "「鞋、鞋子，都堆成小山了！难、难道她家里人很多……？」"
 },
 {
  "name": "索菲娅",
  "message": "「海漫毕竟爱打扮……鞋子多一点也不奇怪」"
 },
 {
  "name": "索菲娅",
  "message": "「啊，不过……」"
 },
 {
  "message": "我在玄关附近仔细找了一圈——随即发现了一样东西。"
 },
 {
  "name": "索菲娅",
  "message": "「……钥匙还在！」"
 },
 {
  "name": "澪",
  "message": "「欸？」"
 },
 {
  "name": "澪",
  "message": "「这是什么意思？海漫她……连钥匙都没带就出门了？」"
 },
 {
  "name": "索菲娅",
  "message": "「又或者是……被什么人抓走了」"
 },
 {
  "name": "澪",
  "message": "「欸？」"
 },
 {
  "name": "索菲娅",
  "message": "「虽然不清楚到底发生了什么，总之，先查查看」"
 },
 {
  "name": "索菲娅",
  "message": "「我看看……有没有什么能派上用场的……找到了！」"
 },
 {
  "message": "我从海漫的厨房里拿起一样东西。"
 },
 {
  "name": "澪",
  "message": "「这是……可可粉？」"
 },
 {
  "name": "索菲娅",
  "message": "「哦，太好了，还有棉签♪　有这个的话……」"
 },
 {
  "name": "澪",
  "message": "「你要做什么？」"
 },
 {
  "name": "索菲娅",
  "message": "「看好啦」"
 },
 {
  "message": "我将棉签的棉头蘸上可可粉，对着门把手轻点几下。"
 },
 {
  "name": "澪",
  "message": "「哇！好厉害！好清晰的指纹……！」"
 },
 {
  "name": "索菲娅",
  "message": "「这是因为可可粉会与指纹上的油脂发生反应」"
 },
 {
  "name": "索菲娅",
  "message": "「……门把手上，只有一种指纹」"
 },
 {
  "name": "澪",
  "message": "「那是，海漫的指纹，对吧？」"
 },
 {
  "name": "索菲娅",
  "message": "「嗯……」"
 },
 {
  "message": "这么看来，至少可以确定海漫并不是在这个房间里被掳走的。"
 }
]