[
 {
  "name": "水仙",
  "message": "「好嘞～开饭喽～！」"
 },
 {
  "name": "夏洛特",
  "message": "「哇——！看着真香！谢谢小水——！」"
 },
 {
  "message": "兰开斯特姐妹和我家小水，不知不觉间已经混得很熟了。"
 },
 {
  "name": "槐",
  "message": "「呜——呜哇……」"
 },
 {
  "name": "索菲娅",
  "message": "「呀，怎么哭了！」"
 },
 {
  "name": "槐",
  "message": "「看到妹妹长大，我这当哥的甚是欣慰啊」"
 },
 {
  "name": "索菲娅",
  "message": "「啊——这个我懂♪」"
 },
 {
  "name": "索菲娅",
  "message": "「最近就算我偷偷掺点欧芹进去，你也不会抱怨了呢」"
 },
 {
  "name": "槐",
  "message": "「能不能别老把我算作弟弟那一辈的啊？」"
 },
 {
  "name": "索菲娅",
  "message": "「不要～」"
 },
 {
  "message": "她答得这么干脆利落，我也只能认命了。"
 },
 {
  "name": "水仙",
  "message": "「喂、喂那边两个大人！别在那儿咬耳朵了，快拿筷子吃饭！」"
 },
 {
  "name": "索菲娅",
  "message": "「好～♪」"
 },
 {
  "message": "小水跟索菲也走得相当近了。"
 },
 {
  "message": "她这人没什么心机，性格又爽朗，确实很难让人讨厌。"
 },
 {
  "name": "槐",
  "message": "「我开动啦～」"
 },
 {
  "name": "埃莉诺",
  "message": "「哇，这蛋包饭……好好吃！」"
 },
 {
  "name": "槐",
  "message": "「小水从小做蛋包饭的手艺就没得说啊」"
 },
 {
  "name": "水仙",
  "message": "「嘛、嘛，因为我也挺喜欢的……」"
 },
 {
  "name": "水仙",
  "message": "「但也不光是因为这个。还不是因为哥哥喜欢吃，水水才老被抓去做蛋包饭！」"
 },
 {
  "name": "槐",
  "message": "「……有吗？」"
 },
 {
  "name": "水仙",
  "message": "「哎呀，说是被抓去做也不太对，其实是水水自己安排的啦」"
 },
 {
  "message": "仔细一想，我确实没少吃蛋包饭。"
 },
 {
  "message": "她这么一说，我吃蛋包饭的时候好像是比较开心。"
 },
 {
  "name": "槐",
  "message": "「不是吧！原来我也喜欢吃蛋包饭吗！」"
 },
 {
  "name": "克拉拉",
  "message": "「欸，你现在才发现？是啊」"
 },
 {
  "name": "水仙",
  "message": "「哥哥对自己不感兴趣的事实在太不上心了，经常后知后觉」"
 },
 {
  "name": "索菲娅",
  "message": "「呵呵，你真是了解他呢」"
 },
 {
  "name": "水仙",
  "message": "「那是！我可是他妹妹！（神采奕奕）」"
 },
 {
  "name": "索菲娅",
  "message": "「～～～～！」"
 },
 {
  "name": "索菲娅",
  "message": "「小、小水？你……也可以叫我姐姐的哦」"
 },
 {
  "name": "槐",
  "message": "「你能不能别见谁都想当人姐姐？」"
 },
 {
  "message": "索菲的姐性真是无边无际啊。"
 },
 {
  "name": "水仙",
  "message": "「啊，这个番茄酱好好吃，跟我们家平时用的不一样欸」"
 },
 {
  "name": "槐",
  "message": "「欸，是吗」"
 },
 {
  "name": "水仙",
  "message": "「哥哥你是沾酱汁的嘛，不过我觉得这味道你应该会喜欢，要尝尝吗？啊——」"
 },
 {
  "name": "槐",
  "message": "「啊呜，嗯嗯，啊，好吃」"
 },
 {
  "name": "索菲娅",
  "message": "「……！」"
 },
 {
  "name": "槐",
  "message": "「我喜欢。索菲，这是哪家的？」"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「索菲？」"
 },
 {
  "name": "索菲娅",
  "message": "「欸，什么？啊，番茄酱啊，那个，这是我自己做的……」"
 },
 {
  "name": "水仙",
  "message": "「居然是自制的吗！哇——哥哥，这可太费工夫了」"
 },
 {
  "name": "索菲娅",
  "message": "「……夏？」"
 },
 {
  "name": "槐",
  "message": "「怎么了？」"
 },
 {
  "name": "索菲娅",
  "message": "「……我的蛋包饭，也分你一口吧？」"
 },
 {
  "name": "槐",
  "message": "「欸，突然咋了，不过谢啦」"
 },
 {
  "name": "索菲娅",
  "message": "「……啊……啊——」"
 },
 {
  "name": "槐",
  "message": "「你没事吧？索菲，你脸好红」"
 },
 {
  "name": "索菲娅",
  "message": "「闭、闭嘴，快点张嘴」"
 },
 {
  "name": "槐",
  "message": "「唔咕」"
 },
 {
  "message": "我才刚张开嘴，她就一把把勺子塞了进来。"
 },
 {
  "name": "槐",
  "message": "「嗯嗯，好吃」"
 },
 {
  "name": "索菲娅",
  "message": "「哼唧」"
 },
 {
  "message": "索菲满脸通红，把头扭了过去。"
 },
 {
  "name": "水仙",
  "message": "「今天也跑来蹭饭啦，非常感谢——！」"
 },
 {
  "name": "埃莉诺",
  "message": "「应该谢谢你才是，还要你来做」"
 },
 {
  "message": "我们吃完饭，踏上归途。"
 },
 {
  "name": "水仙",
  "message": "「欸嘿嘿」"
 },
 {
  "name": "索菲娅",
  "message": "「怎么了？小水，笑得这么开心」"
 },
 {
  "name": "水仙",
  "message": "「就是觉得开心啊，我喜欢热热闹闹地吃饭」"
 },
 {
  "name": "索菲娅",
  "message": "「呵呵，那就好♪」"
 },
 {
  "name": "索菲娅",
  "message": "「随时都可以来玩哦，反正你都和自家人没什么两样了」"
 },
 {
  "name": "水仙",
  "message": "「……！」"
 },
 {
  "name": "水仙",
  "message": "「怎、怎么办，哥哥……！」"
 },
 {
  "name": "水仙",
  "message": "「水水感觉，自己要忍不住叫她姐姐了！」"
 },
 {
  "name": "槐",
  "message": "「别上当，小水！这家伙可会玩弄人心了！」"
 },
 {
  "name": "索菲娅",
  "message": "「哦——呵呵呵！好啊！好啊！」"
 },
 {
  "name": "水仙",
  "message": "「那么，索菲，晚安——！」"
 },
 {
  "name": "索菲娅",
  "message": "「嗯——晚安——」"
 },
 {
  "name": "槐",
  "message": "「小水，你先去睡吧，我过会儿再回去」"
 },
 {
  "name": "水仙",
  "message": "「好——」"
 },
 {
  "message": "我已经习惯和她在晚上散散步了。"
 },
 {
  "name": "索菲娅",
  "message": "「……%0」"
 },
 {
  "message": "小水刚走，索菲就凑到我身边，挽住了我的胳膊。"
 },
 {
  "name": "索菲娅",
  "message": "「……夏」"
 },
 {
  "name": "槐",
  "message": "「怎么了？」"
 },
 {
  "name": "索菲娅",
  "message": "「……可以亲一下哦」"
 },
 {
  "name": "槐",
  "message": "「我也想，不过」"
 },
 {
  "name": "索菲娅",
  "message": "「不过什么？」"
 },
 {
  "name": "槐",
  "message": "「小水折回来了，正满脸通红地看着我们呢」"
 },
 {
  "name": "索菲娅",
  "message": "「喵！！」"
 },
 {
  "name": "水仙",
  "message": "「对、对对、对不起，我忘带备用钥匙了，想找哥哥借一下」"
 },
 {
  "name": "槐",
  "message": "「啊，好，给，钥匙」"
 },
 {
  "name": "水仙",
  "message": "「谢啦～」"
 },
 {
  "name": "水仙",
  "message": "「……索菲啊」"
 },
 {
  "name": "水仙",
  "message": "「明明平时那么像姐姐……可在哥哥面前，就变成爱撒娇的孩子了呢」"
 },
 {
  "name": "索菲娅",
  "message": "「！！」"
 },
 {
  "name": "水仙",
  "message": "「那、那就晚安啦～」"
 },
 {
  "message": "小水走了。"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……没事吧？索菲……索菲同学？」"
 },
 {
  "name": "索菲娅",
  "message": "「啊呜啊呜啊呜～～我、我堂堂淑女，居然会露出如此丑态～」"
 },
 {
  "name": "槐",
  "message": "「哪算丑态了，明明很可爱啊」"
 },
 {
  "name": "索菲娅",
  "message": "「我应该做大家的榜样，当一个优雅又高冷的大小姐～」"
 },
 {
  "name": "槐",
  "message": "（好像你从来就没那样过吧……？）"
 },
 {
  "message": "不过，索菲为了成为理想中的自己而努力的样子，感觉酷酷的。"
 },
 {
  "name": "索菲娅",
  "message": "「唉……真沮丧，走吧，夏」"
 },
 {
  "message": "虽然她还是一脸沮丧，但依然紧紧搂住了我的胳膊。"
 },
 {
  "name": "槐",
  "message": "「不过，爱撒娇的索菲也超级可爱啊」"
 },
 {
  "name": "索菲娅",
  "message": "「……我只想……在你面前撒娇」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "这位大小姐，真是太可爱了。"
 },
 {
  "message": "我们笑着，漫步在夜色中。"
 }
]