[
 {
  "name": "槐",
  "message": "（根本没法正面靠近那家伙。那巨岩，既躲不开也弹不走）"
 },
 {
  "message": "硬要说能不能做到，大概是能的。但成功率太看双方的硬实力了。"
 },
 {
  "name": "槐",
  "message": "（那就只能走——）"
 },
 {
  "name": "华淡",
  "message": "「赤刀！往地下挖过去！」"
 },
 {
  "name": "槐",
  "message": "（地下！！）"
 },
 {
  "message": "华淡咔嚓咔嚓地劈开地底的泥土。转眼间，泥土便化作点点血迹，浸湿了地面。"
 },
 {
  "name": "华淡",
  "message": "「可是夏学长！在地下根本看不见上面的情况呀！」"
 },
 {
  "name": "槐",
  "message": "「没问题，那家伙还不习惯控制反现实，气息漏得到处都是，这样的话……」"
 },
 {
  "message": "R值的波动，我靠皮肤就能感觉到。"
 },
 {
  "name": "槐",
  "message": "「像生怕我们找不到它一样。这上面，有反现实的感觉」"
 },
 {
  "name": "华淡",
  "message": "「……欸？你说……光靠感觉现实性质波动，就能定位……？」"
 },
 {
  "name": "槐",
  "message": "「……你也能吧？」"
 },
 {
  "name": "华淡",
  "message": "「不能啊！我听都没听说过耶！」"
 },
 {
  "message": "这样吗。"
 },
 {
  "message": "想想看，以前给老哥亮这手的时候，他也惊得不行。"
 },
 {
  "name": "槐",
  "message": "「总之，华淡！就是这里！这个角度！」"
 },
 {
  "name": "华淡",
  "message": "「好嘞！」"
 },
 {
  "name": "槐",
  "message": "「直接上吧！舞蹈笔记——！」"
 },
 {
  "message": "我对着上方的土墙，狠狠挥出一拳。"
 },
 {
  "name": "人孽",
  "message": "「……唔！」"
 },
 {
  "name": "华淡",
  "message": "「刚才打人家打得挺爽嘛！」"
 },
 {
  "message": "华淡抡起赤刀。"
 },
 {
  "name": "槐",
  "message": "「啊啊啊啊啊——」"
 },
 {
  "name": "人孽",
  "message": "『汝，应与吾同行』"
 },
 {
  "name": "华淡",
  "message": "「嘿呀！」"
 },
 {
  "message": "华淡甩出链锯。打不了近战就拼远程！"
 },
 {
  "name": "人孽",
  "message": "『……嗯唔』"
 },
 {
  "message": "人孽闪开了这一击。身躯这么庞大，动作居然如此敏捷。"
 },
 {
  "name": "华淡",
  "message": "「喵？！它也太会躲了吧！」"
 },
 {
  "name": "人孽",
  "message": "『吾乃守护之躯，不承必死之命』"
 },
 {
  "name": "槐",
  "message": "「少在那装了……啊啊啊——！！」"
 },
 {
  "message": "我逼近『人孽』，朝墙壁方向发动舞蹈笔记。"
 },
 {
  "name": "人孽",
  "message": "『……！』"
 },
 {
  "name": "槐",
  "message": "「给我飞吧——！！」"
 },
 {
  "name": "人孽",
  "message": "『汝之拳，不过将吾击退，冲击本身，不足为惧——』"
 },
 {
  "name": "华淡",
  "message": "「嗯～那可不一定哦？」"
 },
 {
  "name": "人孽",
  "message": "『……！！』"
 },
 {
  "message": "在人孽被轰飞的方向上，华淡的链锯早已守候在那里。"
 },
 {
  "name": "华淡",
  "message": "「——人家把手腕接到赤刀上了，会朝哪飞，早就算好了」"
 },
 {
  "message": "链锯死死卡在墙壁与人孽之间。"
 },
 {
  "message": "伴随着骇人的轰鸣，链锯疯狂地撕裂着人孽的身体。"
 },
 {
  "name": "人孽",
  "message": "『吾，岂会在此终结』"
 },
 {
  "name": "槐",
  "message": "「休想逃——！」"
 },
 {
  "message": "我的舞蹈笔记狠狠轰在人孽身上。"
 },
 {
  "message": "就在这瞬间，赤刀深深扎入人孽，彻底贯穿了它的身体。"
 },
 {
  "name": "人孽",
  "message": "『噢噢噢噢噢噢噢——！！』"
 },
 {
  "name": "槐",
  "message": "「最后一击！」"
 },
 {
  "message": "我一脚蹬上隧道壁，跃到人孽的正上方。"
 },
 {
  "name": "槐",
  "message": "（从上方使用舞蹈笔记，把它拍死在地上！）"
 },
 {
  "name": "人孽",
  "message": "『呃……呃……！』"
 },
 {
  "message": "这怪物已经只剩最后一口气了——"
 },
 {
  "name": "华淡",
  "message": "「……啊」"
 },
 {
  "name": "华淡",
  "message": "「不行！学长！因为，被吞进去的学院学生——」"
 },
 {
  "name": "人孽",
  "message": "『显现吧』"
 },
 {
  "name": "华淡",
  "message": "「——有两个！！」"
 },
 {
  "name": "人孽",
  "message": "『B.E.G.——「雨之音」』"
 },
 {
  "name": "槐",
  "message": "「什么——！！」"
 },
 {
  "message": "这是被人孽吞噬的另一名学生。"
 },
 {
  "message": "它的B.E.G.『雨之音』，是能射出无数钢钉的能力。"
 },
 {
  "name": "槐",
  "message": "「咕啊……！！咳……可恶……」"
 },
 {
  "message": "我浑身被钉子扎成了筛子，感觉有什么东西正从伤口里往外涌。"
 },
 {
  "name": "槐",
  "message": "「唔……这、这是……我的……魂魄流体……？！」"
 },
 {
  "message": "魂魄流体——也就是力量的源泉。"
 },
 {
  "message": "它从我全身的血洞里疯狂外涌，我连站都快站不住了。"
 },
 {
  "name": "槐",
  "message": "「呃……呃……该死……该死……！」"
 },
 {
  "name": "人孽",
  "message": "『正是。这便是，天命』"
 },
 {
  "message": "令人作呕的声响在耳边回荡，那是人孽的六十四条手脚在地上爬动的动静。"
 },
 {
  "name": "人孽",
  "message": "『永远，相伴，吾友』"
 },
 {
  "message": "人孽浑身淌着黏糊糊的鲜血，试图触碰我。"
 },
 {
  "name": "华淡",
  "message": "「赤刀！快回来——！」"
 },
 {
  "message": "握着赤刀的那只手腕，朝华淡本人飞去。"
 },
 {
  "message": "右手归位的瞬间，她顺势抡起链锯，爆发出浑身的力量。"
 },
 {
  "name": "华淡",
  "message": "「哈啊啊啊啊啊啊啊啊啊啊！！」"
 },
 {
  "message": "链锯怒吼着，劈进了人孽的身体。"
 },
 {
  "message": "可惜，光凭这一下不足以致命——"
 },
 {
  "name": "人孽",
  "message": "『吾友，学不会的少女啊』"
 },
 {
  "name": "华淡",
  "message": "「……！」"
 },
 {
  "message": "链锯被厚实的血肉死死夹住，华淡的手臂也被那六十四条手脚牢牢握住。"
 },
 {
  "name": "人孽",
  "message": "『又来了』"
 },
 {
  "message": "战斗开始的噩梦重演。"
 },
 {
  "message": "华淡的近身攻击被锁死，不光被注入了毒素，甚至快要被整个吞进去——"
 },
 {
  "name": "人孽",
  "message": "『这下，没人能，救你了哦』"
 },
 {
  "message": "人孽像是要重演最初的光景一般，把毒针狠狠扎进了华淡体内。"
 },
 {
  "name": "华淡",
  "message": "「……呃……呃……」"
 },
 {
  "message": "人孽从华淡的指尖开始，一点点把她往肚子里吞。"
 },
 {
  "name": "槐",
  "message": "「华……淡……！！」"
 },
 {
  "name": "华淡",
  "message": "「……啊……」"
 },
 {
  "name": "人孽",
  "message": "『瞧啊，已经，把你，吞掉，这么多了』"
 },
 {
  "message": "华淡肩膀以下的部位都被吞噬了。"
 },
 {
  "message": "这样下去，她会变成人孽的一部分。"
 },
 {
  "message": "我已经束手无策了。"
 },
 {
  "name": "华淡",
  "message": "「……咯咯」"
 },
 {
  "name": "华淡",
  "message": "「逗你玩儿的%0」"
 },
 {
  "name": "人孽",
  "message": "『？』"
 },
 {
  "name": "华淡",
  "message": "「人家早就啾一下调包了哦～」"
 },
 {
  "name": "人孽",
  "message": "『调包……什么……』"
 },
 {
  "message": "赤刀——将物体拆散，拼接的能力。"
 },
 {
  "name": "华淡",
  "message": "「人家和夏学长的左手」"
 },
 {
  "message": "——作为最后的保险，我们事先交换了各自的左手。"
 },
 {
  "message": "就是为了防备身体被那怪物整个吞掉的情况——"
 },
 {
  "name": "人孽",
  "message": "「……！」"
 },
 {
  "name": "华淡",
  "message": "「夏学长！」"
 },
 {
  "name": "槐",
  "message": "「——舞蹈笔记——！！！」"
 },
 {
  "message": "吞下了华淡左手——也就是我的左手的人孽，核心处像烟花一样炸开。"
 },
 {
  "name": "华淡",
  "message": "「舞蹈笔记的能力——强行把碰到的东西击飞五米，而这次，是从内部发动的」"
 },
 {
  "name": "华淡",
  "message": "「GGEZ♪」"
 },
 {
  "name": "槐",
  "message": "「……漂亮……」"
 },
 {
  "message": "我失去了所有力气，身子一晃，意识沉进了黑暗里。"
 },
 {
  "name": "华淡",
  "message": "「果然，这世上啊！」"
 },
 {
  "name": "华淡",
  "message": "「还是，华淡第一，棒棒～！」"
 },
 {
  "message": "听着那没心没肺的胜利感言，我不由得微微笑了笑。"
 }
]