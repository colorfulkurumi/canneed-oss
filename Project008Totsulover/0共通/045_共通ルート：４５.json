[
 {
  "name": "槐",
  "message": "「我回来了……唔……」"
 },
 {
  "message": "刚回到房间，一股强烈的疲惫感就涌了上来。"
 },
 {
  "name": "槐",
  "message": "（糟了……真是，困死了……）"
 },
 {
  "message": "这就是老师口中，超强治疗的副作用吧？"
 },
 {
  "name": "槐",
  "message": "（连钻进被窝……都嫌费劲……）"
 },
 {
  "message": "我像是被抽空了力气一样，直接瘫倒在了地上。"
 },
 {
  "name": "槐",
  "message": "（……啊）"
 },
 {
  "message": "累死了……真的，累得不行……"
 },
 {
  "name": "槐",
  "message": "（得去……宅子一趟……）"
 },
 {
  "message": "我很担心水仙。"
 },
 {
  "message": "为了护着老哥，从学院几十号人手里逃脱，她是不是傻啊。"
 },
 {
  "name": "槐",
  "message": "（得快点……去见她……）"
 },
 {
  "name": "槐",
  "message": "「好想见……她啊……」"
 },
 {
  "message": "我有很多话想对她说。"
 },
 {
  "message": "也有很多事情，想跟她一起决定。"
 },
 {
  "message": "但现在……意识正在一点点往下沉。"
 },
 {
  "message": "……"
 },
 {
  "message": "…………"
 },
 {
  "message": "………………"
 },
 {
  "name": "？？？",
  "message": "「摇篮曲呀，金丝雀在……轻轻唱……」"
 },
 {
  "name": "？？？",
  "message": "「睡吧……睡吧……乖乖睡……♪」"
 },
 {
  "message": "那是空灵的歌声。"
 },
 {
  "message": "像夏日的河面上粼粼闪动的波光，又像在和煦的微风中轻轻摇曳的花朵。"
 },
 {
  "message": "我迷迷糊糊地睁开了眼睛。"
 },
 {
  "name": "水仙",
  "message": "「摇篮……上……♪　枇杷果儿……轻轻摇……♪」"
 },
 {
  "name": "水仙",
  "message": "「睡吧……睡吧……♪　乖乖睡……」"
 },
 {
  "name": "槐",
  "message": "「……小水？」"
 },
 {
  "name": "水仙",
  "message": "「啊……」"
 },
 {
  "message": "水仙注意到我醒了过来。"
 },
 {
  "name": "水仙",
  "message": "「哥哥……」"
 },
 {
  "message": "瞬间，她的小脸皱起，像快要哭出来一样。"
 },
 {
  "name": "水仙",
  "message": "「……欢迎回来！」"
 },
 {
  "message": "紧接着，她绽放出一个灿烂得让人有点想笑的笑容。"
 },
 {
  "name": "槐",
  "message": "「……我回来了」"
 },
 {
  "name": "槐",
  "message": "「你才是，欢迎回来」"
 },
 {
  "name": "水仙",
  "message": "「嗯，我回来了」"
 },
 {
  "message": "唉，真是的……光看她那张脸我就明白了。她这一路上，肯定吃了不少苦头吧。"
 },
 {
  "name": "槐",
  "message": "「我听说了，小水。听说你这次闹翻天了？」"
 },
 {
  "name": "水仙",
  "message": "「消息挺灵通嘛，当时可刺激了，一大帮人红着眼在后面追，死活不肯撒手」"
 },
 {
  "name": "水仙",
  "message": "「……真的，把这辈子跑的路都跑完了」"
 },
 {
  "name": "槐",
  "message": "「没事吧？」"
 },
 {
  "name": "水仙",
  "message": "「腿伤得可厉害了，韧带什么的都断了」"
 },
 {
  "name": "水仙",
  "message": "「估计这阵子……是没法跑步了」"
 },
 {
  "name": "槐",
  "message": "「……是吗」"
 },
 {
  "message": "只是一阵子没法跑步，已经算万幸了吧。"
 },
 {
  "name": "槐",
  "message": "「你啊……真的别乱来了……」"
 },
 {
  "name": "水仙",
  "message": "「干、干嘛啦～」"
 },
 {
  "name": "槐",
  "message": "「……你打算送死吗？」"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「别这么……乱来啊……」"
 },
 {
  "name": "水仙",
  "message": "「……对不起」"
 },
 {
  "name": "槐",
  "message": "「要是没有你……我要怎么办啊……」"
 },
 {
  "name": "水仙",
  "message": "「嗯%0　水水知道啦」"
 },
 {
  "name": "槐",
  "message": "「以后……多爱惜自己啊」"
 },
 {
  "name": "水仙",
  "message": "「是～」"
 },
 {
  "message": "她笑着答应道，但要是再碰上这种事，她肯定还会这么干吧。"
 },
 {
  "name": "槐",
  "message": "（……是啊……她，肯定会这么做的……）"
 },
 {
  "message": "既然如此，那我……"
 },
 {
  "name": "水仙",
  "message": "「大哥正面挨了夜乃学姐的B.E.G.，估计这几个月都别想正常活动了」"
 },
 {
  "name": "槐",
  "message": "「欸欸欸欸，这样啊」"
 },
 {
  "name": "水仙",
  "message": "「虽然宅子里的研究人员们，都在拼命想办法治」"
 },
 {
  "name": "水仙",
  "message": "「不过好像束手无策呢」"
 },
 {
  "message": "直视瓦砾是停止的B.E.G.。"
 },
 {
  "message": "没想到居然能让目标『停止』这么长时间。"
 },
 {
  "name": "水仙",
  "message": "「然后啊……嗯……」"
 },
 {
  "name": "槐",
  "message": "「你干嘛一副心虚的表情？」"
 },
 {
  "name": "水仙",
  "message": "「大哥之前不是对学院的通道做了手脚，把它连到了异界吗？」"
 },
 {
  "name": "水仙",
  "message": "「人家知道以后……感觉必须去救你才行」"
 },
 {
  "name": "水仙",
  "message": "「毕竟大哥当时气疯了，水水觉得二哥肯定会被他杀掉的」"
 },
 {
  "name": "槐",
  "message": "「嗯」"
 },
 {
  "name": "水仙",
  "message": "「可水水要是跟大哥打，肯定打不过吧？所以……」"
 },
 {
  "name": "槐",
  "message": "「你……你不会……！」"
 },
 {
  "message": "零散的线索在这一刻全都串了起来。"
 },
 {
  "name": "槐",
  "message": "「把夜乃学姐带到『异界』的人，难道是——」"
 },
 {
  "name": "水仙",
  "message": "「……啊哈哈～」"
 },
 {
  "name": "槐",
  "message": "「你、你是，怎么做到的……？啊！难道……你用了宅子的通道……？！」"
 },
 {
  "name": "水仙",
  "message": "「……是」"
 },
 {
  "name": "槐",
  "message": "<s30>「你啊啊啊啊啊啊啊啊啊啊啊！！」</s>"
 },
 {
  "message": "我猛地坐起身。"
 },
 {
  "name": "水仙",
  "message": "「喵呜！别生气嘛，哥哥～～～」"
 },
 {
  "name": "槐",
  "message": "「你、你、你把她放进来了？！把夜乃学姐？！放进了咱宅子里？！」"
 },
 {
  "name": "水仙",
  "message": "「……至少呢，水水把痕迹都处理干净了哦？运气也不错，正好赶上爸爸不在的时候」"
 },
 {
  "name": "槐",
  "message": "「运气不错？！」"
 },
 {
  "message": "搞了半天，原来全凭运气啊！！"
 },
 {
  "name": "槐",
  "message": "「你……你到底打算怎么办？！万一老爹和夜乃学姐撞上了！」"
 },
 {
  "name": "水仙",
  "message": "「那当然是——让她上，我脚底抹油开溜」"
 },
 {
  "name": "槐",
  "message": "（绝对是鬼话）"
 },
 {
  "message": "我还能不了解她吗。"
 },
 {
  "message": "她肯定是打算自己拖住老爸，好让夜乃学姐先走。"
 },
 {
  "message": "她就是这种人。"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「哥哥……？真的，对不……呀啊」"
 },
 {
  "message": "我抱住了她。"
 },
 {
  "name": "水仙",
  "message": "「呀呜……啊……哇哇……这、这个……那个……哥哥……？！」"
 },
 {
  "name": "槐",
  "message": "「～～～！」"
 },
 {
  "name": "水仙",
  "message": "「啊……抱、抱太紧了啦……」"
 },
 {
  "name": "槐",
  "message": "「你这个……傻瓜……」"
 },
 {
  "name": "水仙",
  "message": "「啊呜……」"
 },
 {
  "name": "槐",
  "message": "「傻瓜……」"
 },
 {
  "name": "水仙",
  "message": "「哥哥……有点……痛耶……」"
 },
 {
  "name": "槐",
  "message": "「忍着，这点疼算什么」"
 },
 {
  "message": "直到这一刻，我才终于想明白了。"
 },
 {
  "name": "槐",
  "message": "（我必须好好想想今后的事情）"
 },
 {
  "message": "想做什么，该做什么，想成为什么，该怎么选择。"
 },
 {
  "name": "水仙",
  "message": "「……哥哥欺负人」"
 },
 {
  "name": "槐",
  "message": "「唉……真是的……」"
 },
 {
  "name": "槐",
  "message": "「……谢了，小水」"
 },
 {
  "name": "水仙",
  "message": "「嗯」"
 },
 {
  "name": "槐",
  "message": "「要是没有你，我早就没命了吧」"
 },
 {
  "name": "水仙",
  "message": "「嗯」"
 },
 {
  "name": "槐",
  "message": "「但是……」"
 },
 {
  "name": "槐",
  "message": "「要是你因为我出了什么意外，我也活不下去啊」"
 },
 {
  "name": "水仙",
  "message": "「……嗯」"
 },
 {
  "name": "槐",
  "message": "「真是的，你这个，大傻瓜！」"
 },
 {
  "message": "我伸手一顿猛揉，把妹妹的头发揉得乱七八糟。"
 },
 {
  "name": "水仙",
  "message": "「呀～～！等、等一下，哥哥！发、发型乱了啦！」"
 },
 {
  "name": "槐",
  "message": "「闭嘴，你个没脑子的！」"
 },
 {
  "name": "水仙",
  "message": "「呀～～～～！」"
 },
 {
  "message": "……说到底，这次事情，我什么都没能改变。"
 },
 {
  "message": "是小水，把我们救了出来。"
 },
 {
  "name": "槐",
  "message": "（我……得更……）"
 },
 {
  "name": "槐",
  "message": "（更像样点才行啊……）"
 },
 {
  "name": "槐",
  "message": "「……嗯？」"
 },
 {
  "name": "水仙",
  "message": "「有人来了？」"
 },
 {
  "message": "我从门上的猫眼往外看。"
 },
 {
  "message": "站在门外的，是学生会的各位。"
 },
 {
  "message": "夜乃学姐，华淡，还有兰开斯特。"
 },
 {
  "name": "槐",
  "message": "「啊……」"
 },
 {
  "message": "她们怎么来了？"
 },
 {
  "name": "槐",
  "message": "「小水，大家都来了——」"
 },
 {
  "message": "我转过身正要开口，水仙的身影已经不见了。"
 },
 {
  "message": "真不愧是忍者，溜得飞快。"
 },
 {
  "message": "我打开门。"
 },
 {
  "name": "华淡",
  "message": "「夏学长～恭喜出院～！」"
 },
 {
  "name": "樱",
  "message": "「……铃宫，怎么样，身体还好吗」"
 },
 {
  "name": "索菲娅",
  "message": "「这下玫瑰派对就满血复活了！咱们来开庆祝派对吧」"
 },
 {
  "name": "华淡",
  "message": "「好像有不认识的人满血复活了耶，叫什么什么派对来着」"
 },
 {
  "message": "看到她们一个个生龙活虎的样子，我又松了口气。"
 },
 {
  "name": "槐",
  "message": "（太好了，大家都还好——）"
 },
 {
  "name": "华淡",
  "message": "「好啦好啦学长，人家要进屋咯～～」"
 },
 {
  "name": "槐",
  "message": "「什么，等下……」"
 },
 {
  "name": "索菲娅",
  "message": "「呵呵，我可是买了好多好吃的过来呢！」"
 },
 {
  "name": "樱",
  "message": "「第一次……和朋友们开派对……」"
 },
 {
  "message": "一帮人就这么乌泱泱地全挤进了屋里。"
 },
 {
  "message": "……嘛，感觉，也无所谓吧。"
 }
]