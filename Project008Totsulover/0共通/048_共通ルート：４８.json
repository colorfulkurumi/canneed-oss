[
 {
  "message": "暗夜之中，唯有一轮黄金月，像聚光灯一样照亮整座宅子。"
 },
 {
  "name": "槐",
  "message": "（好安静）"
 },
 {
  "message": "——感觉不到有人。"
 },
 {
  "message": "不，也不是没有。"
 },
 {
  "message": "是只剩一股。"
 },
 {
  "message": "那唯一的气息实在太过庞大，庞大到视野无法容纳，反而像是一片虚无。"
 },
 {
  "name": "桧木",
  "message": "「槐，回来了啊」"
 },
 {
  "name": "槐",
  "message": "「……老爸」"
 },
 {
  "name": "桧木",
  "message": "「偶尔，来对练一场吧」"
 },
 {
  "name": "槐",
  "message": "「……好」"
 },
 {
  "message": "我摆开拳脚。"
 },
 {
  "message": "——瞬间，老爹的身影从原地消失。"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「啧」"
 },
 {
  "message": "我的背后，伸出一条粗如圆木的手臂。"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "预先刻印在身体上的魔术程序自动做出了反应。"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "message": "我的身影如雾气般瞬间消散，老爹的重拳直接穿了过去。"
 },
 {
  "name": "槐",
  "message": "「哈啊——！」"
 },
 {
  "message": "我踩着老爹的大腿腾空跃起，顺势一记高速回旋踢扫向他的脑袋。"
 },
 {
  "name": "桧木",
  "message": "「哼……果然啊」"
 },
 {
  "name": "槐",
  "message": "「？！」"
 },
 {
  "message": "老爹却面不改色地抓住了我的脚踝。"
 },
 {
  "name": "槐",
  "message": "（以这种姿势，肯定来不及才对——）"
 },
 {
  "message": "他从无限重叠的近似次元中，重新读取了自己的肉体。"
 },
 {
  "message": "这是老爹的拿手好戏。"
 },
 {
  "name": "槐",
  "message": "「但是——」"
 },
 {
  "message": "到这步为止，都在预料之中。"
 },
 {
  "name": "槐",
  "message": "「咯……嘎啊啊啊啊啊啊啊啊啊啊啊啊！！！」"
 },
 {
  "message": "我的肋骨，刺破皮肉穿了出来。"
 },
 {
  "name": "桧木",
  "message": "「什……」"
 },
 {
  "message": "那些肋骨像食肉植物一样疯狂伸展，如同铁处女般从两侧将老爹死死锁住。"
 },
 {
  "name": "槐",
  "message": "（得手了……！）"
 },
 {
  "name": "桧木",
  "message": "「真是……」"
 },
 {
  "name": "桧木",
  "message": "「变厉害了啊」"
 },
 {
  "message": "锯齿状的肋骨，想要将老爹的双臂生生切断。"
 },
 {
  "message": "在那钢铁般的皮肤上，终于切开了缺口。"
 },
 {
  "message": "但是——"
 },
 {
  "name": "槐",
  "message": "「咳噗……」"
 },
 {
  "message": "——零距离下的寸拳。"
 },
 {
  "name": "桧木",
  "message": "「别松懈，专心」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「啧」"
 },
 {
  "message": "并不是一击。"
 },
 {
  "message": "冲着被肋骨死死锁住的我，他轰出了连珠炮般的寸拳。"
 },
 {
  "name": "槐",
  "message": "「……呜」"
 },
 {
  "message": "最后一击把我彻底轰飞，身体狠狠撞在了墙上。"
 },
 {
  "name": "桧木",
  "message": "「……计划得不算差，但，还是太欠缺锻炼了」"
 },
 {
  "name": "槐",
  "message": "「哈……哈……咳、咳……那还……真是承蒙夸奖了啊……」"
 },
 {
  "message": "内脏被搅得稀烂，肋骨也断了几根。"
 },
 {
  "message": "但不可思议的是，我的心情并不坏。"
 },
 {
  "name": "桧木",
  "message": "「任务，怎么样了？」"
 },
 {
  "name": "槐",
  "message": "「……老哥插了一脚，你知道吧？」"
 },
 {
  "name": "桧木",
  "message": "「嗯……是啊」"
 },
 {
  "name": "槐",
  "message": "「替我转告老哥」"
 },
 {
  "name": "槐",
  "message": "「——下次再碍事，就杀了他」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「知道了，我会告诉他」"
 },
 {
  "name": "槐",
  "message": "「还不止……这些……」"
 },
 {
  "message": "我拖着残破不堪的身体，站起身来。"
 },
 {
  "name": "槐",
  "message": "「……你也一样」"
 },
 {
  "name": "桧木",
  "message": "「……哦」"
 },
 {
  "name": "槐",
  "message": "「任务我会完成，碧蓝之心我也会拿到手」"
 },
 {
  "name": "槐",
  "message": "「但是，别对我的做法……指指点点……」"
 },
 {
  "name": "桧木",
  "message": "「…… 」"
 },
 {
  "name": "槐",
  "message": "「要是敢对水仙出手，就算是你，我也照杀不误」"
 },
 {
  "name": "槐",
  "message": "「要是敢对学院的人出手，就算是你，我也照杀不误」"
 },
 {
  "name": "槐",
  "message": "「——我是认真的」"
 },
 {
  "name": "桧木",
  "message": "「……呵」"
 },
 {
  "name": "桧木",
  "message": "「长进不少，眼神有力气了」"
 },
 {
  "name": "槐",
  "message": "「……啊？」"
 },
 {
  "name": "桧木",
  "message": "「就像刀一样」"
 },
 {
  "name": "桧木",
  "message": "「总算，有点独当一面的样子了吗」"
 },
 {
  "name": "槐",
  "message": "「你……你在说什么……？」"
 },
 {
  "name": "桧木",
  "message": "「我是你的父亲」"
 },
 {
  "name": "桧木",
  "message": "「我比任何人都更了解你」"
 },
 {
  "name": "桧木",
  "message": "「……也好」"
 },
 {
  "name": "桧木",
  "message": "「如果觉得我碍事，到时候，杀了我就是」"
 },
 {
  "name": "桧木",
  "message": "「——我也一样」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "桧木",
  "message": "「这是，男子汉之间，平等的关系」"
 },
 {
  "name": "槐",
  "message": "「什么男不男的……一点都不像魔术师，老掉牙的想法……」"
 },
 {
  "name": "桧木",
  "message": "「不是这样的」"
 },
 {
  "name": "桧木",
  "message": "「男子汉这个名字，是行走于荒野的觉悟」"
 },
 {
  "name": "桧木",
  "message": "「性别之类，一文不值」"
 },
 {
  "name": "桧木",
  "message": "「就像荒野中的孤狮，无法把自己的死归咎于任何人」"
 },
 {
  "name": "桧木",
  "message": "「这是，孤身一人，对抗整个世界的觉悟」"
 },
 {
  "name": "桧木",
  "message": "「这才是『男子汉』」"
 },
 {
  "name": "槐",
  "message": "「……这都，什么……不像样子」"
 },
 {
  "name": "桧木",
  "message": "「……呵」"
 },
 {
  "name": "桧木",
  "message": "「但给我记住，槐啊」"
 },
 {
  "name": "槐",
  "message": "「……什么？」"
 },
 {
  "name": "桧木",
  "message": "「为父，是爱你的」"
 },
 {
  "name": "桧木",
  "message": "「哪怕，最终死在你手里。哪怕，最终由我来取你性命」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "真是，公平啊。"
 },
 {
  "message": "或许在这些方面，我终究继承了这个男人的血脉吧。"
 },
 {
  "name": "槐",
  "message": "「话就说到这吧……我走了」"
 },
 {
  "name": "桧木",
  "message": "「嗯」"
 },
 {
  "message": "我无视腹部传来的阵阵剧痛，迈步离去。"
 },
 {
  "message": "我觉得，怎么着也得装到底。"
 },
 {
  "message": "我觉得，绝不能再让他看到我这副狼狈的样子了。"
 }
]