[
 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "name": "华淡",
  "message": "「……欸」"
 },
 {
  "name": "索菲娅",
  "message": "「这里……是……？」"
 },
 {
  "message": "我们之前，竟完全没有察觉到。"
 },
 {
  "name": "华淡",
  "message": "「不管怎么看……这里都不像是湘南吧……？」"
 },
 {
  "message": "那股令人作呕的邪恶气息，早已缠上我们的双腿。"
 },
 {
  "name": "索菲娅",
  "message": "「这里是……」"
 },
 {
  "name": "槐",
  "message": "「都……把B.E.G.拿出来」"
 },
 {
  "name": "华淡",
  "message": "「——欸？」"
 },
 {
  "message": "我觉得，这就是报应。"
 },
 {
  "message": "我这种人，奢望过安稳日子的报应。"
 },
 {
  "name": "槐",
  "message": "「全体注意！这里是，<d0054>异界</d>！」"
 },
 {
  "name": "索菲娅",
  "message": "「异……界……？」"
 },
 {
  "message": "我戴上舞蹈笔记。"
 },
 {
  "message": "走廊尽头，正散发着某种……亵渎的气息。"
 },
 {
  "message": "我能感觉到，它正一步步逼近。"
 },
 {
  "message": "——一个男人，正躲在远处的阴影里，注视着这一切。"
 },
 {
  "name": "清枫",
  "message": "「我亲爱的弟弟，我也不想弄得太过分啊」"
 },
 {
  "name": "清枫",
  "message": "「不过嘛……就当是爱的鞭策好了。再说，以你的本事，这点难度应该不在话下吧？」"
 },
 {
  "name": "清枫",
  "message": "「难度，成树级。类型，Black。场地，异界。名为『寻找鹿岛』」"
 },
 {
  "name": "清枫",
  "message": "「别死啊」"
 },
 {
  "name": "清枫",
  "message": "「虽然死了……也就是再去找个替代品而已」"
 },
 {
  "message": "男人轻笑着，从怀中摸出了一个约一米高的人偶。"
 },
 {
  "name": "索菲娅",
  "message": "「N.a.v.i.！N.a.v.i.……听不到吗？！」"
 },
 {
  "name": "槐",
  "message": "「没用的……与外界的通信已经被彻底切断了」"
 },
 {
  "name": "华淡",
  "message": "「等等……这、这是怎么回事？」"
 },
 {
  "name": "华淡",
  "message": "「也就是说……有人在暗中改写了通道的坐标……？」"
 },
 {
  "name": "华淡",
  "message": "「能、能暗中改写，通道坐标的人……」"
 },
 {
  "name": "索菲娅",
  "message": "「——魔术师」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "索菲娅",
  "message": "「……如果单论在反现实领域的造诣」"
 },
 {
  "name": "索菲娅",
  "message": "「那些家伙可没有伦理道德的束缚，比学院还要强得多」"
 },
 {
  "name": "索菲娅",
  "message": "「虽然能入侵通道坐标的高阶魔术师……应该屈指可数」"
 },
 {
  "name": "索菲娅",
  "message": "「可、可为什么是我们……？我们……应该不至于被那么厉害的魔术师盯上吧……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "想起来了。"
 },
 {
  "message": "这种黏糊糊的，甩不掉的视线。"
 },
 {
  "name": "槐",
  "message": "（……是……老哥）"
 },
 {
  "name": "槐",
  "message": "（是老哥……他在通道坐标上动了手脚！为了杀掉索菲娅和华淡！）"
 },
 {
  "message": "只有这种解释。"
 },
 {
  "message": "既有这个本事，又有动机的魔术师，只有他了。"
 },
 {
  "name": "华淡",
  "message": "「……没事吧？夏学长」"
 },
 {
  "name": "槐",
  "message": "「啊……欸……？」"
 },
 {
  "name": "华淡",
  "message": "「怎么出这么多汗……脸色也好难看哦……」"
 },
 {
  "name": "槐",
  "message": "「……嗯……嗯……」"
 },
 {
  "name": "索菲娅",
  "message": "「没关系！我好歹也是学生会的副会长呀」"
 },
 {
  "name": "索菲娅",
  "message": "「不用担心，我会保护你们的」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "她是觉得我在害怕吗，朝我故作坚强地笑了笑。"
 },
 {
  "name": "槐",
  "message": "（我……我到底……）"
 },
 {
  "message": "到底该怎么办才好？"
 },
 {
  "name": "槐",
  "message": "（因为，现在，这个情况——）"
 },
 {
  "name": "槐",
  "message": "（就算杀了兰开斯特，也能编出无数借口……）"
 },
 {
  "message": "我的指尖，止不住地颤抖。"
 },
 {
  "message": "——啪嗒，啪嗒。"
 },
 {
  "name": "华淡",
  "message": "「……欸？」"
 },
 {
  "message": "有声音，是从昏暗的走廊深处传来的。"
 },
 {
  "message": "——啪嗒，啪嗒。"
 },
 {
  "name": "索菲娅",
  "message": "「有什么东西，来了！」"
 },
 {
  "message": "兰开斯特举起刺剑，华淡也提起链锯。"
 },
 {
  "name": "槐",
  "message": "（那是……什么）"
 },
 {
  "message": "那里，站着一个人。"
 },
 {
  "message": "体型格外娇小，身子纤弱得仿佛一碰就碎。"
 },
 {
  "message": "可手脚却长得离奇，简直像某种长腿蜘蛛一样。"
 },
 {
  "message": "而最让人毛骨悚然的是——"
 },
 {
  "name": "槐",
  "message": "（那张脸……）"
 },
 {
  "message": "那张脸上，竟然密密麻麻地布满了眼睛。"
 },
 {
  "name": "华淡",
  "message": "「呀！」"
 },
 {
  "name": "索菲娅",
  "message": "「那是……！」"
 },
 {
  "name": "浑身是眼的少女",
  "message": "「……啊……啊……啊……啊」"
 },
 {
  "name": "浑身是眼的少女",
  "message": "「……认……识……吗……？」"
 },
 {
  "name": "槐",
  "message": "「——欸？」"
 },
 {
  "name": "浑身是眼的少女",
  "message": "「鹿岛……鹿岛……认识……吗？」"
 },
 {
  "name": "华淡",
  "message": "「鹿……岛……？」"
 },
 {
  "name": "浑身是眼的少女",
  "message": "「找到……找到……鹿，岛……」"
 },
 {
  "name": "浑身是眼的少女",
  "message": "「找到……找到……求求你们……找到她……找到她……快点！」"
 },
 {
  "name": "浑身是眼的少女",
  "message": "「给我找到她——！！」"
 },
 {
  "message": "伴随震天动地的咆哮。"
 },
 {
  "message": "转瞬之间，那浑身是眼的少女猛地跃起，吸附在天花板上，手脚并用地飞奔起来。"
 },
 {
  "name": "槐",
  "message": "（来了！）"
 },
 {
  "name": "槐",
  "message": "「舞蹈笔记！」"
 },
 {
  "message": "舞蹈笔记是能将接触到的物体弹飞五米的B.E.G.，虽然搞不懂这是什么状况，但在这鬼地方，最适合拿来防身了。"
 },
 {
  "name": "浑身是眼的少女",
  "message": "「找到她！找到她！找到——」"
 },
 {
  "name": "槐",
  "message": "「哇啊——怎么回事？！」"
 },
 {
  "message": "就在我触碰到少女的瞬间——被击退的，反而是我自己。"
 },
 {
  "name": "槐",
  "message": "「唔！」"
 },
 {
  "message": "——不多不少，正好五米。"
 },
 {
  "name": "索菲娅",
  "message": "「你在干什么呀！铃宫！」"
 },
 {
  "name": "索菲娅",
  "message": "「——蔷薇盟誓！」"
 },
 {
  "message": "兰开斯特从背后唤出刺剑，锁定了目标。"
 },
 {
  "name": "索菲娅",
  "message": "「看招……呀啊？！」"
 },
 {
  "message": "刺剑呼啸而出，贯穿了浑身是眼的少女。然而就在这瞬间——"
 },
 {
  "name": "华淡",
  "message": "「危险！」"
 },
 {
  "message": "那柄在空中飞驰的刺剑，竟袭向了兰开斯特。"
 },
 {
  "name": "索菲娅",
  "message": "「谢、谢谢……」"
 },
 {
  "name": "华淡",
  "message": "「不客气！」"
 },
 {
  "message": "华淡手中的链锯及时挑开刺剑。"
 },
 {
  "name": "浑身是眼的少女",
  "message": "「找到……她……只要找到她就好，只要找到她……就……好……」"
 },
 {
  "message": "十只、二十只……数不清多少只眼睛正死死地盯着我们。"
 },
 {
  "name": "索菲娅",
  "message": "「这是……」"
 },
 {
  "name": "槐",
  "message": "「错不了！它能反射B.E.G.！」"
 },
 {
  "name": "华淡",
  "message": "「欸欸欸欸！反射B.E.G.的怪兽？！这样要怎么对付啊！」"
 },
 {
  "name": "浑身是眼的少女",
  "message": "「找到她！！找到她——！！」"
 },
 {
  "message": "浑身是眼的少女发出一声尖啸，腾空跃起。"
 },
 {
  "name": "槐",
  "message": "「华淡！」"
 },
 {
  "name": "华淡",
  "message": "「好嘞！赤刀！」"
 },
 {
  "message": "华淡手起刀落，将地面利落地切出一个四方形，我们随即纵身跳下。"
 },
 {
  "name": "槐",
  "message": "「那家伙也会追下来的！」"
 },
 {
  "name": "华淡",
  "message": "「没关系！人家也是在不断成长的嘛！」"
 },
 {
  "name": "华淡",
  "message": "「赤刀的新能力！」"
 },
 {
  "name": "华淡",
  "message": "「将切掉的东西，复原！」"
 },
 {
  "name": "槐",
  "message": "「！」"
 },
 {
  "message": "被华淡切开的地板悠悠浮起，接着猛地合上，严丝合缝地嵌回了原处。"
 },
 {
  "name": "浑身是眼的少女",
  "message": "『找到她！找到她！！找到她——！！』"
 },
 {
  "message": "楼上不断传来咚咚的撞击声，但也仅此而已。"
 },
 {
  "name": "索菲娅",
  "message": "「得、得救了——」"
 },
 {
  "name": "华淡",
  "message": "「哼哼——快夸人家快夸人家」"
 },
 {
  "name": "槐",
  "message": "「……才这么一会儿就觉醒了新能力，你该不会是天才吧」"
 },
 {
  "name": "华淡",
  "message": "「哼哼哼～～♪」"
 },
 {
  "message": "不对，现在可不是说这个的时候。"
 },
 {
  "name": "索菲娅",
  "message": "「那家伙很快就会追过来的！我们先撤退，思考对策吧」"
 },
 {
  "name": "华淡",
  "message": "「明白！」"
 },
 {
  "message": "我们沿着走廊跑了出去。"
 }
]