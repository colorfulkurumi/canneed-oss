[
 {
  "message": "踩着大楼外墙一路跳跃，总算落到了附近的一个街角。"
 },
 {
  "name": "水仙",
  "message": "「……呼——刚才可真够呛的——」"
 },
 {
  "message": "来这儿之前，我就把那副带『<d0002>信息干扰</d>』性质的面具摘掉了。"
 },
 {
  "message": "破破烂烂的衣服也换了身新的，快速换装可是魔术师的拿手好戏。"
 },
 {
  "name": "槐",
  "message": "「……我真以为我要交代了」"
 },
 {
  "name": "水仙",
  "message": "「去招惹『学院』什么的，我可不想有下次了，啊哈哈哈」"
 },
 {
  "message": "总之，我们的任务算是结束了。"
 },
 {
  "name": "槐",
  "message": "「但愿老哥那边一切顺利吧」"
 },
 {
  "name": "水仙",
  "message": "「大哥会失败？怎么可能嘛！」"
 },
 {
  "message": "我们——是魔术师『崩月家』一族。"
 },
 {
  "message": "百年以来，我们一直威胁着市民的安宁，散播恐惧与疯狂，同时也不断地探求着真理。"
 },
 {
  "message": "在外人眼里，我们就是一群麻烦透顶的家伙。"
 },
 {
  "name": "槐",
  "message": "「唉，赶紧回去吧，累死我了。小水，来，手」"
 },
 {
  "name": "水仙",
  "message": "「牵、牵手就不用了吧！人家已经不是小宝宝了！」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "水仙",
  "message": "「再说，人家现在的个头都比哥哥高了！」"
 },
 {
  "name": "槐",
  "message": "「这跟个子高不高有什么关系啊！」"
 },
 {
  "message": "我受打击了。"
 },
 {
  "message": "明明小时候，回家路上不牵着我的手她就要哭鼻子的。"
 },
 {
  "name": "水仙",
  "message": "「好啦，走咯♪」"
 },
 {
  "message": "水仙已经自顾自地迈开步子，走在了前面。"
 },
 {
  "name": "？？？",
  "message": "「呀」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "——我刚迈了一步，就撞到了人。"
 },
 {
  "name": "槐",
  "message": "「抱、抱歉，没事吧……」"
 },
 {
  "name": "？？？",
  "message": "「……」"
 },
 {
  "message": "我朝摔坐在地的少女伸出了手。"
 },
 {
  "message": "只不过——"
 },
 {
  "name": "槐",
  "message": "（……）"
 },
 {
  "message": "时间仿佛静止了。"
 },
 {
  "message": "美丽的银色长发，宝石般的双眸，那娇小的身躯，有种人偶般的精致。"
 },
 {
  "name": "槐",
  "message": "（不只是可爱，看着她，总觉得……）"
 },
 {
  "name": "槐",
  "message": "（有点……怪怪的……）"
 },
 {
  "message": "我还是第一次有这种感觉。"
 },
 {
  "message": "感觉有点局促不安，有点胸口发紧，可目光怎么也挪不开。"
 },
 {
  "message": "就好像我的心脏本身，正在渴望着她的存在——"
 },
 {
  "name": "槐",
  "message": "（等等，我怎么盯着一个初次见面的女生看个没完啊？！）"
 },
 {
  "name": "槐",
  "message": "「抱歉……你没事吧？」"
 },
 {
  "message": "少女没有接我伸出的手，径直站了起来。"
 },
 {
  "name": "？？？",
  "message": "「对不起，我有点赶，没看到」"
 },
 {
  "name": "槐",
  "message": "「嗯、嗯……其实，我也……」"
 },
 {
  "name": "？？？",
  "message": "「……」"
 },
 {
  "message": "少女微微低了下头，便转身走了。"
 },
 {
  "name": "槐",
  "message": "「那个！」"
 },
 {
  "name": "？？？",
  "message": "「？」"
 },
 {
  "name": "槐",
  "message": "「那、那个……」"
 },
 {
  "message": "……我到底想跟她说什么来着？"
 },
 {
  "name": "槐",
  "message": "「如果可以的话，联系方式……」"
 },
 {
  "name": "？？？",
  "message": "「欸？」"
 },
 {
  "name": "槐",
  "message": "「能不能，留个联系方式……就是……啊？我、我在干嘛啊？」"
 },
 {
  "name": "？？？",
  "message": "「……」"
 },
 {
  "name": "？？？",
  "message": "「不好意思，我不给粉丝留联系方式」"
 },
 {
  "name": "槐",
  "message": "「粉丝？」"
 },
 {
  "name": "？？？",
  "message": "「……欸？」"
 },
 {
  "name": "？？？",
  "message": "「……你，难道不知道我是谁吗？」"
 },
 {
  "name": "槐",
  "message": "「欸？啊……对，不好意思」"
 },
 {
  "message": "难不成是什么明星？我对世上的事完全没兴趣，压根认不出来。"
 },
 {
  "name": "？？？",
  "message": "「……」"
 },
 {
  "name": "？？？",
  "message": "「那，为什么？」"
 },
 {
  "name": "槐",
  "message": "「欸，啊，这、怎么回事啊……啊……真的假的，呜哇，脸好烫……大概是」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……我，可能对你一见钟情了」"
 },
 {
  "name": "？？？",
  "message": "「……」"
 },
 {
  "name": "？？？",
  "message": "「呵，真是有趣的搭讪」"
 },
 {
  "name": "槐",
  "message": "「欸，不是的，我不是在搭讪！我、我是第一次对人说这句话！」"
 },
 {
  "name": "？？？",
  "message": "「然而，这也是搭讪的常用话术」"
 },
 {
  "name": "槐",
  "message": "「啊呃，不那个，呃啊——」"
 },
 {
  "name": "？？？",
  "message": "「呵呵」"
 },
 {
  "name": "？？？",
  "message": "「看来是真的呢——脸都红成那样了」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "看到那个笑容的瞬间，我的心脏像是被狠狠击中。"
 },
 {
  "message": "而且也太羞耻了，丢人丢到家了。"
 },
 {
  "message": "呜哇，好羞耻，想死的心都有了。"
 },
 {
  "name": "槐",
  "message": "「呜呜……那个……对不起……」"
 },
 {
  "name": "？？？",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「夜乃樱，我的名字」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "樱",
  "message": "「虽然不能给你联系方式」"
 },
 {
  "name": "樱",
  "message": "「不过谢谢你，感觉，轻松了些」"
 },
 {
  "message": "那位娇小的少女轻轻一笑，转身走了。"
 },
 {
  "message": "留在原地的，只有满脸通红，一脸蠢样的我。"
 },
 {
  "name": "槐",
  "message": "（搞什么啊，刚才，到底怎么回事？！）"
 },
 {
  "message": "……脑子一团糟，根本理不清。"
 },
 {
  "message": "算了，先追上水仙再说吧。"
 }
]