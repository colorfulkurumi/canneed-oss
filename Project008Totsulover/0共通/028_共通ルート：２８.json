 {
  "name": "樱",
  "message": "「怎么，会……」"
 },
 {
  "name": "索菲娅",
  "message": "「——所以，今天，你要输给我了」"
 },
 {
  "name": "樱",
  "message": "「……欸？」"
 },
 {
  "message": "就在那瞬间。"
 },
 {
  "message": "现实，猛地一下，扭曲了。"
 },
 {
  "name": "索菲娅",
  "message": "「一道伤，两道伤，三道伤」"
 },
 {
  "name": "索菲娅",
  "message": "「每受一次伤，我就会变得更强，我们……会变得更强」"
 },
 {
  "name": "索菲娅",
  "message": "「这就是我与世界的约定。绝不背弃的，骄傲的契约」"
 },
 {
  "name": "索菲娅",
  "message": "「——蔷薇盟誓」"
 },
 {
  "name": "樱",
  "message": "「……欸？」"
 },
 {
  "name": "樱",
  "message": "「这是……什么——」"
 },
 {
  "name": "樱",
  "message": "「那么多的……伤口——」"
 },
 {
  "name": "樱",
  "message": "「是什么时候……？」"
 },
 {
  "name": "索菲娅",
  "message": "「……你还没注意到吗？会长……」"
 },
 {
  "name": "樱",
  "message": "「欸……？」"
 },
 {
  "name": "索菲娅",
  "message": "「这些，全都是你的伤口」"
 },
 {
  "name": "索菲娅",
  "message": "「是你一个人背负的，高傲的伤疤」"
 },
 {
  "name": "索菲娅",
  "message": "「现在，它们全都化作了这银色的刺剑」"
 },
 {
  "message": "蔷薇盟誓——受的伤越深，自动追踪的刺剑就越多。"
 },
 {
  "name": "樱",
  "message": "「为……什么……？」"
 },
 {
  "name": "樱",
  "message": "「明明是我受的伤……你怎么会……？」"
 },
 {
  "name": "索菲娅",
  "message": "「这不是……当然吗……！！」"
 },
 {
  "name": "索菲娅",
  "message": "「因为我们！是朋友啊——？！」"
 },
 {
  "name": "樱",
  "message": "「……欸」"
 },
 {
  "name": "索菲娅",
  "message": "「朋友受伤的话！我也会受伤啊……！」"
 },
 {
  "name": "索菲娅",
  "message": "「这不是……废话吗……」"
