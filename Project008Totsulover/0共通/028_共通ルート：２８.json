[
 {
  "message": "时限就定为一周吧。"
 },
 {
  "message": "这是兰开斯特的提议。"
 },
 {
  "message": "特训期间，学生会那边的工作肯定会耽搁。能腾出来集中进行特训的时间，撑死也就一周。"
 },
 {
  "message": "而今天，就是约定的那天。"
 },
 {
  "name": "樱",
  "message": "「……怎么了，索菲，特地把我叫到训练场来」"
 },
 {
  "name": "樱",
  "message": "「今天还有很多工作要做呢」"
 },
 {
  "name": "索菲娅",
  "message": "「夜乃会长，今天我有一事相求」"
 },
 {
  "name": "樱",
  "message": "「嗯，什么事？」"
 },
 {
  "name": "索菲娅",
  "message": "「请和我打一场模拟战」"
 },
 {
  "name": "索菲娅",
  "message": "「如果我赢了，就不要再把我当小孩看了」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「可以，但不可能的，你太弱了，索菲」"
 },
 {
  "name": "索菲娅",
  "message": "「……！」"
 },
 {
  "name": "索菲娅",
  "message": "「……没错，我确实很弱，但如果，我们三个一起的话——」"
 },
 {
  "name": "华淡",
  "message": "「咱们加在一起绝对是最强的。就算是会长也能一下搞定」"
 },
 {
  "name": "槐",
  "message": "「一拳搞定是绝对不可能的，不过……」"
 },
 {
  "name": "槐",
  "message": "「学姐是觉得我们太弱了，只会拖后腿，才不让我们做事，对吧？」"
 },
 {
  "name": "樱",
  "message": "「嗯」"
 },
 {
  "name": "华淡",
  "message": "（这种时候一点面子都不给人留，会长真是的～）"
 },
 {
  "name": "槐",
  "message": "「既然如此……」"
 },
 {
  "name": "槐",
  "message": "「如果我们三个能赢过夜乃学姐的话，能不能请你多少让我们做点事呢？」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「如果你们真能做到……」"
 },
 {
  "name": "樱",
  "message": "「……嗯，那确实没理由，不把事情交给你们了」"
 },
 {
  "name": "槐",
  "message": "「！」"
 },
 {
  "name": "樱",
  "message": "「不过，多半不可能。我又不会手下留情」"
 },
 {
  "name": "华淡",
  "message": "「那是当然！靠你放水赢有什么意思」"
 },
 {
  "name": "樱",
  "message": "「……是吗」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「唉」"
 },
 {
  "name": "槐",
  "message": "「总感觉，你没什么劲呢」"
 },
 {
  "name": "樱",
  "message": "「我，不太擅长，那个，安慰别人」"
 },
 {
  "name": "樱",
  "message": "「所以，已经，头疼了」"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "message": "兰开斯特脸上挂着微笑。"
 },
 {
  "message": "可她的双手，却在不住地颤抖。"
 },
 {
  "name": "槐",
  "message": "「兰……兰开斯特？」"
 },
 {
  "name": "索菲娅",
  "message": "「啊……」"
 },
 {
  "name": "索菲娅",
  "message": "「啊啊啊啊……」"
 },
 {
  "name": "索菲娅",
  "message": "「啊啊啊啊啊！真是的，这个人真是的！！每次都这副德行……！！」"
 },
 {
  "name": "索菲娅",
  "message": "「你知道我一直在她旁边，是什么心情吗！！」"
 },
 {
  "name": "华淡",
  "message": "「好、好了好了，冷静一下啦，兰开斯特学姐」"
 },
 {
  "name": "索菲娅",
  "message": "「海漫！铃宫！准备B.E.G.！」"
 },
 {
  "name": "华淡",
  "message": "「收到！」"
 },
 {
  "name": "槐",
  "message": "「是！」"
 },
 {
  "name": "索菲娅",
  "message": "「手下留情……！！气死我了！！够了！！不揍烂那张装逼的脸，我这口气可咽不下去……！」"
 },
 {
  "name": "樱",
  "message": "「……那，对不起？」"
 },
 {
  "name": "索菲娅",
  "message": "「烦不烦！」"
 },
 {
  "message": "兰开斯特向前伸手，用有力的声音高呼。"
 },
 {
  "name": "索菲娅",
  "message": "「——蔷薇盟誓」"
 },
 {
  "name": "华淡",
  "message": "「——赤刀」"
 },
 {
  "name": "槐",
  "message": "「——舞蹈笔记」"
 },
 {
  "name": "樱",
  "message": "「嗯」"
 },
 {
  "name": "樱",
  "message": "「——来吧」"
 },
 {
  "message": "就这样，我们的模拟战开始了。"
 },
 {
  "name": "华淡",
  "message": "「那人家先上了哦！请多关照！」"
 },
 {
  "message": "华淡猛地一蹬地面，瞬间逼近了夜乃学姐。"
 },
 {
  "name": "樱",
  "message": "「……哦，速度变快了嘛」"
 },
 {
  "message": "可夜乃学姐却以更快的速度小步后退，想要拉开距离——"
 },
 {
  "name": "槐",
  "message": "「——舞蹈笔记！」"
 },
 {
  "message": "此时，我的手已经搭在了华淡的后背上。"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "name": "华淡",
  "message": "「别想……跑！」"
 },
 {
  "message": "被舞蹈笔记打飞五米远的华淡，以风一般的速度反超了夜乃学姐。"
 },
 {
  "name": "华淡",
  "message": "「切……只切到手指吗」"
 },
 {
  "message": "华淡的赤刀，已经削掉了学姐的手指。"
 },
 {
  "name": "樱",
  "message": "「……果然，光凭空手，对付不了B.E.G.啊」"
 },
 {
  "name": "樱",
  "message": "「但是……」"
 },
 {
  "message": "瞬间，夜乃学姐的身影就从原地消失了。"
 },
 {
  "name": "华淡",
  "message": "「……！」"
 },
 {
  "message": "夜乃学姐压低身子，眨眼就绕到了华淡身后，一把探向她的脖子。"
 },
 {
  "name": "樱",
  "message": "「你的动作，还是太慢了呢」"
 },
 {
  "name": "槐",
  "message": "「没这么容易！」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "我紧贴着华淡的后背，轰开了夜乃学姐伸过来的手。"
 },
 {
  "name": "樱",
  "message": "「唔」"
 },
 {
  "message": "夜乃学姐被轰飞五米，但她似乎巧妙地卸掉了冲击力，毫发无伤。"
 },
 {
  "message": "——但是。"
 },
 {
  "name": "索菲娅",
  "message": "「就是现在！」"
 },
 {
  "message": "悬浮在空中的刺剑，朝着正在卸力的夜乃学姐飞射而去。"
 },
 {
  "name": "樱",
  "message": "「……哼嗯，原来如此」"
 },
 {
  "message": "夜乃学姐的重心已经被彻底打乱了。"
 },
 {
  "message": "可她像体操选手一样，一个转身就轻巧地避开了刺剑。"
 },
 {
  "name": "樱",
  "message": "「你们，用了大吃一惊对吧」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "樱",
  "message": "「我那套平凡的基本战术，你们已经好好预习过了呢」"
 },
 {
  "name": "樱",
  "message": "「嗯，看得出来下过功夫的」"
 },
 {
  "name": "槐",
  "message": "（这种战局掌控力……不愧是身经百战的学生会会长）"
 },
 {
  "message": "论与反现实或B.E.G.的独特战斗，她的经验可比我们丰富太多了！"
 },
 {
  "message": "她的手臂上，浮现出那柄巨大的钉桩发射器。"
 },
 {
  "name": "樱",
  "message": "「那，我也用一用吧」"
 },
 {
  "name": "樱",
  "message": "「——直视瓦砾」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "一股恐怖的重压朝我们袭来。"
 },
 {
  "message": "那是庞大到足以扭曲现实的压迫感。"
 },
 {
  "name": "樱",
  "message": "「铃宫负责防御，海漫做先锋，索菲在后方狙击」"
 },
 {
  "name": "樱",
  "message": "「不错，是个好组合，不过——」"
 },
 {
  "message": "夜乃学姐猛地一蹬地面。"
 },
 {
  "name": "樱",
  "message": "「这样……你们又打算怎么办呢？」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "夜乃学姐瞬间出现在我面前。"
 },
 {
  "name": "樱",
  "message": "「来吧，比比力气」"
 },
 {
  "name": "槐",
  "message": "「唔呃！」"
 },
 {
  "message": "夜乃学姐那巨大的钉桩发射器，已经逼到了我眼前。"
 },
 {
  "name": "槐",
  "message": "「舞蹈笔记！」"
 },
 {
  "name": "樱",
  "message": "「！」"
 },
 {
  "message": "夜乃学姐会被我的手套弹开，倒飞出五米远。"
 },
 {
  "message": "然而，就在我以为她会被轰飞的瞬间——"
 },
 {
  "name": "樱",
  "message": "「我已经看穿了，你出手的时机」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "她早已突进到我跟前，正要挥下那柄巨大的钉桩发射器。"
 },
 {
  "name": "槐",
  "message": "（既然如此，那就多来几次……！）"
 },
 {
  "message": "就在我试图触碰钉桩发射器的瞬间。"
 },
 {
  "name": "槐",
  "message": "「呃啊！」"
 },
 {
  "message": "——那是一记华丽，没有丝毫多余动作的回旋踢。"
 },
 {
  "name": "槐",
  "message": "（该死，根本看不清她的动作——）"
 },
 {
  "message": "这一周以来，我为了提升爆发力可是下足了苦功夫。"
 },
 {
  "message": "至少足以防御夜乃学姐的攻击了。"
 },
 {
  "message": "可只要其中掺杂了一丁点佯攻——"
 },
 {
  "name": "樱",
  "message": "「不太行，只要负责防御的角色崩盘」"
 },
 {
  "message": "钉桩化作真正的杀招，朝失去重心的我呼啸而来。"
 },
 {
  "name": "槐",
  "message": "（糟了，只要被那玩意儿擦到一下，就全完了——）"
 },
 {
  "name": "樱",
  "message": "「先解决一个」"
 },
 {
  "message": "直视瓦砾贯穿了我的身体。"
 },
 {
  "message": "——在这瞬间。"
 },
 {
  "name": "樱",
  "message": "「……欸？」"
 },
 {
  "name": "华淡",
  "message": "「赤刀！我把夏学长切成一瓣一瓣啦！」"
 },
 {
  "message": "夜乃学姐射出的钉桩洞穿了我的腹部。"
 },
 {
  "message": "但就在千钧一发之际，赤刀抢先一步将我的身体切碎。"
 },
 {
  "name": "槐",
  "message": "（毕竟只是模拟战！要是真在实战中被那玩意儿射个对穿，我早就没命了）"
 },
 {
  "message": "好在这次调整了模式，只会削减魂魄流体，不会对肉体造成实际伤害。"
 },
 {
  "message": "不过我腹部的魂魄遭到了重创，无法继续使用……"
 },
 {
  "name": "槐",
  "message": "「——舞蹈笔记！」"
 },
 {
  "message": "我那只散落的手臂，从右下方的死角精准地触碰到了夜乃学姐。"
 },
 {
  "name": "樱",
  "message": "「呀！」"
 },
 {
  "message": "夜乃学姐整个人被这股冲击力掀向了半空。"
 },
 {
  "name": "华淡",
  "message": "「再来一击！」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "华淡手中的链锯，朝半空中的夜乃学姐呼啸而去。"
 },
 {
  "message": "当然，夜乃学姐试图用钉桩发射器防御，然而——"
 },
 {
  "name": "华淡",
  "message": "「骗你的——！%0」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "华淡竟将链锯高高抡起——直接甩了出去。"
 },
 {
  "message": "连同自己的臂膀一起。"
 },
 {
  "name": "樱",
  "message": "「欸……？！」"
 },
 {
  "name": "华淡",
  "message": "「绝杀，无解！」"
 },
 {
  "message": "华淡甩出的那只臂膀，带着链锯从背后劈下。"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "夜乃学姐堪堪躲过，但右臂还是被削飞了。"
 },
 {
  "name": "樱",
  "message": "「不好！」"
 },
 {
  "message": "她手中的直视瓦砾应声落地。"
 },
 {
  "name": "索菲娅",
  "message": "「——我一直在等着这一刻」"
 },
 {
  "message": "那柄银白色的刺剑，早已看准了这个时机。"
 },
 {
  "message": "刺剑如同出膛的子弹般破空而出，径直刺向夜乃学姐的心脏。"
 },
 {
  "name": "槐",
  "message": "（拿下……！）"
 },
 {
  "name": "樱",
  "message": "「不错，很厉害，你们很努力了」"
 },
 {
  "message": "然而，她抓住了——"
 },
 {
  "name": "槐",
  "message": "「什么……？！」"
 },
 {
  "name": "樱",
  "message": "「舞蹈笔记」"
 },
 {
  "message": "——我的手。"
 },
 {
  "name": "索菲娅",
  "message": "「……！」"
 },
 {
  "message": "夜乃学姐用我的手套，轻松弹开兰开斯特的刺剑。"
 },
 {
  "message": "紧接着刺出的第二剑、第三剑，也都被她不费吹灰之力地闪开。"
 },
 {
  "name": "樱",
  "message": "「铃宫，你的能力，真好用啊」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "夜乃学姐轻巧地落回地面，好像什么都没发生过一样。"
 },
 {
  "name": "槐",
  "message": "「不行，华淡！快追击！！」"
 },
 {
  "name": "华淡",
  "message": "「是！」"
 },
 {
  "message": "华淡一脚踩住我掉在地上的左手。"
 },
 {
  "message": "舞蹈笔记发动，华淡借着轰飞五米的冲力，瞬间逼近了夜乃学姐。"
 },
 {
  "name": "华淡",
  "message": "「哦啦——！」"
 },
 {
  "message": "而在夜乃学姐身后，华淡那只握着链锯的手臂正呼啸着逼近。"
 },
 {
  "message": "然而她一脚将手臂踢飞，紧接着顺势一记侧踢，精准地命中了华淡的太阳穴。"
 },
 {
  "name": "华淡",
  "message": "「呜呀！」"
 },
 {
  "name": "樱",
  "message": "「辛苦了，海漫」"
 },
 {
  "name": "槐",
  "message": "（……糟了！这下子……）"
 },
 {
  "name": "樱",
  "message": "「那么，海漫已经被停滞了，散架的铃宫也失去了战斗能力」"
 },
 {
  "name": "樱",
  "message": "「接下来，就只剩你了呢」"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "message": "兰开斯特举起刺剑。"
 },
 {
  "name": "樱",
  "message": "「还想继续吗？我觉得只是白白受苦而已」"
 },
 {
  "name": "樱",
  "message": "「再打下去，也没有意义」"
 },
 {
  "name": "索菲娅",
  "message": "「……你说……意义？」"
 },
 {
  "name": "索菲娅",
  "message": "「难道你就没想过吗，我们向你发起挑战这件事，有什么意义？」"
 },
 {
  "name": "樱",
  "message": "「……意义？」"
 },
 {
  "name": "樱",
  "message": "「是吗……嗯，没想过，不过，也许是因为……」"
 },
 {
  "name": "索菲娅",
  "message": "「因为什么？」"
 },
 {
  "name": "樱",
  "message": "「我不清楚……因为讨厌我吗？」"
 },
 {
  "name": "索菲娅",
  "message": "「不对……完全不对……」"
 },
 {
  "message": "她举起刺剑。可她的眼睛，却像要哭出来似地泛着水光。"
 },
 {
  "name": "索菲娅",
  "message": "「我之所以挑战你……」"
 },
 {
  "name": "索菲娅",
  "message": "「是因为你……总是，一个人……」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "索菲娅",
  "message": "「明明我就在你边上！还有老师！明明大家都在关心你……」"
 },
 {
  "name": "索菲娅",
  "message": "「可你却总是摆出一副！自己很孤单的样子！！」"
 },
 {
  "name": "樱",
  "message": "「……这……可是，事实如此吧？」"
 },
 {
  "name": "樱",
  "message": "「我只有自己，开始如此，结束，也是如此」"
 },
 {
  "name": "索菲娅",
  "message": "「不是有我在吗——！！」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "name": "索菲娅",
  "message": "「我一直……都在啊……一直……现在……还有铃宫……和海漫……」"
 },
 {
  "name": "索菲娅",
  "message": "「即便如此……你……」"
 },
 {
  "name": "索菲娅",
  "message": "「总是独自战斗……总是独自受伤……」"
 },
 {
  "name": "樱",
  "message": "「……可，这也没办法吧？」"
 },
 {
  "name": "樱",
  "message": "「我的话，也就受点伤」"
 },
 {
  "name": "樱",
  "message": "「可你们，会死吧」"
 },
 {
  "name": "樱",
  "message": "「所以，我必须去」"
 },
 {
  "message": "她说得对。"
 },
 {
  "message": "无比正确，无法反驳。"
 },
 {
  "message": "但这种正确，无法让人接受。"
 },
 {
  "name": "索菲娅",
  "message": "「对不起……是我们太弱了，所以……」"
 },
 {
  "name": "索菲娅",
  "message": "「没法成为你可以依靠的人」"
