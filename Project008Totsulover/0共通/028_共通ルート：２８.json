 {
  "name": "索菲娅",
  "message": "「……对不起啊」"
 },
 {
  "name": "索菲娅",
  "message": "「其实，我们应该更早吵这一架的」"
 },
 {
  "name": "索菲娅",
  "message": "「可我太胆小了，怕受伤，也怕你拒绝」"
 },
 {
  "name": "索菲娅",
  "message": "「所以一直说不出口，请原谅我这个胆小鬼……夜乃会长……」"
 },
 {
  "name": "樱",
  "message": "「索菲……」"
 },
 {
  "name": "樱",
  "message": "「你哭了……？」"
 },
 {
  "message": "兰开斯特凝视着生成在她背后的，无数柄银色的刺剑。"
 },
 {
  "message": "那是夜乃学姐受过的伤，也是兰开斯特心中的悔恨。"
 },
 {
  "name": "索菲娅",
  "message": "「来吧」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "name": "索菲娅",
  "message": "「我要认真了，我，绝不会再逃避了」"
 },
 {
  "name": "索菲娅",
  "message": "「我，绝不会再让你一个人受伤了！」"
 },
 {
  "name": "樱",
  "message": "「索……菲……」"
