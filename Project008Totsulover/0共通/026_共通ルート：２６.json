[
 {
  "name": "华淡",
  "message": "「呜呜……这数值差得也太多了吧。被连着剃了三次光头，人家要自闭了……」"
 },
 {
  "name": "华淡",
  "message": "「还是早点回去，洗洗睡吧……」"
 },
 {
  "message": "华淡就这样头也不回地快步离开了。"
 },
 {
  "name": "索菲娅",
  "message": "「……唉，虽说早有心理准备，但没想到我们和夜乃会长之间的差距，竟然大到这种地步啊」"
 },
 {
  "name": "槐",
  "message": "「谁说不是呢……」"
 },
 {
  "message": "打那以后，我们在虚拟世界里发起了数十次挑战。"
 },
 {
  "message": "一开始甚至连夜乃学姐的衣角都碰不到，等终于能勉强接上几招的时候，太阳已经落山了。"
 },
 {
  "name": "索菲娅",
  "message": "「……呜呜……我已经，累趴了……」"
 },
 {
  "name": "槐",
  "message": "「我懂，我的脑子也快炸了……看来那个B.E.G.对使用者的负担不是一般的大啊」"
 },
 {
  "name": "索菲娅",
  "message": "「是呢……呵呵」"
 },
 {
  "name": "槐",
  "message": "「你笑什么啊」"
 },
 {
  "name": "索菲娅",
  "message": "「没什么，就是挺高兴的」"
 },
 {
  "name": "索菲娅",
  "message": "「光凭我一个人，向夜乃会长发起挑战什么的，想都不敢想」"
 },
 {
  "name": "索菲娅",
  "message": "「因为我以前什么都做不到，只能在一旁眼睁睁地看着」"
 },
 {
  "name": "索菲娅",
  "message": "「所以我很开心，哪怕只有一小步，也是前进了」"
 },
 {
  "name": "索菲娅",
  "message": "「谢谢，这都是多亏了你」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "索菲娅",
  "message": "「呵呵，脸都红了，不好意思吗？」"
 },
 {
  "name": "槐",
  "message": "「才才、才没有呢！」"
 },
 {
  "name": "索菲娅",
  "message": "「呵呵」"
 },
 {
  "name": "索菲娅",
  "message": "「那我也回去了……明天继续努力吧！」"
 },
 {
  "name": "槐",
  "message": "「嗯！」"
 },
 {
  "message": "兰开斯特也迈着轻快的步伐转身离去了。"
 },
 {
  "name": "槐",
  "message": "（竟然能和夜乃学姐的虚拟AI对战，这对我的暗杀计划来说简直是意外之喜……）"
 },
 {
  "name": "槐",
  "message": "（彻底摸清她的实力和能力，这对我来说至关重要）"
 },
 {
  "message": "夜乃学姐之所以强大，根本原因——首先在于她惊人的身体素质。"
 },
 {
  "message": "经B.E.G.强化过的四肢，简直就像电影里那些超级英雄。"
 },
 {
  "message": "和普通学生完全不是一个档次。"
 },
 {
  "name": "槐",
  "message": "（大运般的数值，加上蜻蜓一样的机动性）"
 },
 {
  "name": "槐",
  "message": "（还有那双眼睛，时刻冷静地洞察战局）"
 },
 {
  "message": "仅凭这些，单挑就绝无胜算。"
 },
 {
  "message": "而且就算想办法解决了她身体素质方面的强悍——"
 },
 {
  "name": "槐",
  "message": "（她的B.E.G.——直视瓦砾）"
 },
 {
  "name": "槐",
  "message": "（让接触到的东西『停止』的能力）"
 },
 {
  "message": "如果只是单纯的停止，好像用手摸一下就够了。"
 },
 {
  "name": "槐",
  "message": "（相比之下，我的『舞蹈笔记』如果不用B.E.G.本体直接接触就无法发动）"
 },
 {
  "name": "槐",
  "message": "（是使用者熟练度上的差距吗……？）"
 },
 {
  "message": "B.E.G.……真是有趣，看来这玩意儿还有很多未解之谜啊。"
 },
 {
  "name": "槐",
  "message": "「……嗯？」"
 },
 {
  "message": "<d0035>指环手机</d>收到了消息。"
 },
 {
  "message": "是水仙发的。"
 },
 {
  "name": "水仙",
  "message": "『哥哥，小心』"
 },
 {
  "name": "水仙",
  "message": "『背后，你被跟踪了』"
 },
 {
  "message": "——看来有人一直躲在暗处尾随我。"
 },
 {
  "name": "？？？",
  "message": "「……」"
 },
 {
  "message": "我故意拐进一处空无一人的小巷。"
 },
 {
  "name": "？？？",
  "message": "「！」"
 },
 {
  "name": "？？？",
  "message": "「……」"
 },
 {
  "name": "？？？",
  "message": "「好像，是这边」"
 },
 {
  "name": "槐",
  "message": "「干什么呢」"
 },
 {
  "name": "槐",
  "message": "「夜乃学姐」"
 },
 {
  "name": "樱",
  "message": "「！」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「这只是我回家的路」"
 },
 {
  "name": "槐",
  "message": "「少骗人了，学姐你明明住在噬神塔里吧」"
 },
 {
  "name": "樱",
  "message": "「……你怎么知道？」"
 },
 {
  "name": "槐",
  "message": "「！那、那个……兰开斯特说的」"
 },
 {
  "name": "樱",
  "message": "「是吗」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「那，回头见」"
 },
 {
  "message": "夜乃学姐转身走了。"
 },
 {
  "name": "槐",
  "message": "「喂喂喂喂等下！」"
 },
 {
  "name": "樱",
  "message": "「……？有什么事吗？」"
 },
 {
  "name": "槐",
  "message": "「我说，明明是夜乃学姐你在跟踪我吧！」"
 },
 {
  "name": "樱",
  "message": "「跟踪？哪里，没有的事，别毫无根据地下定论」"
 },
 {
  "name": "樱",
  "message": "「我只是随便走走，不知不觉就选了这条路，回过神来已经在你后面了」"
 },
 {
  "name": "槐",
  "message": "「难道，你很不擅长找借口吗？」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「我回去了」"
 },
 {
  "name": "槐",
  "message": "「等等等等等一下！」"
 },
 {
  "name": "槐",
  "message": "「我没想追究什么。只是，你为什么要这么做」"
 },
 {
  "name": "槐",
  "message": "「就是单纯想问问这个」"
 },
 {
  "name": "樱",
  "message": "「这个……」"
 },
 {
  "name": "樱",
  "message": "「……因为」"
 },
 {
  "name": "槐",
  "message": "「因为？」"
 },
 {
  "name": "樱",
  "message": "「……因为大家，都讨厌我」"
 },
 {
  "name": "槐",
  "message": "「——欸？」"
 },
 {
  "name": "樱",
  "message": "「我性格阴暗，不会跟人聊天。我自己也知道，跟我待在一起很无聊」"
 },
 {
  "name": "樱",
  "message": "「所以，那个……没有了」"
 },
 {
  "message": "夜乃学姐到底误会了什么啊？"
 },
 {
  "name": "槐",
  "message": "（对了，今天学生会的活动！我们三个都交了假条）"
 },
 {
  "name": "槐",
  "message": "（结果她正好撞见我们三个一起回家）"
 },
 {
  "message": "她可能以为我们请假，是一起跑出去玩了。"
 },
 {
  "name": "槐",
  "message": "「不、不是这样的！不是你想的那样！」"
 },
 {
  "name": "樱",
  "message": "「没关系，不用解释，我明白的」"
 },
 {
  "name": "樱",
  "message": "「从小到大都是这样，就算跟朋友一起出去玩，最后也只会让大家扫兴」"
 },
 {
  "name": "樱",
  "message": "「不过下次请假的时候，麻烦把理由写清楚。我个人……倒是无所谓」"
 },
 {
  "name": "槐",
  "message": "「不对不对不对！」"
 },
 {
  "name": "槐",
  "message": "「而且，跟夜乃学姐待在一起，怎么可能会无聊啊？！」"
 },
 {
  "name": "樱",
  "message": "「又在撒谎，不可能的」"
 },
 {
  "name": "槐",
  "message": "「啊啊啊好固执啊！」"
 },
 {
  "message": "仔细想想，在学院里，我确实从来没见夜乃学姐跟朋友待在一起过。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "她那落寞的神情，让我不由得想起了小时候的水仙。"
 },
 {
  "name": "槐",
  "message": "「那、那，能占用你一点时间吗？我想带你去个地方」"
 },
 {
  "name": "樱",
  "message": "「……？」"
 },
 {
  "message": "我就像从前牵着水仙那样，拉着这位学院最强的少女，大步走了出去。"
 },
 {
  "name": "樱",
  "message": "「这里是……」"
 },
 {
  "name": "槐",
  "message": "「你来过吗？」"
 },
 {
  "name": "樱",
  "message": "「没来过，这么……可爱的地方」"
 },
 {
  "message": "我也一样，没有朋友。"
 },
 {
  "message": "也完全不习惯出来玩。"
 },
 {
  "message": "不过既然小水之前在这里玩得那么开心，我想带夜乃学姐来看看。"
 },
 {
  "name": "美人鱼",
  "message": "「欢迎光临，陆地的客人们～请这边入座～」"
 },
 {
  "name": "樱",
  "message": "「谢、谢谢」"
 },
 {
  "message": "身经百战的学院最强会长夜乃樱，此刻连看个菜单，都紧张兮兮的。"
 },
 {
  "name": "樱",
  "message": "「……！这个，看起来好好吃，热带美人鱼果汁套餐」"
 },
 {
  "name": "槐",
  "message": "「是不错啊，很漂亮呢」"
 },
 {
  "name": "樱",
  "message": "「这个……撒在芭菲上面，亮晶晶的是什么？」"
 },
 {
  "name": "槐",
  "message": "「谁知道呢，我也不是很懂」"
 },
 {
  "name": "槐",
  "message": "「那我点这个好了……<d0036>提塔利克鱼</d>套餐」"
 },
 {
  "message": "话说提塔利克鱼是啥玩意儿？"
 },
 {
  "name": "樱",
  "message": "「……为什么，要带我来这里」"
 },
 {
  "name": "槐",
  "message": "「欸，没什么，就觉得好玩」"
 },
 {
  "message": "——真的，仅此而已。"
 },
 {
  "message": "亏我还是崩月家的天才魔术师呢，居然会干出这种不过脑子，全凭直觉的事。"
 },
 {
  "message": "但不知道为什么，总觉得非这么做不可。"
 },
 {
  "name": "樱",
  "message": "「好玩……怎么可能」"
 },
 {
  "name": "樱",
  "message": "「……这种地方，跟我一点都不搭边」"
 },
 {
  "message": "夜乃学姐的语气淡淡的，却又带着一丝说不出的落寞。"
 },
 {
  "name": "美人鱼",
  "message": "「让您久等了～！热带美人鱼果汁套餐～！」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "夜乃学姐面前，摆上了一份亮闪闪的，超级可爱的套餐。"
 },
 {
  "message": "堆得像小山一样高的松饼上面，可食用亮片和五颜六色的巧克力碎像不要钱似地铺得满满的。"
 },
 {
  "message": "七色流光的果汁里，正噼噼啪啪地冒着气泡。"
 },
 {
  "name": "槐",
  "message": "「好、好厉害……！」"
 },
 {
  "name": "樱",
  "message": "「……哇啊」"
 },
 {
  "name": "槐",
  "message": "（夜乃学姐，是不是说了句『哇啊』）"
 },
 {
  "message": "搞什么嘛。跟小孩子一样，太可爱了吧。"
 },
 {
  "name": "樱",
  "message": "「我吃了」"
 },
 {
  "message": "她张开小嘴，啊呜一口咬了下去。"
 },
 {
  "name": "樱",
  "message": "「～～～～～～！！」"
 },
 {
  "name": "樱",
  "message": "「好甜——！」"
 },
 {
  "name": "槐",
  "message": "「！」"
 },
 {
  "name": "樱",
  "message": "「……嗯……嗯……嗯」"
 },
 {
  "message": "夜乃学姐两眼放光，大口大口地消灭着面前的松饼。"
 },
 {
  "name": "樱",
  "message": "「……咕嘟咕嘟，这果汁也太厉害了！噼噼啪啪的，而且还不是那种普通的噼噼啪啪——」"
 },
 {
  "name": "樱",
  "message": "「感觉像舌头上有什么东西炸开，这到底是什么啊」"
 },
 {
  "name": "槐",
  "message": "「我也不懂啊」"
 },
 {
  "message": "毕竟我也是个常年闷在家里的人。"
 },
 {
  "name": "樱",
  "message": "「顺滑的奶油入口即化，松饼吃起来也软蓬蓬的」"
 },
 {
  "name": "樱",
  "message": "「这个……好好吃」"
 },
 {
  "name": "槐",
  "message": "「那就好，我这份就有点一言难尽了，居然给我端上来一份炖鱼」"
 },
 {
  "message": "我也想吃甜的啊。"
 },
 {
  "name": "樱",
  "message": "「啊呜啊呜啊呜」"
 },
 {
  "name": "槐",
  "message": "「……噗」"
 },
 {
  "name": "樱",
  "message": "「啊呜啊呜」"
 },
 {
  "name": "槐",
  "message": "「噗……呵呵……」"
 },
 {
  "name": "樱",
  "message": "「……？怎么了，哪里很好笑吗」"
 },
 {
  "name": "槐",
  "message": "「不是啦，学姐，主要你吃得太拼命了」"
 },
 {
  "name": "槐",
  "message": "「奶油都吃脸上去了」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "name": "樱",
  "message": "「哪、哪里，真是……不好意思。身为会长，我却大意了」"
 },
 {
  "name": "槐",
  "message": "「哎呀，别提职务啦」"
 },
 {
  "message": "学姐拿着纸巾，用力地擦着自己的脸。"
 },
 {
  "name": "樱",
  "message": "「擦掉了吗？」"
 },
 {
  "name": "槐",
  "message": "「啊，没有，再往上一点」"
 },
 {
  "name": "樱",
  "message": "「……擦掉了吗？」"
 },
 {
  "message": "她那副不好意思，偷瞄我的样子。"
 },
 {
  "message": "我纯是觉得，实在太可爱了。"
 },
 {
  "message": "于是我下意识地，像平时对待小水那样——"
 },
 {
  "name": "槐",
  "message": "「别动」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "我用大拇指的指腹，碰了她的脸颊。"
 },
 {
  "name": "槐",
  "message": "「擦干净了……哧溜，啊，还真是，甜甜的，好吃」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……怎么了？」"
 },
 {
  "name": "樱",
  "message": "「……不、不是、没什么，没事」"
 },
 {
  "name": "樱",
  "message": "「你……偶尔会突然，像王子一样呢」"
 },
 {
  "name": "槐",
  "message": "「欸，什么叫像王子一样？继承王位之类的？」"
 },
 {
  "name": "樱",
  "message": "「……真是个，怪人」"
 },
 {
  "message": "樱学姐继续啊呜啊呜地吃着松饼。"
 },
 {
  "name": "樱",
  "message": "「我吃饱了」"
 },
 {
  "name": "槐",
  "message": "「这套餐份量还挺大的啊」"
 },
 {
  "name": "樱",
  "message": "「嗯，很好吃」"
 },
 {
  "name": "樱",
  "message": "「……毕竟，是第一次吃」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「下次叫上学生会的大家一起过来吧」"
 },
 {
  "name": "槐",
  "message": "「兰开斯特一听，肯定立马就来了」"
 },
 {
  "name": "樱",
  "message": "「是吗……？我觉得索菲有点怕我」"
 },
 {
  "name": "槐",
  "message": "「哪有哪有，才不是呢！她八成是太紧张了，不知道怎么说话而已」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「今天我们三个请假，其实是因为，我们最近有些打算」"
 },
 {
  "name": "槐",
  "message": "「但绝对不是想排挤学姐，或者故意冷落你什么的」"
 },
 {
  "name": "樱",
  "message": "「是吗？那是为什么？」"
 },
 {
  "name": "槐",
  "message": "「这个嘛……抱歉，我不能说」"
 },
 {
  "name": "槐",
  "message": "「不过我们是想为学生会出力，才这样做的」"
 },
 {
  "name": "樱",
  "message": "「……这样啊」"
 },
 {
  "name": "樱",
  "message": "「明白了。你都这么说了，我相信你」"
 },
 {
  "name": "槐",
  "message": "「！」"
 },
 {
  "message": "——不知为何，心口，隐隐发疼。"
 },
 {
  "message": "明明我来学院，是为了杀掉这个人。"
 },
 {
  "name": "樱",
  "message": "「……今天谢谢你」"
 },
 {
  "name": "樱",
  "message": "「我很开心」"
 },
 {
  "name": "槐",
  "message": "「你开心，我也很开心啊」"
 },
 {
  "name": "樱",
  "message": "「……你」"
 },
 {
  "name": "樱",
  "message": "「其实……并不开心吧？」"
 },
 {
  "name": "槐",
  "message": "「欸，为什么啊」"
 },
 {
  "name": "樱",
  "message": "「因为，虽然我是学姐，却不会聊天，也不会照顾别人……」"
 },
 {
  "name": "槐",
  "message": "「可我真的超级开心啊！」"
 },
 {
  "name": "樱",
  "message": "「……撒谎」"
 },
 {
  "name": "槐",
  "message": "「不不不我说真的，我没想到学姐吃起东西来居然跟小孩子一样」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "name": "槐",
  "message": "「吃东西的时候眼睛亮晶晶的，特别可爱。今天也算是大饱眼福了」"
 },
 {
  "name": "樱",
  "message": "「什、什么……」"
 },
 {
  "name": "槐",
  "message": "「要是跟兰开斯特她们说，她们肯定羡慕死」"
 },
 {
  "name": "樱",
  "message": "「……别、别跟她们说」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "樱",
  "message": "「……今天的事情」"
 },
 {
  "message": "她突然凑到我跟前。"
 },
 {
  "name": "樱",
  "message": "「这是，我们的秘密」"
 },
 {
  "message": "她将食指抵在我的唇上，示意我保密。"
 },
 {
  "name": "樱",
  "message": "「知道了吗？」"
 },
 {
  "name": "槐",
  "message": "「……是、是……」"
 },
 {
  "name": "樱",
  "message": "「……你真知道了？」"
 },
 {
  "name": "槐",
  "message": "「……我知道了。今天的事，我会烂在肚子里的」"
 },
 {
  "name": "樱",
  "message": "「……嗯，那……就好」"
 },
 {
  "message": "她淡淡一笑，又往后退开。"
 },
 {
  "name": "樱",
  "message": "「……你真的，开心吗？」"
 },
 {
  "name": "槐",
  "message": "「嗯，当然了！」"
 },
 {
  "name": "樱",
  "message": "「是吗」"
 },
 {
  "name": "樱",
  "message": "「……我也，很开心」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "樱",
  "message": "「拜拜」"
 },
 {
  "message": "她小声说了一句，转身跑开了。那道身影很快融入夜色，转眼便看不见了。"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "（我居然……跟暗杀目标一起吃了松饼）"
 },
 {
  "message": "这事，可没法跟别人说啊。"
 },
 {
  "message": "我在心里暗暗发誓，今天的事，绝对要烂在肚子里。"
 }
]