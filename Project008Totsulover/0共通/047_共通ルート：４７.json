[
 {
  "message": "不知不觉，夜深了，时间已经不早了。"
 },
 {
  "name": "华淡",
  "message": "「今晚玩哒超开心～那大家，晚安安～」"
 },
 {
  "message": "华淡回房去了。"
 },
 {
  "name": "索菲娅",
  "message": "「那我们也……」"
 },
 {
  "name": "樱",
  "message": "「嗯……」"
 },
 {
  "name": "槐",
  "message": "「那，我送你回去吧」"
 },
 {
  "name": "索菲娅",
  "message": "「哎呀，你还挺有绅士风度嘛」"
 },
 {
  "name": "樱",
  "message": "「好啊……不过我的速度大概每小时五十公里，你跟得上吗？」"
 },
 {
  "name": "槐",
  "message": "「学姐请自己回去吧」"
 },
 {
  "name": "索菲娅",
  "message": "「那就让我享受下有人护送的感觉吧」"
 },
 {
  "name": "华淡",
  "message": "「欸——等等等等，人家也想体验下这种待遇啦」"
 },
 {
  "name": "槐",
  "message": "「你特意从房间里跑出来就为了说这个啊」"
 },
 {
  "name": "华淡",
  "message": "「呜……邻居的缺点暴露了」"
 },
 {
  "message": "然后她安安静静地回房去了。"
 },
 {
  "name": "樱",
  "message": "「……晚安，我今天很开心」"
 },
 {
  "message": "话音刚落，夜乃学姐就高高跃起，踩着屋顶如风般离去了。"
 },
 {
  "name": "槐",
  "message": "「我？送她回家……？我脑子真是有毛病」"
 },
 {
  "name": "索菲娅",
  "message": "「呵呵，不过我觉得，你这样很讨夜乃会长欢心哦」"
 },
 {
  "name": "槐",
  "message": "「欸？是吗，为什么？」"
 },
 {
  "name": "索菲娅",
  "message": "「那可是学生会的夜乃樱会长欸？学院的最终兵器！人类的希望！」"
 },
 {
  "name": "索菲娅",
  "message": "「以前完全没有人……把她当成普通朋友来对待」"
 },
 {
  "name": "索菲娅",
  "message": "「……包括我在内」"
 },
 {
  "name": "槐",
  "message": "「……这样啊」"
 },
 {
  "name": "索菲娅",
  "message": "「呵呵，毕竟我以前也从没想过，能和夜乃会长一起开派对」"
 },
 {
  "message": "兰开斯特踏出一步，宛如轻舞。"
 },
 {
  "name": "索菲娅",
  "message": "「啊，我们走吧，铃宫」"
 },
 {
  "message": "新横滨市晚上，依旧充满着活力。"
 },
 {
  "message": "现在是晚上十点。对学生来说虽然晚了，但对这条街而言，正是黄金时段。"
 },
 {
  "name": "索菲娅",
  "message": "「所以，怎么样？铃宫，你已经熟悉这座城市了吗」"
 },
 {
  "name": "槐",
  "message": "「……嗯——怎么说呢」"
 },
 {
  "message": "从小时候起，我就一直闷在宅子里搞研究。"
 },
 {
  "message": "既没交过朋友，也没去外边玩过。"
 },
 {
  "message": "但是，这样的日子——"
 },
 {
  "name": "槐",
  "message": "「说实话，还不太习惯……」"
 },
 {
  "name": "槐",
  "message": "「但是很开心哦」"
 },
 {
  "name": "索菲娅",
  "message": "「这样啊♪」"
 },
 {
  "message": "兰开斯特开心地笑着。"
 },
 {
  "message": "英国街离商业街并不算远，但街道上已经被夜晚的静谧笼罩。"
 },
 {
  "name": "索菲娅",
  "message": "「这边也是旅游街，但这个时间店都关门了呢」"
 },
 {
  "name": "槐",
  "message": "「欸——这样啊」"
 },
 {
  "name": "槐",
  "message": "「我反而更喜欢这边」"
 },
 {
  "name": "索菲娅",
  "message": "「哦，为什么？」"
 },
 {
  "name": "槐",
  "message": "「人多热闹的地方……啊，不，也不是说不开心……」"
 },
 {
  "name": "槐",
  "message": "「就是，还有点不太适应」"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "message": "华丽亮眼的街道，此刻却安静得不像话。"
 },
 {
  "message": "这种违和感，我并不觉得讨厌。"
 },
 {
  "name": "索菲娅",
  "message": "「……那个，铃宫」"
 },
 {
  "name": "索菲娅",
  "message": "「我们，是不是得好好谈谈……？」"
 },
 {
  "name": "槐",
  "message": "「！」"
 },
 {
  "name": "索菲娅",
  "message": "「当着大家的面，实在没法开口」"
 },
 {
  "message": "我感觉全身都紧张得僵住了。"
 },
 {
  "name": "槐",
  "message": "（啊，果然……）"
 },
 {
  "message": "这世上哪有那么好的事。"
 },
 {
  "message": "像我这种混蛋，有什么资格在这儿嘻嘻哈哈的。"
 },
 {
  "message": "喉咙发干，舌头粘在嘴里。感觉瞬间，后背就被汗水浸湿。"
 },
 {
  "name": "槐",
  "message": "「啊……」"
 },
 {
  "message": "该怎么说？"
 },
 {
  "message": "有办法解释吗？"
 },
 {
  "message": "要把一切都说出来吗？"
 },
 {
  "name": "槐",
  "message": "（到时候我会怎样？不，我怎样都无所谓）"
 },
 {
  "name": "槐",
  "message": "（——水仙呢？）"
 },
 {
  "message": "这才是对我而言最重要的事。"
 },
 {
  "name": "槐",
  "message": "（所以，要是会牵连到小水的话，那我……）"
 },
 {
  "name": "槐",
  "message": "「兰开……」"
 },
 {
  "name": "索菲娅",
  "message": "「——你，亲了我对吧？」"
 },
 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "name": "索菲娅",
  "message": "「那个，啊，不是，其实我也记不太清了……但总觉得，隐隐约约……那个……」"
 },
 {
  "name": "索菲娅",
  "message": "「铃宫……你……是不是亲了我……？」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "（亲了）"
 },
 {
  "message": "仔细想想，确实亲了。"
 },
 {
  "message": "只不过当时完全顾不上这些，早就忘得一干二净了。"
 },
 {
  "message": "但这确实算得上一桩大事。"
 },
 {
  "name": "槐",
  "message": "「……大概亲了」"
 },
 {
  "name": "索菲娅",
  "message": "「哈——！」"
 },
 {
  "message": "兰开斯特满脸通红，捂住了脸。"
 },
 {
  "name": "索菲娅",
  "message": "「果然！我就说——！其实，我也在想会不会是真的」"
 },
 {
  "name": "索菲娅",
  "message": "「啊、啊呜……这样啊，亲了啊……亲了」"
 },
 {
  "name": "槐",
  "message": "「不、不是，但那是不可抗力啊！」"
 },
 {
  "name": "索菲娅",
  "message": "「是、是啊！我知道！不，我当然知道，可是——！」"
 },
 {
  "name": "索菲娅",
  "message": "「……那可是」"
 },
 {
  "name": "索菲娅",
  "message": "「我的初吻啊……」"
 },
 {
  "name": "槐",
  "message": "「……对不起」"
 },
 {
  "name": "索菲娅",
  "message": "「你、你用不着道歉啦！」"
 },
 {
  "name": "索菲娅",
  "message": "「我隐约知道那是情况特殊，不得已而为之」"
 },
 {
  "name": "槐",
  "message": "「真、真的是这样」"
 },
 {
  "name": "索菲娅",
  "message": "「那……怎么样……？」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "索菲娅",
  "message": "「跟我亲……感觉怎么样……？」"
 },
 {
  "name": "槐",
  "message": "「欸？！这是什么问题啊！」"
 },
 {
  "name": "索菲娅",
  "message": "「因、因为人家好奇嘛！」"
 },
 {
  "name": "索菲娅",
  "message": "「就是那个，漫画里不是经常有吗？初吻是什么味道，之类的」"
 },
 {
  "name": "索菲娅",
  "message": "「我从小就在好奇……接吻会是什么味道呢」"
 },
 {
  "name": "槐",
  "message": "「没想到你还有这么少女的一面」"
 },
 {
  "name": "索菲娅",
  "message": "「话、话多」"
 },
 {
  "name": "索菲娅",
  "message": "「……所以到底怎么样嘛。我不太记得了，请你告诉我吧」"
 },
 {
  "name": "槐",
  "message": "「这个……」"
 },
 {
  "message": "和兰开斯特的吻，要说味道——"
 },
 {
  "name": "槐",
  "message": "「当时我全身疼得要死，还飙了一堆血，好像完全不记得是什么味道了」"
 },
 {
  "name": "索菲娅",
  "message": "「喵——！」"
 },
 {
  "name": "槐",
  "message": "「真要说的话，大概是血和眼泪的味道……？」"
 },
 {
  "name": "索菲娅",
  "message": "「一股拳击漫画的味道！」"
 },
 {
  "name": "索菲娅",
  "message": "「呜……我纯洁的初吻啊……」"
 },
 {
  "name": "槐",
  "message": "「那个……抱歉……」"
 },
 {
  "name": "索菲娅",
  "message": "「……唉——算了，无所谓」"
 },
 {
  "message": "兰开斯特偷偷瞥了我一眼。"
 },
 {
  "name": "索菲娅",
  "message": "「其实，也没有多讨厌」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "索菲娅",
  "message": "「不如说……其实还挺不错的？嗯——虽然，你跟白马王子完全不搭边就是了」"
 },
 {
  "name": "索菲娅",
  "message": "「在入学第二年有了初吻。嗯，时间也刚刚好」"
 },
 {
  "name": "索菲娅",
  "message": "「初吻的对象，嗯，算及格吧」"
 },
 {
  "name": "槐",
  "message": "「唔哇……」"
 },
 {
  "name": "索菲娅",
  "message": "「呵呵，一下子就脸红了呢，没想到你还挺纯情，很可爱哦」"
 },
 {
  "name": "槐",
  "message": "「……烦人」"
 },
 {
  "name": "索菲娅",
  "message": "「啊，生气啦？咯咯咯，对不起哦，是姐姐太坏了」"
 },
 {
  "name": "槐",
  "message": "「谁是你弟弟啊！再说咱俩一样大吧！」"
 },
 {
  "name": "索菲娅",
  "message": "「可铃宫你，不就像小孩子嘛」"
 },
 {
  "name": "槐",
  "message": "「哪里像了啊！」"
 },
 {
  "name": "索菲娅",
  "message": "「嗯，就这种地方啊♪」"
 },
 {
  "message": "到头来，感觉我还是被她耍了。"
 },
 {
  "message": "明明她平时大大咧咧的，有时候却又显得格外成熟啊。"
 },
 {
  "name": "索菲娅",
  "message": "「啊，说着说着就到了呢」"
 },
 {
  "name": "槐",
  "message": "「啊，你家在这边啊」"
 },
 {
  "name": "索菲娅",
  "message": "「嗯，要不要上来坐坐？」"
 },
 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "name": "索菲娅",
  "message": "「咯咯咯，逗你的啦，我家里人都在呢？」"
 },
 {
  "name": "槐",
  "message": "「告辞！」"
 },
 {
  "name": "索菲娅",
  "message": "「对不起对不起，是我太过分啦」"
 },
 {
  "name": "索菲娅",
  "message": "「都怪你不好，谁让你每次的反应都这么好玩」"
 },
 {
  "name": "槐",
  "message": "「……能被您当成玩具，是我的荣幸」"
 },
 {
  "name": "索菲娅",
  "message": "「啊哈哈」"
 },
 {
  "name": "索菲娅",
  "message": "「那么，下次见啦，铃宫」"
 },
 {
  "name": "槐",
  "message": "「嗯，晚安——」"
 },
 {
  "message": "我转过身，与此同时——"
 },
 {
  "name": "索菲娅",
  "message": "「……那个」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "索菲娅",
  "message": "「你是不是……有什么……烦心事？」"
 },
 {
  "name": "槐",
  "message": "「欸……？唔，没有吧」"
 },
 {
  "name": "索菲娅",
  "message": "「是吗，那就好」"
 },
 {
  "name": "索菲娅",
  "message": "「不过，要是遇到什么困难，尽管来找我哦。毕竟……我们已经是朋友了嘛」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "——朋友。"
 },
 {
  "message": "这两个字，在我心里久久回荡。"
 },
 {
  "name": "槐",
  "message": "（……啊啊，今天，真开心啊）"
 },
 {
  "message": "已经多久……没有觉得月色如此迷人了呢。"
 },
 {
  "name": "槐",
  "message": "（我——）"
 },
 {
  "message": "差不多，该面对现实了。"
 },
 {
  "message": "我迈开脚步，朝着小巷深处走去。"
 }
]