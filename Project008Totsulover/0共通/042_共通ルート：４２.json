[
 {
  "name": "索菲娅",
  "message": "「蔷薇盟誓！！」"
 },
 {
  "message": "数十柄银色的刺剑，化作铺天盖地的剑雨倾泻而下。"
 },
 {
  "name": "清枫",
  "message": "「……真烦人」"
 },
 {
  "message": "那个男人却满脸不耐烦，仅靠最小幅度的动作就将它们全部躲开——"
 },
 {
  "name": "清枫",
  "message": "「哼！」"
 },
 {
  "message": "他一记手刀，将刺剑劈断。"
 },
 {
  "name": "索菲娅",
  "message": "「……！」"
 },
 {
  "name": "清枫",
  "message": "「跟麦芽糖似的」"
 },
 {
  "message": "一半的刺剑已经被他打断。"
 },
 {
  "message": "掉落在地的刺剑，已经失去了力量。"
 },
 {
  "name": "清枫",
  "message": "「……好了，还剩十四柄，等我把这些玩意儿全部折断」"
 },
 {
  "name": "清枫",
  "message": "「按照刚才说的，我会把你碾成肉泥，然后拿去喂我那老弟吧——」"
 },
 {
  "name": "索菲娅",
  "message": "「……我不会让你得逞的」"
 },
 {
  "name": "索菲娅",
  "message": "「你休想——！！」"
 },
 {
  "message": "我握紧刺剑，正要拉近距离——就在这瞬间。"
 },
 {
  "name": "清枫",
  "message": "「……！！」"
 },
 {
  "name": "索菲娅",
  "message": "「……什么？！」"
 },
 {
  "message": "大地猛地一震，接着传来什么东西爆裂的感觉。"
 },
 {
  "message": "就像气泡在指尖轻轻炸开一样，有点不明所以。"
 },
 {
  "name": "清枫",
  "message": "「这……是……！」"
 },
 {
  "message": "魔术师从打开的窗户中，伸出了一只手。"
 },
 {
  "name": "清枫",
  "message": "「……这个异界，已经失去存在的意义了吗」"
 },
 {
  "name": "索菲娅",
  "message": "「……！」"
 },
 {
  "name": "索菲娅",
  "message": "「做到了……海漫她……！！」"
 },
 {
  "message": "一定是这样。"
 },
 {
  "message": "她解决了那『浑身是眼的少女』！"
 },
 {
  "name": "索菲娅",
  "message": "「——这下子，可真是攻守易形了呢」"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "索菲娅",
  "message": "「异界已经崩溃了，学院的援军应该马上就到」"
 },
 {
  "name": "索菲娅",
  "message": "「十分钟？不，五分钟？留给你的时间，到底还剩多少呢」"
 },
 {
  "name": "清枫",
  "message": "「……也是啊，呼——倒霉透顶」"
 },
 {
  "name": "清枫",
  "message": "「你们这帮人，对异界的调查向来谨慎。我明明特地选了这里作为舞台……」"
 },
 {
  "name": "清枫",
  "message": "「……真没料到，居然有人能看穿这座学校的谜团」"
 },
 {
  "name": "索菲娅",
  "message": "「我的学妹，可是相当优秀的！」"
 },
 {
  "name": "清枫",
  "message": "「算了……」"
 },
 {
  "message": "魔术师的身影瞬间消失。"
 },
 {
  "name": "索菲娅",
  "message": "「什……」"
 },
 {
  "name": "清枫",
  "message": "「我只想说，那又怎样？」"
 },
 {
  "message": "像重型卡车一般沉重的踢击，贯穿了我的腹部。"
 },
 {
  "name": "索菲娅",
  "message": "「咳……」"
 },
 {
  "name": "清枫",
  "message": "「啊，内脏被踢碎了几块？真走运」"
 },
 {
  "name": "索菲娅",
  "message": "「咳……咳呕……呃……」"
 },
 {
  "message": "我吐了一地的血。"
 },
 {
  "name": "清枫",
  "message": "「……行了，这下你应该站不起来了吧，反正时间也确实不多了……」"
 },
 {
  "message": "我倒在地上，男人一把揪住我的头发，把我整个人拎了起来。"
 },
 {
  "name": "清枫",
  "message": "「要发泄得赶紧了」"
 },
 {
  "message": "男人抡起拳头，重重砸在我的脸上。"
 },
 {
  "name": "索菲娅",
  "message": "「……！」"
 },
 {
  "name": "清枫",
  "message": "「哈哈哈！打女人真开心啊」"
 },
 {
  "name": "索菲娅",
  "message": "「啊……啊……啊……」"
 },
 {
  "name": "清枫",
  "message": "「别瞪我啊，那么吓人干嘛」"
 },
 {
  "name": "清枫",
  "message": "「再过五分钟就送你上路，在那之前——你就乖乖当我的玩具吧」"
 },
 {
  "message": "男人一把掐住我的脸。"
 },
 {
  "name": "清枫",
  "message": "「多漂亮的眼睛啊。我一直觉得，给玛利亚换上正合适」"
 },
 {
  "message": "男人的手指，伸向我的双眼。"
 },
 {
  "message": "指尖已经挤进了眼皮内侧。"
 },
 {
  "message": "就在这时。"
 },
 {
  "name": "樱",
  "message": "「……你在干什么？」"
 },
 {
  "name": "清枫",
  "message": "「欸——」"
 },
 {
  "message": "一股骇人的怒气，从背后汹涌而来。"
 },
 {
  "name": "樱",
  "message": "「你在……干……什么……！」"
 },
 {
  "name": "樱",
  "message": "「——不准，再动一下」"
 },
 {
  "name": "清枫",
  "message": "「什……？！」"
 },
 {
  "message": "魔术师的身体，被钉在了原地。"
 },
 {
  "message": "只有那因惊愕扬起的眉梢，还能微微颤动。"
 },
 {
  "name": "樱",
  "message": "「……铃宫……索菲」"
 },
 {
  "message": "是夜乃学姐。"
 },
 {
  "message": "……夜乃学姐，来了！！"
 },
 {
  "name": "索菲娅",
  "message": "「学……姐……对不，起……我……已经很努力了，可是……」"
 },
 {
  "name": "樱",
  "message": "「嗯……嗯……」"
 },
 {
  "name": "索菲娅",
  "message": "「我……好像还是，一点用都没有……」"
 },
 {
  "name": "樱",
  "message": "「不会的……不会的……」"
 },
 {
  "message": "夜乃学姐温柔地将我抱起，随即把我轻轻放在了地面上。"
 },
 {
  "name": "樱",
  "message": "「辛苦了，你做得很好」"
 },
 {
  "message": "她轻轻摸了摸我的刘海，温柔地笑了。"
 },
 {
  "name": "樱",
  "message": "「……你」"
 },
 {
  "name": "清枫",
  "message": "「……欸……你就是夜乃樱啊，难怪老爸会提起你」"
 },
 {
  "name": "清枫",
  "message": "「不过，不知道是不是我的错觉，你那个B.E.G.的能力，应该是让触碰到的物体停止吧——」"
 },
 {
  "name": "樱",
  "message": "「是你伤了他们两个吧」"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「理由，我不想听，也不重要。只是，真的，很不对」"
 },
 {
  "name": "清枫",
  "message": "「……哈」"
 },
 {
  "message": "魔术师的手指，微微动了一下。"
 },
 {
  "name": "索菲娅",
  "message": "「会长！小心——！」"
 },
 {
  "name": "樱",
  "message": "「——我，有点，生气了」"
 },
 {
  "name": "清枫",
  "message": "「啊，是吗，那又怎样？」"
 },
 {
  "message": "魔术师的『停止』解除了。"
 },
 {
  "message": "男人连续蹬踩墙壁、天花板，以惊人的速度逼近夜乃学姐。"
 },
 {
  "name": "樱",
  "message": "「……太好了」"
 },
 {
  "name": "清枫",
  "message": "「……！」"
 },
 {
  "message": "夜乃学姐稳稳挡下魔术师的踢击。"
 },
 {
  "message": "魔术师的身体在半空中『停止』，夜乃学姐则缓缓举起了拳头。"
 },
 {
  "name": "樱",
  "message": "「你看起来，很耐揍——」"
 },
 {
  "message": "夜乃学姐的重拳，陷进了男人的脸颊。"
 },
 {
  "name": "清枫",
  "message": "「唔……！」"
 },
 {
  "message": "而且，不止一拳。"
 },
 {
  "name": "樱",
  "message": "「哈啊啊啊啊啊啊啊啊啊！！」"
 },
 {
  "message": "夜乃学姐对着『停止』在半空中的魔术师——"
 },
 {
  "name": "樱",
  "message": "「一，二，三，四，五，六，七，八，九，十，十一，十二，十三，十四，十五，十六，十七」"
 },
 {
  "name": "清枫",
  "message": "「唔……唔……唔哦哦……！！」"
 },
 {
  "name": "樱",
  "message": "「十八，十九，二十，二一，二二、二三，二四，二五，二六，二七，二八，二九，三十——」"
 },
 {
  "name": "清枫",
  "message": "「……唔哦哦……？！」"
 },
 {
  "name": "樱",
  "message": "「三一！」"
 },
 {
  "message": "拳以每秒五下的频率，暴风骤雨般落下，随后她狠狠向前踏出一步，全力轰出最后一击。"
 },
 {
  "name": "清枫",
  "message": "「呃啊啊啊啊啊啊啊啊啊啊……！！」"
 },
 {
  "message": "男人整个被打飞了出去，直接撞穿了教室的墙壁。"
 },
 {
  "message": "教室剧烈摇晃，碎片哗啦啦地从天花板上剥落。而在漫天碎屑之中，夜乃学姐像皎月一般，静静地笑了。"
 },
 {
  "name": "樱",
  "message": "「等我一下，你们两个」"
 },
 {
  "name": "樱",
  "message": "「——我来和他做个了断」"
 },
 {
  "message": "学姐纵身一跃，轻盈地掠向走廊。"
 },
 {
  "name": "索菲娅",
  "message": "（啊……果然，好帅啊……）"
 },
 {
  "message": "我真的，好高兴，好高兴。"
 },
 {
  "message": "胸口，暖融融的。"
 },
 {
  "message": "眼眶，有点湿。"
 },
 {
  "message": "随后，晕了过去。"
 },
 {
  "name": "樱",
  "message": "「——站起来」"
 },
 {
  "message": "崩月清枫浑身青紫，抬头望着夜乃樱。"
 },
 {
  "name": "樱",
  "message": "「你该不会，只有这点能耐吧？」"
 },
 {
  "message": "刚才那三十一记连击，几乎打碎了他全身的骨头。"
 },
 {
  "name": "清枫",
  "message": "（不是吧，这家伙）"
 },
 {
  "name": "清枫",
  "message": "（有点，厉害啊）"
 },
 {
  "message": "然而，他到底是个老练的魔术师。"
 },
 {
  "message": "刻印在肉体中的魔术程序消耗着代价，完成了对肉体的治疗。"
 },
 {
  "name": "清枫",
  "message": "「嘿咻」"
 },
 {
  "message": "清枫满不在乎地站起身来。"
 },
 {
  "name": "樱",
  "message": "「崩月清枫，我知道你，毕竟你也算个名人」"
 },
 {
  "name": "清枫",
  "message": "「是啊，夜乃樱，不过比起你来，我这点名声真不算什么」"
 },
 {
  "name": "樱",
  "message": "「——你们的知识和技术，相当出色」"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「可为什么，要把这些用在错误的事上？」"
 },
 {
  "name": "樱",
  "message": "「为什么不能用来帮助大家呢？」"
 },
 {
  "message": "这么一问，清枫反而感到一阵索然无味。"
 },
 {
  "name": "清枫",
  "message": "（什么嘛，闹了半天，不过是个小鬼）"
 },
 {
  "message": "你不会真以为自己能理解别人吧？"
 },
 {
  "name": "清枫",
  "message": "「——是水仙吧」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "清枫",
  "message": "「她背叛了我们吗……那个臭丫头，果然是个没救的废物」"
 },
 {
  "name": "清枫",
  "message": "「等我回去——一定得亲手宰了她，再把她当可燃垃圾扔掉」"
 },
 {
  "name": "樱",
  "message": "「你觉得你还能回去啊」"
 },
 {
  "name": "清枫",
  "message": "「嗯，就像之前的每一天一样」"
 },
 {
  "message": "夜乃樱脚尖一蹬，整个人疾冲而出。"
 },
 {
  "name": "樱",
  "message": "「直视瓦砾」"
 },
 {
  "name": "清枫",
  "message": "「——唱吧，我的玛利亚」"
 },
 {
  "message": "一具精巧的人偶从清枫的袖中滑出。"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "name": "清枫",
  "message": "「我也不乐意啊，让这张脏兮兮的小脸为我歌唱——」"
 },
 {
  "name": "清枫",
  "message": "「去吧，吸魂虫——」"
 },
 {
  "message": "虫群忠实地涌向夜乃樱。"
 },
 {
  "name": "樱",
  "message": "「……止」"
 },
 {
  "message": "——然而，就在触碰到樱的那一瞬，所有虫子齐齐停了下来，坠落在地。"
 },
 {
  "name": "樱",
  "message": "「凭这些，就想把我——」"
 },
 {
  "name": "清枫",
  "message": "「——你的能力，有上限吧？」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "清枫脚蹬墙壁，借力朝樱飞踢。"
 },
 {
  "message": "樱急忙用直视瓦砾格挡——但清枫并没有停止。"
 },
 {
  "name": "清枫",
  "message": "「果然啊……！！」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "name": "清枫",
  "message": "「……根据能力的使用范围和数量，让目标停止的时间也不同，吧？」"
 },
 {
  "name": "清枫",
  "message": "「刚才你明明连碰都没碰，就让我停止了。现在却只能拼命挥舞那个大家伙」"
 },
 {
  "name": "清枫",
  "message": "「——刚才那一招，是你的必杀技吧，可不是想用就用的招数」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "清枫的这番分析，确实切中了要害。"
 },
 {
  "message": "樱的B.E.G.直视瓦砾，能力是让触碰到的物体停止。"
 },
 {
  "message": "不过，只要消耗超出极限的力量，她也在几秒内通过停滞空气，让生物停止。"
 },
 {
  "message": "但这也会对樱的身体造成极大的负担。"
 },
 {
  "message": "为了救索菲娅，樱甚至冒了烧坏部分大脑的风险。"
 },
 {
  "name": "清枫",
  "message": "「……那么，对付你，也是一样的办法」"
 },
 {
  "message": "魔术师身边，聚集起密密麻麻的虫群。"
 },
 {
  "name": "清枫",
  "message": "「折磨到死，就完了」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「你啊，真是个胆小鬼」"
 },
 {
  "name": "清枫",
  "message": "「……哈？」"
 },
 {
  "name": "樱",
  "message": "「因为害怕，所以虚张声势。因为软弱，所以喋喋不休」"
 },
 {
  "name": "樱",
  "message": "「分析我的能力也是」"
 },
 {
  "name": "樱",
  "message": "「为了证明自己有多厉害，说个不停，拼命炫耀」"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "清枫",
  "message": "「你这家伙，真恶心」"
 },
 {
  "name": "樱",
  "message": "「那种感觉，我懂」"
 },
 {
  "name": "樱",
  "message": "「因为以前，我也没有朋友」"
 },
 {
  "message": "一股连樱自己都无法理解的情绪，正支配着她。"
 },
 {
  "message": "友人受伤的痛苦，失去朋友的恐惧，以及——对自己深深的悔恨。"
 },
 {
  "name": "樱",
  "message": "「原本想听你说说来龙去脉，再多少给你一点同情——」"
 },
 {
  "name": "樱",
  "message": "「——但抱歉，现在我没那个心情」"
 },
 {
  "name": "清枫",
  "message": "「哼，所以？」"
 },
 {
  "name": "樱",
  "message": "「N.a.v.i.」"
 },
 {
  "name": "樱",
  "message": "「申请解除限制协议」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『收到，请宣誓』"
 },
 {
  "name": "樱",
  "message": "「我宣誓，遵照盟约，我将动用此力，捍卫学院的研究与秩序」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『解除申请已批准，请遵守安全事项』"
 },
 {
  "name": "樱",
  "message": "「明白」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『请输入解除代码』"
 },
 {
  "name": "樱",
  "message": "「Sakura——Red——02」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『已确认，使命与你同在』"
 },
 {
  "message": "——就在那瞬间。"
 },
 {
  "name": "清枫",
  "message": "「……啊？」"
 },
 {
  "message": "樱的身后，升腾起一股足以扭曲视线的，浓烈的现实性。"
 },
 {
  "name": "樱",
  "message": "「——功率限制解除」"
 },
 {
  "name": "清枫",
  "message": "「……！！」"
 },
 {
  "message": "清枫凭借身经百战的直觉，意识到绝不能让那一招成型。"
 },
 {
  "name": "清枫",
  "message": "「发什么呆！快上，吸魂虫！」"
 },
 {
  "message": "成百上千的虫群，在空中飞掠而过。"
 },
 {
  "name": "清枫",
  "message": "「……！」"
 },
 {
  "message": "清枫也猛地蹬地，腾空而起。"
 },
 {
  "message": "然而在此之前，樱已经扣下了扳机。"
 },
 {
  "name": "樱",
  "message": "「直视瓦砾——等阶二」"
 },
 {
  "name": "清枫",
  "message": "（什么……那是……！！）"
 },
 {
  "message": "现实性的密度，跟刚才不在一个量级。"
 },
 {
  "name": "清枫",
  "message": "（这么强的反现实……连在<d0067>热田神宫</d>都没见过啊！）"
 },
 {
  "name": "樱",
  "message": "「……这还是我第一次，对人类用这一招」"
 },
 {
  "name": "樱",
  "message": "「所以会怎么样，说实话，我也不清楚」"
 },
 {
  "name": "樱",
  "message": "「抱歉，不过，无所谓了」"
 },
 {
  "name": "清枫",
  "message": "「哈……！」"
 },
 {
  "message": "魔术师笑了。"
 },
 {
  "name": "樱",
  "message": "「全锁定，现在，发射」"
 },
 {
  "message": "——只因他，是个魔术师。"
 },
 {
  "name": "清枫",
  "message": "（在那么美丽的光芒下，我会变成什么样呢——）"
 },
 {
  "message": "身为真理的探求者，他无法克制想要亲眼目睹那一幕的冲动。"
 },
 {
  "message": "又或者说，他本来就无处可逃。"
 },
 {
  "name": "清枫",
  "message": "「夜乃……樱啊啊啊啊啊啊啊！！！」"
 },
 {
  "message": "魔术师的身体骤然膨胀到极限，跃入半空。"
 },
 {
  "name": "樱",
  "message": "「——你，就是你，像你这种人」"
 },
 {
  "message": "光芒在凝聚，那是足以摧毁现实的光芒。"
 },
 {
  "message": "那是为了守护人类而诞生的，救赎之光。"
 },
 {
  "name": "樱",
  "message": "「永远，直视着，这片瓦砾吧」"
 },
 {
  "message": "那道骇人的湛蓝光辉，焚烧了直线上的一切。"
 },
 {
  "message": "不管是飞虫，是魔术师，还是层层叠叠的屏障。"
 },
 {
  "message": "皆被光芒焚尽。"
 },
 {
  "name": "清枫",
  "message": "（这……是……！）"
 },
 {
  "name": "清枫",
  "message": "（这道光……！这种反现实性……！！）"
 },
 {
  "name": "清枫",
  "message": "（原来如此……我懂了，我终于懂了……！！怪不得老爸，这么想要它……！！）"
 },
 {
  "message": "那是近乎暴虐的，对现实性本身的粉碎。"
 },
 {
  "message": "光芒无情地灼烧着清枫的肉体，将他的魂魄流体轰得七零八落。"
 },
 {
  "name": "清枫",
  "message": "「……该死……再看一眼……一眼……」"
 },
 {
  "name": "清枫",
  "message": "「我……还没看够……呢……」"
 },
 {
  "message": "魔术师的意识，被收割殆尽。"
 },
 {
  "message": "但直到最后一刻，他依然向前伸着手。"
 },
 {
  "name": "清枫",
  "message": "（决定了……我决定了……！！）"
 },
 {
  "name": "清枫",
  "message": "（这份力量……总有一天……我一定要……）"
 },
 {
  "name": "清枫",
  "message": "「我一定要……夺过来……」"
 },
 {
  "message": "男人双膝跪地，当场倒下。"
 },
 {
  "name": "樱",
  "message": "「……唔，哈啊……哈啊……」"
 },
 {
  "message": "蓝光燃尽了走廊，樱也因为巨大的消耗而跪倒。"
 },
 {
  "name": "N.a.v.i.",
  "message": "『你还好吗？检查生命体征』"
 },
 {
  "name": "樱",
  "message": "「……没关系，果然……等阶二……消耗太大了」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『此次情况，确实满足了解除条件』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……但是，我……』"
 },
 {
  "name": "樱",
  "message": "「别说了，N.a.v.i.」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……』"
 },
 {
  "name": "樱",
  "message": "「不管这些了，得赶紧，把大家，送走才行」"
 },
 {
  "message": "樱将昏迷不醒的索菲娅和槐扛在肩头。"
 },
 {
  "name": "樱",
  "message": "（两个人都……伤成这样……）"
 },
 {
  "name": "樱",
  "message": "「快点送去医院」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『是，我已经呼叫了救护车，学院的增援应该很快就到』"
 },
 {
  "name": "樱",
  "message": "「那个魔术师，也得移交过去」"
 },
 {
  "message": "樱回到走廊时，整个人都愣住了。"
 },
 {
  "name": "樱",
  "message": "「……欸？」"
 },
 {
  "name": "樱",
  "message": "「刚才，明明，还倒在这里的」"
 },
 {
  "message": "然而，崩月清枫的身影已经从这里消失了。"
 },
 {
  "name": "N.a.v.i.",
  "message": "『以他的状态，是不可能动弹的』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『正常情况下，至少需要卧床一个月』"
 },
 {
  "name": "樱",
  "message": "「是……啊」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『我会向学院报告，现场会在五分钟内被包围』"
 },
 {
  "name": "樱",
  "message": "「嗯，拜托你了」"
 },
 {
  "message": "樱陷入了沉默。"
 },
 {
  "name": "樱",
  "message": "（那个，高个子的女孩……）"
 },
 {
  "name": "樱",
  "message": "（……真是个，麻烦的人呢）"
 },
 {
  "message": "樱浅浅一笑，开始寻找华淡的身影。"
 }
]