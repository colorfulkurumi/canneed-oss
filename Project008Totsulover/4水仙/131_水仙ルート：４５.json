[
 {
  "name": "槐",
  "message": "「……？」"
 },
 {
  "message": "瞬间，我察觉到了什么，猛地回过头去。"
 },
 {
  "name": "水仙",
  "message": "「怎么了？哥哥」"
 },
 {
  "name": "槐",
  "message": "「不……」"
 },
 {
  "message": "不知为何，一股令人怀念的香气乘着风，钻入鼻腔。"
 },
 {
  "message": "这股怀念的感觉，让我一时间几乎要落下泪来。"
 },
 {
  "message": "我仿佛感受到了，那个守护我成长的人，所留下的余香。"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「不，没什么，走吧，小水」"
 },
 {
  "message": "此时此刻，我心中充盈着的，唯有无尽的感激。"
 },
 {
  "message": "可只要我们还留在这里，就难免会被卷入各种纷争。"
 },
 {
  "message": "到头来，恐怕又得去拯救世界了吧。"
 },
 {
  "name": "水仙",
  "message": "「哥哥，没关系哦」"
 },
 {
  "name": "槐",
  "message": "「欸……？」"
 },
 {
  "name": "水仙",
  "message": "「只有哥哥一个人的话——水水，会让你幸福的」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「所以，一定，没关系的！」"
 },
 {
  "message": "我忍不住笑了出来。"
 },
 {
  "message": "毕竟，我们兄妹真是，彼此彼此。"
 },
 {
  "name": "槐",
  "message": "「那个，小水，把想做的事，全都做一遍吧」"
 },
 {
  "name": "水仙",
  "message": "「全都？」"
 },
 {
  "name": "槐",
  "message": "「以前做不了的事，全部。去看电影，去旅行」"
 },
 {
  "name": "槐",
  "message": "「去钓鱼也不错，还得去泡个温泉！朋友也肯定能交到」"
 },
 {
  "name": "水仙",
  "message": "「……嗯」"
 },
 {
  "name": "槐",
  "message": "「我们一定可以的」"
 },
 {
  "name": "水仙",
  "message": "「……也就是说」"
 },
 {
  "name": "水仙",
  "message": "「我们，要像普通人那样生活吗？」"
 },
 {
  "name": "槐",
  "message": "「我曾经也……那么想过」"
 },
 {
  "name": "槐",
  "message": "「但那是，不可能的」"
 },
 {
  "name": "槐",
  "message": "「无论走到哪里，我们都只能是我们自己」"
 },
 {
  "name": "槐",
  "message": "「……看到病房里的老哥时，我就……确信了这一点」"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「虽然有些痛苦，也有些悲哀」"
 },
 {
  "name": "槐",
  "message": "「但我们要去寻找，属于我们的幸福之路」"
 },
 {
  "name": "槐",
  "message": "「不行吗？」"
 },
 {
  "name": "水仙",
  "message": "「……真是的」"
 },
 {
  "name": "水仙",
  "message": "「怎么可能……不行呢……」"
 },
 {
  "name": "水仙",
  "message": "「水水高兴得……都快死掉了……」"
 },
 {
  "name": "槐",
  "message": "「不行，起码活个百来岁吧」"
 },
 {
  "name": "水仙",
  "message": "「啊哈哈，嗯！」"
 },
 {
  "message": "我紧紧握住了她的小手。"
 },
 {
  "message": "从孩提时起就一直牵着，今后，也会一直牵下去吧。"
 },
 {
  "name": "水仙",
  "message": "「你说想做什么都可以，真是什么都可以？真的……？」"
 },
 {
  "name": "槐",
  "message": "「有想做的事了？」"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「……想要小宝宝」"
 },
 {
  "name": "槐",
  "message": "「！！」"
 },
 {
  "name": "水仙",
  "message": "「开、开玩笑的！只是、只是说着玩的！别当真——」"
 },
 {
  "name": "槐",
  "message": "「好啊，小宝宝肯定得要一个」"
 },
 {
  "name": "水仙",
  "message": "「！」"
 },
 {
  "name": "水仙",
  "message": "「可以……吗……？」"
 },
 {
  "name": "槐",
  "message": "「当然，你把我当什么了」"
 },
 {
  "name": "槐",
  "message": "「……我可是人类最强的魔术师家族中，最有天赋的老二啊」"
 },
 {
  "name": "槐",
  "message": "「这点小事，分分钟搞定」"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「呵呵，真恶心」"
 },
 {
  "name": "槐",
  "message": "「别多嘴啊」"
 },
 {
  "message": "这注定，会是场大冒险。"
 },
 {
  "message": "就像飞向宇宙遥远的尽头，就像打倒从未有人见过的怪物。"
 },
 {
  "message": "……想必，会是一场极其艰辛的冒险。"
 },
 {
  "name": "水仙",
  "message": "「……要永远，在一起哦，哥哥」"
 },
 {
  "name": "槐",
  "message": "「……嗯」"
 },
 {
  "name": "水仙",
  "message": "「只要永远在一起，就一定，能去往任何地方」"
 },
 {
  "message": "她笑了。"
 },
 {
  "message": "我也觉得，没关系。"
 },
 {
  "message": "一定——总有一天，会抵达的。"
 },
 {
  "message": "抵达属于我们两个人的——幸福。"
 }
]