[
 {
  "message": "——崩月家周围，早已打得不可开交。"
 },
 {
  "name": "华淡",
  "message": "「呀啊啊啊！！！赤刀——！！」"
 },
 {
  "name": "华淡",
  "message": "「哈啊，哈啊！这什么玩意啊，累死人家了！！」"
 },
 {
  "name": "炭化的男人",
  "message": "『ＧＹＹＹＹＹＹＹＹＹＹＹＹＹＹＹＹＹ！！』"
 },
 {
  "name": "华淡",
  "message": "「哇啊，还有完没完啊？！」"
 },
 {
  "message": "崩月家门前，他们制造的怪兽复制品正和学院的学生们战作一团。"
 },
 {
  "name": "华淡",
  "message": "「哦啦哦啦哦啦哦啦哦啦！！」"
 },
 {
  "name": "华淡",
  "message": "「娜娜！那边怎么样了？！」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『依旧无法与他们取得联系』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『崩月家地下入口，解锁进度百分之四十三，请继续维持战线』"
 },
 {
  "name": "华淡",
  "message": "「欸欸欸！才这么点？！拜托再快点啦！这样下去，学长他们会——」"
 },
 {
  "name": "炭化的男人",
  "message": "『ＧＹＹＹＹＹＹＹＹＹＹＹＹＹＹＹＹＹ！！』"
 },
 {
  "name": "华淡",
  "message": "「别说他们啦，问题是我们这边也快撑不住了～～～～？？！！」"
 },
 {
  "message": "发生战斗的地方，可不只有树海。"
 },
 {
  "name": "华淡",
  "message": "（虽然很担心夏学长，但同样担心的，还有——）"
 },
 {
  "name": "华淡",
  "message": "（——夜乃学姐）"
 },
 {
  "message": "等待着她的，将是一场避无可避的大战。"
 },
 {
  "message": "华淡挥舞着链锯，在心中默默祈祷朋友能平安无事。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "她只是觉得，对方一定会来。"
 },
 {
  "message": "她轻吸一口气，目光沉静地望向前方。"
 },
 {
  "name": "樱",
  "message": "「……果然，呢」"
 },
 {
  "name": "樱",
  "message": "「你来了这里，正如铃宫所说」"
 },
 {
  "name": "桧木",
  "message": "「……看来」"
 },
 {
  "name": "桧木",
  "message": "「犬子承蒙关照了」"
 },
 {
  "name": "樱",
  "message": "「初次见面」"
 },
 {
  "name": "樱",
  "message": "「我是学院横滨校区的学生会会长，夜乃樱」"
 },
 {
  "name": "桧木",
  "message": "「……我是崩月家家主，崩月桧木」"
 },
 {
  "name": "樱",
  "message": "「你的目标，从一开始就有我吧？」"
 },
 {
  "name": "桧木",
  "message": "「……呵」"
 },
 {
  "name": "桧木",
  "message": "「当学院开始讨伐崩月家时，我就只关注你了」"
 },
 {
  "name": "桧木",
  "message": "「可真是，让我好找啊」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "桧木看来——这简直是天赐良机。"
 },
 {
  "message": "目标少女与同伴失散，如今孤立无援。"
 },
 {
  "message": "绝不会再有比这更好的机会了。"
 },
 {
  "message": "即便，那是个陷阱。"
 },
 {
  "name": "樱",
  "message": "「……我想问你一件事」"
 },
 {
  "name": "桧木",
  "message": "「无妨，就当是为刚才的失礼赔个不是」"
 },
 {
  "name": "樱",
  "message": "（……还真是公平，铃宫也是这样）"
 },
 {
  "message": "这种没有一丝愧疚，游离于善恶之外的不羁。"
 },
 {
  "name": "樱",
  "message": "「你为什么想要碧蓝之心？」"
 },
 {
  "name": "桧木",
  "message": "「……有必要问吗」"
 },
 {
  "name": "樱",
  "message": "「你想要，黑列车的力量吗？」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「收手吧，那根本不是人类能驾驭的东西」"
 },
 {
  "name": "樱",
  "message": "「那是真正的奇迹，纯粹无限的产物，永恒祈愿的源流」"
 },
 {
  "name": "樱",
  "message": "「……这好比把大型粒子对撞机交给一只鸡来操作。人类绝无可能掌控它」"
 },
 {
  "name": "桧木",
  "message": "「你知道？」"
 },
 {
  "name": "樱",
  "message": "「……偶尔」"
 },
 {
  "name": "樱",
  "message": "「我能听到，黑列车的声音，这一定……是因为我体内的碧蓝之心」"
 },
 {
  "name": "桧木",
  "message": "「……不，那」"
 },
 {
  "name": "樱",
  "message": "「什么？」"
 },
 {
  "name": "桧木",
  "message": "「那这可就说不通了」"
 },
 {
  "name": "樱",
  "message": "「……欸？」"
 },
 {
  "name": "桧木",
  "message": "「你要是因为拥有碧蓝之心，才能听到黑列车的声音——」"
 },
 {
  "name": "桧木",
  "message": "「……那槐听不见，可就说不过去了」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「你，在说什么」"
 },
 {
  "name": "桧木",
  "message": "「你应该知道吧」"
 },
 {
  "name": "桧木",
  "message": "「你应该也感受到了吧，被他吸引的感觉」"
 },
 {
  "name": "桧木",
  "message": "「只是待在他身边，就能让你安心」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「看来，他看上别人了啊……抱歉，事情不该是这样的」"
 },
 {
  "name": "樱",
  "message": "「……啊？」"
 },
 {
  "message": "樱只觉得——喉咙干涩，有些发紧。"
 },
 {
  "name": "桧木",
  "message": "「本来，他该选你的」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「抱歉让你白期待了一场，我能理解你的心情」"
 },
 {
  "name": "樱",
  "message": "「……闭」"
 },
 {
  "name": "桧木",
  "message": "「你难道不是这么想的吗？他选了水仙的时候」"
 },
 {
  "name": "桧木",
  "message": "「——觉得，他被抢走了」"
 },
 {
  "name": "樱",
  "message": "「闭嘴」"
 },
 {
  "name": "桧木",
  "message": "「是吗，你一直藏着它啊……真是个老实人」"
 },
 {
  "name": "樱",
  "message": "「闭嘴……！！」"
 },
 {
  "message": "樱在空中唤出巨大的钉桩发射器，身形如野兽般迅猛，猛踩石头地面，冲了出去。"
 },
 {
  "name": "樱",
  "message": "「直视瓦砾！！」"
 },
 {
  "name": "桧木",
  "message": "「……嗯，原来如此」"
 },
 {
  "name": "樱",
  "message": "「——」"
 },
 {
  "name": "桧木",
  "message": "「和槐说的一样，这种水平的使用者……已经多久没见了呢」"
 },
 {
  "name": "樱",
  "message": "「哈啊啊啊啊啊啊啊啊啊！！」"
 },
 {
  "name": "桧木",
  "message": "「这件武器太大了，怎么看都不像用来跟人战斗的」"
 },
 {
  "name": "桧木",
  "message": "「……这是对付怪兽，而且是对付巨型怪兽用的。恐怕，你并不喜欢与人战斗吧」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「凭这种不坚定的决心……是伤不到我的」"
 },
 {
  "name": "樱",
  "message": "「——真的吗？」"
 },
 {
  "name": "桧木",
  "message": "「……！」"
 },
 {
  "message": "樱使出浑身力气，将巨大的钉桩发射器狠狠掷了出去。"
 },
 {
  "name": "桧木",
  "message": "「！」"
 },
 {
  "message": "桧木急忙闪身避开，樱却在这瞬间消失在了钉桩发射器的阴影下。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「唔……！」"
 },
 {
  "message": "樱从死角扫出一记重踢，将桧木整个人踹飞出去。"
 },
 {
  "name": "樱",
  "message": "「直视瓦砾」"
 },
 {
  "message": "她让钉桩发射器瞬间消失，紧接着又在自己手中重新唤出。"
 },
 {
  "name": "樱",
  "message": "（得手了——）"
 },
 {
  "message": "钉桩呼啸着，直逼因这一脚失去平衡的桧木。"
 },
 {
  "name": "桧木",
  "message": "「……不愧是你」"
 },
 {
  "name": "樱",
  "message": "「！」"
 },
 {
  "name": "桧木",
  "message": "「几句话，还动摇不了你吗」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "就在钉尖触及到他的瞬间，桧木的身影消失了。"
 },
 {
  "message": "还没等反应过来——他已经出现在了身后。"
 },
 {
  "name": "樱",
  "message": "「这就是你的……魔术？」"
 },
 {
  "name": "桧木",
  "message": "「是我魔术的一种」"
 },
 {
  "message": "从近似的次元中读取另一个自己，也就是说——与拥有另一种可能性的自己进行替换。"
 },
 {
  "message": "这是桧木最常用的战斗方法。"
 },
 {
  "name": "桧木",
  "message": "（不过……不愧是号称学院最强的存在）"
 },
 {
  "name": "桧木",
  "message": "（在绝大多数的世界中，我都已经中招了。能用来读取的我，只存在于比较遥远的次元里）"
 },
 {
  "name": "桧木",
  "message": "（……这招没法用第二次了）"
 },
 {
  "message": "这是种弃卒保车，以自身寿命为代价施展的招式。"
 },
 {
  "name": "桧木",
  "message": "「接下来」"
 },
 {
  "message": "桧木缓缓地，从空无一物的虚空中拔出了一柄长刀。"
 },
 {
  "name": "桧木",
  "message": "「试探，到此为止」"
 },
 {
  "name": "樱",
  "message": "（那是……什么……）"
 },
 {
  "message": "那是一柄通体血红的刀。"
 },
 {
  "message": "发黑的血珠正顺着刀刃，接连不断地滴落下来。"
 },
 {
  "message": "那便是多年来，支撑桧木一路走来的利刃。"
 },
 {
  "name": "桧木",
  "message": "「——妖刀『血戮』」"
 },
 {
  "name": "樱",
  "message": "「……妖刀」"
 },
 {
  "message": "那是在B.E.G.出现之前，武士们为了守护民众而使用的武器。"
 },
 {
  "name": "樱",
  "message": "「你以为那种过时的古董，有什么用吗？」"
 },
 {
  "name": "桧木",
  "message": "「说得没错」"
 },
 {
  "name": "桧木",
  "message": "「妖刀确实过时了，不过是散发着铁锈味的武器」"
 },
 {
  "name": "桧木",
  "message": "「比起你们的奇迹，确实相形见绌」"
 },
 {
  "name": "桧木",
  "message": "「……但是」"
 },
 {
  "name": "樱",
  "message": "「！」"
 },
 {
  "message": "『血戮』散发出邪异的朱红光辉。"
 },
 {
  "message": "那是一种看着就让人作呕的，极其强烈的不祥色彩。"
 },
 {
  "name": "桧木",
  "message": "「但它，例外」"
 },
 {
  "message": "桧木高高举起『血戮』——"
 },
 {
  "name": "樱",
  "message": "「……欸？」"
 },
 {
  "name": "桧木",
  "message": "「咕……呜……！！」"
 },
 {
  "message": "——猛地刺进了自己的腹中。"
 },
 {
  "name": "桧木",
  "message": "「咕哦哦哦哦哦哦哦哦哦哦哦！！！」"
 },
 {
  "message": "刀刃斩断骨头，刺穿内脏，激起大片鲜血喷涌而出。"
 },
 {
  "name": "桧木",
  "message": "「哦哦哦哦哦哦哦哦哦哦哦！！！」"
 },
 {
  "message": "剧痛与恶心，让男人发出了野兽般的嘶吼。"
 },
 {
  "name": "樱",
  "message": "「你在……干什么……」"
 },
 {
  "message": "樱愣了一瞬，随即意识到眼下并非迟疑之时。"
 },
 {
  "name": "樱",
  "message": "（这是种前摇！管它是什么——必须阻止他！）"
 },
 {
  "name": "樱",
  "message": "「直视瓦砾！！」"
 },
 {
  "message": "樱以极简的动作蹬地疾驰，顺势挥出手中的钉桩发射器。"
 },
 {
  "name": "桧木",
  "message": "「……咕」"
 },
 {
  "message": "这一击，结结实实地命中了男人的要害。"
 },
 {
  "name": "樱",
  "message": "「像你这种人……」"
 },
 {
  "name": "樱",
  "message": "「就直视，这瓦砾吧」"
 },
 {
  "message": "桧木的肉体『停止』了。"
 },
 {
  "message": "并非单纯的触碰，钉桩发射器前端的钉桩，已然贯穿了他的肉体。"
 },
 {
  "message": "直视瓦砾的钉桩并非实体，它虽不伤及皮肉，却能令万物『停止』。"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "message": "崩月桧木，完全停止了。"
 },
 {
  "name": "樱",
  "message": "「……呼」"
 },
 {
  "name": "樱",
  "message": "（好险，这把妖刀的气息，太过诡异……恐怕，反现实性质非比寻常）"
 },
 {
  "name": "樱",
  "message": "「不过这样，姑且是，将他控制住了」"
 },
 {
  "message": "樱很着急。"
 },
 {
  "message": "同伴们此刻仍在那片富士树海中奋战。"
 },
 {
  "message": "必须赶去支援。她这样想着。"
 },
 {
  "name": "樱",
  "message": "（咦）"
 },
 {
  "message": "樱——察觉到了男人腹部有东西在流淌。"
 },
 {
  "name": "樱",
  "message": "（没有，停止）"
 },
 {
  "message": "直视瓦砾是足以令万象归于『停止』的B.E.G.。"
 },
 {
  "message": "然而。"
 },
 {
  "name": "樱",
  "message": "（血，还在流）"
 },
 {
  "message": "妖刀贯穿了桧木的腹部，鲜血从创口中不断流出，丝毫没有停止的迹象。"
 },
 {
  "name": "樱",
  "message": "（不好！）"
 },
 {
  "message": "樱全身的感官都在疯狂拉响警报。"
 },
 {
  "message": "刹那间，她的身体如断线风筝般倒飞出去。"
 },
 {
  "name": "樱",
  "message": "（什……）"
 },
 {
  "message": "剧烈的冲击让她的大脑空白，根本无法理解发生了什么。"
 },
 {
  "name": "樱",
  "message": "（我，现在——）"
 },
 {
  "name": "樱",
  "message": "（——被打飞了？！）"
 },
 {
  "message": "击中樱的，仅仅只是一记随意的挥掌。"
 },
 {
  "name": "樱",
  "message": "「咕呜……！！呃……！！」"
 },
 {
  "message": "面部受创的樱横飞出数米远，重重地砸在墙壁上。"
 },
 {
  "message": "背部遭受的重击令她几近窒息。"
 },
 {
  "name": "樱",
  "message": "「咳……咳……为，什么……！！」"
 },
 {
  "name": "桧木",
  "message": "「你问我，为什么」"
 },
 {
  "name": "桧木",
  "message": "「你居然在问我？」"
 },
 {
  "name": "桧木",
  "message": "「在这你死我活的时候」"
 },
 {
  "message": "桧木的残影如狂风般袭来，鞋底已逼近樱的头颅。"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "樱的身形如子弹般回旋，堪堪避开那一击。"
 },
 {
  "name": "樱",
  "message": "「直视瓦砾！！」"
 },
 {
  "name": "桧木",
  "message": "「……！」"
 },
 {
  "message": "哪怕身处劣势，钉桩发射器射出钉桩依然精准地锁定着桧木的心脏。"
 },
 {
  "name": "桧木",
  "message": "「……真了不起」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "name": "桧木",
  "message": "「但仅凭这些，可停不住我」"
 },
 {
  "message": "桧木猛地抓住樱的脸。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「……可停不住我」"
 },
 {
  "message": "他抡圆手臂——将少女狠狠掷了出去。"
 },
 {
  "name": "樱",
  "message": "（不好，这样，没法受身——）"
 },
 {
  "message": "那投掷的力道惊人，以超一百五十迈的时速，将樱纤细的身躯再度拍碎在墙面上。"
 },
 {
  "name": "樱",
  "message": "「呃……呼……」"
 },
 {
  "message": "锁骨碎裂，肩膀脱臼，颈椎没断，算是不幸中的万幸吧。"
 },
 {
  "name": "樱",
  "message": "（不好……这个男人——）"
 },
 {
  "name": "桧木",
  "message": "「吾之性命，早已不止我一人」"
 },
 {
  "name": "樱",
  "message": "（好强！！）"
 },
 {
  "name": "桧木",
  "message": "「——」"
 },
 {
  "message": "桧木起步的刹那，钉桩发射器的寒芒已近在咫尺。"
 },
 {
  "name": "桧木",
  "message": "「……你很强大」"
 },
 {
  "name": "樱",
  "message": "「哈啊，哈啊，哈啊」"
 },
 {
  "name": "桧木",
  "message": "「吃过刚才那一下，还能爬起来吗」"
 },
 {
  "name": "樱",
  "message": "「……必须，站起来」"
 },
 {
  "name": "樱",
  "message": "「我必须站起来，因为你」"
 },
 {
  "message": "樱以坚定的目光死死盯着桧木。"
 },
 {
  "name": "樱",
  "message": "「一定会，伤害，我的朋友」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "message": "这。"
 },
 {
  "message": "——这对桧木而言，是世间最为残酷的言语。"
 },
 {
  "message": "一声悲凉至极的笑，从男人的肺腑深处传出。"
 },
 {
  "name": "桧木",
  "message": "「是么」"
 },
 {
  "name": "桧木",
  "message": "「为了朋友，前行吗」"
 },
 {
  "name": "桧木",
  "message": "「和我，刚好相反啊」"
 },
 {
  "name": "樱",
  "message": "「……欸」"
 },
 {
  "name": "桧木",
  "message": "「我可是……踩着朋友的尸体，走到今天的啊」"
 },
 {
  "message": "——妖刀『<d0122>血戮</d>』。"
 },
 {
  "message": "吸干他人的鲜血，化作自己的生命。"
 },
 {
  "message": "无论死过多少次，哪怕被彻底『停止』。"
 },
 {
  "message": "过去被桧木杀死的挚友，仍在以生命死死支撑着他前行。"
 },
 {
  "message": "无愧妖刀之名。"
 },
 {
  "name": "桧木",
  "message": "「让我停下啊」"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "name": "桧木",
  "message": "「让我的脚步——停下啊！！」"
 },
 {
  "message": "铁臂。"
 },
 {
  "message": "铁臂以挚友的生命为燃料，毫不犹豫地砸向直视瓦砾。"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "哪怕隔着钉桩发射器，那剧烈的冲击依旧把樱娇小的身躯轰飞。"
 },
 {
  "name": "桧木",
  "message": "「有本事……就让我停下啊啊啊啊啊啊！！！！」"
 },
 {
  "message": "无视一切防御与阻碍，如狂轰滥炸般的拳击。"
 },
 {
  "name": "樱",
  "message": "「……！！」"
 },
 {
  "message": "樱只能咬紧牙关，拼死防守。"
 },
 {
  "message": "这令人窒息的连击毫无破绽，她能做的，只有等待对方因体力耗尽停下。"
 },
 {
  "message": "她是对的。"
 },
 {
  "message": "——前提是，眼前的男人是正常人。"
 },
 {
  "name": "桧木",
  "message": "「……！」"
 },
 {
  "message": "那双在绝望中磨砺出的眼眸，比世上任何妖刀都更为锐利。"
 },
 {
  "name": "桧木",
  "message": "「……哦」"
 },
 {
  "message": "那颗在血海中跋涉至今的心脏，早已锻出远超钢铁的决心。"
 },
 {
  "name": "桧木",
  "message": "「哦哦哦哦哦哦哦哦哦哦哦！！」"
 },
 {
  "message": "他竟想凭血肉之躯，硬生生折断B.E.G.，事实上，钉桩发射器已经开始发生形变。"
 },
 {
  "message": "这个男人，并非常人。"
 },
 {
  "message": "他已是——魔人。"
 },
 {
  "name": "桧木",
  "message": "「交出来……！」"
 },
 {
  "name": "桧木",
  "message": "「把那颗心脏……！！」"
 },
 {
  "name": "桧木",
  "message": "「给我交出来啊啊啊啊啊啊啊啊啊啊啊！！！！！！」"
 },
 {
  "name": "樱",
  "message": "（啊，不好）"
 },
 {
  "message": "她死死攥着钉桩发射器。"
 },
 {
  "message": "眼睁睁看着它在手中寸寸碎裂。"
 },
 {
  "name": "樱",
  "message": "（这个人）"
 },
 {
  "name": "樱",
  "message": "（比我的，『决心』——）"
 },
 {
  "message": "要深重得多。"
 },
 {
  "message": "这绝非寻常之物。"
 },
 {
  "message": "那是由绝望铸成的，绝不动摇的决心。"
 },
 {
  "message": "那是凡人无法企及，唯有魔人才配拥有的武器。"
 },
 {
  "name": "樱",
  "message": "（面对这些）"
 },
 {
  "name": "樱",
  "message": "（是不可能赢的——）"
 },
 {
  "message": "那本该所向披靡，无法被破坏，由非物质构成的巨型钉桩发射器……此刻却……"
 },
 {
  "name": "樱",
  "message": "（碎……了……）"
 },
 {
  "name": "桧木",
  "message": "「——结束了」"
 },
 {
  "message": "在失去防身之物的樱眼前，那只巨大的铁拳已近在咫尺。"
 },
 {
  "message": "在死亡的恐惧袭来之前，在落败的遗憾涌现之前。"
 },
 {
  "name": "樱",
  "message": "（真是个……可怜的人啊）"
 },
 {
  "message": "她的脑海中，只余下这个念头。"
 },
 {
  "name": "桧木",
  "message": "「哦哦哦哦哦哦哦哦哦哦哦！！！！！！」"
 },
 {
  "message": "那一拳，足以碾碎樱娇小的头颅。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「……欸」"
 },
 {
  "name": "？？？",
  "message": "「……我来晚了」"
 },
 {
  "name": "樱",
  "message": "「……啊」"
 },
 {
  "message": "一名遍体鳞伤的少女，正站在那里。"
 },
 {
  "name": "索菲娅",
  "message": "「对不起……为了……甩掉护士……花了点，时间——」"
 },
 {
  "message": "此时的她，光是行走就已竭尽全力。"
 },
 {
  "name": "桧木",
  "message": "「你是……什么人……」"
 },
 {
  "message": "然而——那柄银色刺剑，未失去半分高傲的锋芒。"
 },
 {
  "name": "桧木",
  "message": "「……呃」"
 },
 {
  "message": "它已深深从桧木的脑袋侧边刺入。"
 },
 {
  "name": "索菲娅",
  "message": "「前些日子未能向您致意，失礼了」"
 },
 {
  "name": "索菲娅",
  "message": "「我是兰开斯特家族的大女儿，索菲娅・兰开斯特」"
 },
 {
  "name": "索菲娅",
  "message": "「您只需记住这一件事就好」"
 },
 {
  "name": "索菲娅",
  "message": "「我——可没有只输不赢的兴趣」"
 },
 {
  "message": "在几近倒下的少女身边，游曳着数百柄刺剑。"
 },
 {
  "name": "索菲娅",
  "message": "「前些日子欠下的债，是时候加倍奉还了」"
 },
 {
  "name": "樱",
  "message": "「索菲……！！」"
 },
 {
  "name": "桧木",
  "message": "「……！」"
 },
 {
  "message": "桧木一把扯下刺在太阳穴上的刺剑。"
 },
 {
  "message": "鲜血如注，又被『血戮』中储存的生命填补。"
 },
 {
  "name": "桧木",
  "message": "「呃……！！」"
 },
 {
  "message": "然而——就在这瞬间，另一柄刺剑已然深深贯穿他的腹部。"
 },
 {
  "name": "桧木",
  "message": "（不好，这是——）"
 },
 {
  "message": "桧木的『血戮』，是以储存的性命，获得近乎不死之身的武装。"
 },
 {
  "message": "但，它并非没有极限。"
 },
 {
  "message": "如果耗尽了供奉给『血戮』的三百余条性命，桧木就难逃一死。"
 },
 {
  "message": "而悬浮在索菲娅周围的刺剑——远不止三百把。"
 },
 {
  "name": "桧木",
  "message": "（她的能力，简直就是『血戮』的克星……！）"
 },
 {
  "message": "如果是樱，不管威力多大，一次也只能夺走一条命。"
 },
 {
  "message": "但在身受重伤的索菲娅面前，这却轻而易举。"
 },
 {
  "name": "樱",
  "message": "「索菲！！配合我！！」"
 },
 {
  "name": "索菲娅",
  "message": "「是！会长……！！」"
 },
 {
  "name": "桧木",
  "message": "（不好……！！）"
 },
 {
  "message": "破碎的直视瓦砾，此刻已然重构。"
 },
 {
  "message": "樱紧握住它，将其狠狠刺入桧木的心脏。"
 },
 {
  "name": "桧木",
  "message": "「咕……呃……！！」"
 },
 {
  "name": "樱",
  "message": "「即便你不怕『停止』——」"
 },
 {
  "name": "樱",
  "message": "「……一秒！我还是能定住你一秒的」"
 },
 {
  "message": "而只要能争取到那一秒。"
 },
 {
  "name": "桧木",
  "message": "「……呃……哦哦哦哦哦……！！」"
 },
 {
  "name": "索菲娅",
  "message": "「……我事先声明」"
 },
 {
  "name": "索菲娅",
  "message": "「被雷劈，真的很痛的」"
 },
 {
  "message": "——蔷薇盟誓。"
 },
 {
  "message": "承载着骄傲与复仇意志的B.E.G.，瞬间便将桧木刺得千疮百孔。"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "message": "面对瞬间造成的数百次死亡，坠入绝望的男人——终于跪地。"
 },
 {
  "name": "樱",
  "message": "「……哈啊……哈啊……哈啊」"
 },
 {
  "name": "索菲娅",
  "message": "「……会，长……」"
 },
 {
  "name": "樱",
  "message": "「索菲！！」"
 },
 {
  "message": "樱扶住了险些倒下的索菲娅。"
 },
 {
  "name": "樱",
  "message": "「笨蛋！！这么……这么乱来……！！」"
 },
 {
  "name": "索菲娅",
  "message": "「欸……欸嘿嘿……可、可是……大家，都在拼命啊……」"
 },
 {
  "name": "索菲娅",
  "message": "「丢我一个……在那里，睡大觉……怎么……可能嘛……」"
 },
 {
  "message": "说完，她就晕了过去。"
 },
 {
  "name": "樱",
  "message": "「索菲？」"
 },
 {
  "name": "索菲娅",
  "message": "「……呼……」"
 },
 {
  "message": "她真的，已经精疲力尽了。"
 },
 {
  "message": "应该是在精疲力竭之际全力驱动B.E.G.，反噬让她陷入了昏迷。"
 },
 {
  "message": "哪怕只是射出一柄刺剑，都已经是奇迹了。"
 },
 {
  "name": "樱",
  "message": "「……谢、谢……」"
 },
 {
  "message": "如果没有她在场，自己肯定必败无疑。樱伸出手，用力将索菲娅搂在怀中。"
 },
 {
  "name": "樱",
  "message": "「一直……谢谢你……」"
 },
 {
  "message": "最近，她终于明白了。"
 },
 {
  "message": "自己……并非孤身一人。"
 },
 {
  "name": "？？？",
  "message": "「……你真是有个，很好的朋友啊」"
 },
 {
  "message": "所以，那道声音。"
 },
 {
  "message": "那道低沉，如同地鸣，透着几分绝望的声音。"
 },
 {
  "name": "樱",
  "message": "「……不可能」"
 },
 {
  "message": "传入耳中的瞬间，樱的心彻底凉了。"
 },
 {
  "name": "桧木",
  "message": "「……老实说，刚才，我确实乱了」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「不愧是你们，『血戮』竟然被那少女彻底破解了」"
 },
 {
  "name": "桧木",
  "message": "「不过」"
 },
 {
  "name": "桧木",
  "message": "「我是魔术师」"
 },
 {
  "name": "桧木",
  "message": "「妖刀，不过是我的万千道具之一罢了」"
 },
 {
  "name": "樱",
  "message": "「……啊……啊」"
 },
 {
  "name": "桧木",
  "message": "「死而复生的办法……我一直准备着三四种」"
 },
 {
  "message": "桧木身上那些密密麻麻的血洞，正一寸一寸地愈合。"
 },
 {
  "name": "桧木",
  "message": "「……死亡的恐惧，那是整整一个世纪前，品尝过的滋味了」"
