 {
  "name": "樱",
  "message": "「这会摧毁碧蓝之心」"
 },
 {
  "name": "桧木",
  "message": "「……是吗，那你试试看啊」"
 },
 {
  "name": "樱",
  "message": "「嗯」"
 },
 {
  "message": "樱将钉桩发射器抵住心口，毫不犹豫地猛刺下去——"
 },
 {
  "name": "桧木",
  "message": "「……住手！！」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「……住手」"
 },
 {
  "name": "樱",
  "message": "「是么」"
 },
 {
  "name": "樱",
  "message": "「你从一开始，就带着巨大的劣势」"
 },
 {
  "name": "樱",
  "message": "「而你，一直藏得很好」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「无论付出何种代价，你都一定要得到我的心脏」"
 },
 {
  "name": "樱",
  "message": "「所以——你从一开始，就没法杀我」"
 },
 {
  "name": "桧木",
  "message": "「……呵」"
 },
 {
  "message": "由桧木亲手夺取碧蓝之心——那不过是最终手段。"
 },
 {
  "message": "那是事态失控，无计可施时，最后的挣扎。"
 },
 {
  "message": "依照原计划，理应由崩月槐通过正当途径夺取那颗心脏。"
 },
 {
  "name": "樱",
  "message": "「……走开」"
 },
 {
  "name": "桧木",
  "message": "「……我看走眼了吗」"
 },
 {
  "name": "樱",
  "message": "「现在，立刻，从我眼前消失」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「否则——」"
 },
 {
  "name": "桧木",
  "message": "「明白了」"
 },
 {
  "name": "桧木",
  "message": "「我走」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「……活着，真是艰难啊」"
 },
 {
  "name": "樱",
  "message": "「……彼此彼此」"
 },
 {
  "name": "樱",
  "message": "「我也，时常，感同身受」"
 },
 {
  "name": "桧木",
  "message": "「……呵」"
 },
 {
  "message": "桧木将刀收入腰间。"
 },
 {
  "message": "方才那如修罗降世般的压迫感消失了，现在的他，不过是个随处可见，神色阴郁的高大男子。"
 },
 {
  "name": "樱",
  "message": "（……真是个，可怕的人）"
 },
 {
  "message": "宛如有个开关一般，在疯狂与平静间轻松切换。"
 },
 {
  "message": "这是疯子的铁则。"
 },
 {
  "name": "桧木",
  "message": "「……那么至少，让我说几句吧」"
 },
 {
  "name": "樱",
  "message": "「嗯，说」"
 },
 {
  "name": "桧木",
  "message": "「守护好那颗心脏啊」"
 },
 {
  "name": "桧木",
  "message": "「要是这东西换了主人，世间流淌的鲜血，会让地狱都相形见绌」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「替我向我的儿女问好」"
 },
 {
  "message": "话音未落，男人就化作一道残影，踏着地面疾驰而去。"
 },
 {
  "message": "一眨眼的功夫，那男人便没了踪影。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "樱浑身一软，坐倒在地上。"
 },
 {
  "name": "樱",
  "message": "「真……的，就差一点……啊……」"
 },
 {
  "name": "樱",
  "message": "「……所以」"
 },
 {
  "name": "樱",
  "message": "「我可……做到了哦」"
 },
 {
  "message": "心脏还在砰砰直跳。"
 },
 {
  "message": "但，我赢了。"
 },
 {
  "name": "樱",
  "message": "「你……也别输啊」"
 },
 {
  "name": "樱",
  "message": "「……铃宫」"
 },
 {
  "message": "樱抬头望向那片黄昏。"
 },
 {
  "message": "再过不久，夜色就要笼罩大地了。"
 },
 {
  "message": "——正是，明月升起的时间呢。"
 }
]