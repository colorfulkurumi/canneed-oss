[
 {
  "name": "槐",
  "message": "「哈啊……哈啊……哈啊……」"
 },
 {
  "message": "槐没命地狂奔着。"
 },
 {
  "message": "他喘得很厉害，这也难怪，体力早已见底，失血过多，骨头也断了好几根。"
 },
 {
  "message": "可即便如此，他也只能继续跑。"
 },
 {
  "name": "清枫",
  "message": "「找到了，在那儿呢」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "清枫",
  "message": "「老实点——」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "槐射出钩爪枪，钩住大楼楼顶，随后踩着墙壁爬了上去。"
 },
 {
  "name": "清枫",
  "message": "「嚯，挺能干嘛」"
 },
 {
  "name": "清枫",
  "message": "「不过你现在这姿势，就是个活靶子啊」"
 },
 {
  "message": "无数个清枫同时扬手，漫天石子呼啸砸落。"
 },
 {
  "message": "虽说扔出来的不过是些碎石，但扔石头的人可不是常人。"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "精准无比，且时速超过一百七十迈的石子，无情地贯穿了槐的身体。"
 },
 {
  "name": "槐",
  "message": "「咕……呕……」"
 },
 {
  "message": "槐痛得直干呕，狼狈不堪地翻上了楼顶。"
 },
 {
  "name": "清枫",
  "message": "「……真是狼狈啊，槐」"
 },
 {
  "name": "清枫",
  "message": "「身为哥哥，该履行最后的义务了」"
 },
 {
  "name": "清枫",
  "message": "「很快，我就会帮你解脱」"
 },
 {
  "message": "清枫们追在槐的身后。"
 },
 {
  "name": "槐",
  "message": "「呼……呼……呼……」"
 },
 {
  "name": "槐",
  "message": "（还没来吗？那东西……）"
 },
 {
  "name": "槐",
  "message": "（拜托了……！求求你，快来啊……！！来啊……）"
 },
 {
  "message": "事到如今，槐除了在心中祈祷跟拼命拖延时间之外，已经无计可施了。"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "黑暗中，涌出了数十只升级版吸魂虫。"
 },
 {
  "name": "槐",
  "message": "「舞蹈笔记……！」"
 },
 {
  "message": "他死命挥舞着手臂，却根本无法将这群东西甩开。"
 },
 {
  "name": "槐",
  "message": "「该……死……」"
 },
 {
  "name": "清枫",
  "message": "「躲在这儿啊」"
 },
 {
  "name": "槐",
  "message": "「既然……既然这样……！」"
 },
 {
  "message": "槐扒着楼顶的护栏，向下看了一眼。"
 },
 {
  "message": "高度差不多有二十米。要是直接摔下去，绝对不可能安然无恙。"
 },
 {
  "name": "槐",
  "message": "「哈啊……呼……」"
 },
 {
  "message": "——但现在，他已经没得选了。"
 },
 {
  "name": "槐",
  "message": "「啊啊啊啊啊啊啊啊！！」"
 },
 {
  "name": "清枫",
  "message": "「……！」"
 },
 {
  "message": "槐翻过护栏，纵身一跃。"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "他死命稳住快要失控的身体，将手套狠狠砸向地面。"
 },
 {
  "name": "槐",
  "message": "「舞蹈……笔记……！！」"
 },
 {
  "name": "槐",
  "message": "「咳啊！」"
 },
 {
  "message": "槐在半空中触碰舞蹈笔记，下坠的势头猛地一滞，反向升起了五米。"
 },
 {
  "message": "原本足有二十米的坠落高度，被硬生生削减到了七八米左右。"
 },
 {
  "name": "槐",
  "message": "「呼……呼……」"
 },
 {
  "message": "可即便如此。"
 },
 {
  "message": "由于着陆的姿势太过勉强，他的身体遭受了二次重创。"
 },
 {
  "message": "事到如今，他连站起来走两步都已竭尽全力。"
 },
 {
  "name": "清枫",
  "message": "「真的假的，还真是够拼啊」"
 },
 {
  "name": "槐",
  "message": "「……呼——呼——」"
 },
 {
  "message": "然而，清枫的一个分身，正站在他不远处。"
 },
 {
  "name": "清枫",
  "message": "「不过啊，你差不多也该放弃了吧」"
 },
 {
  "name": "槐",
  "message": "「唔……呃……哈……哈……」"
 },
 {
  "message": "槐拖着沉重的脚步，一步步向前挪动。"
 },
 {
  "name": "清枫",
  "message": "「怎么了？你这家伙，该不会还在眼巴巴地等着奇迹发生吧？」"
 },
 {
  "name": "清枫",
  "message": "「奇迹，怎么可能降临在你和我这种恶人身上呢」"
 },
 {
  "name": "清枫",
  "message": "「能享受奇迹这种恩赐的，只有那些脚踏实地，本分过活的家伙啊」"
 },
 {
  "name": "清枫",
  "message": "「所以我们这些恶人，只能把老实人的尸体堆成高山」"
 },
 {
  "name": "清枫",
  "message": "「然后在上面开开心心地开派对，不是吗？」"
 },
 {
  "name": "槐",
  "message": "「哈……哈……」"
 },
 {
  "message": "槐已经奄奄一息，却依然拼了命地迈动步子，推开一扇建筑的门，走了进去。"
 },
 {
  "name": "清枫",
  "message": "「……算了，随你」"
 },
 {
  "name": "清枫",
  "message": "「反正我快玩腻了」"
 },
 {
  "name": "清枫",
  "message": "「是时候做个了结了」"
 },
 {
  "message": "清枫紧跟在槐身后，穿过了那扇门。"
 },
 {
  "message": "可就在他穿过门的瞬间，突然意识到了。"
 },
 {
  "name": "清枫",
  "message": "「……门？」"
 },
 {
  "message": "清枫转动门把手，踏入其中。那是一扇陈旧的，西洋式的大门。"
 },
 {
  "message": "它与这栋大楼格格不入，透着一股违和感。"
 },
 {
  "name": "槐",
  "message": "「……我就知道，你会进来的」"
 },
 {
  "message": "门内一片漆黑，只有槐的声音在回荡。"
 },
 {
  "name": "槐",
  "message": "「不，应该说，你不得不进来」"
 },
 {
  "name": "槐",
  "message": "「因为你就是这样的人」"
 },
 {
  "name": "槐",
  "message": "「因为你一直在拼了命地寻找能逗笑自己的喜剧」"
 },
 {
  "name": "清枫",
  "message": "「……这里，是哪啊」"
 },
 {
  "message": "这里明显透着一股非现实的气息。"
 },
 {
  "name": "槐",
  "message": "「……这里是」"
 },
 {
  "name": "槐",
  "message": "「帮你，实现愿望的地方」"
 },
 {
  "name": "清枫",
  "message": "（……欸，居然还有底牌，真让人吃惊）"
 },
 {
  "message": "我环顾四周，感受着周围的气息。"
 },
 {
  "name": "清枫",
  "message": "（这里是，异界吗）"
 },
 {
  "name": "清枫",
  "message": "（不是魔术产生的世界，这种独立的气息……是Yellow型吗？）"
 },
 {
  "name": "清枫",
  "message": "「呵，槐，你到底想让我看什么，真是期待啊」"
 },
 {
  "message": "我在这片漆黑的世界里，漫无目的地走着。"
 },
 {
  "name": "清枫",
  "message": "「……这里是」"
 },
 {
  "message": "我完全没察觉到，这一切是什么时候发生的。"
 },
 {
  "message": "等我回过神来，已经站在一个莫名熟悉的地方。"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "message": "横滨的城市废墟。"
 },
 {
  "message": "以前，那个魔术师就住在这附近。"
 },
 {
  "message": "我的青梅。"
 },
 {
  "message": "以前常在这一带玩耍，没少被那些瘾君子和邪教徒纠缠。"
 },
 {
  "name": "亚津沙",
  "message": "『你好啊，清枫』"
 },
 {
  "name": "清枫",
  "message": "「……！」"
 },
 {
  "message": "恍惚间——我仿佛听到了，令人无比怀念的声音。"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "清枫",
  "message": "「……亚津沙？」"
 },
 {
  "message": "那个爱诗，爱世界，爱一切事物，总是笑着的，我的挚友。"
 },
 {
  "name": "清枫",
  "message": "「亚津沙？」"
 },
 {
  "name": "亚津沙",
  "message": "『呵呵』"
 },
 {
  "name": "清枫",
  "message": "「亚津沙！！出来！！我……我、我要把你……！！」"
 },
 {
  "name": "亚津沙",
  "message": "『我，怎么？』"
 },
 {
  "name": "清枫",
  "message": "「你……」"
 },
 {
  "name": "亚津沙",
  "message": "『你该不会是想说……你爱过我吧？』"
 },
 {
  "name": "清枫",
  "message": "「……！」"
 },
 {
  "name": "亚津沙",
  "message": "『你这辈子，一次都没有爱过我哦』"
 },
 {
  "name": "亚津沙",
  "message": "『我难过极了，却又没办法，只能一个人偷偷哭』"
 },
 {
  "name": "清枫",
  "message": "「……我」"
 },
 {
  "name": "亚津沙",
  "message": "『你……恨过我吗？』"
 },
 {
  "name": "清枫",
  "message": "「……怎么可能」"
 },
 {
  "name": "清枫",
  "message": "「怎么可能，我怎么可能恨你」"
 },
 {
  "name": "清枫",
  "message": "「你」"
 },
 {
  "name": "清枫",
  "message": "「……你就是我的全部」"
 },
 {
  "name": "亚津沙",
  "message": "『……真是可怜』"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "亚津沙",
  "message": "『你原来连自己的全部，都爱不起来啊』"
 },
 {
  "name": "亚津沙",
  "message": "『因为你心底里断定，这一切索然无味吧』"
 },
 {
  "name": "清枫",
  "message": "「……亚津沙」"
 },
 {
  "name": "清枫",
  "message": "「你为什么要……抛下我啊？」"
 },
 {
  "name": "亚津沙",
  "message": "『呵呵，现在还说什么呢』"
 },
 {
  "name": "亚津沙",
  "message": "『你——不是想这样吗？』"
 },
 {
  "message": "她的话，沉甸甸地落在我胸口。"
 },
 {
  "message": "我其实，一直都明白。"
 },
 {
  "name": "清枫",
  "message": "（啊啊，确实，是的）"
 },
 {
  "name": "亚津沙",
  "message": "『你不是渴望失去我吗』"
 },
 {
  "name": "亚津沙",
  "message": "『你不是想沉浸在这种失去的感觉里吗』"
 },
 {
  "name": "亚津沙",
  "message": "『因为对你来说，只有这瞬间，才能证明你对世界的爱』"
 },
 {
  "name": "清枫",
  "message": "「……呵」"
 },
 {
  "name": "亚津沙",
  "message": "『人们不是常说嘛』"
 },
 {
  "name": "亚津沙",
  "message": "『重要的东西，失去了才懂得珍惜』"
 },
 {
  "name": "亚津沙",
  "message": "『你真是可怜啊，落魄，可悲』"
 },
 {
  "name": "亚津沙",
  "message": "『只有在失去的时候，你才能感受到某样东西的珍贵』"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "亚津沙",
  "message": "『所以，你才不惜践踏自己的尊严，制造自己的克隆体。所以，你才想要伤害所有你深爱的人』"
 },
 {
  "name": "亚津沙",
  "message": "『所以』"
 },
 {
  "name": "亚津沙",
  "message": "『在我消失在空间空洞那次——那时，你的脸上，不就挂着那样的笑容吗？』"
 },
 {
  "name": "清枫",
  "message": "「……啊啊」"
 },
 {
  "message": "是吗。"
 },
 {
  "message": "在你眼里，我在笑吗。"
 },
 {
  "name": "清枫",
  "message": "（我当时……在笑吗）"
 },
 {
  "message": "在即将失去她的瞬间。"
 },
 {
  "message": "我竟然，笑得出来吗。"
 },
 {
  "name": "清枫",
  "message": "「……呵」"
 },
 {
  "name": "清枫",
  "message": "「所以呢，那又如何？」"
 },
 {
  "name": "清枫",
  "message": "「就算我是残缺的。就算我的渴望相互矛盾，就算前路连一丝希望都不存在」"
 },
 {
  "name": "清枫",
  "message": "「那又怎样？」"
 },
 {
  "name": "亚津沙",
  "message": "『……那个啊』"
 },
 {
  "name": "亚津沙",
  "message": "『即便如此，我还是，一直爱着你啊』"
 },
 {
  "name": "亚津沙",
  "message": "『我一直爱着那个笨拙，挣扎，痛苦却依然美丽的你啊』"
 },
 {
  "name": "亚津沙",
  "message": "『所以』"
 },
 {
  "name": "清枫",
  "message": "「嗯」"
 },
 {
  "name": "亚津沙",
  "message": "『……至少，我会把你最想要的东西给你』"
 },
 {
  "name": "亚津沙",
  "message": "『用尽我所有的爱，送给你』"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "清枫",
  "message": "「这里是……」"
 },
 {
  "message": "回过神来时，我正站在自己出生长大的家门前。"
 },
 {
  "message": "线香的气味，蔺草的清香，以及隐约混杂其中的血腥味。"
 },
 {
  "name": "槐",
  "message": "『……』"
 },
 {
  "name": "清枫",
  "message": "「……槐」"
 },
 {
  "name": "清枫",
  "message": "（这是怎么回事？）"
 },
 {
  "name": "清枫",
  "message": "（为什么，伤口都愈合了——）"
 },
 {
  "name": "清枫",
  "message": "（而且，这个异界，到底是什么样子的）"
 },
 {
  "name": "槐",
  "message": "『老哥』"
 },
 {
  "name": "清枫",
  "message": "「……嗯？」"
 },
 {
  "name": "槐",
  "message": "『……直接拿出真本事来』"
 },
 {
  "name": "清枫",
  "message": "「啊？都现在了，你说什么——」"
 },
 {
  "message": "槐的身影，从我眼前消失了。"
 },
 {
  "name": "清枫",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "『会死的』"
 },
 {
  "name": "清枫",
  "message": "「……！」"
 },
 {
  "message": "一记飞踢，狠狠击中了我的下巴。"
 },
 {
  "name": "清枫",
  "message": "（不好，这下肯定脑震荡……根本，站不起来）"
 },
 {
  "name": "槐",
  "message": "『啊啊啊啊啊……！！』"
 },
 {
  "message": "当然，槐不可能放过破绽百出的我。"
 },
 {
  "name": "清枫",
  "message": "「咕——」"
 },
 {
  "message": "又是一脚飞踢，狠狠扫在我的太阳穴上。"
 },
 {
  "name": "槐",
  "message": "『喂……少装死，给我站起来』"
 },
 {
  "name": "清枫",
  "message": "（好可怕的威力，他的体术……明显不正常）"
 },
 {
  "name": "槐",
  "message": "『再不站起来……』"
 },
 {
  "message": "一股令人胆寒的气息弥漫开来。"
 },
 {
  "name": "槐",
  "message": "『我就，杀了你』"
 },
 {
  "message": "好几条通道，出现在槐身后。"
 },
 {
  "message": "谁都看得出来，他正准备从中召唤出什么东西。"
 },
 {
  "name": "清枫",
  "message": "（哈哈，你啊……）"
 },
 {
  "name": "清枫",
  "message": "（所以，我不是说了吗）"
 },
 {
  "name": "清枫",
  "message": "（只有你，才是真正的天才）"
 },
 {
  "message": "既然如此，我也不能继续躺在地上装死了。"
 },
 {
  "message": "我挣扎着站起身，拿出玛利亚。"
 },
 {
  "name": "清枫",
  "message": "「……来吧」"
 },
 {
  "name": "清枫",
  "message": "「让我见识一下」"
 },
 {
  "name": "清枫",
  "message": "「让我看看你的潜力！看看你能达到什么境界！还有这个世界——真正的价值！！」"
 },
 {
  "name": "槐",
  "message": "『……好啊，没问题，不用你说』"
 },
 {
  "name": "清枫",
  "message": "「只有你……只有你……」"
 },
 {
  "message": "——现身的，是千只怪物组成的军团。"
 },
 {
  "name": "清枫",
  "message": "（……啊啊）"
 },
 {
  "message": "无数羽翼组成的集合体，由巨大眼球和数亿刀刃聚成的怪物，不断嘶吼的野兽，还有冰霜凝结而成的巨龙。"
 },
 {
  "name": "清枫",
  "message": "（啊啊……我）"
 },
 {
  "name": "槐",
  "message": "『来了啊，老哥，你可要——拼了命地挣扎啊』"
 },
 {
  "name": "清枫",
  "message": "（正如此灿烂地……活着啊）"
 },
 {
  "message": "那一刻，我笑了。"
 },
 {
  "message": "那种快乐，让我无法自拔。"
 },
