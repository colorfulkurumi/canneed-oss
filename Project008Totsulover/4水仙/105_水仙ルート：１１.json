[
 {
  "name": "水仙",
  "message": "「哥、哥哥……不用缩到那么边上，不然会……盖不到被子的……」"
 },
 {
  "name": "槐",
  "message": "「……啊……是吗？」"
 },
 {
  "name": "水仙",
  "message": "「嗯……再往这边，靠一点……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "冰冷的被窝里，传来了她的体温。"
 },
 {
  "message": "某一瞬，她的脚尖不经意地碰到了我，吓得我缩了一下。"
 },
 {
  "message": "外面下着瓢泼大雨。"
 },
 {
  "message": "她那双亮晶晶的眼睛，正悄悄地注视着我。"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "明明外面下着瓢泼大雨，她微弱的呼吸声却在我耳边清晰可闻。"
 },
 {
  "name": "水仙",
  "message": "「……总觉得……像这样待在一起啊……」"
 },
 {
  "name": "槐",
  "message": "「嗯」"
 },
 {
  "name": "水仙",
  "message": "「两个人……钻进同一个被窝……好久没这样了呢……」"
 },
 {
  "name": "槐",
  "message": "「是啊……」"
 },
 {
  "message": "小时候倒是经常这样。不过，长大了以后嘛……"
 },
 {
  "name": "槐",
  "message": "「我倒觉得没什么啊，是小水你后来都不肯过来了吧」"
 },
 {
  "name": "水仙",
  "message": "「什、什么嘛，这么说，哥哥你不也一样」"
 },
 {
  "name": "槐",
  "message": "「什么啊」"
 },
 {
  "name": "水仙",
  "message": "「你也不来……水水的……被窝嘛……」"
 },
 {
  "name": "槐",
  "message": "「当哥哥的钻妹妹被窝，也太不对了吧」"
 },
 {
  "name": "水仙",
  "message": "「为什么啊」"
 },
 {
  "name": "槐",
  "message": "「那当然是因为……你……」"
 },
 {
  "message": "妹妹钻哥哥的被窝，还能说成撒娇，夸句可爱就过去了。"
 },
 {
  "message": "可当哥哥的要是钻进妹妹的被窝，那不纯犯罪吗。"
 },
 {
  "name": "槐",
  "message": "「怎么，难道你舍不得？」"
 },
 {
  "name": "水仙",
  "message": "「你、你说什么呢」"
 },
 {
  "name": "槐",
  "message": "「明明想跟哥哥待在一块，却没法老实说出口吧」"
 },
 {
  "name": "槐",
  "message": "「唉——真可爱啊」"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「怎么沉默了」"
 },
 {
  "name": "水仙",
  "message": "「因为……没什么……」"
 },
 {
  "name": "水仙",
  "message": "「……就是这样嘛」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "真是的，我妹妹也太可爱了。"
 },
 {
  "name": "槐",
  "message": "「我不在宅子的时候，你会想我吗？」"
 },
 {
  "name": "水仙",
  "message": "「……（点头）」"
 },
 {
  "name": "槐",
  "message": "「这样啊，那以后我多抽点时间陪陪你吧」"
 },
 {
  "name": "水仙",
  "message": "「不……不是的……水水也不是说……想让哥哥这样……」"
 },
 {
  "name": "槐",
  "message": "「所以啊，小水」"
 },
 {
  "name": "槐",
  "message": "「对我来说，没有比你更重要的了」"
 },
 {
  "name": "水仙",
  "message": "「……！」"
 },
 {
  "name": "槐",
  "message": "「你想做的事，就是我想做的事。懂了吗？我想把你的愿望全都实现」"
 },
 {
  "name": "槐",
  "message": "「所以……不管多么任性的要求，都可以跟哥哥说哦……」"
 },
 {
  "name": "水仙",
  "message": "「……哥哥……真是的……没办法……」"
 },
 {
  "name": "槐",
  "message": "「嗯？」"
 },
 {
  "name": "水仙",
  "message": "「真的……可以吗……？」"
 },
 {
  "name": "水仙",
  "message": "「什么……都可以吗……？」"
 },
 {
  "name": "水仙",
  "message": "「水水……想做的事情……都可以吗……？」"
 },
 {
  "message": "微微发烫的脸颊。"
 },
 {
  "message": "那双迷离的眼睛。"
 },
 {
  "message": "她的呼吸轻轻拂过我的肩膀。"
 },
 {
  "name": "槐",
  "message": "「……可以啊，当然可以了」"
 },
 {
  "name": "水仙",
  "message": "「……这可是你说的哦」"
 },
 {
  "name": "槐",
  "message": "「额，干嘛，有点吓人」"
 },
 {
  "name": "水仙",
  "message": "「那……」"
 },
 {
  "message": "水仙朝我贴了过来。"
 },
 {
  "name": "水仙",
  "message": "「……要枕胳膊」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "水仙",
  "message": "「给水水枕胳膊！」"
 },
 {
  "name": "槐",
  "message": "「……是！」"
 },
 {
  "message": "我把胳膊伸进她的脖子和枕头之间。"
 },
 {
  "name": "水仙",
  "message": "「唔呼——%0」"
 },
 {
  "message": "这位公主殿下露出了心满意足的表情。"
 },
 {
  "name": "水仙",
  "message": "「然后……用空着的那只手……抱紧水水」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「……哥哥明明说，什么都答应的」"
 },
 {
  "message": "不，话是这么说，我是说过没错。"
 },
 {
  "message": "可要是把穿得这么单薄的她抱进怀里。"
 },
 {
  "message": "绝对会碰到各种敏感部位的吧。"
 },
 {
  "name": "槐",
  "message": "（管他呢，豁出去了！）"
 },
 {
  "message": "我紧紧抱住了她。"
 },
 {
  "name": "水仙",
  "message": "「……%0」"
 },
 {
  "name": "槐",
  "message": "「……这样，可以了吧……？」"
 },
 {
  "name": "水仙",
  "message": "「不行，要再用点力……抱紧水水」"
 },
 {
  "name": "槐",
  "message": "「……我一答应，你就变得这么黏人啊」"
 },
 {
  "name": "水仙",
  "message": "「都是哥哥的错」"
 },
 {
  "name": "水仙",
  "message": "「因为哥哥太宠水水了」"
 },
 {
  "name": "水仙",
  "message": "「所以……水水才会得寸进尺，哥哥没有好好管教妹妹，要负全责」"
 },
 {
  "name": "槐",
  "message": "「……甩锅大王啊」"
 },
 {
  "name": "水仙",
  "message": "「好了好了，抱紧紧」"
 },
 {
  "message": "我做好了觉悟。"
 },
 {
  "name": "水仙",
  "message": "「……！」"
 },
 {
  "message": "我抱住她，用力将她拉进自己怀里。"
 },
 {
  "name": "水仙",
  "message": "「哈……%0　呼……嗯……%0」"
 },
 {
  "name": "槐",
  "message": "「会难受吗？」"
 },
 {
  "name": "水仙",
  "message": "「哥哥……力气……好大……」"
 },
 {
  "name": "槐",
  "message": "「啊，抱歉」"
 },
 {
  "name": "水仙",
  "message": "「不是……」"
 },
 {
  "name": "水仙",
  "message": "「可以……再用力点……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "感觉我的理智快灰飞烟灭了。"
 },
 {
  "name": "水仙",
  "message": "「哥……哥……%0」"
 },
 {
  "message": "她也紧紧抱住了我。"
 },
 {
  "message": "简直像小孩子抱着自己喜欢的玩偶。"
 },
 {
  "name": "槐",
  "message": "（呜哇……）"
 },
 {
  "message": "她整个人拼命贴着我，那对丰满的胸死死顶在我肚子上，挤扁了。"
 },
 {
  "name": "水仙",
  "message": "「……呵呵，抱抱真舒服啊，哥哥」"
 },
 {
  "name": "槐",
  "message": "「……你满意就好」"
 },
 {
  "message": "她滑溜溜的肌肤，还有那软糯肉肉的手感……"
 },
 {
  "message": "她用腿缠住我，越贴越近，最后还把头埋进了我怀里。"
 },
 {
  "name": "水仙",
  "message": "「……嘶——哈——」"
 },
 {
  "name": "槐",
  "message": "「……你是不是在深呼吸？」"
 },
 {
  "name": "水仙",
  "message": "「……嗯？哪有啊」"
 },
 {
  "name": "槐",
  "message": "「哪没有啊」"
 },
 {
  "name": "水仙",
  "message": "「……哥哥……最喜欢你了」"
 },
 {
  "name": "槐",
  "message": "「嗯，我也……爱你」"
 },
 {
  "name": "水仙",
  "message": "「别、别抢跑啊！」"
 },
 {
  "name": "槐",
  "message": "「干嘛！」"
 },
 {
  "name": "水仙",
  "message": "「水水说的是喜欢，哥哥却回了一句爱」"
 },
 {
  "name": "水仙",
  "message": "「这不显得水水输了嘛！」"
 },
 {
  "name": "槐",
  "message": "「这又不是在比输赢！」"
 },
 {
  "name": "水仙",
  "message": "「可、可是」"
 },
 {
  "name": "水仙",
  "message": "「肯定是……水水……更喜欢哥哥嘛……」"
 },
 {
  "name": "槐",
  "message": "「不是，这可未必」"
 },
 {
  "name": "水仙",
  "message": "「就是！」"
 },
 {
  "name": "槐",
  "message": "「就不是」"
 },
 {
  "name": "水仙",
  "message": "「哥哥只是不懂」"
 },
 {
  "name": "水仙",
  "message": "「水水是……什么感觉……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「呵呵」"
 },
 {
  "message": "她嫣然一笑，凝视着我。"
 },
 {
  "message": "那双澄澈的眸子，仿佛要把我整个人都吸进去。"
 },
 {
  "name": "水仙",
  "message": "「所以，从今以后——」"
 },
 {
  "name": "水仙",
  "message": "「要哥哥说最喜欢水水，然后水水说……最爱哥哥」"
 },
 {
  "name": "槐",
  "message": "「我还没答应呢」"
 },
 {
  "name": "水仙",
  "message": "「不是说妹妹的愿望，哥哥全都会实现吗」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「哥哥这个大骗子」"
 },
 {
  "name": "槐",
  "message": "「……咕奴奴，真拿你没办法」"
 },
 {
  "name": "水仙",
  "message": "「嘿嘿」"
 },
 {
  "name": "水仙",
  "message": "「哥哥……」"
 },
 {
  "name": "水仙",
  "message": "「……水水爱你哦」"
 },
 {
  "name": "槐",
  "message": "「我也……爱你」"
 },
 {
  "name": "水仙",
  "message": "「笨、笨蛋……都说了……！」"
 },
 {
  "name": "槐",
  "message": "「这也不行？」"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「真拿你没办法……那水水就退一步好了……」"
 },
 {
  "message": "她用力地抱紧了我。"
 },
 {
  "name": "水仙",
  "message": "「哈……%0　呼……%0　呼……%0」"
 },
 {
  "message": "她的呼吸喷在我裸露的皮肤上，有些痒痒的。"
 },
 {
  "message": "她一个劲儿地把身体往我身上挤。"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "水仙",
  "message": "「哥……哥……%0」"
 },
 {
  "name": "槐",
  "message": "「那、那个，小水。差不多该睡了，贴得这么紧，会睡不着吧……」"
 },
 {
  "name": "水仙",
  "message": "「不要」"
 },
 {
  "name": "槐",
  "message": "「……会睡不着吧？」"
 },
 {
  "name": "水仙",
  "message": "「睡得着」"
 },
 {
  "name": "水仙",
  "message": "「哥、哥哥讨厌这样吗？和水水贴在一起」"
 },
 {
  "name": "槐",
  "message": "「怎么可能讨厌……」"
 },
 {
  "message": "可要是这样下去……"
 },
 {
  "name": "水仙",
  "message": "「……欸？」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "她的大腿，碰了一下我那已经彻底硬起来的部位。"
 },
 {
  "name": "水仙",
  "message": "「呀啊……哥哥……对、对不起！」"
 },
 {
  "name": "槐",
  "message": "「没……我才是……对不起」"
 },
 {
  "name": "水仙",
  "message": "「不用道歉……没关系的……」"
 },
 {
  "name": "水仙",
  "message": "「毕、毕竟，这只是正常的生理现象吧？」"
 },
 {
  "name": "槐",
  "message": "「当、当然了，那肯定……」"
 },
 {
  "message": "要说我心里完全没有邪念——那绝对是骗人的。"
 },
 {
  "name": "水仙",
  "message": "「所以……没关系啦……水水……都明白的……」"
 },
 {
  "name": "槐",
  "message": "「……总之，你明白了吧？所以，先放开我……」"
 },
 {
  "name": "水仙",
  "message": "「……不要」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "水仙",
  "message": "「因为……既然只是生理现象的话……」"
 },
 {
  "name": "水仙",
  "message": "「水水……又不会介意……」"
 },
 {
  "message": "她低声说着，再次抱紧了我。"
 },
 {
  "message": "我那变大的部位，顶在了她的小腹上。"
 },
 {
  "name": "水仙",
  "message": "「呵呵，真的好硬哦，好恶心～」"
 },
 {
  "name": "槐",
  "message": "「你、你啊……」"
 },
 {
  "name": "水仙",
  "message": "「哥哥……对妹妹……也会这样啊……」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "水仙",
  "message": "「……哥哥也……这样啊」"
 },
 {
  "name": "槐",
  "message": "「小……小水……」"
 },
 {
  "name": "水仙",
  "message": "「……好啦，快睡吧」"
 },
 {
  "name": "水仙",
  "message": "「哥哥……明天还要上学呢」"
 },
 {
  "message": "那硬邦邦的部位还死死顶在她的小腹上。"
 },
 {
  "message": "水仙像往常一样笑着，用力搂住了我。"
 },
 {
  "name": "水仙",
  "message": "「……欸嘿嘿」"
 },
 {
  "name": "槐",
  "message": "「干、干嘛……」"
 },
 {
  "name": "水仙",
  "message": "「没啊……没什么～」"
 },
 {
  "name": "水仙",
  "message": "「只是……突然觉得……水水……今天……是世界上最幸福的人……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「最喜欢你了……哥哥……水水爱你哦……」"
 },
 {
  "message": "说完，她闭上了眼睛。"
 },
 {
  "message": "我无比温柔地抚摸她的脑袋。"
 },
 {
  "name": "槐",
  "message": "「晚安……小水……」"
 },
 {
  "message": "我一定要好好珍惜她。"
 },
 {
  "message": "这个又可爱又温柔，世界第一好的妹妹。"
 },
 {
  "name": "槐",
  "message": "（她已经喜欢我到，根本不在乎我硬没硬了）"
 },
 {
  "name": "槐",
  "message": "（我……肯定，也一样）"
 },
 {
  "message": "我将她紧紧搂在怀里。"
 },
 {
  "message": "真想亲她啊。"
 },
 {
  "message": "但是幸福的睡意，比这个念头更先到来。"
 },
 {
  "message": "我们就这样抱在一起，沉沉睡去。"
 }
]