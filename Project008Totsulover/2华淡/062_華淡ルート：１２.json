[
 {
  "message": "不知不觉溜达了快一个钟头，总算回到了公寓。"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "很明显，我们都舍不得和对方分开。"
 },
 {
  "name": "槐",
  "message": "（但是，我……）"
 },
 {
  "message": "这到底该怎么办啊。"
 },
 {
  "name": "槐",
  "message": "「那、那华淡，明天见——」"
 },
 {
  "message": "我正打算开门，她却突然紧紧抓住了我的衣角。"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "华淡",
  "message": "「不要」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "华淡",
  "message": "「……不要」"
 },
 {
  "name": "槐",
  "message": "「……不要……什么啊」"
 },
 {
  "name": "华淡",
  "message": "「……不要走，多陪人家一会儿」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「……明明都强奸过人家了」"
 },
 {
  "name": "槐",
  "message": "<s30>「什？！」</s>"
 },
 {
  "name": "华淡",
  "message": "「原来学长只馋人家的身体啊」"
 },
 {
  "name": "槐",
  "message": "「才没有！！要我说先下手的是你吧！！」"
 },
 {
  "name": "华淡",
  "message": "「……仅限第一回吧？」"
 },
 {
  "name": "槐",
  "message": "<s30>「呃……」</s>"
 },
 {
  "name": "华淡",
  "message": "「第二次……是夏学长动的」"
 },
 {
  "name": "华淡",
  "message": "「人家明明一直在喊不要不要，你还硬把肉棒塞进人家嘴里来」"
 },
 {
  "name": "槐",
  "message": "「在外面别说这种让人误会的话啊！」"
 },
 {
  "name": "华淡",
  "message": "「干、干嘛啦！」"
 },
 {
  "name": "华淡",
  "message": "「人家介么可爱，学长难道不想和人家多待一会儿吗！」"
 },
 {
  "name": "槐",
  "message": "「……！这、这个……」"
 },
 {
  "message": "——废话，我当然想了。"
 },
 {
  "message": "想待在一起。"
 },
 {
  "message": "但是啊。"
 },
 {
  "name": "槐",
  "message": "（要是现在跟她一起进了房间，我绝对会忍不住对她出手的！）"
 },
 {
  "message": "我对此有着绝对的自信。"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "message": "华淡一言不发，死死地瞪着我。"
 },
 {
  "name": "华淡",
  "message": "「……夏学长」"
 },
 {
  "name": "槐",
  "message": "「……干嘛」"
 },
 {
  "name": "华淡",
  "message": "「……你喜欢人家吗？」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「……你不喜欢人家啊」"
 },
 {
  "name": "槐",
  "message": "「怎、怎么就不喜欢了啊！」"
 },
 {
  "name": "华淡",
  "message": "「……明明不喜欢人家，还跟人家色色」"
 },
 {
  "name": "槐",
  "message": "「怎么就当既定事实了啊！！喂？！」"
 },
 {
  "name": "华淡",
  "message": "「……请你回答我」"
 },
 {
  "name": "槐",
  "message": "「～～～！」"
 },
 {
  "name": "华淡",
  "message": "「其实人家心里清楚得很，现在人家正做着超级不知廉耻的事情」"
 },
 {
  "name": "华淡",
  "message": "「毕竟夏学长你啊，怎么看都喜欢人家嘛，喜欢得不行」"
 },
 {
  "name": "华淡",
  "message": "「所以其实……看学长这样……人家一直在等……看你会不会快点跟人家表白呢」"
 },
 {
  "name": "华淡",
  "message": "「……可这样，太磨叽了，等不下去了」"
 },
 {
  "name": "槐",
  "message": "「……唔」"
 },
 {
  "name": "华淡",
  "message": "「夏学长……告诉我吧？」"
 },
 {
  "name": "华淡",
  "message": "「在你说出来之前，人家是绝对不会放你走的哦」"
 },
 {
  "name": "华淡",
  "message": "「人家可是相当主动的哦」"
 },
 {
  "name": "华淡",
  "message": "「……喜欢？还是讨厌？快说呀？」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "这——"
 },
 {
  "name": "槐",
  "message": "「我怎么可能……讨厌你啊……」"
 },
 {
  "name": "华淡",
  "message": "「……嗯，人家知道%0」"
 },
 {
  "name": "华淡",
  "message": "「那，是什么？」"
 },
 {
  "name": "槐",
  "message": "「……啊」"
 },
 {
  "message": "她水汪汪的大眼睛看着我。"
 },
 {
  "message": "我只觉得喉咙里干得要冒烟。"
 },
 {
  "message": "到底该怎么办，我是真的没主意了。"
 },
 {
  "name": "槐",
  "message": "「我……啊……」"
 },
 {
  "name": "华淡",
  "message": "「……嗯」"
 },
 {
  "name": "槐",
  "message": "「……根本不是……你想的……那种人」"
 },
 {
  "name": "华淡",
  "message": "「——欸？」"
 },
 {
  "name": "槐",
  "message": "「我……我，是……」"
 },
 {
  "name": "槐",
  "message": "「我是个……大骗子……我、我一直在对所有人……撒谎……」"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「我根本，没资格……对你说出喜欢两个字啊……」"
 },
 {
  "message": "没错，我怎么可能说出口。"
 },
 {
  "message": "因为我是学院的敌人。"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「学长，你把人家当傻瓜吗？」"
 },
 {
  "name": "槐",
  "message": "「……不，这是——」"
 },
 {
  "name": "华淡",
  "message": "「——那只纸折的蝴蝶」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "华淡",
  "message": "「在『浑身是眼的少女』的异界里，那只牵着丝线跟人家传音的蝴蝶」"
 },
 {
  "name": "华淡",
  "message": "「那个，是B.E.G.吧」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「人家思考过无数次，那到底是谁的B.E.G.呢」"
 },
 {
  "name": "华淡",
  "message": "「在那所女校里，除了我们之外，应该没有学院的人了」"
 },
 {
  "name": "华淡",
  "message": "「兰开斯特学姐不是那么有心计的人，她是个正直又高洁的人」"
 },
 {
  "name": "华淡",
  "message": "「可是，夏学长……」"
 },
 {
  "name": "华淡",
  "message": "「是个有点狡猾，却很厉害的人。这点事，人家还是知道的」"
 },
 {
  "name": "槐",
  "message": "「华……淡……」"
 },
 {
  "name": "华淡",
  "message": "「——学长，你有两个B.E.G.对吧？」"
 },
 {
  "message": "这……"
 },
 {
  "name": "华淡",
  "message": "「也就是说，有谁给了你一个B.E.G.，然后你一直拿那个瞒着我们」"
 },
 {
  "name": "华淡",
  "message": "「……这点事，人家还是知道的」"
 },
 {
  "name": "槐",
  "message": "「……不对……根本不是这种级别的问题……」"
 },
 {
  "name": "华淡",
  "message": "「那，又是什么级别的问题？」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "这一瞬间，我甚至想过干脆把一切都告诉她。"
 },
 {
  "message": "我的真实身份，我的本名，我的目的。"
 },
 {
  "message": "但是——"
 },
 {
  "name": "槐",
  "message": "（要是说了后，华淡要把真相告诉学院呢？）"
 },
 {
  "message": "到时候，我就得跟华淡动手了吗？"
 },
 {
  "message": "我——真的下得去手吗？"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「……夏学长？」"
 },
 {
  "name": "槐",
  "message": "「对不起……对不起……」"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「我……太没用了……没有一点『觉悟』……每次，都是这样……」"
 },
 {
  "name": "槐",
  "message": "「我……我一直以来，都只知道躲在地下的研究室里……」"
 },
 {
  "name": "槐",
  "message": "「我根本不知道……这个世界这么美丽……」"
 },
 {
  "name": "槐",
  "message": "「还……这么复杂……」"
 },
 {
  "name": "华淡",
  "message": "「学……长……？」"
 },
 {
  "message": "我觉得，自己不能和她走这么近。"
 },
 {
  "message": "因为和她走这么近，就等于把她也拖进这浑水里了。"
 },
 {
  "name": "槐",
  "message": "（无论华淡是体谅我，还是会变成我的敌人——）"
 },
 {
  "name": "槐",
  "message": "（结果都只会伤害到她——）"
 },
 {
  "message": "所以，我做不到。"
 },
 {
  "message": "我绝对做不到。"
 },
 {
  "name": "槐",
  "message": "「对不起，华淡……我……」"
 },
 {
  "message": "——我不能再和她待在一起了。"
 },
 {
  "message": "和华淡相处的日子太过开心，太过惬意，以至于我都快忘了这点。"
 },
 {
  "message": "我，是魔术师。"
 },
 {
  "name": "槐",
  "message": "「对不起……！」"
 },
 {
  "message": "我转过身，背对她。"
 },
 {
  "message": "就在那瞬间。"
 },
 {
  "message": "她从背后，抱紧了我。"
 },
 {
  "name": "槐",
  "message": "「……欸」"
 },
 {
  "name": "华淡",
  "message": "「……对不起！」"
 },
 {
  "name": "槐",
  "message": "「……什么？」"
 },
 {
  "name": "华淡",
  "message": "「……人家，明白了……」"
 },
 {
  "name": "槐",
  "message": "「欸——」"
 },
 {
  "name": "华淡",
  "message": "「——哦啦啊啊啊啊啊！」"
 },
 {
  "message": "她一个冲撞的动作，就将我推进了房间。"
 },
 {
  "name": "槐",
  "message": "<s30>「什……？！」</s>"
 },
 {
  "name": "槐",
  "message": "<s34>「哇啊！」</s>"
 },
 {
  "message": "我就这么被她扑倒在走廊上，后脑勺重重地磕到了地板。"
 },
 {
  "name": "槐",
  "message": "「华淡……！你，干嘛……！」"
 },
 {
  "name": "华淡",
  "message": "「……人家，明白了……」"
 },
 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "name": "华淡",
  "message": "「人家明白了……所以……别这副表情啊……」"
 },
 {
  "name": "槐",
  "message": "「这副……表情……？」"
 },
 {
  "name": "华淡",
  "message": "「一脸『不能再和她待下去了』……」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "华淡",
  "message": "「人家明白哦……学长……你这点心思，太好猜了……」"
 },
 {
  "name": "华淡",
  "message": "「对、对不起……」"
 },
 {
  "name": "华淡",
  "message": "「人家……不会再，追问了……也不会，挖你的秘密……」"
 },
 {
  "name": "华淡",
  "message": "「所以……别丢下人家走掉啊……」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "华淡",
  "message": "「……果然，一副被说中了的样子」"
 },
 {
  "name": "槐",
  "message": "「我、我才没有——」"
 },
 {
  "name": "华淡",
  "message": "「……人家没关系哦」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "华淡",
  "message": "「学长是骗子也没关系，学长有秘密也没关系」"
 },
 {
  "name": "华淡",
  "message": "「就算你伤害人家，也没关系」"
 },
 {
  "name": "槐",
  "message": "「……啊」"
 },
 {
  "name": "华淡",
  "message": "「所以，作为交换——」"
 },
 {
  "name": "华淡",
  "message": "「——说喜欢我」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「把人家当舔狗也可以的……」"
 },
 {
  "name": "华淡",
  "message": "「就算最后……把人家玩坏了再丢掉，也无所谓……」"
 },
 {
  "name": "华淡",
  "message": "「但至少现在……」"
 },
 {
  "name": "华淡",
  "message": "「说喜欢我，抱紧我啊……」"
 },
 {
  "message": "啊啊，我……"
 },
 {
  "name": "槐",
  "message": "（我真的很喜欢她啊）"
 },
 {
  "message": "我不由地想，怎么会有如此美丽的人。"
 },
 {
  "name": "槐",
  "message": "「……华淡」"
 },
 {
  "name": "华淡",
  "message": "「……嗯」"
 },
 {
  "name": "槐",
  "message": "「手机，打开」"
 },
 {
  "name": "华淡",
  "message": "「……欸？」"
 },
 {
  "name": "槐",
  "message": "「……如果你觉得，应该这么做的话……」"
 },
 {
  "name": "槐",
  "message": "「立刻……向学院举报我……」"
 },
 {
  "name": "华淡",
  "message": "「……学……长……？」"
 },
 {
  "name": "槐",
  "message": "「先用你那把链锯把我大卸八块也行……」"
 },
 {
  "message": "华淡愣了一下。"
 },
 {
  "message": "接着，她眼中闪过一丝决心，轻轻点了下头。"
 },
 {
  "name": "槐",
  "message": "「……我是……魔术师……」"
 },
 {
  "name": "华淡",
  "message": "「——欸」"
 },
 {
  "name": "槐",
  "message": "「……铃宫夏是假名」"
 },
 {
  "name": "槐",
  "message": "「我真正的名字叫——崩月槐」"
 },
 {
  "name": "华淡",
  "message": "「——槐……」"
 },
 {
  "message": "华淡的眼睛瞪得圆圆的，像一轮满月。"
 },
 {
  "name": "华淡",
  "message": "「赤刀」"
 },
 {
  "message": "只一瞬间，我的手脚就被大卸八块了。"
 },
 {
  "message": "她果然是个聪明的姑娘啊。"
 },
 {
  "name": "槐",
  "message": "（没错……这样才对）"
 },
 {
  "message": "华淡泪眼汪汪地看着我。"
 },
 {
  "name": "华淡",
  "message": "「对不……起，学长……」"
 },
 {
  "name": "槐",
  "message": "「……嗯」"
 },
 {
  "name": "华淡",
  "message": "「如果你的目的……」"
 },
 {
  "name": "华淡",
  "message": "「会伤害大家的话」"
 },
 {
  "name": "华淡",
  "message": "「人家绝对不能坐视不管……」"
 },
 {
  "name": "槐",
  "message": "「……呵」"
 },
 {
  "name": "华淡",
  "message": "「干嘛？」"
 },
 {
  "name": "槐",
  "message": "「没什么……只是觉得，真像你啊」"
 },
 {
  "message": "华淡重情重义，温柔，是个好人。"
 },
 {
  "message": "但她却比谁都要冷静，要聪明。"
 },
 {
  "message": "聪明到哪怕面对自己喜欢的人，也能表现出敌意。"
 },
 {
  "message": "连她这点，我也喜欢。"
 },
 {
  "name": "华淡",
  "message": "「崩月……是那个，崩月吗……？」"
 },
 {
  "name": "华淡",
  "message": "「最疯狂的魔术师一族……我国历史上，最著名的——」"
 },
 {
  "name": "槐",
  "message": "「……嗯，我是家里的老二」"
 },
 {
  "name": "华淡",
  "message": "「……人家在新闻里……看到过，老二，是——」"
 },
 {
  "name": "华淡",
  "message": "「——现实破坏者」"
 },
 {
  "name": "华淡",
  "message": "「自己一个人……就打破了无数有关反现实的定论……」"
 },
 {
  "name": "华淡",
  "message": "「最接近，幻想的人类……」"
 },
 {
  "name": "槐",
  "message": "「……嗯」"
 },
 {
  "name": "华淡",
  "message": "「……你在，骗人家吧……？」"
 },
 {
  "name": "槐",
  "message": "「不，是真的」"
 },
 {
  "name": "槐",
  "message": "「我有崩月家的任务，是为了获取『碧蓝之心』才潜入学院的」"
 },
 {
  "name": "华淡",
  "message": "「……碧蓝之心？那是，什么啊？」"
 },
 {
  "name": "槐",
  "message": "「我也不太清楚，只知道好像在夜乃学姐手里」"
 },
 {
  "name": "华淡",
  "message": "「……！所以你才要进学生会……？！」"
 },
 {
  "name": "槐",
  "message": "「……嗯，这就是我的目的，不过我没打算伤害学院里的人」"
 },
 {
  "name": "槐",
  "message": "「……我甚至还跟家里人表明，要是他们敢乱来，我会杀了他们」"
 },
 {
  "name": "华淡",
  "message": "「……哈？」"
 },
 {
  "name": "槐",
  "message": "「这就是我的秘密」"
 },
 {
  "name": "华淡",
  "message": "「你……」"
 },
 {
  "name": "华淡",
  "message": "「……你是笨蛋吗……！」"
 },
 {
  "name": "华淡",
  "message": "「这么重要的事！别顺水推舟说出来呀！！」"
 },
 {
  "name": "华淡",
  "message": "「就因为人家一个女孩子……稍微闹了点情绪」"
 },
 {
  "name": "华淡",
  "message": "「你就把重要机密……给说出来了……」"
 },
 {
  "name": "华淡",
  "message": "「你到底，是有多笨啊……」"
 },
 {
  "name": "槐",
  "message": "「不是你自己说的吗，让我说喜欢你」"
 },
 {
  "name": "华淡",
  "message": "「……笨」"
 },
 {
  "name": "槐",
  "message": "「……我喜欢你」"
 },
 {
  "name": "华淡",
  "message": "「……！」"
 },
 {
  "name": "槐",
  "message": "「感觉是你的话，我落得什么下场都无所谓」"
 },
 {
  "name": "槐",
  "message": "「所以我说了，就这样」"
 },
 {
  "name": "华淡",
  "message": "「……你，太狡猾了……学长……」"
 },
 {
  "name": "华淡",
  "message": "「居然逼人家……来做决定……」"
 },
 {
  "name": "华淡",
  "message": "「人家明明只是……」"
 },
 {
  "name": "华淡",
  "message": "「想听学长说声喜欢人家……」"
 },
 {
  "name": "华淡",
  "message": "「然后像公主那样，接个吻而已……」"
 },
 {
  "name": "槐",
  "message": "「……哈哈，人生就是不会如意啊」"
 },
 {
  "name": "华淡",
  "message": "「……真是……的……」"
 },
 {
  "message": "华淡泪眼汪汪地，捧住了我的脸。"
 },
 {
  "message": "一样水润的东西，碰到了我的嘴唇。"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "message": "只是单纯地贴着。"
 },
 {
  "message": "只是为了感受彼此的存在。"
 },
 {
  "message": "——那是一个，非常安静的吻。"
 },
 {
  "name": "槐",
  "message": "「……华……淡」"
 },
 {
  "name": "华淡",
  "message": "「……真是个……大笨蛋……」"
 },
 {
  "name": "槐",
  "message": "「……欸」"
 },
 {
  "name": "华淡",
  "message": "「说什么呢，什么叫杀掉自家人啊」"
 },
 {
  "name": "槐",
  "message": "「……『寻找鹿岛』的异界，是我老哥干的」"
 },
 {
  "name": "华淡",
  "message": "「……他……就是学长的哥哥？」"
 },
 {
  "name": "槐",
  "message": "「为了让我完成任务，他打算杀掉大家」"
 },
 {
  "name": "槐",
  "message": "「所以我……选择了战斗……」"
 },
 {
  "name": "华淡",
  "message": "「……原来，是这样啊」"
 },
 {
  "name": "槐",
  "message": "「嗯，华淡，所以，我才……」"
 },
 {
  "name": "华淡",
  "message": "「……嗯」"
 },
 {
  "message": "她的脸庞凑近，堵住了我的嘴。"
 },
 {
  "message": "比刚才的吻更香甜，感觉脑子都要宕机了。"
 },
 {
  "name": "槐",
  "message": "「……唔」"
 },
 {
  "name": "华淡",
  "message": "「笨蛋……笨蛋……笨蛋……」"
 },
 {
  "name": "槐",
  "message": "「干、干嘛……啊……？」"
 },
 {
  "name": "华淡",
  "message": "「以敌人的身份潜入学院的……却对大家动了真情，甚至要和崩月家反目……」"
 },
 {
  "name": "华淡",
  "message": "「……人家猜对了吧？」"
 },
 {
  "name": "槐",
  "message": "「呃……这、这个……」"
 },
 {
  "name": "华淡",
  "message": "「……你一直……都是孤零零的……」"
 },
 {
  "name": "华淡",
  "message": "「连一个……同伴都没有吧……」"
 },
 {
  "name": "华淡",
  "message": "「周围……全都是敌人……」"
 },
 {
  "name": "华淡",
  "message": "「这样下去……你打算怎么办啊……」"
 },
 {
  "name": "槐",
  "message": "「……这，个」"
 },
 {
  "name": "华淡",
  "message": "「既当不了坏人……」"
 },
 {
  "name": "华淡",
  "message": "「也当不了……好人……」"
 },
 {
  "name": "华淡",
  "message": "「不上不下……」"
 },
 {
  "name": "华淡",
  "message": "「……一个人……你一直都是孤零零的吗……？」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「你说这些，让人家……怎么办才好啊……」"
 },
 {
  "name": "槐",
  "message": "「……随你喜欢」"
 },
 {
  "name": "华淡",
  "message": "「真的……？真的，随我喜欢吗？」"
 },
 {
  "name": "槐",
  "message": "「欸」"
 },
 {
  "name": "华淡",
  "message": "「……真的吗？」"
 },
 {
  "name": "槐",
  "message": "「这、这个——」"
 },
 {
  "name": "华淡",
  "message": "「……学长，人家觉得，你可能误解了」"
 },
 {
  "name": "槐",
  "message": "「……误会什么？」"
 },
 {
  "name": "华淡",
  "message": "「人家啊，讨厌伤害别人，希望大家都能开开心心地笑着」"
 },
 {
  "name": "华淡",
  "message": "「但是——」"
 },
 {
  "name": "华淡",
  "message": "「但如果是为了喜欢的人，当个坏人也不算什么哦」"
 },
 {
  "name": "华淡",
  "message": "「本来，人家就不是什么正义的伙伴」"
 },
 {
  "name": "槐",
  "message": "「……啊」"
 },
 {
  "name": "华淡",
  "message": "「……人家……不会再让你，孤零零的了……」"
 },
 {
  "message": "华淡眼里泛起泪光，笑了起来。"
 },
 {
  "name": "华淡",
  "message": "「请让人家……留在，学长身边吧……」"
 },
 {
  "name": "华淡",
  "message": "「人家绝对……不会背叛你的……」"
 },
 {
  "name": "华淡",
  "message": "「也绝不会……告诉任何人……」"
 },
 {
  "message": "那是饱含『觉悟』的笑容。"
 },
 {
  "message": "我不由得看呆了。"
 },
 {
  "name": "槐",
  "message": "「华淡……你确定？」"
 },
 {
  "name": "华淡",
  "message": "「……嗯！」"
 },
 {
  "message": "既然如此，那我——"
 },
 {
  "name": "槐",
  "message": "「我……喜欢你……」"
 },
 {
  "name": "华淡",
  "message": "「……嗯%0」"
 },
 {
  "name": "华淡",
  "message": "「人家也……喜欢学长……」"
 },
 {
  "name": "华淡",
  "message": "「最喜欢了！」"
 },
 {
  "name": "槐",
  "message": "「华淡……」"
 },
 {
  "name": "槐",
  "message": "「……一直，和我在一起……好吗？」"
 },
 {
  "name": "华淡",
  "message": "「嗯%0」"
 },
 {
  "message": "那——也成了我的『觉悟』。"
 },
 {
  "message": "我下定了决心，无论发生什么，都要保护好她。"
 },
 {
  "name": "槐",
  "message": "（我……会爱她一辈子吧）"
 },
 {
  "message": "我隐隐约约，有这种预感。"
 },
 {
  "name": "华淡",
  "message": "「作为交换……刚才学长说的那个，现在人家要行使那个权利咯？」"
 },
 {
  "name": "槐",
  "message": "「……那个？」"
 },
 {
  "name": "华淡",
  "message": "「『随你喜欢』」"
 },
 {
  "name": "槐",
  "message": "「欸」"
 },
 {
  "name": "华淡",
  "message": "「……嗯……人家要……随自己喜欢了哦」"
 },
 {
  "name": "华淡",
  "message": "「因为，人家想这样，想了好久」"
 },
 {
  "message": "华淡伸出舌尖，轻轻舔了舔嘴角。"
 },
 {
  "name": "槐",
  "message": "「……华淡？」"
 },
 {
  "name": "华淡",
  "message": "「学长是人家的……是只属于人家一个人的哦」"
 },
 {
  "name": "槐",
  "message": "「什——」"
 },
 {
  "name": "华淡",
  "message": "「人家开次啦……%0」"
 },
 {
  "message": "她纤细的手指，碰到了我衬衫的纽扣。"
 }
]