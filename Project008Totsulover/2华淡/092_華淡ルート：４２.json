[
 {
  "message": "某个午后——"
 },
 {
  "name": "播音员",
  "message": "『紧急播报！横滨产生大规模反现实实体！请附近居民立即撤离至指定区域避难！』"
 },
 {
  "name": "播音员",
  "message": "『重复！请立即撤离至指定区域避难！』"
 },
 {
  "message": "街上到处是四散奔逃的人群。"
 },
 {
  "name": "居民甲",
  "message": "「快跑啊——！大楼要塌了！会被压死的——！」"
 },
 {
  "name": "急救队",
  "message": "「冷静！请大家保持冷静！不要惊慌，有序撤离！」"
 },
 {
  "name": "学院学生甲",
  "message": "『这里是机动部队阿尔法！发现巨大怪兽「无畏级」！』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『类别，Ⅲ类怪兽，预估难度，成树级』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『那只怪兽……和上个月夜乃会长讨伐的，完全是同一个个体！』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『难道……这种巨大的怪兽？！是人为制造的？！』"
 },
 {
  "message": "为了讨伐怪兽，学院的学生们已经各就各位。"
 },
 {
  "name": "N.a.v.i.",
  "message": "『请小心，这——可不是普通的怪兽！』"
 },
 {
  "name": "学院学生乙",
  "message": "『已锁定学院学生「铃宫夏」，学院学生「海漫华淡」！正在追踪——』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……欸？』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『请报告情况！机动部队阿尔法？请立即汇报』"
 },
 {
  "name": "？？？",
  "message": "『……啊……啊——』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『？！你是……！』"
 },
 {
  "name": "？？？",
  "message": "『N.a.v.i.，是我，谢谢你之前的照顾』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『铃宫……夏同学……？你为什么要这么做』"
 },
 {
  "name": "槐",
  "message": "『学院地下藏着黑列车。这件事，你知道吗？』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……不，我不明白你在说什么』"
 },
 {
  "name": "槐",
  "message": "『看你这反应，多少有点头绪吧』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……！』"
 },
 {
  "name": "槐",
  "message": "『接下来，我们要改变这个世界』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『你要为了年轻时的痴人说梦，与学院为敌吗？』"
 },
 {
  "name": "槐",
  "message": "『……年轻的梦？』"
 },
 {
  "name": "槐",
  "message": "『硬要说的话，更像是老人家乱来吧……』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『你在说什么——』"
 },
 {
  "name": "槐",
  "message": "『我只是想跟你说声谢谢』"
 },
 {
  "name": "槐",
  "message": "『替我向老师，还有班上的大家问个好』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『等等，你到底要……！』"
 },
 {
  "message": "就在N.a.v.i.忍不住抬高声音的瞬间，通信被啪的一声切断了。"
 },
 {
  "name": "N.a.v.i.",
  "message": "『你……到底……』"
 },
 {
  "name": "槐",
  "message": "「学院的追兵，应该甩掉了吧」"
 },
 {
  "name": "华淡",
  "message": "「……话说，现在根本没闲工夫管我们吧？」"
 },
 {
  "message": "远处，我造的那头巨大怪兽正闹得天翻地覆。"
 },
 {
  "message": "我让它尽量别破坏街道，也绝对不能伤到人。"
 },
 {
  "message": "要是这个弱点被发现，那头怪兽恐怕转眼间就会被收拾掉吧。"
 },
 {
  "name": "大狱系统",
  "message": "『这一带港口的运行系统已经被本大爷接管了，船也准备好了』"
 },
 {
  "name": "槐",
  "message": "「华淡，往东往西，你想去哪？」"
 },
 {
  "name": "华淡",
  "message": "「东边！因为那是太阳升起的方向嘛」"
 },
 {
  "name": "槐",
  "message": "「东边……不错嘛，咱们，要么当个东夷得了」"
 },
 {
  "name": "华淡",
  "message": "「那边受反现实影响也很深吧，肯定有很多人在为此发愁呢」"
 },
 {
  "name": "槐",
  "message": "「是啊」"
 },
 {
  "message": "——我们朝着港口一路狂奔。"
 },
 {
  "message": "水仙应该已经在港口等我们了。"
 },
 {
  "message": "就差一点了。"
 },
 {
  "message": "就差一点，就要和这个城市告别了。"
 },
 {
  "message": "但是。"
 },
 {
  "message": "但我总隐约觉得。"
 },
 {
  "message": "事情不会就这么轻易结束。"
 },
 {
  "message": "毕竟，那个女孩可不会善罢甘休。"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "message": "——前方伫立着一名少女。"
 },
 {
  "message": "她独自一人，就这么挡在道路正中央。"
 },
 {
  "name": "索菲娅",
  "message": "「——蔷薇盟誓」"
 },
 {
  "message": "她手中紧握着美丽的银白刺剑，目光中盛满属于她的骄傲。"
 },
 {
  "name": "华淡",
  "message": "「兰开……斯特……学姐……」"
 },
 {
  "name": "索菲娅",
  "message": "「……我只是隐约」"
 },
 {
  "name": "索菲娅",
  "message": "「只是隐约觉得，应该在这边」"
 },
 {
  "name": "索菲娅",
  "message": "「毕竟那头怪兽，表现得实在太温柔了」"
 },
 {
  "name": "索菲娅",
  "message": "「无论怎么看，都只是个诱饵」"
 },
 {
  "name": "槐",
  "message": "「……兰开斯特，请你……让开」"
 },
 {
  "name": "索菲娅",
  "message": "「……我倒想反过来问你呢」"
 },
 {
  "name": "索菲娅",
  "message": "「你觉得我会走吗？」"
 },
 {
  "name": "索菲娅",
  "message": "「你们伤了夜乃会长，还背叛了所有人——」"
 },
 {
  "name": "索菲娅",
  "message": "「——你觉得，我现在会走开吗？！」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "是啊，没错。"
 },
 {
  "message": "她是个『骄傲』的人。"
 },
 {
  "message": "正因如此，她才会孤身一人出现在这里。"
 },
 {
  "message": "一个同伴都没带。"
 },
 {
  "message": "也没打算搞奇袭。"
 },
 {
  "message": "而是选择堂堂正正地，举起那柄银色的刺剑。"
 },
 {
  "name": "华淡",
  "message": "「……槐，这里，交给我吧」"
 },
 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "name": "华淡",
  "message": "「求你了，让我来吧」"
 },
 {
  "message": "不知为何，我竟然理解了那种心情。"
 },
 {
  "message": "我们对兰开斯特这个人，实在是太了解了。"
 },
 {
  "message": "——那是憧憬，是对她气度的向往。"
 },
 {
  "name": "索菲娅",
  "message": "「虽然……我有满肚子的话想问你们」"
 },
 {
  "name": "索菲娅",
  "message": "「不过，还是等把你们抓起来之后，再慢慢问吧！」"
 },
 {
  "name": "华淡",
  "message": "「……好」"
 },
 {
  "name": "华淡",
  "message": "「我不会找借口，也绝不会撒一句谎」"
 },
 {
  "name": "华淡",
  "message": "「所以……兰开斯特学姐……！」"
 },
 {
  "message": "华淡把话咽了回去，转而——"
 },
 {
  "name": "华淡",
  "message": "「——赤刀」"
 },
 {
  "message": "举起了那柄鲜红的链锯。"
 },
 {
  "name": "索菲娅",
  "message": "「……你的B.E.G.，打算拿来做什么呢？」"
 },
 {
  "name": "索菲娅",
  "message": "「——我可是，有很多伤要跟你们算啊」"
 },
 {
  "name": "华淡",
  "message": "「……！」"
 },
 {
  "name": "索菲娅",
  "message": "「海漫，铃宫。我呢，可没那么大本事」"
 },
 {
  "name": "索菲娅",
  "message": "「我没本事毫发无伤地把你们抓起来！」"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「兰开斯特学姐……」"
 },
 {
  "name": "华淡",
  "message": "「听起来……你像说给自己听，在给自己打气呢……」"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「人家啊，最喜欢这样的学姐了」"
 },
 {
  "name": "华淡",
  "message": "「但是——我们，必须得走了」"
 },
 {
  "name": "索菲娅",
  "message": "「走……去哪里……？」"
 },
 {
  "name": "华淡",
  "message": "「去一个比这里更棒的地方」"
 },
 {
  "name": "华淡",
  "message": "「我们啊……一不小心，背负了太多太多的东西……虽然只是个意外」"
 },
 {
  "name": "华淡",
  "message": "「托很多很多人的福，我们跨越了无限」"
 },
 {
  "name": "华淡",
  "message": "「所以……该怎么说呢……」"
 },
 {
  "name": "华淡",
  "message": "「所以……必须做点能让自己抬起头来的事才行……」"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「所以，我们——已经停不下来了」"
 },
 {
  "message": "华淡举起了链锯。"
 },
 {
  "message": "兰开斯特也握紧了刺剑——"
 },
 {
  "name": "索菲娅",
  "message": "「上吧！蔷薇盟誓！！」"
 },
 {
  "message": "数十柄刺剑瞬间迸发，齐刷刷地向华淡袭去。"
 },
 {
  "message": "华淡的赤刀并不擅长应对这种正面拦截。"
 },
 {
  "message": "想要将所有刺剑悉数击落，恐怕是异想天开。"
 },
 {
  "name": "华淡",
  "message": "「赤刀……」"
 },
 {
  "message": "如果她还是以前的她。"
 },
 {
  "name": "华淡",
  "message": "「……旋转木马」"
 },
 {
  "name": "索菲娅",
  "message": "「……！」"
 },
 {
  "message": "一瞬间，所有的刺剑都深深没入地面。"
 },
 {
  "name": "索菲娅",
  "message": "「……欸？」"
 },
 {
  "name": "华淡",
  "message": "「赤刀的第三能力——旋转木马」"
 },
 {
  "name": "华淡",
  "message": "「……将时间，搅碎」"
 },
 {
  "message": "一瞬间，华淡毫无征兆地出现在了兰开斯特身后。"
 },
 {
  "message": "那种感觉，就像视频跳帧了一样。"
 },
 {
  "name": "索菲娅",
  "message": "「唔……」"
 },
 {
  "message": "华淡手中的链锯，从背后贯穿了兰开斯特的身体。"
 },
 {
  "message": "这种形态只会削去对方的魂魄流体，并不会对肉体造成实质损伤。"
 },
 {
  "message": "夺走兰开斯特的体力后，刺剑消失，她的身体也随之瘫软下去。"
 },
 {
  "name": "索菲娅",
  "message": "「……那是……什么……这种……能力……」"
 },
 {
  "name": "华淡",
  "message": "「……这可是人家为了撕裂无限世界，拼命学会的力量」"
 },
 {
  "name": "华淡",
  "message": "「虽然到头来，在那边完全没派上用场就是了」"
 },
 {
  "message": "兰开斯特倒了下去，华淡伸手扶住了她。"
 },
 {
  "name": "华淡",
  "message": "「……对不起，兰开斯特学姐」"
 },
 {
  "name": "华淡",
  "message": "「人家……最喜欢学姐了」"
 },
 {
  "name": "华淡",
  "message": "「一直以来……谢谢」"
 },
 {
  "message": "华淡将兰开斯特轻轻平放在地面上。"
 },
 {
  "name": "槐",
  "message": "「……让你做了件残忍的事呢」"
 },
 {
  "name": "华淡",
  "message": "「咯咯，是啊」"
 },
 {
  "name": "华淡",
  "message": "「这些事，我们一起分担吧？」"
 },
 {
  "name": "槐",
  "message": "「……嗯」"
 },
 {
  "message": "我们肩并肩，迈开脚步。"
 },
 {
  "message": "不知为何，我突然想到。"
 },
 {
  "message": "我想，能和她一起走到今天，一定是无数偶然与选择交织的结果。"
 },
 {
  "message": "或许在某个不同的地方，也存在一个我，做出了截然不同的决断吧。"
 },
 {
  "message": "这种理所当然的事情，竟让我觉得有些奇妙。"
 },
 {
  "name": "索菲娅",
  "message": "「……等……一下……」"
 },
 {
  "message": "身后，传来了她起身的声响。"
 },
 {
  "name": "索菲娅",
  "message": "「哈啊……哈啊……给我……站住……」"
 },
 {
  "name": "华淡",
  "message": "「……骗人的吧，人家明明已经让她彻底站不起来了才对」"
 },
 {
  "name": "索菲娅",
  "message": "「不行……还不能……你们……还不能走……！」"
 },
 {
  "name": "槐",
  "message": "「兰开斯特……」"
 },
 {
  "name": "索菲娅",
  "message": "「至少……让我问清楚」"
 },
 {
  "name": "索菲娅",
  "message": "「根据你们的回答……我、我……」"
 },
 {
  "message": "她，举起了刺剑。"
 },
 {
  "message": "以一副跌跌撞撞，遍体鳞伤的模样。"
 },
 {
  "name": "索菲娅",
  "message": "「我——绝不会放你走」"
 },
 {
  "name": "槐",
  "message": "「……你……啊……」"
 },
 {
  "name": "槐",
  "message": "「……行啊，你想问什么？」"
 },
 {
  "name": "索菲娅",
  "message": "「铃宫……你是不是——」"
 },
 {
  "name": "槐",
  "message": "「我？」"
 },
 {
  "name": "索菲娅",
  "message": "「——被什么人威胁了？」"
 },
 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "name": "索菲娅",
  "message": "「又是……被哥哥……被家人……胁迫……才出现在这里吗……」"
 },
 {
  "name": "槐",
  "message": "「……难道，说」"
 },
 {
  "message": "她啊。"
 },
 {
  "message": "哪怕伤成这样也要站起来。"
 },
 {
  "message": "哪怕只有一个人也要战斗。"
 },
 {
  "name": "槐",
  "message": "「你……这是……在担心我，吗？」"
 },
 {
  "name": "索菲娅",
  "message": "「——回答我！！」"
 },
 {
  "message": "啊，真的，多么骄傲的人啊。"
 },
 {
  "message": "她这副模样，让我不禁心生向往。"
 },
 {
  "message": "幻想着有朝一日……能够，像她一点。"
 },
 {
  "name": "槐",
  "message": "「……不是的」"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「这是我自己的选择，我坚信这是正确的道路」"
 },
 {
  "name": "槐",
  "message": "「就算是我」"
 },
 {
  "name": "槐",
  "message": "「……也想，朝着希望前进」"
 },
 {
  "name": "索菲娅",
  "message": "「……」"
 },
 {
  "message": "她手中的刺剑落地，发出哐当一声脆响。"
 },
 {
  "name": "索菲娅",
  "message": "「……是吗」"
 },
 {
  "name": "索菲娅",
  "message": "「……太好了」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "索菲娅",
  "message": "「那就……太好了……」"
 },
 {
  "message": "她笑了。"
 },
 {
  "name": "索菲娅",
  "message": "「再见了，两位」"
 },
 {
  "name": "索菲娅",
  "message": "「……要一直……好好的啊」"
 },
 {
  "name": "索菲娅",
  "message": "「一定要……好好的啊……」"
 },
 {
  "message": "低语完后，她倒了下去。"
 },
 {
  "name": "华淡",
  "message": "「……！」"
 },
 {
  "message": "华淡的眼眶里，盈满了泪水。"
 },
 {
  "name": "槐",
  "message": "「……啊，你啊」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "华淡",
  "message": "「……谢谢……」"
 },
 {
  "name": "华淡",
  "message": "「真的……谢谢……兰开斯特……学姐……」"
 },
 {
  "message": "这次，我们真的，迈出了脚步。"
 },
 {
  "message": "背后，新横滨市的街道渐渐远去。"
 },
 {
  "message": "向着那无限延伸的世界，踏步而去。"
 }
]