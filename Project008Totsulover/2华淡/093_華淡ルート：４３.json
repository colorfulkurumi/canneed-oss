[
 {
  "name": "水仙",
  "message": "「哥哥——！华淡——！这边这边——！」"
 },
 {
  "name": "槐",
  "message": "「嚯，又选了艘大船啊」"
 },
 {
  "name": "水仙",
  "message": "「欸，因为它带泳池嘛」"
 },
 {
  "name": "槐",
  "message": "「就这理由啊」"
 },
 {
  "name": "华淡",
  "message": "「哎呀，行了行了快上船！追兵马上又要追上来啦！」"
 },
 {
  "name": "大狱系统",
  "message": "『嘎哈哈哈哈！！那本大爷我再大闹一场不就得了！』"
 },
 {
  "message": "我们登上了船。"
 },
 {
  "message": "负责驾驶的是大狱。"
 },
 {
  "message": "他是拥有肉身的，世界最强的计算机，独自操船对他来说根本不在话下。"
 },
 {
  "name": "大狱系统",
  "message": "『好了，都坐好——起航喽！！』"
 },
 {
  "message": "船开始缓缓移动。"
 },
 {
  "message": "破开海水，逐渐驶离新横滨的港口。"
 },
 {
  "message": "——接下来才是关键。"
 },
 {
  "message": "从这里开始，我们的故事，才刚要开始。"
 },
 {
  "name": "华淡",
  "message": "「——你看，横滨的街道，越来越远了」"
 },
 {
  "name": "槐",
  "message": "「……嗯，是啊」"
 },
 {
  "name": "华淡",
  "message": "「说了好多次好多次再见呢」"
 },
 {
  "name": "槐",
  "message": "「……是啊」"
 },
 {
  "message": "向无限世界道别。"
 },
 {
  "message": "向夜乃学姐和兰开斯特道别。"
 },
 {
  "message": "然后现在，我们也要向这座城市道别了。"
 },
 {
  "name": "华淡",
  "message": "「总觉得，好像人生就只剩下了告别一样」"
 },
 {
  "name": "槐",
  "message": "「……是吗？」"
 },
 {
  "name": "华淡",
  "message": "「嗯，时间总会流逝吧，就像这海水一样，奔流不息」"
 },
 {
  "name": "华淡",
  "message": "「明明我们的心，一直系在这胸口正中央，从未移动过」"
 },
 {
  "name": "华淡",
  "message": "「……好舍不得呀」"
 },
 {
  "name": "华淡",
  "message": "「但是」"
 },
 {
  "name": "华淡",
  "message": "「可人家身边，还有你陪着嘛」"
 },
 {
  "name": "槐",
  "message": "「……嗯，是啊」"
 },
 {
  "name": "华淡",
  "message": "「哪怕道别了无数次，无数次」"
 },
 {
  "name": "华淡",
  "message": "「我们，也会永远在一起的」"
 },
 {
  "name": "槐",
  "message": "「……嗯」"
 },
 {
  "name": "华淡",
  "message": "「人家，一点都不寂寞哦」"
 },
 {
  "name": "槐",
  "message": "「哈哈」"
 },
 {
  "message": "明明刚才还在叫舍不得呢。"
 },
 {
  "name": "槐",
  "message": "「喂，我们去做点好玩的不得了的事吧，华淡」"
 },
 {
  "name": "华淡",
  "message": "「咯咯，好呀？」"
 },
 {
  "name": "槐",
  "message": "「做点超级开心的事情吧，把寂寞全都赶跑」"
 },
 {
  "name": "华淡",
  "message": "「啊……好欸，这也太棒了！」"
 },
 {
  "name": "华淡",
  "message": "「不愧是人家的老公！」"
 },
 {
  "message": "我们笑着，依偎在一起，注视着渐渐远去的横滨。"
 },
 {
  "message": "这是我们相遇的土地，我们在那里学到了许多东西。"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "message": "华淡还是舍不得，眼里泛起了泪光。"
 },
 {
  "name": "华淡",
  "message": "「……咯咯」"
 },
 {
  "message": "她哭着，却又笑着。"
 },
 {
  "name": "华淡",
  "message": "「……嘶——」"
 },
 {
  "message": "她深深地吸了一口气。"
 },
 {
  "name": "华淡",
  "message": "「谢谢——！！！」"
 },
 {
  "name": "华淡",
  "message": "「谢谢你们——！！！！」"
 },
 {
  "name": "华淡",
  "message": "「一直以来！！！谢谢你们！！！！真的非常感谢啊啊啊啊——！！！！！」"
 },
 {
  "message": "她放声呐喊。"
 },
 {
  "message": "直到声嘶力竭。"
 },
 {
  "message": "我先是愣了一下，随即笑了出来。"
 },
 {
  "name": "槐",
  "message": "（啊……真是）"
 },
 {
  "name": "槐",
  "message": "（能和她相遇，真是太好了）"
 },
 {
  "message": "——我打心底里，这么觉得。"
 }
]