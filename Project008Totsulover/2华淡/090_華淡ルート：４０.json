 {
  "name": "槐",
  "message": "「让少数几个强大而特别的人，通过牺牲自己来守护他人」"
 },
 {
  "name": "槐",
  "message": "「这种体制，从一开始就是扭曲的」"
 },
 {
  "name": "樱",
  "message": "「直视瓦砾……你复制……量产了它……？」"
 },
 {
  "name": "樱",
  "message": "「这……怎么可能……」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「……你到底，打算用这股力量……去做什么」"
 },
 {
  "name": "槐",
  "message": "「让你，让我，甚至大狱也——」"
 },
 {
  "name": "槐",
  "message": "「变得不再特别，变成最平凡的存在」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「会引起大混乱的」"
 },
 {
  "name": "槐",
  "message": "「嗯，我知道会引发混乱」"
 },
 {
  "name": "槐",
  "message": "「但是，即便如此……」"
 },
 {
  "name": "槐",
  "message": "「但我仍坚信这就是希望，并决定义无反顾地走下去」"
 },
 {
  "name": "樱",
  "message": "「……哈」"
 },
 {
  "name": "槐",
  "message": "「学姐，你要不要……也跟我一起？」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「不行啊，毕竟我，是『这边』的人」"
 },
 {
  "name": "槐",
  "message": "「什么这边那边的……根本不存在……那些东西……谁在乎啊……」"
 },
 {
  "name": "樱",
  "message": "「你错了」"
 },
 {
  "name": "樱",
  "message": "「你只是，已经看不见了而已」"
 },
 {
  "message": "想必——"
 },
 {
  "message": "想必，就是这样吧。"
 },
 {
  "message": "我本应身为一名魔术师，为了血脉与家族而生。"
 },
 {
  "message": "那一天发生的一切，早已成了遥远而模糊的往事。"
 },
 {
  "message": "事到如今，我已经想不明白，当初为什么要执着于那种事了。"
 },
 {
  "name": "樱",
  "message": "「槐」"
 },
 {
  "name": "樱",
  "message": "「——拿出你的，真本事来吧」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「你该不会以为，那种假货赢得了我吧？」"
 },
 {
  "name": "槐",
  "message": "「学……姐……」"
 },
 {
  "name": "樱",
  "message": "「你……」"
 },
 {
  "name": "樱",
  "message": "「你！」"
 },
 {
  "name": "槐",
  "message": "「！」"
 },
 {
  "name": "樱",
  "message": "「你要挑战的，是比我强得多、也更可怕的存在吧？！」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「所以……」"
 },
 {
  "name": "樱",
  "message": "「来吧！！认真点！！！！」"
 },
 {
  "message": "啊啊，真是——"
 },
 {
  "name": "槐",
  "message": "（一个，帅气的人啊……）"
 },
 {
  "message": "这是我发自内心的，最真切的感想。"
 },
 {
  "name": "槐",
  "message": "「好……接招吧……我要……认真了……」"
 },
 {
  "message": "——我想，这便是诀别了。"
 },
 {
  "message": "与我的青春。"
 },
 {
  "message": "与我的学院。"
 },
 {
  "message": "与我——和她的一切。"
 },
 {
  "name": "大狱系统",
  "message": "『来吧，随时可以发射，槐——！！』"
 },
 {
  "name": "槐",
  "message": "「嗯！准备发射……！！」"
 },
 {
  "name": "樱",
  "message": "「……！这反现实性……还真是惊人啊……」"
 },
 {
  "name": "樱",
  "message": "「但我……不会输的」"
 },
 {
  "name": "樱",
  "message": "「绝对！不会输的！」"
 },
 {
  "name": "槐",
  "message": "「……好啊！我也……绝对……绝对……！！」"
 },
 {
  "message": "不会输的。但我终究还是没说出口。"
 },
 {
  "name": "槐",
  "message": "「夜乃……学姐……」"
 },
 {
  "name": "樱",
  "message": "「怎么了？」"
 },
 {
  "name": "槐",
  "message": "「一直以来……谢谢你……」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「谢……！谢……！！」"
 },
 {
  "message": "她笑了。"
 },
 {
  "name": "樱",
  "message": "「彼此彼此」"
 },
 {
  "name": "樱",
  "message": "「我也很开心哦，能和你待在一起」"
 },
 {
  "message": "平日里总是面无表情的她，温柔地笑了。"
 },
 {
  "message": "让我有点，想哭。"
 },
 {
  "name": "槐",
  "message": "「最大功率！！给我轰飞她，大狱——！！」"
 },
 {
  "name": "樱",
  "message": "「哈啊啊啊啊啊啊啊啊啊啊啊啊！！！！」"
 },
 {
  "name": "樱",
  "message": "「来吧！！直视瓦砾！！直视这……瓦砾吧啊啊啊啊啊啊！！！」"
 },
 {
  "name": "槐",
  "message": "「哈啊……哈啊……哈啊……」"
 },
 {
  "message": "我低头看着，陷入停止的她。"
 },
 {
  "name": "槐",
  "message": "「哈啊……哈啊……呼——」"
 },
 {
  "name": "大狱系统",
  "message": "『你没事吧？小子，果然还是太硬来了吧』"
 },
 {
  "name": "槐",
  "message": "「……小问题，没关系」"
 },
 {
  "name": "槐",
  "message": "「……是从什么时候，开始的呢」"
 },
 {
  "name": "大狱系统",
  "message": "『啊？』"
 },
 {
  "name": "槐",
  "message": "「我啊……本来对什么别人，就没多少兴趣」"
 },
 {
  "name": "槐",
  "message": "「我这种人，打从一开始就不是会『为了大家』的……」"
 },
 {
  "name": "大狱系统",
  "message": "『……』"
 },
 {
  "name": "槐",
  "message": "「但是，这位娇小的学姐……」"
 },
 {
  "name": "槐",
  "message": "「她独自一人，想要守护所有人的背影」"
 },
 {
  "name": "槐",
  "message": "「一定已经，烙印在我的脑海里……」"
 },
 {
  "message": "不知不觉间，我就做起了这种事。"
 },
 {
  "name": "槐",
  "message": "「……谢谢你」"
 },
 {
  "message": "这位少女，是我的原点。"
 },
 {
  "message": "是我最喜欢的学姐，我最重要的朋友。"
 },
 {
  "message": "以及——今后的『敌人』。"
 },
 {
  "name": "槐",
  "message": "「……好」"
 },
 {
  "message": "我运用反现实手段，将手探入她的胸口，取出了那颗碧蓝之心。"
 },
 {
  "message": "我将亲手制作的人造心脏放进她体内，取而代之。"
 },
 {
  "message": "比起碧蓝之心，至少它的使用寿命应该更长，也更安全。"
 },
 {
  "name": "槐",
  "message": "「走吧，回家去了，搭档」"
 },
 {
  "name": "大狱系统",
  "message": "『喂，回去之前先去买那个吧，槐！就是那个甜滋滋，水灵灵的玩意儿！』"
 },
 {
  "name": "槐",
  "message": "「……桃子？你这么喜欢？」"
 },
 {
  "name": "大狱系统",
  "message": "『才才、才没有呢，也就马马虎虎吧！』"
 },
 {
  "message": "我微微一笑，离开了学院。"
 },
 {
  "message": "离开之前，我把那件再也不会穿的校服外套，披在了沉睡的夜乃学姐身上。"
 }
]