[
 {
  "name": "槐",
  "message": "（这东西……？！）"
 },
 {
  "message": "怎么看都是玩物理攻击的，我立刻反应过来，装备上『舞蹈笔记』。"
 },
 {
  "name": "书虫",
  "message": "「不可以哦……入侵者不许来这里」"
 },
 {
  "name": "槐",
  "message": "（是图书兽！这么快就撞上了）"
 },
 {
  "message": "根据羽鸟给的日志，图书兽按理应该只在更深层的区域活动才对。"
 },
 {
  "name": "华淡",
  "message": "「……那个」"
 },
 {
  "name": "书虫",
  "message": "「嗯？」"
 },
 {
  "name": "华淡",
  "message": "「我们是来图书馆查资料的！能不能请你帮帮人家呀？」"
 },
 {
  "name": "槐",
  "message": "「！」"
 },
 {
  "message": "我压根没想过还能这么搞。"
 },
 {
  "message": "大概只有对反现实怀有感情的华淡，才会进行这种交涉吧。"
 },
 {
  "message": "可图书兽却歪了歪头。"
 },
 {
  "name": "书虫",
  "message": "「……帮忙？为啥？」"
 },
 {
  "name": "华淡",
  "message": "「我们打算办完事就立刻走啦！」"
 },
 {
  "name": "书虫",
  "message": "「嘴上这么说……其实又想骗人对吧？」"
 },
 {
  "name": "华淡",
  "message": "「欸——」"
 },
 {
  "name": "书虫",
  "message": "「你们啊，信不过」"
 },
 {
  "name": "书虫",
  "message": "「唯独，你们」"
 },
 {
  "message": "书虫在腰间横起镰刀，八条腿死死抠住地面。"
 },
 {
  "name": "书虫",
  "message": "「——绝不原谅」"
 },
 {
  "name": "华淡",
  "message": "「……！」"
 },
 {
  "message": "镰刀掠过一道寒芒，劈向华淡的身躯。"
 },
 {
  "name": "华淡",
  "message": "「……好险好险！」"
 },
 {
  "message": "华淡在千钧一发之际，靠着后跳步险之又险地躲了过去。"
 },
 {
  "name": "华淡",
  "message": "「呼——！速度好快……！不过，还是比不上夜乃学姐！」"
 },
 {
  "name": "槐",
  "message": "「……要是换成那种级别的对手，咱们现在已经玩完了」"
 },
 {
  "message": "不过刚才那话，到底是什么意思？"
 },
 {
  "name": "槐",
  "message": "（唯独……你们？）"
 },
 {
  "message": "这『你们』，到底是指『谁』……？"
 },
 {
  "message": "不过让人疑惑的地方，可不止这一处。"
 },
 {
  "name": "槐",
  "message": "「……？」"
 },
 {
  "message": "图书兽再次抡起镰刀，砍向的却是华淡刚才站着的地方。"
 },
 {
  "message": "它并没有瞄准更外头的华淡，而是瞄准她的身前——"
 },
 {
  "name": "华淡",
  "message": "「……？」"
 },
 {
  "name": "书虫",
  "message": "「我，岂能再受，这等侮辱」"
 },
 {
  "message": "图书兽对着空气，挥下镰刀。"
 },
 {
  "name": "槐",
  "message": "（虽然搞不懂它在玩什么把戏，但绝不能让它得逞——！！）"
 },
 {
  "message": "我凭着本能挥出一拳，打算把图书兽直接揍飞。"
 },
 {
  "name": "书虫",
  "message": "「……嘁」"
 },
 {
  "message": "图书兽猛地转身面向我，正要挥镰格挡——而就在这一瞬，我的手碰到了刀锋。"
 },
 {
  "name": "槐",
  "message": "「舞蹈笔记！」"
 },
 {
  "name": "书虫",
  "message": "「……呃」"
 },
 {
  "message": "书虫被轰得倒飞出五米远，撞碎了图书馆的书架，重重地摔在地上。"
 },
 {
  "name": "槐",
  "message": "（刚才那是怎么回事——）"
 },
 {
  "name": "华淡",
  "message": "「——欸？」"
 },
 {
  "message": "身后，传来了叫声。"
 },
 {
  "message": "我猛然回头。"
 },
 {
  "name": "槐",
  "message": "「什……」"
 },
 {
  "name": "华淡",
  "message": "「……！」"
 },
 {
  "message": "——华淡的肩膀上，多了一道血淋淋的伤口。"
 },
 {
  "name": "华淡",
  "message": "「唔……！」"
 },
 {
  "name": "槐",
  "message": "「什么时候……？！」"
 },
 {
  "name": "书虫",
  "message": "「呼咻咻……」"
 },
 {
  "message": "图书兽已经一跃而起，再次横起了镰刀。"
 },
 {
  "name": "槐",
  "message": "（到底是什么能力……？得先摸清它的套路才行……！！）"
 },
 {
  "name": "书虫",
  "message": "「嚯嚯……嚯嚯……」"
 },
 {
  "message": "图书兽这次没有立刻摆好架势，而是像观察猎物一样，绕着我们兜起了圈子。"
 },
 {
  "name": "槐",
  "message": "（搞什么……？）"
 },
 {
  "message": "那家伙转到大约九十度角的位置时，停下了脚步。"
 },
 {
  "name": "书虫",
  "message": "「——咻」"
 },
 {
  "message": "它抡起镰刀——对着空气，一记竖劈。"
 },
 {
  "name": "槐",
  "message": "「华淡！拦住它！」"
 },
 {
  "name": "华淡",
  "message": "「收到！」"
 },
 {
  "message": "华淡横起链锯，挡下了这一击。"
 },
 {
  "message": "——与此同时。"
 },
 {
  "name": "槐",
  "message": "「咕……！」"
 },
 {
  "message": "冲击掠过我的额头。"
 },
 {
  "name": "华淡",
  "message": "「学长！」"
 },
 {
  "name": "槐",
  "message": "「我没事……只是道有点深的口子」"
 },
 {
  "message": "——起码，不是冲击波之流。"
 },
 {
  "name": "槐",
  "message": "（……？等等，这出血的方式不对劲）"
 },
 {
  "message": "毕竟我根本就没站在它挥刀的延长线上。"
 },
 {
  "name": "槐",
  "message": "（这血痕……）"
 },
 {
  "name": "华淡",
  "message": "「赤刀！！」"
 },
 {
  "message": "华淡抡起链锯，狠狠劈下。"
 },
 {
  "message": "图书兽并没有硬接，而是冷静地向后一跃，拉开了距离。"
 },
 {
  "name": "槐",
  "message": "「……我懂了，这东西的能力」"
 },
 {
  "name": "槐",
  "message": "「它瞄准的，并不是我」"
 },
 {
  "name": "槐",
  "message": "「而是我的——轨迹」"
 },
 {
  "name": "华淡",
  "message": "「……轨迹？」"
 },
 {
  "name": "槐",
  "message": "「那把镰刀！是能切开过去的利刃！」"
 },
 {
  "message": "额头被切开的瞬间，鲜血便已淌到了下巴。"
 },
 {
  "message": "甚至在血滴落之前，我都完全没有受伤的感觉。"
 },
 {
  "message": "那只图书兽……它斩断的是过去的我。"
 },
 {
  "name": "槐",
  "message": "「华淡！别让它挥那镰刀——！！」"
 },
 {
  "message": "我也戴上舞蹈笔记，冲了过去。"
 },
 {
  "message": "这下糟了！拖得越久，局势就越不利！！"
 },
 {
  "name": "书虫",
  "message": "「——太迟了」"
 },
 {
  "name": "华淡",
  "message": "「哈啊啊啊啊！！」"
 },
 {
  "message": "华淡提着链锯欺身而上，图书兽却敏捷地侧身闪过。"
 },
 {
  "message": "它绕过华淡身侧，对着空无一物的虚空挥下镰刀。"
 },
 {
  "name": "槐",
  "message": "「呃啊……！！」"
 },
 {
  "message": "——胳膊的裂口处，鲜血喷溅而出。"
 },
 {
  "name": "华淡",
  "message": "「……！」"
 },
 {
  "name": "槐",
  "message": "（糟了！）"
 },
 {
  "message": "它的力气并不算强，看来是把重心放在了攻击频率上。"
 },
 {
  "message": "然而，图书兽此时所处的空间，正是我刚才疾驰而过的地方。"
 },
 {
  "message": "它不过随意挥舞镰刀，我全身的刀伤就在不断增加。"
 },
 {
  "name": "槐",
  "message": "「～～～～～！」"
 },
 {
  "name": "华淡",
  "message": "「学长！」"
 },
 {
  "message": "华淡的链锯，架住了镰刀。"
 },
 {
  "message": "图书兽试图拉开距离，华淡却死死咬住，寸步不让。"
 },
 {
  "name": "书虫",
  "message": "「你们，入侵者，我，追踪者」"
 },
 {
  "name": "华淡",
  "message": "「吵死了！！」"
 },
 {
  "message": "华淡拼命挥舞着链锯。"
 },
 {
  "message": "可是，面对一个只需斩断『轨迹』就能立于不败之地的对手，近身缠斗根本没有胜算。"
 },
 {
  "name": "槐",
  "message": "（但是——）"
 },
 {
  "message": "那只图书兽，它在我们面前用太多次能力了。"
 },
 {
  "name": "槐",
  "message": "「华淡！刚好十秒！」"
 },
 {
  "name": "槐",
  "message": "「那把镰刀能斩断的，只能是十秒前的过去！」"
 },
 {
  "name": "书虫",
  "message": "「……！」"
 },
 {
  "message": "图书兽举起镰刀。"
 },
 {
  "message": "它那把镰刀瞄准的，正是十秒前的华淡。"
 },
 {
  "name": "槐",
  "message": "（这家伙瞄准的，正好是十秒前举起链锯的华淡）"
 },
 {
  "name": "槐",
  "message": "（而此刻，最大的破绽——就是喉咙）"
 },
 {
  "message": "图书兽猛地刺出镰刀。"
 },
 {
  "message": "但是——既然已经看穿了攻击的落点。"
 },
 {
  "name": "槐",
  "message": "「——舞蹈笔记」"
 },
 {
  "name": "书虫",
  "message": "「叽叽？！」"
 },
 {
  "message": "我的舞蹈笔记同时抵住了刃尖与刀背。"
 },
 {
  "name": "书虫",
  "message": "「……嚯嚯嚯！！」"
 },
 {
  "message": "镰刀在朝两个反方向『击飞五米』的冲击下，应声折断。"
 },
 {
  "name": "华淡",
  "message": "「哦啦啊啊啊啊啊！！！」"
 },
 {
  "message": "赤刀毫不留情地向着失去武器的图书兽劈了过去。"
 },
 {
  "name": "书虫",
  "message": "「……叽叽叽叽！！」"
 },
 {
  "message": "图书兽被拦腰劈成了两截。"
 },
 {
  "name": "华淡",
  "message": "「还没完呢啊啊啊！！」"
 },
 {
  "message": "沉重的链锯在空中纵横翻飞，疯狂地肆虐着。"
 },
 {
  "message": "图书兽被彻底搅碎，化作了一堆细小的碎块。"
 },
 {
  "name": "华淡",
  "message": "「……呼——好，搞定！华淡第一，棒棒——！」"
 },
 {
  "name": "槐",
  "message": "「……哈啊、哈啊，真是……一场苦战啊……」"
 },
 {
  "name": "华淡",
  "message": "「你没事吧？学长，这伤口……」"
 },
 {
  "message": "我忍不住笑了出来。"
 },
 {
  "message": "因为华淡身上，也同样伤痕累累。"
 },
 {
  "name": "槐",
  "message": "「……先歇会儿吧」"
 }
]