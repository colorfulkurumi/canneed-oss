[
 {
  "name": "大狱系统",
  "message": "『——开什么玩笑？』"
 },
 {
  "message": "真是难以置信，这也太离谱了。"
 },
 {
  "name": "大狱系统",
  "message": "『用B.E.G.的能力，让自己进入了休眠状态吗——』"
 },
 {
  "message": "在休眠的数千年间，人类兴起，文明发展。"
 },
 {
  "message": "那两人大概会定期醒来，引导文明的进程吧。"
 },
 {
  "message": "又或者，他们也曾失败过许多次，眼睁睁看着人类灭亡。"
 },
 {
  "message": "然而，在经历这一切之后。"
 },
 {
  "name": "大狱系统",
  "message": "『——哈哈，真的假的』"
 },
 {
  "name": "大狱系统",
  "message": "『还能这么搞』"
 },
 {
  "name": "大狱系统",
  "message": "『人类？区区两个……人类……』"
 },
 {
  "name": "大狱系统",
  "message": "『居然，打败了无限——』"
 },
 {
  "message": "严格来说，遗骸之王所创造的世界，并非真正的无限。"
 },
 {
  "message": "因为构成他的只是三万具人类遗骸，不过是以三万人的演算能力构筑世界。"
 },
 {
  "message": "也就是说，它是有边界的，哪怕其广阔程度近乎无限。"
 },
 {
  "name": "大狱系统",
  "message": "『……这下，真服了啊』"
 },
 {
  "message": "——大圣堂的中央，一扇门正在开启。"
 },
 {
  "message": "噼啪作响，闪烁着霹雳般的白光。"
 },
 {
  "name": "大狱系统",
  "message": "『要……回来了吗』"
 },
 {
  "name": "大狱系统",
  "message": "『你们』"
 },
 {
  "name": "大狱系统",
  "message": "『没有被无限打倒，也没有向绝望屈服』"
 },
 {
  "name": "大狱系统",
  "message": "『——现在要来，干掉本大爷了吗』"
 },
 {
  "message": "真是，心服口服。"
 },
 {
  "message": "真是，不服不行啊。"
 },
 {
  "name": "大狱系统",
  "message": "『呵……呵……呵……』"
 },
 {
  "name": "大狱系统",
  "message": "『哈！哈……哈！！！嘎哈哈哈哈哈！！！』"
 },
 {
  "name": "大狱系统",
  "message": "『喂喂，也太厉害了吧，你们这群家伙，真是有点厉害了啊！！』"
 },
 {
  "message": "世界裂开了缝隙。"
 },
 {
  "message": "——他们来了。"
 },
 {
  "message": "历经数十万年，他们击碎了无限，抵达了世界的尽头。"
 },
 {
  "name": "大狱系统",
  "message": "『来吧！来吧！来吧！来吧！』"
 },
 {
  "name": "大狱系统",
  "message": "『放马过来吧，人类小子！！』"
 },
 {
  "name": "大狱系统",
  "message": "『本大爷……我们……！！』"
 },
 {
  "name": "大狱系统",
  "message": "『就是因为相信你们这群家伙的光芒，才变成这副德行的啊——！！』"
 },
 {
  "name": "大狱系统",
  "message": "『让老子好好看看！！那道……光芒啊啊啊啊！！！！』"
 },
 {
  "message": "——空间裂开了。"
 },
 {
  "message": "裂缝逐渐变得巨大。"
 },
 {
  "message": "少年与少女的呐喊声响彻天地。"
 },
 {
  "name": "华淡",
  "message": "「哈啊啊啊啊啊啊啊啊啊啊！！！」"
 },
 {
  "name": "华淡",
  "message": "「接招吧！！赤刀啊啊啊啊啊啊！！！」"
 },
 {
  "message": "——接着，我们回来了。"
 },
 {
  "message": "回到我们的故乡，回到我们的战场。"
 },
 {
  "name": "槐",
  "message": "「哈啊啊啊啊啊啊啊啊啊啊啊！！」"
 },
 {
  "name": "大狱系统",
  "message": "『嘎哈哈哈！！来吧——直接……杀过来吧！！』"
 },
 {
  "name": "华淡",
  "message": "「槐！」"
 },
 {
  "name": "槐",
  "message": "「嗯！！」"
 },
 {
  "message": "我们两人共同握住赤刀，朝着遗骸之王挥砍下去。"
 },
 {
  "name": "槐&华淡",
  "message": "「粉碎吧啊啊啊啊啊啊啊啊啊——！！」"
 },
 {
  "message": "赤刀承载着两人的魂魄流体，全力一击。"
 },
 {
  "message": "其上缠绕着肉眼可见的灵气，这刀倾尽全力，力求一击必杀。"
 },
 {
  "message": "然而遗骸之王，却大笑着将它接了下来。"
 },
 {
  "name": "槐",
  "message": "「什……」"
 },
 {
  "name": "大狱系统",
  "message": "『有意思……！！有意思……！！太有意思了！你们这群小子啊……！！』"
 },
 {
  "name": "华淡",
  "message": "「槐，别退！！一口气把它切碎！！」"
 },
 {
  "name": "槐",
  "message": "「嗯！」"
 },
 {
  "name": "大狱系统",
  "message": "『不过……我……本大爷我……！！』"
 },
 {
  "name": "大狱系统",
  "message": "『可没打算这么轻易地输给你们啊……！！』"
 },
 {
  "message": "遗骸之王正面接下链锯的利刃，伴随着刺耳的摩擦声，火花四溅。"
 },
 {
  "name": "大狱系统",
  "message": "『你们这帮小子确实不赖！帅毙了！不过啊——』"
 },
 {
  "name": "大狱系统",
  "message": "『本大爷，得更酷一点！！不然……』"
 },
 {
  "name": "大狱系统",
  "message": "『可不行啊啊啊啊啊啊啊啊啊！！！！』"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "遗骸之王身上狂暴的魂魄流体，猛地将赤刀的刀刃弹开。"
 },
 {
  "name": "槐",
  "message": "（这家伙，还能这样！）"
 },
 {
  "message": "仅凭这副赤裸的身躯，就足以与奇迹的结晶——B.E.G.相抗衡。"
 },
 {
  "message": "那位王本身——就是奇迹。"
 },
 {
  "name": "槐",
  "message": "「华淡……再加把劲……！」"
 },
 {
  "name": "华淡",
  "message": "「！」"
 },
 {
  "name": "槐",
  "message": "「把劲儿全使出来！！对付他……」"
 },
 {
  "name": "槐",
  "message": "「不拼尽全力……可赢不了……！！！」"
 },
 {
  "name": "华淡",
  "message": "「——是！」"
 },
 {
  "message": "这是一场超乎想象的恶战。"
 },
 {
  "message": "漫长而险阻，由无数奇迹铺就的道路。"
 },
 {
  "message": "而我们就站在那条路的终点。"
 },
 {
  "message": "到了最后——不过是意志的对撞。"
 },
 {
  "name": "槐&华淡",
  "message": "「哈啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊！」"
 },
 {
  "name": "大狱系统",
  "message": "『噢啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！』"
 },
 {
  "message": "火花噼里啪啦地爆裂开来。"
 },
 {
  "message": "高度浓缩的奇迹，令空气剧烈震颤。"
 },
 {
  "message": "我——"
 },
 {
  "name": "槐",
  "message": "（……啊啊）"
 },
 {
  "name": "槐",
  "message": "（肯定，要输吧）"
 },
 {
  "name": "槐",
  "message": "（凭我，根本赢不了遗骸之王）"
 },
 {
  "name": "槐",
  "message": "（我们背负至今的东西……分量不同）"
 },
 {
  "message": "没错。"
 },
 {
  "message": "我赢不了。"
 },
 {
  "message": "如果——只有我的话。"
 },
 {
  "name": "华淡",
  "message": "「哈啊啊啊啊啊啊啊啊啊啊！！」"
 },
 {
  "name": "华淡",
  "message": "「差……不多该……」"
 },
 {
  "name": "华淡",
  "message": "「该给你最后一击了啊啊啊啊啊！！」"
 },
 {
  "message": "——但是，我现在并非孤身一人。"
 },
 {
  "message": "因为这个女孩相信我。"
 },
 {
  "message": "从始至终。"
 },
 {
  "message": "明明没有任何理由，明明这么做对她毫无益处。"
 },
 {
  "message": "她却一直，陪在我身边。"
 },
 {
  "name": "槐",
  "message": "（你可没有华淡）"
 },
 {
  "name": "槐",
  "message": "「这场胜负的差距——就在于此」"
 },
 {
  "name": "大狱系统",
  "message": "『……』"
 },
 {
  "name": "华淡",
  "message": "「——赤刀」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "大狱系统",
  "message": "『哈哈……』"
 },
 {
  "name": "大狱系统",
  "message": "『真行啊……真的……太强了……』"
 },
 {
  "name": "大狱系统",
  "message": "『……喂，最后，能拜托你们，一件事吗』"
 },
 {
  "name": "槐",
  "message": "「……什么事？」"
 },
 {
  "name": "大狱系统",
  "message": "『是我们……输了……所以』"
 },
 {
  "message": "遗骸之王露出一副似哭非哭的表情，笑了起来。"
 },
 {
  "name": "大狱系统",
  "message": "『能不能……让我们……当你们的朋友啊？』"
 },
 {
  "message": "我和华淡对视了一眼。"
 },
 {
  "name": "华淡",
  "message": "「嗯——当然！」"
 },
 {
  "message": "我刚笑出声，就因脱力直接瘫倒在了地上。"
 },
 {
  "message": "浑身力气都被抽空，连站起来的劲都没了。"
 },
 {
  "message": "但这种疲惫，却让人感到无比惬意。"
 },
 {
  "message": "我和她就这么躺在地上，四目相对。"
 },
 {
  "message": "——会心一笑后，握住了彼此的手。"
 }
]