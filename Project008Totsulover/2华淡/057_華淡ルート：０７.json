[
 {
  "message": "夜幕下的新横滨市，依旧喧闹不停。"
 },
 {
  "name": "槐",
  "message": "（还挺新鲜的嘛）"
 },
 {
  "message": "视角的高度变了，周围人投来的视线也变了。"
 },
 {
  "message": "人家好歹也是个超级美少女，路上的男生大多都会忍不住偷瞄几眼。"
 },
 {
  "message": "偶尔也会撞见些凶巴巴的人，所以还是不太喜欢大晚上出门。"
 },
 {
  "name": "槐",
  "message": "（不过现在，倒是不必担心那些了）"
 },
 {
  "message": "感觉这样也挺不赖的。"
 },
 {
  "name": "？？？",
  "message": "「呵呵」"
 },
 {
  "message": "——身后冷不防响起了一阵笑声。"
 },
 {
  "name": "？？？",
  "message": "「猜猜我是谁～？」"
 },
 {
  "name": "槐",
  "message": "<s30>「哇啊！」</s>"
 },
 {
  "message": "视线突然被遮了个严实。"
 },
 {
  "name": "槐",
  "message": "「谁、谁、谁、谁啊？！」"
 },
 {
  "name": "水仙",
  "message": "「哈哈，真是的，哥哥你也太胆小了，抱歉抱歉，吓到你了没」"
 },
 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "message": "我记得她是……水仙。"
 },
 {
  "message": "是夏学长的妹妹来着。"
 },
 {
  "name": "槐",
  "message": "（她怎么会大晚上出现在这种地方？）"
 },
 {
  "message": "难不成只是凑巧碰上了？"
 },
 {
  "name": "水仙",
  "message": "「话说回来，哥哥你这是怎么了？大晚上的居然在外面晃悠，太阳打西边出来啦？」"
 },
 {
  "name": "槐",
  "message": "「那、那个……」"
 },
 {
  "name": "水仙",
  "message": "「呵呵，逗你玩的啦，我都清楚，你是从华淡房间里出来的，我可都看在眼里呢」"
 },
 {
  "name": "槐",
  "message": "「……哈？」"
 },
 {
  "name": "水仙",
  "message": "「最近，你经常往她的房间跑呢」"
 },
 {
  "name": "槐",
  "message": "「……看在眼里？什么意思？」"
 },
 {
  "name": "水仙",
  "message": "「……欸？字面意思啊，就跟平时一样」"
 },
 {
  "message": "莫名其妙的。"
 },
 {
  "message": "她说，看见夏学长在人家的房间里。"
 },
 {
  "message": "可她到底是从哪看见的？又是为什么？"
 },
 {
  "name": "槐",
  "message": "「你是从哪看到的」"
 },
 {
  "name": "水仙",
  "message": "「……？你不是知道吗，就是公园旁边那个空房间呀，从那里看，正好能透过窗户看见哥哥的睡脸」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "难不成，她——"
 },
 {
  "name": "槐",
  "message": "（是个重度病娇跟踪狂妹妹吗？！）"
 },
 {
  "message": "连亲哥都监视，也太离谱了吧。"
 },
 {
  "name": "槐",
  "message": "「阿巴阿巴」"
 },
 {
  "message": "这下我该如何是好啊。"
 },
 {
  "name": "水仙",
  "message": "「所以呢，哥哥你干嘛去，大晚上还往外跑」"
 },
 {
  "name": "槐",
  "message": "「欸、欸欸……去便利店买点东西」"
 },
 {
  "name": "水仙",
  "message": "「啊，这样呀」"
 },
 {
  "message": "她噗嗤一声笑了出来。"
 },
 {
  "name": "水仙",
  "message": "「水水也要去～♪」"
 },
 {
  "message": "她像是在撒娇，顺势搂住了我的胳膊。"
 },
 {
  "name": "槐",
  "message": "「……什？！」"
 },
 {
  "name": "水仙",
  "message": "「……？」"
 },
 {
  "message": "她抱住了人家的手臂，动作那叫一个自然。"
 },
 {
  "name": "槐",
  "message": "（难不成，他们平时经常这样？！）"
 },
 {
  "message": "原来如此。"
 },
 {
  "message": "不，虽说之前就觉得这对兄妹感情挺好的……"
 },
 {
  "name": "槐",
  "message": "（可这也太……亲昵了吧……？）"
 },
 {
  "message": "莫名有点焦虑。"
 },
 {
  "name": "水仙",
  "message": "「欸嘿嘿～走啦，哥哥！」"
 },
 {
  "name": "槐",
  "message": "（……但是好可爱啊）"
 },
 {
  "message": "虽然心里堵得慌，但看在她这么可爱的份上，就先不计较了。"
 },
 {
  "name": "水仙",
  "message": "「呐，难得出来，我们去散散步嘛」"
 },
 {
  "name": "槐",
  "message": "「欸？好吧……」"
 },
 {
  "name": "水仙",
  "message": "「好耶～」"
 },
 {
  "message": "能有这么个可爱的妹妹，真是让人羡慕。"
 },
 {
  "name": "槐",
  "message": "（就没什么办法，把她变成人家的妹妹吗？）"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "我差点就自爆了。"
 },
 {
  "name": "水仙",
  "message": "「～♪」"
 },
 {
  "message": "我们肩并肩，在空旷的英国街散步。"
 },
 {
  "name": "槐",
  "message": "（不过，夏学长和他妹妹的关系，感觉还真是挺迷的呢）"
 },
 {
  "message": "明明是亲兄妹，干嘛要分开住呢？"
 },
 {
  "message": "听说夏学长原本是住在东京长城那边的。"
 },
 {
  "message": "我还默认他老家也在那边呢……"
 },
 {
  "name": "水仙",
  "message": "「啊，对了，听说大哥的伤，好得比预想中要快呢」"
 },
 {
  "name": "槐",
  "message": "「这样啊」"
 },
 {
  "message": "……大哥？"
 },
 {
  "name": "槐",
  "message": "（夏学长居然还有个哥哥？）"
 },
 {
  "message": "说起来，好像从来没听他提过家里的事。"
 },
 {
  "name": "水仙",
  "message": "「可逗了，大哥明明身子骨还动弹不得」"
 },
 {
  "name": "水仙",
  "message": "「结果水水一过去，他就气得直冒火，还想拿花瓶砸人呢」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "水仙",
  "message": "「……？怎么了？」"
 },
 {
  "name": "槐",
  "message": "「没、没什么」"
 },
 {
  "message": "夏学长的哥哥，究竟是个什么样的人呢。"
 },
 {
  "message": "为什么会动弹不得，又干嘛要扔花瓶。"
 },
 {
  "message": "这也太迷了吧。"
 },
 {
  "name": "水仙",
  "message": "「啊，对了～！哥哥你啊～！」"
 },
 {
  "name": "水仙",
  "message": "「最近是不是老是窝在华淡屋里不出来呀？」"
 },
 {
  "name": "槐",
  "message": "「……欸」"
 },
 {
  "name": "水仙",
  "message": "「嘛～水水我早就看出来了，哥哥你就喜欢那样的吧？」"
 },
 {
  "name": "槐",
  "message": "「……欸」"
 },
 {
  "name": "槐",
  "message": "「是、是吗，那么明显？」"
 },
 {
  "name": "水仙",
  "message": "「……？欸，嗯，哥哥不是就喜欢那种，有点点爱玩的女孩子吗？」"
 },
 {
  "name": "槐",
  "message": "「哪有」"
 },
 {
  "name": "水仙",
  "message": "「就是那种对宅宅很温柔的辣妹？」"
 },
 {
  "name": "槐",
  "message": "「都什么啊」"
 },
 {
  "message": "人家到底被当成什么人了啊。"
 },
 {
  "name": "水仙",
  "message": "「嘛～毕竟哥哥心思太重，我觉得那样的女生最适合你」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「那个……你觉得可以吗，我是说……我跟女孩子交往的话」"
 },
 {
  "message": "人家刚试着问出口，她的眼睛就亮了起来。"
 },
 {
  "name": "水仙",
  "message": "「嗯，我觉得太可以了！！」"
 },
 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "name": "水仙",
  "message": "「嗯，嗯……真的可以哦！呜哇……没想到哥哥竟然会说出这种话来」"
 },
 {
  "name": "槐",
  "message": "「是、是吗」"
 },
 {
  "name": "水仙",
  "message": "「……嗯」"
 },
 {
  "name": "水仙",
  "message": "「哥哥你啊……总是，从来都不顾自己呢」"
 },
 {
  "name": "槐",
  "message": "「欸……」"
 },
 {
  "name": "水仙",
  "message": "「一直在想水水的事啦，家里的事啦，什么使命啊……真理啊……」"
 },
 {
  "name": "槐",
  "message": "（使命……？真理……？）"
 },
 {
  "name": "水仙",
  "message": "「水水我一直都在想——」"
 },
 {
  "name": "水仙",
  "message": "「哥哥你大可多为自己做些事」"
 },
 {
  "message": "感觉她有点……想哭的样子，却又笑得那么开心。"
 },
 {
  "name": "槐",
  "message": "（啊啊……她……）"
 },
 {
  "name": "槐",
  "message": "（她真的很爱夏学长啊……）"
 },
 {
  "message": "我意识到了这一点。"
 },
 {
  "name": "水仙",
  "message": "「哥哥也差不多该离开妹妹了吧～」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "面对这沉甸甸的爱意，我一时间竟有些不知所措。"
 },
 {
  "name": "槐",
  "message": "（因、因为要问人家是不是真的……那么爱夏学长的话……）"
 },
 {
  "message": "那我确实在乎他。"
 },
 {
  "message": "简直是人家的理想型。"
 },
 {
  "name": "槐",
  "message": "（但是……这完全就是性欲在作祟吧？！）"
 },
 {
  "message": "看着夏学长在怀里那副害羞的样子，下面就硬得不行。"
 },
 {
  "message": "这、这也太肮脏了吧！！"
 },
 {
  "name": "槐",
  "message": "「……好、好耀眼……小水……」"
 },
 {
  "name": "水仙",
  "message": "「欸——哈哈，什么呀，这么突然」"
 },
 {
  "message": "水仙开心地笑着，望向我。"
 },
 {
  "name": "水仙",
  "message": "「要是哥哥能像普通人那样谈场恋爱」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "水仙",
  "message": "「普通地玩耍，普通地学习，最后普通地和某个人获得幸福的话」"
 },
 {
  "name": "水仙",
  "message": "「没有比这还让水水开心的事了」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "我不明白。"
 },
 {
  "name": "槐",
  "message": "（……为什么？）"
 },
 {
  "message": "为什么要对夏学长说这些话？"
 },
 {
  "message": "毕竟『普通地获得幸福』，明明就很普通啊，因为都说了普通了。"
 },
 {
  "name": "槐",
  "message": "（难道……夏学长并不『普通』？）"
 },
 {
  "message": "但我已经没有心思再继续追问下去了。"
 },
 {
  "message": "因为，我有点，害怕。"
 },
 {
  "name": "水仙",
  "message": "「啊，对了，还有一件事，大哥托我给你带个话」"
 },
 {
  "name": "槐",
  "message": "「嗯、嗯」"
 },
 {
  "name": "水仙",
  "message": "「那我直接说了啊……嗯，咳咳」"
 },
 {
  "name": "水仙",
  "message": "「他说『还是一样没长进，别指望还有下次，槐』……♪」"
 },
 {
  "name": "水仙",
  "message": "「啊哈哈，明明自己都动弹不得了，说话还真是够硬气的呢」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "（……槐？）"
 },
 {
  "message": "她确实是这么说了。"
 },
 {
  "message": "听起来，那是对夏学长的称呼。"
 },
 {
  "name": "槐",
  "message": "（难道是……家里人之间互相叫的某种昵称吗？）"
 },
 {
  "message": "我这样想了想。"
 },
 {
  "name": "槐",
  "message": "「我回来了」"
 },
 {
  "name": "华淡",
  "message": "「回来啦，去挺久啊」"
 },
 {
  "name": "槐",
  "message": "「……散步开心嘛」"
 },
 {
  "message": "华淡回来以后，我们又待了一会儿。"
 },
 {
  "message": "——时间差不多了，该睡觉了。"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "我在地上铺了张床单躺下，华淡则躺在床上。"
 },
 {
  "name": "槐",
  "message": "「不过这样挺奇怪的吧，毕竟现在，夏学长才是女孩子啊」"
 },
 {
  "name": "华淡",
  "message": "「……嘛，我明白你想说什么」"
 },
 {
  "name": "槐",
  "message": "「要换一下吗？」"
 },
 {
  "name": "华淡",
  "message": "「没关系，你睡床吧，我是那种在哪都能睡着的类型」"
 },
 {
  "message": "虽然表面上装得挺淡定，但怎么说呢，心跳得厉害。"
 },
 {
  "name": "华淡",
  "message": "（……和女孩子共处一室，果然还是会紧张啊）"
 },
 {
  "message": "不对，女孩子是我才对吧。"
 },
 {
  "name": "华淡",
  "message": "「那、那华淡，晚安」"
 },
 {
  "name": "槐",
  "message": "「欸」"
 },
 {
  "name": "华淡",
  "message": "「欸什么啊」"
 },
 {
  "name": "槐",
  "message": "「不打算熬个夜什么的吗？」"
 },
 {
  "name": "华淡",
  "message": "「……为啥要熬啊」"
 },
 {
  "name": "槐",
  "message": "「难得一起过夜嘛，来讲点鬼故事吧」"
 },
 {
  "name": "槐",
  "message": "「或者搞点恋爱八卦」"
 },
 {
  "name": "华淡",
  "message": "「……」"
 },
 {
  "message": "我明明紧张得要死，华淡却表现得跟没事人一样。"
 },
 {
  "message": "我忍不住笑了一下。"
 },
 {
  "name": "槐",
  "message": "「欸，你笑什么啊」"
 },
 {
  "name": "华淡",
  "message": "「……没什么，只是看你还是老样子，放心了」"
 },
 {
  "name": "槐",
  "message": "「放心？」"
 },
 {
  "name": "华淡",
  "message": "「毕竟是和男人一起过夜，你倒是放松得很啊」"
 },
 {
  "name": "华淡",
  "message": "「你不紧张就好」"
 },
 {
  "name": "槐",
  "message": "「……嗯——」"
 },
 {
  "name": "槐",
  "message": "「可是啊」"
 },
 {
  "message": "华淡从床上起身，走到我的枕边。"
 },
 {
  "name": "华淡",
  "message": "「……嘿」"
 },
 {
  "name": "槐",
  "message": "「现在弱势方，不是学长吗？」"
 },
 {
  "message": "华淡轻轻扣住我的双手，将我的身体压在地上。"
 },
 {
  "name": "华淡",
  "message": "「喵」"
 },
 {
  "name": "槐",
  "message": "「女孩子之所以害怕和男人过夜，就是因为比力气赢不过男的啊」"
 },
 {
  "name": "华淡",
  "message": "「华……华淡……」"
 },
 {
  "name": "槐",
  "message": "「你看？根本反抗不了吧」"
 },
 {
  "message": "我拼命活动胳膊，想要挣脱，却依旧被死死按在地上。"
 },
 {
  "name": "槐",
  "message": "「哈哈，学长害怕了？真可爱」"
 },
 {
  "name": "华淡",
  "message": "「不是……等等……！有些玩笑能开，有些不能开啊……！」"
 },
 {
  "name": "槐",
  "message": "「是你没搞清楚状况吧」"
 },
 {
  "name": "槐",
  "message": "「和男人睡同一个房间，还毫无防备的女孩子——」"
 },
 {
  "name": "槐",
  "message": "「就必须让她长点记性才行呢」"
 },
 {
  "name": "华淡",
  "message": "「……住……住手……！」"
 },
 {
  "message": "华淡突然用力抓住了我的胸。"
 },
 {
  "message": "瞬间，我只感觉全身麻酥酥的。"
 },
 {
  "name": "华淡",
  "message": "「～～～～」"
 },
 {
  "message": "我忍不住扑腾起双腿。"
 },
 {
  "message": "就在这瞬间，我的脚不小心碰到了一下华淡的下身。"
 },
 {
  "name": "槐",
  "message": "「！」"
 },
 {
  "message": "她的身体猛地颤抖起来。"
 },
 {
  "name": "华淡",
  "message": "「……欸？」"
 },
 {
  "name": "槐",
  "message": "「开、开玩笑的啦，啊——逗学长玩可真有意思」"
 },
 {
  "name": "华淡",
  "message": "「……啊、啊哈，也是，真是的……我知道了，原谅我吧」"
 },
 {
  "name": "槐",
  "message": "「……那，该睡了吧？」"
 },
 {
  "name": "华淡",
  "message": "「……嗯」"
 },
 {
  "message": "——刚才，华淡，该不会是……勃起了吧？"
 },
 {
  "message": "总觉得刚才好像碰到了什么硬邦邦的东西。"
 },
 {
  "name": "华淡",
  "message": "「～～～」"
 },
 {
  "message": "真是羞耻得要死。"
 },
 {
  "name": "华淡",
  "message": "（因为刚才，那里，玩真的啊！）"
 },
