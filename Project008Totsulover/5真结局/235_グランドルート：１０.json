[
 {
  "message": "那是一个安逸的午后。"
 },
 {
  "message": "要想散步，这是再好不过的天气。我们却面对面，正襟跪坐着。"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「是么」"
 },
 {
  "name": "槐",
  "message": "「嗯」"
 },
 {
  "name": "桧木",
  "message": "「……是么」"
 },
 {
  "message": "老爸闭上眼睛喝了口茶，随即茫然地望向窗外。"
 },
 {
  "name": "槐",
  "message": "「马修，守墓教团，老哥，还有学生会……大家都会助我一臂之力」"
 },
 {
  "name": "槐",
  "message": "「所以，你要不要也在我身上赌一把」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「老爸，你的目的，是想利用黑列车穿越时间，回到过去吧」"
 },
 {
  "name": "槐",
  "message": "「人虽然无法完全控制黑列车，但应该能将其活动记录下来」"
 },
 {
  "name": "槐",
  "message": "「只要借助大狱系统的力量，我肯定能做到」"
 },
 {
  "name": "桧木",
  "message": "「你打算造什么时光机么」"
 },
 {
  "name": "槐",
  "message": "「没错，哪怕要花上几十年，甚至上百年」"
 },
 {
  "name": "槐",
  "message": "「我一定会找到方法」"
 },
 {
  "name": "槐",
  "message": "「以崩月槐之名」"
 },
 {
  "name": "桧木",
  "message": "「……你让我信这个？」"
 },
 {
  "name": "槐",
  "message": "「没错」"
 },
 {
  "name": "桧木",
  "message": "「这种，荒谬绝伦的梦话？」"
 },
 {
  "name": "槐",
  "message": "「没错」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「你这人虽然乱来，但好歹也是个懂得权衡利弊的男人吧」"
 },
 {
  "name": "槐",
  "message": "「与学院，老哥以及大狱为敌，你觉得胜算有多大？」"
 },
 {
  "name": "槐",
  "message": "「退一万步讲，即便你夺得了黑列车的力量，也几乎没可能掌控它吧？」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「这，本就是一条修罗之路」"
 },
 {
  "name": "槐",
  "message": "「嗯，所以」"
 },
 {
  "name": "槐",
  "message": "「接下来的路，由我来走」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「你走过的修罗之路，我会继承。前方的路，我会亲手铺就」"
 },
 {
  "name": "槐",
  "message": "「所以啊，老爸你就颤颤巍巍地跟在我后面吧……毕竟，你已经老了」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「就让我尽尽孝心吧」"
 },
 {
  "name": "桧木",
  "message": "「……为什么？」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "桧木",
  "message": "「为什么你要这么做？」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「明明这与你毫无关系」"
 },
 {
  "name": "槐",
  "message": "「……我可是崩月家的老二，你的儿子啊」"
 },
 {
  "name": "槐",
  "message": "「造时光机，想想就让人热血沸腾啊」"
 },
 {
  "name": "桧木",
  "message": "「……！」"
 },
 {
  "name": "槐",
  "message": "「我，可是魔术师」"
 },
 {
  "name": "槐",
  "message": "「……现在，也依旧是」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「你，需要我的力量吗」"
 },
 {
  "name": "槐",
  "message": "「嗯」"
 },
 {
  "name": "桧木",
  "message": "「既然如此，为什么不带同伴来？又为什么，要一个人到这里来」"
 },
 {
  "name": "槐",
  "message": "「因为」"
 },
 {
  "name": "槐",
  "message": "「就像荒野中的孤狮，无法把自己的死归咎于任何人」"
 },
 {
  "name": "槐",
  "message": "「我带着孤身一人与整个世界为敌的觉悟，来到了这里」"
 },
 {
  "name": "槐",
  "message": "「你，就是这样的男人吧」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「我也是，一个人」"
 },
 {
  "name": "槐",
  "message": "「虽然我幸运地拥有了许多朋友和同伴，但即便如此，我……也是一个男人」"
 },
 {
  "name": "槐",
  "message": "「所以，我才会一个人来」"
 },
 {
  "name": "桧木",
  "message": "「……呵」"
 },
 {
  "message": "老爸笑了起来，直直地看着我。"
 },
 {
  "name": "桧木",
  "message": "「——你长大了」"
 },
 {
  "name": "槐",
  "message": "「……嗯」"
 },
 {
  "name": "桧木",
  "message": "「你长大了啊」"
 },
 {
  "name": "槐",
  "message": "「……是啊」"
 },
 {
  "name": "桧木",
  "message": "「……」"
 },
 {
  "name": "桧木",
  "message": "「我也该，前进了，吗」"
 },
 {
  "name": "槐",
  "message": "「是啊」"
 },
 {
  "name": "桧木",
  "message": "「……是吗」"
 },
 {
  "name": "桧木",
  "message": "「……是吗」"
 },
 {
  "message": "在那之后，我们零零散散地聊了许多事。"
 },
 {
  "message": "聊了聊朋友，也聊了聊过去。"
 },
 {
  "message": "看起来，就像是寻常人家在聊家常。"
 }
]