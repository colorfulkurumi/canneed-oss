[
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "回到房间，放下东西。"
 },
 {
  "name": "樱",
  "message": "（吃得，好饱）"
 },
 {
  "message": "那家拉面确实挺好吃的。"
 },
 {
  "message": "不过对我来说，分量稍微有点多。"
 },
 {
  "message": "下次去的时候，也许可以点个小份。"
 },
 {
  "name": "樱",
  "message": "（下次……去吃的时候……）"
 },
 {
  "message": "下次一个人去吗，不过，我不习惯在外面吃饭。"
 },
 {
  "message": "在我看来，吃东西能填饱肚子就行了，营养搭配什么的也没注意过。"
 },
 {
  "name": "樱",
  "message": "（可是，今天的晚饭……）"
 },
 {
  "message": "很好吃。"
 },
 {
  "message": "非常，非常，好吃。"
 },
 {
  "name": "樱",
  "message": "（说起来，之前和大家一起吃的那顿，也很好吃……）"
 },
 {
  "message": "我从包里，拿出了刚才的那张CD。"
 },
 {
  "message": "纸质的封套，廉价的印刷，一看就是手工做的。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "我目不转睛地盯着封套的背面。"
 },
 {
  "name": "樱",
  "message": "（……原来我，很开心啊）"
 },
 {
  "message": "毕竟此刻的我，还在这样恋恋不舍地嗅闻着记忆的余香。"
 },
 {
  "name": "樱",
  "message": "「N.a.v.i.」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『什么事，会长』"
 },
 {
  "message": "我对着指环手机叫了一声，N.a.v.i.立刻就出现了。"
 },
 {
  "name": "樱",
  "message": "「我今天，去了一趟游戏特区」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『是做什么调查吗？我还没有收到报告』"
 },
 {
  "name": "樱",
  "message": "「不，只是和铃宫一起去玩了而已」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『！您，去玩了』"
 },
 {
  "name": "樱",
  "message": "「我玩了抓娃娃机，第一次玩」"
 },
 {
  "name": "樱",
  "message": "「结果我和他都笨手笨脚的，一个也没抓到」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『需要我准备一些讲解抓娃娃技巧的视频或图片吗』"
 },
 {
  "name": "樱",
  "message": "「不用，没关系，然后呢」"
 },
 {
  "name": "樱",
  "message": "「我今天在港口那边看到，好像可以在游轮上吃午餐」"
 },
 {
  "name": "樱",
  "message": "「我想去一次，和大家一起」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『收到，需要预约吗？』"
 },
 {
  "name": "樱",
  "message": "「不用，没关系，还有啊」"
 },
 {
  "name": "樱",
  "message": "「我和铃宫……去吃了拉面」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『那个，会长』"
 },
 {
  "name": "樱",
  "message": "「嗯？」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『您不会是，把我当成深夜聊天对象了吧？』"
 },
 {
  "name": "樱",
  "message": "「不是」"
 },
 {
  "name": "樱",
  "message": "「只是，单纯想找人说说话」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『那不就是吗，会长』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『禁止将我用于作战以外的用途』"
 },
 {
  "name": "樱",
  "message": "「聊的这些可比作战重要多了」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『不对』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『提议，既然您和铃宫同学玩得那么愉快』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『直接给他打电话不就可以吗？』"
 },
 {
  "name": "樱",
  "message": "「！为什么」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『根据推算，他大概率会感到高兴』"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「为什么」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『我是AI，掌控学院所有通话记录』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『这只是基于统计数据得出的结论而已』"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「既然你都这么说了，那就打吧」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『我觉得这种直接正是会长的优良美德』"
 },
 {
  "message": "我拨通了铃宫的电话。"
 },
 {
  "name": "N.a.v.i.",
  "message": "『那么我先告退了』"
 },
 {
  "name": "樱",
  "message": "「先别走」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……为什么？』"
 },
 {
  "name": "樱",
  "message": "「我有点担心」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『会长，将我用于私人目的——』"
 },
 {
  "name": "槐",
  "message": "『喂，学姐？找我有事吗？』"
 },
 {
  "name": "樱",
  "message": "「……接通了」"
 },
 {
  "name": "樱",
  "message": "「是N.a.v.i.让我打的，她说让我给你打个电话」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『会长，您这也省略得太多了吧』"
 },
 {
  "name": "槐",
  "message": "『……N.a.v.i.？？为什么？？』"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「详细就不说了」"
 },
 {
  "name": "槐",
  "message": "『不说吗』"
 },
 {
  "name": "樱",
  "message": "「那个……怎么说呢……嗯」"
 },
 {
  "name": "樱",
  "message": "「……我，今天很开心」"
 },
 {
  "name": "樱",
  "message": "「我只是想告诉你这些」"
 },
 {
  "name": "槐",
  "message": "『！』"
 },
 {
  "name": "樱",
  "message": "「……抱歉，是不是很莫名其妙」"
 },
 {
  "name": "樱",
  "message": "「不过，是N.a.v.i.叫我打的」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『请不要把责任推到AI头上』"
 },
 {
  "name": "槐",
  "message": "『啊，不……我很高兴』"
 },
 {
  "name": "樱",
  "message": "「是吗？」"
 },
 {
  "name": "槐",
  "message": "『我也……特别开心』"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "听到他这么说，我松了一口气，心里也变得暖暖的。"
 },
 {
  "message": "他会不会因为我说的话，和我有同样的感觉呢。"
 },
 {
  "name": "樱",
  "message": "（那么，打电话给他真是太好了）"
 },
 {
  "name": "樱",
  "message": "「那就这样吧，占用你的时间，抱歉。我就是想说这些，明天见」"
 },
 {
  "name": "槐",
  "message": "『等等？！欸——』"
 },
 {
  "message": "我挂断了电话。"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……』"
 },
 {
  "name": "樱",
  "message": "「谢谢你，N.a.v.i.，你果然很优秀」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『他刚才，似乎还想再多聊一会儿呢？』"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「那我再打一次」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『我建议您还是别这么做为好』"
 },
 {
  "name": "樱",
  "message": "「……N.a.v.i.，你总是强人所难」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『与他的交流对您而言，似乎有着非同一般的意义呢……』"
 },
 {
  "name": "槐",
  "message": "「这到底，搞什么啊……」"
 },
 {
  "message": "这通电话莫名其妙的，她是不是……很想找我说话？"
 },
 {
  "message": "要真是这样的话……那……"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "不管怎样，这至少说明我已经赢得了她的信任。"
 },
 {
  "name": "槐",
  "message": "（她现在，说不定……会露出破绽？）"
 },
 {
  "message": "今天和她在一起时，我感受到了她对我抱有类似好感的东西。"
 },
 {
  "message": "不管是身为朋友还是同伴，她是想和我待在一起的。"
 },
 {
  "name": "槐",
  "message": "（不……这些……）"
 },
 {
  "name": "槐",
  "message": "（其实……早在……很久之前……）"
 },
 {
  "message": "从很久以前开始，她就一直在保护我。"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "该下定决心了。"
 },
 {
  "message": "只能豁出去了。"
 },
 {
  "message": "事到如今，已经没有退路了。"
 },
 {
  "name": "槐",
  "message": "「把……夜乃樱……」"
 },
 {
  "name": "槐",
  "message": "「……杀掉」"
 }
]