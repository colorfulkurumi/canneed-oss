[
 {
  "message": "——夜晚的游戏特区，简直是欲望丛生的温床。"
 },
 {
  "name": "樱",
  "message": "「好厉害，都已经这么晚了，这里还是这么热闹」"
 },
 {
  "name": "槐",
  "message": "「哦——！学姐你看，那边有人在街头弹唱呢」"
 },
 {
  "name": "樱",
  "message": "「……这旋律，真美」"
 },
 {
  "name": "槐",
  "message": "「学姐，你平时会听歌吗？」"
 },
 {
  "name": "樱",
  "message": "「……从来不听」"
 },
 {
  "name": "槐",
  "message": "「我也是，咱们过去瞧瞧吧」"
 },
 {
  "message": "我们两人并肩挤进了围观的人群中。"
 },
 {
  "name": "音乐人",
  "message": "「各位，请听」"
 },
 {
  "message": "男人不紧不慢地说着，指尖在琴弦上拨动，那流畅自如的动作，即便是我这个门外汉看了也觉得精彩绝伦。"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "message": "或许是因为现场演奏吧，那股冲击力简直扑面而来。"
 },
 {
  "message": "男人那略带沙哑的嗓音，仿佛从灵魂深处迸发出来。"
 },
 {
  "name": "槐",
  "message": "（……他，是把灵魂都融进旋律里了啊）"
 },
 {
  "message": "这绝对是我无法企及的境界。"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "我有点担心夜乃学姐会觉得无聊，便下意识地用余光偷瞄了她的侧脸。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "她的眼睛扑闪扑闪，静静地凝视着乐手。"
 },
 {
  "message": "那纯粹的目光，就像一只在夜色中仰望月亮的猫。"
 },
 {
  "name": "槐",
  "message": "（……）"
 },
 {
  "message": "胸口深处，莫名地感到一阵细微的刺痛。"
 },
 {
  "name": "音乐人",
  "message": "「多谢捧场——！」"
 },
 {
  "message": "大汗淋漓的男人结束了演奏，对着观众深深地鞠了一躬。"
 },
 {
  "name": "音乐人",
  "message": "「这里有我自己灌录的CD！下周我还有场Live，请大家多多捧场！」"
 },
 {
  "name": "槐",
  "message": "「CD啊！我倒真想买一张」"
 },
 {
  "name": "樱",
  "message": "「嗯」"
 },
 {
  "name": "槐",
  "message": "「不过学姐，你家里有能放CD的机器吗？」"
 },
 {
  "name": "樱",
  "message": "「……没有」"
 },
 {
  "name": "槐",
  "message": "「那下次，我陪你一起去买吧」"
 },
 {
  "name": "樱",
  "message": "「……！嗯」"
 },
 {
  "message": "我们相视一笑，我便从兜里掏出一张五十大钞，朝那名音乐人走去。"
 },
 {
  "name": "槐",
  "message": "「我要一张」"
 },
 {
  "name": "音乐人",
  "message": "「！谢了！」"
 },
 {
  "message": "我递过那张崭新的纸币，他赶忙伸出双手，郑重地接了过去。"
 },
 {
  "name": "音乐人",
  "message": "「太感谢了！」"
 },
 {
  "name": "槐",
  "message": "「……那个，我会支持你的」"
 },
 {
  "name": "音乐人",
  "message": "「大哥，你是怎么知道我的？」"
 },
 {
  "name": "槐",
  "message": "「啊，不是，刚才跟学姐散步时，偶然听到」"
 },
 {
  "name": "槐",
  "message": "「我对音乐其实一窍不通，也谈不上了解……但刚才听了，真的觉得特别棒」"
 },
 {
  "name": "音乐人",
  "message": "「……」"
 },
 {
  "name": "音乐人",
  "message": "「谢了！」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "音乐人",
  "message": "「没比这更高兴的事了」"
 },
 {
  "name": "音乐人",
  "message": "「不管是素不相识的路人，还是不懂音乐的外行」"
 },
 {
  "name": "音乐人",
  "message": "「要是我的音乐没法打动他们，可没法登顶啊！」"
 },
 {
  "name": "槐",
  "message": "「登顶？」"
 },
 {
  "name": "音乐人",
  "message": "「没错！我，可是要站在顶峰的人！」"
 },
 {
  "name": "音乐人",
  "message": "「等到那天，您可要拿今天的事去炫耀啊！」"
 },
 {
  "name": "槐",
  "message": "「……好」"
 },
 {
  "message": "见他很快又被人群簇拥起来，我便悄悄从他身边离开了。"
 },
 {
  "name": "樱",
  "message": "「……他，好厉害」"
 },
 {
  "name": "槐",
  "message": "「他说他的目标是顶峰」"
 },
 {
  "name": "槐",
  "message": "「学姐，你有过这样的念头吗？」"
 },
 {
  "name": "樱",
  "message": "「……没有」"
 },
 {
  "message": "并非受谁所迫，也无关使命。"
 },
 {
  "message": "只是在自己选定的道路上，一往无前地走下去。"
 },
 {
  "message": "直到抵达那遥不可及的终点吗。"
 },
 {
  "name": "槐",
  "message": "「……真是帅得没边啊」"
 },
 {
  "name": "樱",
  "message": "「你想成为那样的人吗？」"
 },
 {
  "name": "槐",
  "message": "「谁知道呢，成不成为的，光靠想就能实现吗」"
 },
 {
  "name": "樱",
  "message": "「你的话，一定可以的」"
 },
 {
  "name": "槐",
  "message": "「呵呵，是吗？依据呢」"
 },
 {
  "name": "樱",
  "message": "「没有，只是觉得，应该这么说」"
 },
 {
  "message": "她果然是个不擅长说场面话的人。但我偏偏就喜欢她这点。"
 },
 {
  "name": "槐",
  "message": "「学姐将来，有什么想做的事吗？」"
 },
 {
  "name": "樱",
  "message": "「毕业后，我会进入学院任职，目前只确定了这一件事」"
 },
 {
  "name": "槐",
  "message": "「这是学姐……想做的事吗？」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「但我觉得，这是最好的选择」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「铃宫呢？你有什么对未来的梦想吗」"
 },
 {
  "name": "槐",
  "message": "「啊……」"
 },
 {
  "message": "说实话的话，感觉就像鹦鹉学舌一样。"
 },
 {
  "message": "我是崩月家的老二，大概会当一辈子魔术师吧。"
 },
 {
  "message": "不是想不想做的问题，是我根本没得选。"
 },
 {
  "message": "不过要是把这些都撇开，做什么都行的话……"
 },
 {
  "name": "槐",
  "message": "「……我做什么都可以」"
 },
 {
  "name": "樱",
  "message": "「嗯」"
 },
 {
  "name": "槐",
  "message": "「能像现在这样，和大家待在一起……就很开心了」"
 },
 {
  "name": "樱",
  "message": "「大家？」"
 },
 {
  "name": "槐",
  "message": "「羽鸟啊，华淡啊，兰开斯特啊」"
 },
 {
  "name": "槐",
  "message": "「当然，还有夜乃学姐」"
 },
 {
  "name": "樱",
  "message": "「！」"
 },
 {
  "name": "槐",
  "message": "「……最近，我偶尔会想」"
 },
 {
  "name": "槐",
  "message": "「要是时间能就这么停下来就好了——」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「要我借你吗？直视瓦砾」"
 },
 {
  "name": "槐",
  "message": "「不用了不用了！我指的不是那种物理意义上的停下！」"
 },
 {
  "name": "樱",
  "message": "「看出来了，呵呵」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「怎么了？」"
 },
 {
  "name": "槐",
  "message": "「没想到夜乃学姐也会开玩笑啊」"
 },
 {
  "name": "樱",
  "message": "「……看出来了？我，稍微努力了一下」"
 },
 {
  "name": "槐",
  "message": "「很成功，而且……」"
 },
 {
  "name": "樱",
  "message": "「……？」"
 },
 {
  "name": "槐",
  "message": "「学姐笑起来，真的好美啊」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "不对，等等，我刚才……说了什么？"
 },
 {
  "message": "我是不是说了什么超级直白，不过脑子的话？"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "看吧，夜乃学姐都被我弄得不知所措，愣在那儿了！"
 },
 {
  "name": "槐",
  "message": "「不、不、不，对不起！！刚才那个，怎么说呢，就当是我开个玩笑」"
 },
 {
  "name": "樱",
  "message": "「……欸」"
 },
 {
  "name": "槐",
  "message": "「欸」"
 },
 {
  "name": "樱",
  "message": "「玩笑……吗……？」"
 },
 {
  "message": "那双眼睛里带着悲伤，哀求般看向我。"
 },
 {
  "name": "槐",
  "message": "「不、不、不……不是……玩笑……」"
 },
 {
  "name": "樱",
  "message": "「到底是不是」"
 },
 {
  "name": "槐",
  "message": "「不是……玩笑……」"
 },
 {
  "name": "樱",
  "message": "「那你为什么说是玩笑」"
 },
 {
  "name": "槐",
  "message": "「那个……因为」"
 },
 {
  "name": "槐",
  "message": "「只是不小心把实话说出来了，所以想着赶紧掩饰一下……」"
 },
 {
  "name": "樱",
  "message": "「……实话」"
 },
 {
  "name": "槐",
  "message": "「……是」"
 },
 {
  "name": "樱",
  "message": "「这样啊」"
 },
 {
  "message": "不是，那个，我是说……"
 },
 {
  "name": "槐",
  "message": "「……抱歉，突然说了些莫名其妙的话」"
 },
 {
  "name": "樱",
  "message": "「没关系，反正你平时也总是奇奇怪怪的」"
 },
 {
  "name": "槐",
  "message": "「喂喂」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "夜乃学姐百无聊赖地把脸别了过去。"
 },
 {
  "name": "槐",
  "message": "（……啊）"
 },
 {
  "message": "可她的脸颊上，却浮着一层淡淡的红晕。"
 },
 {
  "message": "夜空深处，隐隐透出一弯月色。"
 },
 {
  "message": "不仅如此。"
 },
 {
  "message": "漆黑静谧的海面上，倒映着金黄的月光。"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "我们谁也没说话，走在深夜的街道上。"
 },
 {
  "message": "明明打算去游戏特区玩的。"
 },
 {
  "message": "也许，就这么并肩走着，就已经足够让人舒心了。"
 },
 {
  "name": "槐",
  "message": "（真是不可思议）"
 },
 {
  "name": "槐",
  "message": "（就算彼此什么都不说，也不会觉得尴尬）"
 },
 {
  "message": "只是，单纯地，感觉很自在。"
 },
 {
  "name": "樱",
  "message": "「……那个……就是……」"
 },
 {
  "name": "樱",
  "message": "「……铃宫，你有什么兴趣爱好吗？」"
 },
 {
  "message": "原来只有我一个人在享受沉默，夜乃学姐已经显得有些待不住了。"
 },
 {
  "name": "槐",
  "message": "「没，所以晚上回了家，也总是闲得发慌」"
 },
 {
  "name": "樱",
  "message": "「！我懂」"
 },
 {
  "name": "槐",
  "message": "「……所以你回了家，也还是在埋头处理那些文件吧」"
 },
 {
  "name": "樱",
  "message": "「！你怎么知道的」"
 },
 {
  "name": "槐",
  "message": "「搜集委员会的学长学姐告诉我的」"
 },
 {
  "name": "槐",
  "message": "「说夜乃学姐老是二话不说，就把各个委员会的活全揽到自己身上」"
 },
 {
  "name": "槐",
  "message": "「搞得他们手头没活干，正愁得慌呢」"
 },
 {
  "name": "樱",
  "message": "「……（移开视线）」"
 },
 {
  "name": "槐",
  "message": "「……时不时还会混进几份，让人怀疑这真归学生会管吗的文件」"
 },
 {
  "name": "樱",
  "message": "「嗯，所以」"
 },
 {
  "name": "樱",
  "message": "「让大家陪我一起，总觉得过意不去」"
 },
 {
  "name": "槐",
  "message": "「所以你才一个人干啊……」"
 },
 {
  "message": "该说她单纯呢，还是难搞呢。"
 },
 {
  "name": "槐",
  "message": "「那以后，咱们这两个闲人……」"
 },
 {
  "name": "槐",
  "message": "「要不偶尔像现在这样，放学后出来逛逛？」"
 },
 {
  "name": "樱",
  "message": "「欸？」"
 },
 {
  "name": "槐",
  "message": "「……你不方便就算了」"
 },
 {
  "name": "樱",
  "message": "「我怎么可能，不方便」"
 },
 {
  "name": "槐",
  "message": "「那，我会很开心的」"
 },
 {
  "name": "樱",
  "message": "「铃宫你……不嫌弃吗」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "樱",
  "message": "「跟我待在一起，肯定不好玩吧」"
 },
 {
  "name": "槐",
  "message": "「我开心得不得了啊」"
 },
 {
  "name": "樱",
  "message": "「骗人」"
 },
 {
  "name": "槐",
  "message": "「是真的，要我证明给你看吗？」"
 },
 {
  "name": "樱",
  "message": "「怎么证明？」"
 },
 {
  "name": "槐",
  "message": "「……要不给你来段欢乐颂？」"
 },
 {
  "name": "樱",
  "message": "「……噗……什么跟什么啊」"
 },
 {
  "name": "槐",
  "message": "「……是真的啦」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「我和学姐待在一起的时候，真的很开心，不，与其说开心……不如说，舒服？」"
 },
 {
  "name": "槐",
  "message": "「只要和学姐说说话，感觉……心情就会变得很平静……」"
 },
 {
  "name": "槐",
  "message": "「只要看到学姐的笑容，我就觉得……心里特别，高兴」"
 },
 {
  "name": "樱",
  "message": "「什么嘛，好奇怪」"
 },
 {
  "name": "槐",
  "message": "「也是啊……可能是有点奇怪」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "一阵惬意的夜风从我们两人之间穿行而过。"
 },
 {
  "name": "樱",
  "message": "「姑且问一下」"
 },
 {
  "name": "槐",
  "message": "「嗯」"
 },
 {
  "name": "樱",
  "message": "「你、你该不会是在撩我吧」"
 },
 {
  "name": "槐",
  "message": "「欸欸？！不是啊？！」"
 },
 {
  "name": "樱",
  "message": "「那、那就好」"
 },
 {
  "name": "槐",
  "message": "「……不，我也真是……净说些莫名其妙的话，抱歉」"
 },
 {
  "name": "樱",
  "message": "「没事，没关系」"
 },
 {
  "name": "樱",
  "message": "「没什么，我也……很高兴」"
 },
 {
  "message": "她很高兴啊。"
 },
 {
  "message": "这样啊。"
 },
 {
  "name": "樱",
  "message": "「我也……偶尔想这样一起出来玩」"
 },
 {
  "name": "槐",
  "message": "「这不是客套话吧」"
 },
 {
  "name": "樱",
  "message": "「是、是真的」"
 },
 {
  "name": "樱",
  "message": "「和你待在一起，很开心」"
 },
 {
  "message": "是吗，我好开心，超级开心。"
 },
 {
  "message": "坏了，真的太开心了，嘴角都压不住了。"
 },
 {
  "name": "槐",
  "message": "（……先取得夜乃学姐的信任，尽量多争取些能待在一起的时间）"
 },
 {
  "name": "槐",
  "message": "（按照作战计划，这个方向应该没错）"
 },
 {
  "message": "应该……是吧……？"
 },
 {
  "message": "肯定是的。"
 },
 {
  "message": "我拼命把目光移向别处，不去关注自己的内心——只是望着她，还有那轮倒映在海面上的月亮。"
 }
]