[
 {
  "name": "槐",
  "message": "「……夜乃，学姐……我……要去自首」"
 },
 {
  "message": "不知道过了多久，外面早已是一片漆黑。"
 },
 {
  "message": "在昏暗的房间里，只有她那头美丽的白发，显得格外明亮。"
 },
 {
  "name": "樱",
  "message": "「这样啊……为什么？」"
 },
 {
  "name": "槐",
  "message": "「……我骗了你们……还企图……伤害你」"
 },
 {
  "name": "樱",
  "message": "「可结果，你什么都没做」"
 },
 {
  "name": "槐",
  "message": "「但是，即便如此……！」"
 },
 {
  "name": "槐",
  "message": "「……我……必须……承担责任才行」"
 },
 {
  "name": "樱",
  "message": "「……『责任』？好蠢的词语」"
 },
 {
  "name": "樱",
  "message": "「明明根本不存在」"
 },
 {
  "name": "樱",
  "message": "「不过是那些擅长玩弄文字的人，用来束缚他人的东西罢了」"
 },
 {
  "name": "樱",
  "message": "「我对那种无聊的规矩，不感兴趣」"
 },
 {
  "name": "槐",
  "message": "「……可是，我……这样……我……」"
 },
 {
  "message": "我死命握住了拳头。"
 },
 {
  "name": "槐",
  "message": "「……这些日子……谢谢你们，我……会从你们面前消失的」"
 },
 {
  "name": "樱",
  "message": "「不行，我不允许你逃跑」"
 },
 {
  "name": "槐",
  "message": "「为什么……！」"
 },
 {
  "name": "樱",
  "message": "「因为，我喜欢你」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "樱",
  "message": "「要是你不见了，我会舍不得」"
 },
 {
  "name": "樱",
  "message": "「都想杀我了，就别再让我一个人了啊」"
 },
 {
  "name": "槐",
  "message": "「可是……我……这样……」"
 },
 {
  "name": "槐",
  "message": "「我不知道……该怎么……赎罪才好……」"
 },
 {
  "name": "樱",
  "message": "「赎罪……你想这么做吗？」"
 },
 {
  "message": "那当然想，如果可以的话。"
 },
 {
  "message": "因为，我。"
 },
 {
  "message": "我，也喜欢她啊。"
 },
 {
  "name": "槐",
  "message": "「……是的」"
 },
 {
  "name": "樱",
  "message": "「这样啊」"
 },
 {
  "name": "樱",
  "message": "「那就好好向我偿还吧」"
 },
 {
  "name": "樱",
  "message": "「不要跑去自首，借陌生人定的规矩来向我道歉」"
 },
 {
  "name": "樱",
  "message": "「也不要一走了之，装作什么都没发生过」"
 },
 {
  "name": "樱",
  "message": "「想杀我的事，必须好好向我偿还」"
 },
 {
  "name": "槐",
  "message": "「……我……该做什么才好，只要能做到，我什么都愿意做」"
 },
 {
  "name": "樱",
  "message": "「别说自己什么都愿意做，这可是……分量很重的话」"
 },
 {
  "name": "槐",
  "message": "「是……我什么都愿意做」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「你刚才说……希望，我能杀了你」"
 },
 {
  "name": "樱",
  "message": "「你现在还希望吗？」"
 },
 {
  "name": "槐",
  "message": "「……是，如果，你想的话」"
 },
 {
  "name": "樱",
  "message": "「这样啊」"
 },
 {
  "name": "樱",
  "message": "「——直视瓦砾」"
 },
 {
  "message": "那柄巨大的钉桩发射器，抵住了我的胸口。"
 },
 {
  "name": "樱",
  "message": "「只要现在发动B.E.G.，你的心脏就会停止跳动」"
 },
 {
  "name": "樱",
  "message": "「即便如此，你也无所谓吗？」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……是，请您……杀了我吧」"
 },
 {
  "name": "樱",
  "message": "「我明白了，那么」"
 },
 {
  "message": "冰冷的钉桩发射器，碰到了我的胸口。"
 },
 {
  "name": "樱",
  "message": "「——好了，你死了」"
 },
 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "name": "樱",
  "message": "「从这一刻起，你的命就不再属于你自己了」"
 },
 {
  "name": "樱",
  "message": "「而是属于我」"
 },
 {
  "name": "槐",
  "message": "「欸……」"
 },
 {
  "name": "樱",
  "message": "「今后，如果我下令让你去死，你就要立刻了结自己」"
 },
 {
  "name": "樱",
  "message": "「无论我想要什么，哪怕过程再艰难，你都必须做到」"
 },
 {
  "name": "樱",
  "message": "「你要成为我的所有物」"
 },
 {
  "name": "樱",
  "message": "「这样，我就原谅你……原谅你想杀掉我的罪过」"
 },
 {
  "name": "槐",
  "message": "「这……」"
 },
 {
  "name": "樱",
  "message": "「这无关同情，也不是爱情，这只是——交易」"
 },
 {
  "name": "樱",
  "message": "「……选吧？」"
 },
 {
  "message": "我根本不需要思考。"
 },
 {
  "message": "只要能得到她的宽恕，哪怕是获得一个赎罪的机会。"
 },
 {
  "name": "槐",
  "message": "「……是……当然，我的命，从现在起……就属于你了」"
 },
 {
  "name": "樱",
  "message": "「嗯，我知道了，那么，我也原谅你了」"
 },
 {
  "message": "她的嘴角，泛起了一抹浅浅的笑意。"
 },
 {
  "name": "樱",
  "message": "「那么，现在给你第一个命令，要是敢违抗，我绝不饶你」"
 },
 {
  "name": "槐",
  "message": "「……嗯……是什么」"
 },
 {
  "name": "樱",
  "message": "「不准再说杀了我这种话」"
 },
 {
  "name": "槐",
  "message": "「……欸」"
 },
 {
  "name": "樱",
  "message": "「无论发生什么，无论谁对你说什么」"
 },
 {
  "name": "樱",
  "message": "「诸如……死了也行，杀了我这种话，绝对不准再说出口」"
 },
 {
  "name": "樱",
  "message": "「无论身处怎样的痛苦与煎熬，哪怕背负着再深重的罪孽」"
 },
 {
  "name": "樱",
  "message": "「无论如何，都要活下去」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「这是我的第一个命令……听明白了吗？」"
 },
 {
  "name": "槐",
  "message": "「……是」"
 },
 {
  "name": "槐",
  "message": "「是……夜乃学姐……是……我……我……对不起……」"
 },
 {
  "name": "樱",
  "message": "「我不明白你为什么要道歉，我们之间，已经没有事需要道歉了」"
 },
 {
  "message": "明明，眼泪早该在刚才就流干了。"
 },
 {
  "name": "槐",
  "message": "「对不起……学姐……呜……对不起……对不起……」"
 },
 {
  "name": "樱",
  "message": "「……真没看出来，原来你……是个小哭包啊」"
 },
 {
  "message": "她温柔地抚弄着我的头发，安抚着哭得像个傻瓜一样的我。"
 },
 {
  "name": "槐",
  "message": "「……抱歉……我，就是……泪腺好像坏了一样」"
 },
 {
  "name": "樱",
  "message": "「呵呵，眼睛都红了」"
 },
 {
  "name": "樱",
  "message": "「……那么，差不多该睡了吧，天都这么晚了」"
 },
 {
  "name": "樱",
  "message": "「来，走吧，上床」"
 },
 {
  "name": "槐",
  "message": "「欸？！」"
 },
 {
  "name": "槐",
  "message": "「学姐，你刚刚差点在睡着的时候被杀掉，还睡得着吗」"
 },
 {
  "name": "樱",
  "message": "「……？嗯，可以啊」"
 },
 {
  "message": "虽然早有感觉，但她真是好气量啊。"
 },
 {
  "message": "或许从一开始，我就不是她的对手。"
 },
 {
  "name": "樱",
  "message": "「哈啊……困死了，快点来吧」"
 },
 {
  "name": "槐",
  "message": "「不、不是，我还在自责呢，现在有点……不，是相当手足无措啊」"
 },
 {
  "name": "樱",
  "message": "「这是命令，快过来」"
 },
 {
  "message": "既然她都这么说了，我也只能乖乖听从。"
 },
 {
  "message": "我在她身旁躺了下来。"
 },
 {
  "message": "等我回过神来，窗外的雨声已经停了。"
 },
 {
  "name": "樱",
  "message": "「……嗯……晚安，铃宫」"
 },
 {
  "name": "槐",
  "message": "「……晚、晚安」"
 },
 {
  "name": "槐",
  "message": "「我现在清醒得很，一点睡意都没有」"
 },
 {
  "name": "樱",
  "message": "「睡觉，这是命令」"
 },
 {
  "name": "槐",
  "message": "「……我睡了」"
 },
 {
  "message": "我只好硬逼着自己闭上眼睛。"
 },
 {
  "name": "樱",
  "message": "「……呼……呼……」"
 },
 {
  "message": "还没过几分钟，夜乃学姐就已经安然入睡了。"
 },
 {
  "message": "真是，和我完全不在一个层次啊。"
 },
 {
  "name": "槐",
  "message": "（今后，我……）"
 },
 {
  "name": "槐",
  "message": "（该作何选择，又该为什么而活下去呢）"
 },
 {
  "message": "我给不出答案。"
 },
 {
  "message": "要说一点都不害怕，那肯定是骗人的。"
 },
 {
  "message": "尽管如此。"
 },
 {
  "name": "槐",
  "message": "（……）"
 },
 {
  "message": "心里却涌起一阵说不清的轻松。"
 },
 {
  "message": "然后，还是没忍住，又悄悄落了几滴眼泪。"
 }
]