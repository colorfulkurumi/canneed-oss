 {
  "name": "槐",
  "message": "「没什么，只是，空调……稍微有点冷而已」"
 },
 {
  "name": "樱",
  "message": "「这样啊，那，你盖好被子吧」"
 },
 {
  "message": "她把被子拉到我的肩头。"
