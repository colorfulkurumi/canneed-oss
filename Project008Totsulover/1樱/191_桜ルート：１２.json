 {
  "name": "槐",
  "message": "「……欸？」"
 },
 {
  "name": "樱",
  "message": "「……其实……房间……还有好几间……可是……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「只是因为，我想和你待在一起……」"
