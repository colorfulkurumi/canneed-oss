 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "樱",
  "message": "「铃宫你，总在说谎呢」"
 },
 {
  "name": "槐",
  "message": "「我哪有……」"
 },
 {
  "message": "心脏，猛地揪紧了。"
 },
 {
  "name": "槐",
  "message": "「……我没说谎啊」"
 },
 {
  "name": "樱",
  "message": "「……欸？」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "樱",
  "message": "「为什么你会一副，快哭出来的表情呢」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "我才没有，怎么可能。"
