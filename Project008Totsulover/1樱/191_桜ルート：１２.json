[
 {
  "message": "我隔着透明的墙壁，看着他在床上缩成一团。"
 },
 {
  "name": "樱",
  "message": "（他是刻意不看我的身体吗）"
 },
 {
  "name": "樱",
  "message": "（其实，就算他看到也无所谓）"
 },
 {
  "message": "连我自己都觉得，这副身材拿不出手。"
 },
 {
  "message": "个子又矮，该凸的地方也平平的。"
 },
 {
  "message": "跟刚才电视里那个姐姐比起来，简直没法看。"
 },
 {
  "name": "樱",
  "message": "（可就算这样，铃宫还是夸我很漂亮）"
 },
 {
  "name": "樱",
  "message": "（既然觉得漂亮，就看啊）"
 },
 {
  "message": "肯定只是在骗人。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "就连现在，他也别过头去，不往这边看。"
 },
 {
  "message": "就在我这样想的时候。"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "铃宫在那一瞬间，朝我这边瞥了一眼。"
 },
 {
  "message": "视线，与我撞了个正着。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "我的视力有四点零，所以看得特别清楚。"
 },
 {
  "message": "他瞥见我赤身裸体的那一瞬，猛地涨红了脸，慌忙移开了视线。"
 },
 {
  "name": "樱",
  "message": "（明明想装出一副绅士的样子）"
 },
 {
  "name": "樱",
  "message": "（……结果还是没忍住，偷偷看了呢）"
 },
 {
  "message": "我感觉到了。"
 },
 {
  "message": "虽然我最不擅长看懂人心。"
 },
 {
  "message": "但那道视线深处，有像野兽一样，名为欲望的热浪。"
 },
 {
  "name": "樱",
  "message": "（……）"
 },
 {
  "name": "樱",
  "message": "（为什么……连我的身体也热起来了呢）"
 },
 {
  "message": "不止如此。"
 },
 {
  "message": "胸口深处，好像揪紧了。"
 },
 {
  "message": "真想让他继续用那种眼神看我。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "我，到底在做什么啊。"
 },
 {
  "message": "我把身体贴在冰冷的玻璃上，就那样一直望着他。"
 },
 {
  "name": "樱",
  "message": "「……哈啊……哈啊」"
 },
 {
  "message": "肌肤蹭着玻璃，发出吱的一声轻响。"
 },
 {
  "name": "樱",
  "message": "（要是他真的看了过来……会变成什么样呢？）"
 },
 {
  "message": "现在的我，表情肯定很怪吧。"
 },
 {
  "message": "呼吸急促，脸颊发烫，眼神大概也湿湿的。"
 },
 {
  "name": "樱",
  "message": "「……看我」"
 },
 {
  "message": "细小的呢喃，转眼就被淋浴的水声吞没。"
 },
 {
  "name": "樱",
  "message": "「……看我」"
 },
 {
  "message": "啊啊，我好像明白了。"
 },
 {
  "message": "我。"
 },
 {
  "name": "樱",
  "message": "（我想被他看着，用那……滚烫的目光）"
 },
 {
  "message": "毕竟，他说我很棒。"
 },
 {
  "message": "毕竟，他说我很漂亮。"
 },
 {
  "message": "所以，我希望他能向我证明。"
 },
 {
  "name": "樱",
  "message": "（毕竟，这里是情侣酒店嘛）"
 },
 {
  "name": "樱",
  "message": "（都到这样的地方来了）"
 },
 {
  "name": "樱",
  "message": "（就算……真的发生了什么意外，也没关系吧）"
 },
 {
  "message": "我绞尽脑汁想弄清原因，接着很快就察觉到了。"
 },
 {
  "name": "樱",
  "message": "（一定是从我脱掉他衣服，帮他擦身体的那一刻起）"
 },
 {
  "name": "樱",
  "message": "（我的视线，就再也无法从他身上移开了）"
 },
 {
  "message": "他也不擅长理解别人的心思，所以没有注意到。"
 },
 {
  "message": "身体……一直，一直好热。"
 },
 {
  "message": "我想起刚才电视里放的，那种色色的视频。"
 },
 {
  "message": "就算和他睡了，也没什么不好吧。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "为什么呢。"
 },
 {
  "message": "我不擅长思考，所以也弄不清这种感觉是从哪来的。"
 },
 {
  "name": "樱",
  "message": "「……哈啊……呼——」"
 },
 {
  "message": "只是，想被他弄得乱七八糟，想被他宽厚的身体压在下面。"
 },
 {
  "message": "被他欺负到失声，被彻底弄坏……"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "我想，我一定会很开心的。"
 },
 {
  "name": "樱",
  "message": "（我，是个坏学姐）"
 },
 {
  "name": "樱",
  "message": "（他明明那么努力，想装出一副绅士的样子）"
 },
 {
  "name": "樱",
  "message": "（我却像只发情的野兽一样，想着这些）"
 },
 {
  "message": "我得反省，必须马上停下来，可是……"
 },
 {
  "message": "我的指尖在墙壁上划出细微的声响，像是在渴求着什么。"
 },
 {
  "name": "樱",
  "message": "（如果他能回过头来）"
 },
 {
  "name": "樱",
  "message": "（进到这个浴室里来）"
 },
 {
  "name": "樱",
  "message": "（他会不会……把我紧紧地抱进怀里呢）"
 },
 {
  "message": "因为，我一直。"
 },
 {
  "message": "一直，一直……"
 },
 {
  "name": "樱",
  "message": "（都想……离你再近一点）"
 },
 {
  "message": "为什么呢。"
 },
 {
  "message": "真不可思议。"
 },
 {
  "message": "这就是所谓的恋爱，或者爱情吗。"
 },
 {
  "message": "虽然，感觉又有点不太一样。"
 },
 {
  "name": "樱",
  "message": "（只是，希望他能看看我）"
 },
 {
  "name": "樱",
  "message": "（看看我……）"
 },
 {
  "message": "这好像，还是我第一次这么强烈地抱有某种感情。"
 },
 {
  "name": "槐",
  "message": "「那、那……我关灯了哦」"
 },
 {
  "name": "樱",
  "message": "「嗯」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「……嘿咻……」"
 },
 {
  "message": "夜乃学姐在床上窸窸窣窣地钻进了被窝。"
 },
 {
  "name": "槐",
  "message": "「真、真的可以吗？那个……」"
 },
 {
  "name": "樱",
  "message": "「……没关系，你越客气越让人犯难，快点过来吧」"
 },
 {
  "message": "她若无其事地说道，连退路都堵死了。"
 },
 {
  "name": "槐",
  "message": "「那……」"
 },
 {
  "message": "我钻进了被窝，就躺在她的身旁。两个人的脚尖几乎要碰到一起。"
 },
 {
  "message": "钻进被窝的瞬间，我感受到了她的体温。"
 },
 {
  "name": "樱",
  "message": "「那……晚安」"
 },
 {
  "name": "槐",
  "message": "「……嗯」"
 },
 {
  "message": "我们——打算入睡。"
 },
 {
  "message": "天色已经很晚了，时间点也刚好，更何况这里还是酒店。"
 },
 {
  "name": "槐",
  "message": "（夜乃学姐……你到底有多信任我啊……）"
 },
 {
  "message": "因为，让一个大男人跟自己钻进同一个被窝，还毫无戒心地打算入睡。"
 },
 {
  "name": "槐",
  "message": "（不过，这可是）"
 },
 {
  "message": "我清清楚楚地感觉到，自己的心脏正扑通扑通地狂跳。"
 },
 {
  "name": "槐",
  "message": "（这就是我一直以来，等的机会）"
 },
 {
  "message": "学院最强的少女，唯一露出破绽的瞬间。"
 },
 {
  "message": "我终于来到了沉睡的夜乃樱身旁。"
 },
 {
  "message": "地球上百分之九十九的人类都达不到的胜利条件，眼下就要被我达成了。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "message": "我看向娇小的少女，她闭着眼，我凝视着她的脸。"
 },
 {
  "name": "槐",
  "message": "（好美）"
 },
 {
  "message": "她身体的轮廓如同大理石雕琢的天使，甚至让人感受到一丝神圣。"
 },
 {
  "message": "窗外大雨如注，唯独她的身旁，一片寂静。"
 },
 {
  "name": "樱",
  "message": "「……怎么了，你在看我呢」"
 },
 {
  "name": "槐",
  "message": "「欸，不……那个，我不是故意看的……」"
 },
 {
  "name": "樱",
  "message": "「嗯」"
 },
 {
  "name": "槐",
  "message": "「……因为……太美了……」"
 },
 {
  "name": "槐",
  "message": "「……眼睛……移不开」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「……明明你刚才就移开了」"
 },
 {
  "name": "槐",
  "message": "「欸？」"
 },
 {
  "name": "樱",
  "message": "「不理你了」"
 },
 {
  "message": "她小声嘀咕着，又一次闭上了双眼。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「……你还在看吧」"
 },
 {
