 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「所以」"
 },
 {
  "name": "樱",
  "message": "「我说了谎，对不起……」"
 },
 {
  "message": "我攥紧了拳头。"
 },
 {
  "message": "拼命克制着，不让双手颤抖。"
 },
 {
  "message": "她离我实在是太近了。"
 },
 {
  "message": "我绝不能表现出哪怕一丁点动摇。"
 },
 {
  "name": "槐",
  "message": "「……晚安……学姐……」"
 },
 {
  "message": "我用发颤的声音，努力挤出这句话。"
