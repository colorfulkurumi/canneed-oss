 {
  "name": "樱",
  "message": "「而且，也没人愿意了解我在想什么」"
 },
 {
  "name": "樱",
  "message": "「连我自己，也觉得没有这个必要」"
 },
 {
  "name": "樱",
  "message": "「所以早就认定，自己会一直孤零零的」"
 },
 {
  "name": "槐",
  "message": "「……可是……我明明，什么都没做……」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「……我们两个，真的很像呢」"
 },
 {
  "name": "樱",
  "message": "「都不在乎别人的感受」"
 },
 {
  "name": "樱",
  "message": "「……总是在不知不觉中，践踏了别人的感情，自己却毫不自知」"
 },
 {
  "name": "槐",
  "message": "「欸……」"
 },
 {
  "name": "樱",
  "message": "「别这么说」"
 },
 {
  "name": "樱",
  "message": "「多亏了你，我才能和索菲这么要好」"
 },
 {
  "name": "樱",
  "message": "「多亏了你，我才第一次和朋友一起玩」"
 },
 {
  "name": "樱",
  "message": "「多亏了你，我才在学院里开心起来」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「这都是我珍贵的回忆，所以，别说你什么都没做」"
 },
 {
  "name": "槐",
  "message": "「……学……姐……」"
 },
 {
  "name": "樱",
  "message": "「那个把我带进崩月家的女孩子，应该就是崩月水仙吧」"
 },
 {
  "name": "樱",
  "message": "「她说，她想要救自己重要的人」"
 },
 {
  "name": "樱",
  "message": "「铃宫……你就是，她口中，重要的人吧」"
 },
 {
  "name": "樱",
  "message": "「跟她一起去崩月家那次，她说，她想救自己重要的人」"
 },
 {
  "name": "樱",
  "message": "「是吗……那个人就是你啊」"
 },
 {
  "name": "槐",
  "message": "「……！」"
 },
 {
  "name": "樱",
  "message": "「索菲家里的人我都清楚，所以我猜那个人不是你，就是海漫」"
 },
 {
  "name": "樱",
  "message": "「我……其实，并不打算……去调查这些」"
 },
 {
  "name": "樱",
  "message": "「学生会里有崩月家的人。明明只要稍微想想，就能想到」"
 },
 {
  "name": "槐",
  "message": "「……那是……为什么」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「因为我害怕」"
 },
 {
  "name": "槐",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「一想到大家可能都在骗我，只是装出开心的样子……」"
 },
 {
  "name": "樱",
  "message": "「我就想哭出来」"
 },
 {
  "name": "樱",
  "message": "「不过，太好了」"
 },
 {
  "name": "槐",
  "message": "「什么……太好了……？」"
 },
 {
  "name": "樱",
  "message": "「因为，你也一样啊」"
 },
 {
  "name": "樱",
  "message": "「和我一样」"
 },
 {
  "name": "樱",
  "message": "「要自己亲手毁掉这个温暖的地方时，真的会难过到……下不去手」"
 },
 {
  "name": "樱",
  "message": "「所以才哭了」"
 },
 {
  "name": "槐",
  "message": "「……学……姐……我……我……我……」"
 },
 {
  "name": "槐",
  "message": "「……我……」"
 },
 {
  "name": "槐",
  "message": "「我……不知道……」"
 },
 {
  "name": "樱",
  "message": "「嗯」"
 },
 {
  "name": "槐",
  "message": "「自己……竟然……这么软弱……」"
 },
 {
  "name": "樱",
  "message": "「……嗯」"
 },
 {
  "message": "她就那样，无比温柔地抱着我。"
 },
 {
  "message": "我拼命想忍住，可眼泪还是不听使唤，大颗大颗地，往下滴落。"
 }
]