[
 {
  "message": "——铃宫就这样，冲出了房间。"
 },
 {
  "name": "樱",
  "message": "「其实……没关系的」"
 },
 {
  "message": "我一个人低声自语，显然不会有人回应。"
 },
 {
  "name": "樱",
  "message": "（比起这些）"
 },
 {
  "name": "樱",
  "message": "（我明明更想和他待在一起啊）"
 },
 {
  "message": "他的重量，他的温度，他的呼吸。"
 },
 {
  "message": "光是这些温暖的消失，就让我觉得自己像被掏空了一样。"
 },
 {
  "message": "好寂寞，好舍不得，孤独得不得了。"
 },
 {
  "name": "樱",
  "message": "「啊，不过」"
 },
 {
  "message": "裙子上沾着，他的忍耐汁。"
 },
 {
  "name": "樱",
  "message": "「……这个要是留下印子，可就糟了」"
 },
 {
  "name": "樱",
  "message": "「N.a.v.i.」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『有什么事吗，会长』"
 },
 {
  "name": "樱",
  "message": "「裙子上要是沾了前列腺液，该怎么洗掉」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……』"
 },
 {
  "name": "N.a.v.i.",
  "message": "『……基本上用水洗就够了，如果洗不掉的话，用洗涤剂试试』"
 },
 {
  "name": "樱",
  "message": "「谢谢」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『您最近是不是把我当成随叫随到的树洞了？』"
 },
 {
  "name": "樱",
  "message": "「……？」"
 },
 {
  "name": "N.a.v.i.",
  "message": "『唉，也无所谓吧……』"
 },
 {
  "message": "N.a.v.i.的身影瞬间消失了。"
 },
 {
  "message": "我脱下裙子，走向洗手间。"
 },
 {
  "message": "弄脏的内裤，先塞进袋子里，带回家再洗好了。"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "我一边用水轻轻揉洗裙子，一边回想着刚才的事。"
 },
 {
  "name": "樱",
  "message": "（……虽然不太明白是怎么回事）"
 },
 {
  "name": "樱",
  "message": "（总感觉……自己好像做了件不得了的事）"
 },
 {
  "message": "说不定，刚才那个。"
 },
 {
  "name": "樱",
  "message": "（难道就是……传说中的，色色的事吗）"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "我套上那条微微打湿的裙子，盥洗室角落里放着个东西，引起了我的注意。"
 },
 {
  "name": "樱",
  "message": "「铃宫的……衬衫……」"
 },
 {
  "message": "总觉得。"
 },
 {
  "message": "心里空落落的，寂寞得难以忍受。"
 },
 {
  "name": "樱",
  "message": "（他怎么还不快点回来呢）"
 },
 {
  "message": "我从洗衣篮里拿起他的衬衫，紧紧地抱在怀里。"
 },
 {
  "name": "樱",
  "message": "「……！」"
 },
 {
  "message": "突然间。"
 },
 {
  "name": "樱",
  "message": "（有声音，很近，就在房间里）"
 },
 {
  "message": "有人躲在暗处偷看？"
 },
 {
  "message": "是他的敌人吗，崩月家的人。"
 },
 {
  "message": "动静越来越大了，对方大概是想逃。"
 },
 {
  "name": "樱",
  "message": "「别想逃，直视瓦砾」"
 },
 {
  "message": "我让周围五米的一切都停了下来。"
 },
 {
  "message": "这招很消耗体力，本来应该更谨慎地使用才对。"
 },
 {
  "name": "樱",
  "message": "（要是我们两个的事被崩月家发现，肯定很麻烦）"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "我警惕地拉开了壁橱的门。"
 },
 {
  "name": "水仙",
  "message": "「唔唔……」"
 },
 {
  "name": "樱",
  "message": "「……欸？你是……」"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "message": "水仙汗如雨下，正坐在铃宫的房间里。"
 },
 {
  "name": "樱",
  "message": "「……那个」"
 },
 {
  "name": "樱",
  "message": "「好久不见……？水仙……？」"
 },
 {
  "name": "水仙",
  "message": "「不、不是！」"
 },
 {
  "name": "樱",
  "message": "「……？」"
 },
 {
  "name": "水仙",
  "message": "「我、我才不叫……水仙呢……我、我叫……啾、啾莉，我叫啾莉！」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "啊，原来如此。"
 },
 {
  "name": "樱",
  "message": "（她大概以为我不知道铃宫的真正目的吧）"
 },
 {
  "name": "樱",
  "message": "（怕被我这个暗杀目标认出来，会出事吧）"
 },
 {
  "name": "樱",
  "message": "「呃……那个」"
 },
 {
  "message": "我记得铃宫好像说过。"
 },
 {
  "message": "『小水她，肯定会站在我这边』。"
 },
 {
  "name": "樱",
  "message": "「你不用撒谎，我全都知道了」"
 },
 {
  "name": "水仙",
  "message": "「唔欸？！」"
 },
 {
  "name": "樱",
  "message": "「铃宫之前是想暗杀我的对吧？不过，他失败了」"
 },
 {
  "name": "樱",
  "message": "「现在，他已经是我的人了」"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「对不起，我完全听不懂你在说什么」"
 },
 {
  "name": "樱",
  "message": "「唔……」"
 },
 {
  "message": "我本来就不太会三言两语把事情说清楚。"
 },
 {
  "name": "樱",
  "message": "「昨天，我和铃宫去了情侣酒店」"
 },
 {
  "name": "水仙",
  "message": "「嗯……欸？！什么？！」"
 },
 {
  "name": "樱",
  "message": "「后来，我差点就被铃宫杀掉了呢」"
 },
 {
  "name": "水仙",
  "message": "「……欸、欸欸」"
 },
 {
  "name": "樱",
  "message": "「我跟他说杀了我也没关系，还亲手把注射器扎进了自己脖子里」"
 },
 {
  "name": "水仙",
  "message": "「……？？？？？？」"
 },
 {
  "name": "樱",
  "message": "「可结果，铃宫他……竟然哭了」"
 },
 {
  "name": "水仙",
  "message": "「……啊」"
 },
 {
  "name": "樱",
  "message": "「他一直跟我说对不起」"
 },
 {
  "name": "樱",
  "message": "「我告诉他没关系，原谅了他」"
 },
 {
  "name": "水仙",
  "message": "「……这样，啊」"
 },
 {
  "name": "樱",
  "message": "「没错，他终究没法杀了我，决定彻底与崩月家分道扬镳」"
 },
 {
  "name": "水仙",
  "message": "「……！」"
 },
 {
  "name": "樱",
  "message": "「他说过，你一定会站在他那边的」"
 },
 {
  "name": "水仙",
  "message": "「……这样……啊」"
 },
 {
  "name": "樱",
  "message": "「他，真的很喜欢你这个妹妹呢」"
 },
 {
  "name": "水仙",
  "message": "「……嗯」"
 },
 {
  "message": "她脸上露出了无比欣喜的神情，洋溢着幸福的笑容。"
 },
 {
  "name": "水仙",
  "message": "「事情变成这样……夜乃，对不起，我们……」"
 },
 {
  "name": "樱",
  "message": "「什么？」"
 },
 {
  "name": "水仙",
  "message": "「毕竟我也是帮凶，参与了对你的暗杀计划」"
 },
 {
  "name": "水仙",
  "message": "「但却……还厚着脸皮向你求救……」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "这对兄妹还真是一模一样，但又大不相同。"
 },
 {
  "name": "樱",
  "message": "「你后悔吗？」"
 },
 {
  "name": "水仙",
  "message": "「……」"
 },
 {
  "name": "水仙",
  "message": "「真的很对不起，但是，我……」"
 },
 {
  "name": "水仙",
  "message": "「哪怕时光倒流，我也绝对会做出同样的选择」"
 },
 {
  "message": "果然如此啊。"
 },
 {
  "message": "铃宫是在纠结与痛苦中，做出了违背本心的选择。"
 },
 {
  "message": "可水仙这个女孩，想必从始至终都没有产生过哪怕一丝一毫的动摇吧。"
 },
 {
  "name": "樱",
  "message": "（这一切，全都是为了铃宫啊）"
 },
 {
  "message": "总觉得，稍微有点嫉妒呢。"
 },
 {
  "name": "樱",
  "message": "「没关系的，我们都只是做自己该做的事罢了」"
 },
 {
  "name": "水仙",
  "message": "「……谢谢你」"
 },
 {
  "name": "水仙",
  "message": "「夜乃……你真是强大呢」"
 },
 {
  "name": "樱",
  "message": "「强大？」"
 },
 {
  "message": "这评价简直就像是某种固定标签一样，被无数人用来赞美我。"
 },
 {
  "message": "可唯独在这一刻，我觉得自己配不上那个词。"
 },
 {
  "name": "水仙",
  "message": "「……有些事，我一直没敢跟哥哥说」"
 },
 {
  "name": "水仙",
  "message": "「我……其实早就预感到，会有这么一天了」"
 },
 {
  "name": "樱",
  "message": "「欸？」"
 },
 {
  "name": "水仙",
  "message": "「哥哥他，不是笨笨的吗。啊，我不是说他做事笨，是说他的性格」"
 },
 {
  "name": "樱",
  "message": "「……嗯」"
 },
 {
  "name": "水仙",
  "message": "「所以我觉得，他肯定没办法背叛那些他喜欢上的人吧」"
 },
 {
  "name": "水仙",
  "message": "「我一直……都这么觉得」"
 },
 {
  "name": "樱",
  "message": "「……这样啊」"
 },
 {
  "message": "现在想来，正因如此，她当时才会选择向我求助吧。"
 },
 {
  "message": "她从一开始，就没彻底把我当成敌人。"
 },
 {
  "name": "樱",
  "message": "「你呢，没关系吗？要和家里人反目成仇」"
 },
 {
  "name": "水仙",
  "message": "「啊、啊哈哈……嗯……这件事，也请千万别告诉哥哥哦」"
 },
 {
  "name": "水仙",
  "message": "「说实话，我不想，也很难受」"
 },
 {
  "name": "水仙",
  "message": "「因为不管是爸爸，还是大哥，我……现在都很喜欢他们」"
 },
 {
  "name": "水仙",
  "message": "「但是」"
 },
 {
  "message": "她的目光中，闪过一丝如利刃般锐利的光芒。"
 },
 {
  "name": "水仙",
  "message": "「对我来说，还是二哥更重要」"
 },
 {
  "name": "水仙",
  "message": "「水水……我……」"
 },
 {
  "name": "水仙",
  "message": "「如果这一天真的到来，我一定会站在二哥这边」"
 },
 {
  "name": "水仙",
  "message": "「从九岁起，就决定了」"
 },
 {
  "name": "樱",
  "message": "「……这样啊」"
 },
 {
  "message": "那双眼睛中，蕴含着强烈的决意。"
 },
 {
  "message": "即便是我这种人，也能明白那就是爱。"
 },
 {
  "name": "水仙",
  "message": "「那、那个，我还有件事想问一下」"
 },
 {
  "name": "水仙",
  "message": "「夜乃……你、你在和我哥哥……交往吗？」"
 },
 {
  "name": "樱",
  "message": "「欸？」"
 },
 {
  "name": "水仙",
  "message": "「欸」"
 },
 {
  "message": "我一下子愣住了。"
 },
 {
  "name": "樱",
  "message": "「怎么突然这么问」"
 },
 {
  "name": "水仙",
  "message": "「不、不是啦，因为！虽然偷看是我不对，但是！」"
 },
 {
  "name": "水仙",
  "message": "「你们刚才，明明在做色色的事吧！」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「这倒也是」"
 },
 {
  "name": "水仙",
  "message": "「所以，你们果然在交往吗？！」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「这个倒没有」"
 },
 {
  "name": "水仙",
  "message": "「欸？」"
 },
 {
  "name": "樱",
  "message": "「毕竟，没有交往的理由啊」"
 },
 {
  "name": "樱",
  "message": "「而且，应该也不会有人想找我这种小不点当女朋友吧」"
 },
 {
  "name": "水仙",
  "message": "「你在说什么呢？！」"
 },
 {
  "name": "水仙",
  "message": "「不行啦！你要爱惜自己！」"
 },
 {
  "name": "樱",
  "message": "「……我有在爱惜啊？」"
 },
 {
  "name": "水仙",
  "message": "「那、那怎么能随随便便就跟没交往的人上床呢！」"
 },
 {
  "name": "樱",
  "message": "「……确实，好像大家都这么说」"
 },
 {
  "name": "樱",
  "message": "「但是，我觉得没关系，因为……我自己也想做」"
 },
 {
  "name": "樱",
  "message": "「所以，没关系的」"
 },
 {
  "name": "水仙",
  "message": "「你……喜欢……哥哥吗？」"
 },
 {
  "message": "在她面前，我一时竟有些不敢把那个答案说出口。"
 },
 {
  "message": "毕竟，和她那份深沉的爱相比，我的这点心意简直就像刚冒出地面的嫩芽，太过微小了。"
 },
 {
  "name": "樱",
  "message": "「嗯，喜欢……很喜欢」"
 },
 {
  "name": "水仙",
  "message": "「但是你们没交往？」"
 },
 {
  "name": "樱",
  "message": "「……？我觉得没必要」"
 },
 {
  "name": "水仙",
  "message": "「不是有没有必要的问题！」"
 },
 {
  "name": "水仙",
  "message": "「夜乃，你想和他交往吗？」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "name": "樱",
  "message": "「我没有考虑过」"
 },
 {
  "name": "水仙",
  "message": "「为什么呀？！」"
 },
 {
  "message": "毕竟，我以前从没想过自己能和别人交往。"
 },
 {
  "message": "直到不久之前，我甚至连朋友都没有。"
 },
 {
  "message": "更别说什么男朋友了。"
 },
 {
  "name": "水仙",
  "message": "「啊，不好！外面有脚步声！哥哥回来了！」"
 },
 {
  "name": "樱",
  "message": "「欸，好厉害，你能听到脚步声吗？」"
 },
 {
  "message": "我可是完全听不到呢。"
 },
 {
  "name": "水仙",
  "message": "「这、这件事请你一定替我保密！」"
 },
 {
  "name": "水仙",
  "message": "「因为我可是被逼着签了合同，要尽可能保护他的隐私啊！」"
 },
 {
  "name": "樱",
  "message": "「好、好的」"
 },
 {
  "name": "水仙",
  "message": "「那我走啦，嗖！」"
 },
 {
  "message": "水仙朝脚下扔了一颗烟雾弹。"
 },
 {
  "name": "樱",
  "message": "「咳咳，咳咳」"
 },
 {
  "message": "等烟雾散去，她早已不见了踪影。"
 },
 {
  "message": "真是了不起的本事，不过，有必要搞这么大动静吗？"
 },
 {
  "name": "槐",
  "message": "「我、我回来啦——！」"
 },
 {
  "name": "槐",
  "message": "「话说……怎么觉得屋里有点烟味啊？」"
 },
 {
  "name": "樱",
  "message": "「嗯……那个……」"
 },
 {
  "name": "樱",
  "message": "「……因为刚才有卖烤红薯的从外面路过」"
 },
 {
  "name": "槐",
  "message": "「欸，你买了吗？那有没有我的份啊？」"
 },
 {
  "name": "樱",
  "message": "「我全吃光了」"
 },
 {
  "name": "槐",
  "message": "「……学姐，你还挺能吃的嘛」"
 },
 {
  "name": "樱",
  "message": "「……」"
 },
 {
  "message": "结果我背上了一个有点不太光彩的评价。"
 }
]