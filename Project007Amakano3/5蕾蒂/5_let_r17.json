[
 {
  "message": "今天醒得早，干脆出来钓鱼。姑且给斑鸠学姐发了消息。"
 },
 {
  "name": "{fn}",
  "message": "「嘿咻——啊……脱钩了啊」"
 },
 {
  "message": "天刚亮那会儿鱼还咬钩，太阳一出来就全消停了。"
 },
 {
  "message": "反正本来也是来散心的，对着水面发发呆也挺好的。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人」"
 },
 {
  "name": "{fn}",
  "message": "「嗯？早上好」"
 },
 {
  "name": "蕾蒂",
  "message": "「是，我看到消息就过来了」"
 },
 {
  "name": "{fn}",
  "message": "「这样啊……谢谢你特地过来」"
 },
 {
  "message": "原来是看到我发的消息过来了啊。不过，还挺开心的。"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "message": "她就静静站着。"
 },
 {
  "name": "{fn}",
  "message": "「怎么了？不嫌弃的话，坐坐吧？」"
 },
 {
  "message": "我指了指身旁的冷藏箱。"
 },
 {
  "name": "蕾蒂",
  "message": "「那个……我能画一张您的画像吗？」"
 },
 {
  "name": "{fn}",
  "message": "「画我……？」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯，我想画一张写生」"
 },
 {
  "name": "{fn}",
  "message": "「这……」"
 },
 {
  "message": "虽然有点不好意思，但她的表情很认真。"
 },
 {
  "name": "{fn}",
  "message": "「好啊，你画吧」"
 },
 {
  "message": "我想不出理由拒绝，就点头了。"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "message": "她动笔开始画。"
 },
 {
  "message": "她说我像平常一样钓鱼就行，我就又盯着浮漂看了。"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "name": "{fn}",
  "message": "「……嗯？」"
 },
 {
  "message": "我突然发现，她正盯着我看。"
 },
 {
  "message": "写生看着模特很正常，但她却停下了笔，就只是盯着我看。"
 },
 {
  "name": "蕾蒂",
  "message": "「……啊」"
 },
 {
  "message": "我们目光对上的瞬间，她急忙低下头继续画。"
 },
 {
  "name": "{fn}",
  "message": "（……随她喜欢吧）"
 },
 {
  "message": "气氛有点奇怪，但我并不讨厌。"
 },
 {
  "message": "虽然距离比平时稍远，但这会儿又感觉近了些。"
 },
 {
  "name": "蕾蒂",
  "message": "「……画好了」"
 },
 {
  "message": "她小声说道。"
 },
 {
  "name": "{fn}",
  "message": "「辛苦了，能让我……看看吗？」"
 },
 {
  "message": "我还是挺好奇的，她把我画成了什么样。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……嗯」"
 },
 {
  "message": "她好像有点犹豫，但还是把画递了过来。"
 },
 {
  "name": "{fn}",
  "message": "「这是……」"
 },
 {
  "message": "我以为是素描，没想到是彩色铅笔画的，颜色很鲜艳。"
 },
 {
  "message": "画的是我在钓鱼的样子……怎么说呢，感觉画得还挺帅的？"
 },
 {
  "message": "莫非在她眼中，我就是这个样子的吗？"
 },
 {
  "name": "{fn}",
  "message": "（开心是开心，但也太羞耻了……）"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "message": "我忽然感到有人在看我，一抬头，她正看着我，眼里带着期待。"
 },
 {
  "name": "{fn}",
  "message": "「……画得太帅了吧」"
 },
 {
  "name": "蕾蒂",
  "message": "「是吗？」"
 },
 {
  "message": "然而她却一脸不解。"
 },
 {
  "name": "蕾蒂",
  "message": "「因为我看到的，就是洋溢着色彩的世界」"
 },
 {
  "name": "{fn}",
  "message": "「是、是吗……」"
 },
 {
  "message": "看来在她眼里，我真的是这个样子啊。"
 },
 {
  "name": "{fn}",
  "message": "「真希望我本人也能有画里这么帅气」"
 },
 {
  "name": "蕾蒂",
  "message": "「您现在就有啊……啊，您出汗了，我来擦」"
 },
 {
  "name": "{fn}",
  "message": "「唔噗」"
 },
 {
  "message": "她掏出手帕，帮我擦掉额头上的汗。"
 },
 {
  "name": "{fn}",
  "message": "「谢、谢谢」"
 },
 {
  "message": "这是她以前常做的事，好久没这样过了，我心里有点痒痒的。"
 },
 {
  "message": "我俩的脸一下子拉近。"
 },
 {
  "name": "蕾蒂",
  "message": "「您没中暑吧？晕不晕？头疼吗？」"
 },
 {
  "message": "她一脸担心地帮我擦汗。"
 },
 {
  "name": "{fn}",
  "message": "「嗯，我没事」"
 },
 {
  "message": "我也老老实实地让她来。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "她的手停住了。"
 },
 {
  "message": "然后，隔着手帕，慢慢地沿着我的脸移动。"
 },
 {
  "name": "{fn}",
  "message": "「嗯……学姐？」"
 },
 {
  "name": "蕾蒂",
  "message": "「啊，不……失礼了」"
 },
 {
  "message": "她像突然回过神来一样缩回手，脸已经红了。"
 },
 {
  "message": "这副样子……果然是在害羞？"
 },
 {
  "name": "{fn}",
  "message": "「学姐也……」"
 },
 {
  "message": "既然如此，只要像平时一样用行动表现出来就好。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "我也掏出毛巾，帮学姐擦汗。擦着擦着，动作就慢了下来，几乎像在摸她的脸。"
 },
 {
  "name": "蕾蒂",
  "message": "「……谢谢您」"
 },
 {
  "message": "学姐脸有点红，但也没躲开。"
 },
 {
  "message": "那天晚上，学姐难得来我房间，陪我一起睡。"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "message": "接着就没再说话，只是一个劲儿地看着我。"
 },
 {
  "name": "{fn}",
  "message": "「斑鸠学姐？」"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……我不知道该怎么办……不，也不是……」"
 },
 {
  "message": "她慌得不行。即便在黑暗中，我也能看出她的羞涩。"
 },
 {
  "name": "{fn}",
  "message": "「……不好意思吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「……是的，非常不好意思」"
 },
 {
  "name": "蕾蒂",
  "message": "「现在的我，好像已经没法再像以前那样，当您的女仆了」"
 },
 {
  "message": "某种意义上，她还真是坦诚。而且，她的话让我很开心。"
 },
 {
  "name": "{fn}",
  "message": "「那不当女仆，当我的女朋友吧？」"
 },
 {
  "name": "蕾蒂",
  "message": "「女朋友……」"
 },
 {
  "name": "{fn}",
  "message": "「嗯，女朋友」"
 },
 {
  "name": "蕾蒂",
  "message": "「女朋友……」"
 },
 {
  "message": "学姐又念了一遍，像是在确认什么。"
 },
 {
  "name": "{fn}",
  "message": "「我觉得，这样就好」"
 },
 {
  "message": "我向学姐伸出手，在她的手上轻轻敲了两下。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "学姐也伸出手，在我的胸口轻轻叩了叩。"
 },
 {
  "name": "蕾蒂",
  "message": "「哈啊……♪」"
 },
 {
  "message": "她满足地闭上了眼。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "message": "她对我露出这般神情，让我无比喜悦。"
 },
 {
  "name": "{fn}",
  "message": "「可以，吗？」"
 },
 {
  "message": "我想现在抱她还太早，就往她那边挪了挪。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "学姐好像有点紧张，但那一声轻呼，分明是高兴的。"
 },
 {
  "message": "光是能察觉到她的这份心意，就让我无比开心了。"
 }
]