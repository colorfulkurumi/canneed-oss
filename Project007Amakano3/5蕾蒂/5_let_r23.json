[
 {
  "name": "冬桦",
  "message": "「哈啊～～～闻起来好香啊……♪ 哎呀，还有刺身呢」"
 },
 {
  "message": "晚饭时，御所院饶有兴致地盯着桌上摆好的菜肴。"
 },
 {
  "name": "{fn}",
  "message": "「对对对，鱚鱼刺身和鱚鱼丸汤」"
 },
 {
  "name": "冬桦",
  "message": "「欸～～～原来鱚鱼除了做成天妇罗，还有这种吃法呀」"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "name": "叶梦",
  "message": "「肚子饿扁啦～我开动咯！！」"
 },
 {
  "name": "纱由美",
  "message": "「我开动了。嗯，这鱼丸汤味道好鲜，真好喝～♪」"
 },
 {
  "name": "叶梦",
  "message": "「原来鱚鱼丸汤是这个味道呀～♪」"
 },
 {
  "name": "叶梦",
  "message": "「不过，刺身配白米饭，你不觉得有点怪吗？」"
 },
 {
  "name": "{fn}",
  "message": "「是吗？」"
 },
 {
  "name": "叶梦",
  "message": "「你看！刺身往米饭上一放，那不就成寿司了嘛！」"
 },
 {
  "name": "{fn}",
  "message": "「你这想法也太夸张了吧」"
 },
 {
  "name": "冬桦",
  "message": "「我就喜欢鱼的味道，配热米饭正好」"
 },
 {
  "name": "叶梦",
  "message": "「又不是烤肉，我不想把它盖在饭上吃～」"
 },
 {
  "name": "纱由美",
  "message": "「啊，这我可以理解」"
 },
 {
  "name": "叶梦",
  "message": "「说起来，既然是鱚鱼，这该不会是学长钓回来的吧？」"
 },
 {
  "name": "{fn}",
  "message": "「算是吧」"
 },
 {
  "message": "今天钓了不少，所以做了顿鱚鱼大餐。"
 },
 {
  "name": "叶梦",
  "message": "「哇，居然够所有人吃，太厉害了！」"
 },
 {
  "name": "{fn}",
  "message": "「没什么大不了的」"
 },
 {
  "message": "被人夸奖，当然是高兴的。"
 },
 {
  "name": "诗梦",
  "message": "「只是运气好罢了」"
 },
 {
  "name": "{fn}",
  "message": "「呜，运气确实是一部分原因……」"
 },
 {
  "name": "诗梦",
  "message": "「嘛，能省下伙食费倒是好事」"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "message": "大家总是像这样，乐呵呵地谈论着美食，聊着闲天。"
 },
 {
  "message": "餐桌上的话题多半都很有意思，我也爱听。可要让我加入其中，却总是很难。"
 },
 {
  "message": "话题总是围着叶梦大人和冬桦大人转，她们也总是和主人聊得很热络。"
 },
 {
  "name": "蕾蒂",
  "message": "「……嗯嗯？」"
 },
 {
  "name": "蕾蒂",
  "message": "（这种感觉，究竟是什么呢？）"
 },
 {
  "message": "总觉得心里有些焦虑。"
 },
 {
  "message": "而且，这感觉和对主人的爱慕有几分相像，但又完全不同。"
 },
 {
  "message": "硬要说的话……急躁？"
 },
 {
  "name": "叶梦",
  "message": "「下次人家还想尝尝鱚鱼寿司——！」"
 },
 {
  "name": "{fn}",
  "message": "「要是能钓到好几种不同的鱼，做寿司也不错啊」"
 },
 {
  "name": "叶梦",
  "message": "「尊嘟？那学长要加油哦！！」"
 },
 {
  "name": "{fn}",
  "message": "「我会努力的」"
 },
 {
  "message": "主人和叶梦大人说话时，总显得格外开心。"
 },
 {
  "message": "感觉与我相处时的客气，或者说是尊重不同。这就是……亲近吗？"
 },
 {
  "message": "还是说……开心？"
 },
 {
  "message": "主人与我独处时看起来也很开心。可两种开心，好像又不太一样。"
 },
 {
  "message": "……难道说。"
 },
 {
  "name": "蕾蒂",
  "message": "（我也许……是个很没意思的女朋友吧）"
 },
 {
  "name": "{fn}",
  "message": "「我回来了——」"
 },
 {
  "message": "吃过鱚鱼大餐的第二天，我购物回来，看见蕾蒂正在打扫卫生。"
 },
 {
  "name": "{fn}",
  "message": "「总是辛苦你了」"
 },
 {
  "message": "听到我的声音——"
 },
 {
  "name": "蕾蒂",
  "message": "「耶耶～主人～呀吼呀吼～」"
 },
 {
  "name": "{fn}",
  "message": "「……欸？」"
 },
 {
  "message": "蕾蒂这话让我脑子嗡了一下。"
 },
 {
  "name": "蕾蒂",
  "message": "「扫扫地而已，小事小事，交给人家就好啦」"
 },
 {
  "name": "{fn}",
  "message": "「是、是吗……那个？斯卡蕾特……？」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯～？怎么啦？主人也辛苦啦，这么热的天，还好吗？」"
 },
 {
  "message": "说着说着，她把身子靠了过来。"
 },
 {
  "message": "噗扭。"
 },
 {
  "name": "{fn}",
  "message": "「等下！」"
 },
 {
  "message": "她贼大胆地把胸往我胳膊上贴。"
 },
 {
  "message": "隔着女仆装都能感受到那种柔软，手臂几乎陷了进去。"
 },
 {
  "name": "蕾蒂",
  "message": "「嘻嘻，主人，怎么啦？害羞了吗？」"
 },
 {
  "message": "确实，我有点害羞。"
 },
 {
  "name": "{fn}",
  "message": "「与其说是害羞，不如说是吓到了」"
 },
 {
  "name": "蕾蒂",
  "message": "「吓到了咩」"
 },
 {
  "name": "{fn}",
  "message": "「因、因为……太突然了」"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "name": "蕾蒂",
  "message": "「跟想象中的反应完全不一样呢」"
 },
 {
  "name": "{fn}",
  "message": "「想、想象中的？」"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "name": "蕾蒂",
  "message": "「为什么猴子不喜欢平行线，因为没有相交——」"
 },
 {
  "message": "好冷的笑话。"
 },
 {
  "message": "而且还是面无表情讲出来的。"
 },
 {
  "name": "蕾蒂",
  "message": "「……不好笑吗？」"
 },
 {
  "name": "{fn}",
  "message": "「抱、抱歉，我有点没跟上」"
 },
 {
  "message": "他这样子，我都说不利索话了。"
 },
 {
  "name": "蕾蒂",
  "message": "「是吗……」"
 },
 {
  "message": "她肩膀垮了下来，看到她这样，我反倒觉得有些过意不去。"
 },
 {
  "name": "蕾蒂",
  "message": "「看来，不行呢」"
 },
 {
  "name": "{fn}",
  "message": "「也不是说不行……但你干嘛那样讲话？」"
 },
 {
  "name": "蕾蒂",
  "message": "「主人和叶梦大人，还有冬桦大人说话的时候，该怎么说呢……」"
 },
 {
  "name": "蕾蒂",
  "message": "「感觉特别……耶」"
 },
 {
  "name": "{fn}",
  "message": "「耶、耶？」"
 },
 {
  "name": "蕾蒂",
  "message": "「……就是很兴奋」"
 },
 {
  "message": "见我没明白，她又解释了一下。"
 },
 {
  "name": "{fn}",
  "message": "「我觉得跟平时没什么两样啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「可你跟我不这样」"
 },
 {
  "name": "{fn}",
  "message": "「这个……」"
 },
 {
  "message": "好像是，我跟那两人更聊得来些。"
 },
 {
  "name": "{fn}",
  "message": "（……话说，蕾蒂这反应）"
 },
 {
  "name": "{fn}",
  "message": "「该不会是在……闹别扭吧？」"
 },
 {
  "name": "蕾蒂",
  "message": "「闹别扭……不，我只是感觉焦虑」"
 },
 {
  "name": "蕾蒂",
  "message": "「看您那么开心……我觉得很急躁」"
 },
 {
  "message": "果然，这不就是在吃醋吗。"
 },
 {
  "name": "{fn}",
  "message": "（蕾蒂……）"
 },
 {
  "name": "{fn}",
  "message": "「蕾蒂」"
 },
 {
  "name": "蕾蒂",
  "message": "「是——唔嗯？！」"
 },
 {
  "message": "我把蕾蒂拉进怀里，吻了她。"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯啾……唔嗯，哈啊……主人……？」"
 },
 {
  "name": "{fn}",
  "message": "「知道你在吃醋，我还挺高兴的」"
 },
 {
  "name": "蕾蒂",
  "message": "「吃醋？可是……这不是一种负面情绪吗？」"
 },
 {
  "name": "{fn}",
  "message": "「但这同时也意味着，你是喜欢我的啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「那肯定……啊，这样啊……啾」"
 },
 {
  "message": "蕾蒂也主动亲了我。"
 },
 {
  "name": "蕾蒂",
  "message": "「啾噗……哈啊，主人接吻的样子，只有我能看到呢……♪」"
 },
 {
  "name": "{fn}",
  "message": "「这倒没错」"
 },
 {
  "message": "我们对视着，蕾蒂笑了起来。"
 },
 {
  "name": "冬桦",
  "message": "「哈呜呜？！」"
 },
 {
  "name": "叶梦",
  "message": "「啊哇哇，豹豹公主～！！」"
 },
 {
  "message": "回过神来，才发现冬桦和叶梦不知何时出现了。"
 },
 {
  "name": "{fn}",
  "message": "「啊……你们看见了？」"
 },
 {
  "name": "叶梦",
  "message": "「嗯、嗯……你们啃来啃去，把人家吓了一大跳」"
 },
 {
  "name": "冬桦",
  "message": "「是、是的，真是成熟呢……」"
 },
 {
  "message": "御所院捂着鼻子，点了点头。"
 },
 {
  "name": "{fn}",
  "message": "「那个，你不要紧吧？」"
 },
 {
  "name": "冬桦",
  "message": "「没、没事的，请不要在意我」"
 },
 {
  "name": "叶梦",
  "message": "「斑斑刚才是在学人家说话吧～」"
 },
 {
  "name": "{fn}",
  "message": "「你们从那会儿就在了……？」"
 },
 {
  "message": "那也太……难为情了……"
 },
 {
  "name": "蕾蒂",
  "message": "「是的，我稍微学了一下」"
 },
 {
  "name": "叶梦",
  "message": "「果然！嘿嘿嘿——♪」"
 },
 {
  "message": "叶梦连连点头，满脸坏笑。"
 },
 {
  "name": "叶梦",
  "message": "「讲辣妹语的美女女仆……这属性超赞的吧！」"
 },
 {
  "name": "{fn}",
  "message": "「什么意思啊？」"
 },
 {
  "name": "蕾蒂",
  "message": "「……？」"
 },
 {
  "name": "叶梦",
  "message": "「嘿嘿嘿～人家有件事想拜托一下斑斑啦！」"
 },
 {
  "message": "见我们没反应过来，叶梦朝我们眨了眨眼。"
 }
]