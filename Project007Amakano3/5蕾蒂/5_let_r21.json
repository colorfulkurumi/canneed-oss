[
 {
  "message": "约会这天，我提前到外面等蕾蒂。"
 },
 {
  "name": "{fn}",
  "message": "「应该……没问题吧」"
 },
 {
  "message": "毕竟是难得的约会，我费了些心思，把自己打理了一番。"
 },
 {
  "name": "{fn}",
  "message": "（穿新衣的蕾蒂……会是什么样呢……？）"
 },
 {
  "name": "{fn}",
  "message": "（会走清新风……还是成熟一点的路线……啊不会露很多吧……不对我想什么呢）"
 },
 {
  "message": "光是想象，我就等不及了。"
 },
 {
  "name": "{fn}",
  "message": "（毕竟她上次穿泳装简直是大杀器……）"
 },
 {
  "name": "诗梦",
  "message": "「……口水，擦一下」"
 },
 {
  "name": "{fn}",
  "message": "「呃」"
 },
 {
  "message": "柳木先行出来，一脸无奈地说道，我赶紧捂住嘴。"
 },
 {
  "name": "叶梦",
  "message": "「嘻嘻，很期待吧～♪ 斑斑，快出来～♪」"
 },
 {
  "name": "蕾蒂",
  "message": "「来、来了」"
 },
 {
  "name": "蕾蒂",
  "message": "「久等了」"
 },
 {
  "name": "{fn}",
  "message": "「蕾蒂……」"
 },
 {
  "message": "蕾蒂的模样……超越了我的想象。"
 },
 {
  "message": "我知道她很美，但这身衣服更是把她的魅力放大了好几倍。"
 },
 {
  "message": "那种清纯里透着几分成熟的感觉，被这身衣服衬得刚刚好。"
 },
 {
  "message": "女仆装虽然也很棒，但这身才是约会该有的打扮啊……"
 },
 {
  "name": "诗梦",
  "message": "「嘴」"
 },
 {
  "name": "{fn}",
  "message": "「啊，哦」"
 },
 {
  "name": "冬桦",
  "message": "「呵呵，不过，看来反响不错呢！」"
 },
 {
  "name": "纱由美",
  "message": "「看他，乐得嘴都合不上了♪」"
 },
 {
  "message": "宿舍的大家也都跟了出来，推了推蕾蒂的背。"
 },
 {
  "name": "蕾蒂",
  "message": "「是的，我也很开心」"
 },
 {
  "name": "叶梦",
  "message": "「嘿嘿嘿～～～超成功！」"
 },
 {
  "message": "叶梦高举起一只手。"
 },
 {
  "name": "叶梦",
  "message": "「斑斑也来！」"
 },
 {
  "name": "蕾蒂",
  "message": "「好、好的」"
 },
 {
  "name": "叶梦",
  "message": "「来击个掌♪ 约会顺利～！」"
 },
 {
  "message": "蕾蒂也举起手，和她击了个掌。"
 },
 {
  "name": "{fn}",
  "message": "「那么，我们出发吧」"
 },
 {
  "message": "我向蕾蒂伸出了手。"
 },
 {
  "name": "蕾蒂",
  "message": "「麻烦了。各位，我们走了」"
 },
 {
  "message": "蕾蒂牵住我的手，向大家告别。"
 },
 {
  "name": "纱由美",
  "message": "「路上小心哦！」"
 },
 {
  "name": "冬桦",
  "message": "「祝二位玩得愉快！」"
 },
 {
  "name": "诗梦",
  "message": "「……路上小心」"
 },
 {
  "message": "我们俩的第一站，是阿藏家的旅馆。"
 },
 {
  "message": "倒不是想跟阿藏炫耀，而是准备一起去见见奶奶。"
 },
 {
  "name": "{fn}",
  "message": "「阿藏，辛苦啦」"
 },
 {
  "message": "我跟正在旅馆门口打扫的阿藏打了声招呼。"
 },
 {
  "name": "地藏",
  "message": "「哟！嗯嗯……？什么情况，都有斑鸠学姐了，怎么又领了个大美女？给人带路？」"
 },
 {
  "name": "{fn}",
  "message": "「不，这位就是斑鸠学姐本人啊」"
 },
 {
  "name": "地藏",
  "message": "「欸……」"
 },
 {
  "name": "蕾蒂",
  "message": "「地藏大人，平时多谢您照顾奶奶了」"
 },
 {
  "name": "地藏",
  "message": "「欸……啥？！真的假的？！还、还真是学姐……」"
 },
 {
  "message": "他愣了半晌，才总算明白过来。"
 },
 {
  "name": "地藏",
  "message": "「不是……怎么感觉斑鸠学姐这气质，简直像变了个人……」"
 },
 {
  "name": "蕾蒂",
  "message": "「……嗯，都是托主人的福」"
 },
 {
  "message": "她脸上悄悄漫开一层红晕，低着头笑了。"
 },
 {
  "name": "地藏",
  "message": "「我去……这、这是发生啥了」"
 },
 {
  "name": "{fn}",
  "message": "「交往之后，发生了很多吧」"
 },
 {
  "name": "地藏",
  "message": "「很多……你小子，难道是！那种带颜色的！！」"
 },
 {
  "name": "{fn}",
  "message": "「这个回头再聊，我们是来见奶奶的」"
 },
 {
  "message": "他貌似察觉了，但我没接茬，直接说明了来意。"
 },
 {
  "name": "地藏",
  "message": "「真是的，羡慕死我了……算了，你们俩好好的就行，奶奶在里头呢」"
 },
 {
  "name": "{fn}",
  "message": "「多谢」"
 },
 {
  "message": "我跟阿藏道了声谢，便走进了店里。"
 },
 {
  "name": "{fn}",
  "message": "「奶奶，我进来了哦」"
 },
 {
  "name": "奶奶",
  "message": "「哦，进来吧」"
 },
 {
  "name": "{fn}",
  "message": "「打扰了」"
 },
 {
  "name": "蕾蒂",
  "message": "「祖母大人，好久不见」"
 },
 {
  "name": "奶奶",
  "message": "「哎哟，打扮得这么漂亮，我都快认不出来了」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯，这是大家一起帮我选的」"
 },
 {
  "name": "奶奶",
  "message": "「是吗，看来你在宿舍和大家处得不错呀」"
 },
 {
  "name": "蕾蒂",
  "message": "「大家对我都很好，而且……主人也对我很好」"
 },
 {
  "message": "她说着，悄悄瞥了我一眼。虽然之前跟奶奶提过了，但还是得当面正式说一声。"
 },
 {
  "name": "{fn}",
  "message": "「虽然之前也提了一嘴，我和蕾蒂在交往」"
 },
 {
  "name": "蕾蒂",
  "message": "「我和主人正在交往」"
 },
 {
  "name": "奶奶",
  "message": "「这样啊」"
 },
 {
  "message": "奶奶目不转睛地打量着蕾蒂。"
 },
 {
  "name": "奶奶",
  "message": "「蕾蒂，你变了啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「是的，我改变了很多」"
 },
 {
  "name": "奶奶",
  "message": "「你喜欢她吗」"
 },
 {
  "name": "蕾蒂",
  "message": "「如果这种感觉就是恋爱的话，我觉得自己特别幸福」"
 },
 {
  "name": "奶奶",
  "message": "「嗯……嗯，我倒不是有什么意见」"
 },
 {
  "name": "奶奶",
  "message": "「我就说一句话，凡事多商量，两个人好好过，没了」"
 },
 {
  "name": "{fn}",
  "message": "「谢谢」"
 },
 {
  "name": "蕾蒂",
  "message": "「谢谢您」"
 },
 {
  "message": "我们俩不约而同地点了点头。"
 },
 {
  "name": "蕾蒂",
  "message": "「这里就是……」"
 },
 {
  "message": "我们坐缆车来到了山顶公园，从这里可以俯瞰整个日和山温泉。"
 },
 {
  "name": "{fn}",
  "message": "「嗯，山顶公园。你来过这儿吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「没有，我是第一次来。视野真开阔啊」"
 },
 {
  "name": "{fn}",
  "message": "「嗯，我们宿舍就在那边」"
 },
 {
  "name": "蕾蒂",
  "message": "「在哪边呢」"
 },
 {
  "message": "蕾蒂说着，把身子凑了过来。"
 },
 {
  "message": "她凑得很近，呼吸就在耳边，身上的衣服又和平常不一样，让我心跳得厉害。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊，在那里，叶梦大人好像正要出门」"
 },
 {
  "name": "{fn}",
  "message": "「咦，那么远都能看清吗？」"
 },
 {
  "message": "或许是她视力好吧，一下子就找到了。"
 },
 {
  "name": "蕾蒂",
  "message": "「是的……啊，那边是地藏大人的旅馆，祖母大人就住在那里」"
 },
 {
  "name": "蕾蒂",
  "message": "「还能看到御所院学园……」"
 },
 {
  "message": "换个角度欣赏平时常去的地方，似乎让她感到十分新奇。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "name": "蕾蒂",
  "message": "「怎么了？」"
 },
 {
  "message": "我正盯着她的侧脸发呆，她像是感觉到了，也朝我看了过来。"
 },
 {
  "name": "{fn}",
  "message": "「距离太近，有点不好意思」"
 },
 {
  "name": "蕾蒂",
  "message": "「……啊、是」"
 },
 {
  "message": "蕾蒂有点不好意思地挪开了点，可没两秒，又悄悄靠了回来。"
 },
 {
  "name": "蕾蒂",
  "message": "「这样……可以吗？」"
 },
 {
  "name": "{fn}",
  "message": "「可以吧？」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯，因为我也想挨着主人」"
 },
 {
  "name": "{fn}",
  "message": "「……嗯，我开心得不得了」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯……♪」"
 },
 {
  "message": "她弯弯眼睛，满足地笑了。"
 },
 {
  "name": "{fn}",
  "message": "「我能再靠近些吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「欸……啊，嗯，当然」"
 },
 {
  "message": "蕾蒂睫毛颤了颤，闭上了眼。"
 },
 {
  "name": "蕾蒂",
  "message": "「……啾，唔……♪」"
 },
 {
  "message": "我俯身吻住了她。"
 },
 {
  "name": "蕾蒂",
  "message": "「……真的，好近啊」"
 },
 {
  "message": "分开的时候，她喘得有点急，开心地朝我微笑道。"
 },
 {
  "name": "蕾蒂",
  "message": "「那么，请张嘴」"
 },
 {
  "name": "{fn}",
  "message": "「啊——」"
 },
 {
  "message": "我张口吃下蕾蒂递到嘴边的三明治。"
 },
 {
  "message": "三明治里夹着厚实的炸猪排，分量十足。"
 },
 {
  "name": "{fn}",
  "message": "「唔，好吃」"
 },
 {
  "name": "蕾蒂",
  "message": "「太好了……」"
 },
 {
  "name": "{fn}",
  "message": "「你还特地准备了便当啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「这个应该叫野餐吧？」"
 },
 {
  "name": "{fn}",
  "message": "「嗯，是叫野餐」"
 },
 {
  "name": "蕾蒂",
  "message": "「既然是野餐，三明治应该不能少吧」"
 },
 {
  "message": "她这说法，估计是上网查来的。"
 },
 {
  "name": "蕾蒂",
  "message": "「不过，我想还是做熟一点的东西比较好」"
 },
 {
  "name": "{fn}",
  "message": "「原来如此，所以才选了炸猪排三明治啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「是的，炸猪排的做法是跟诗梦大人学的」"
 },
 {
  "name": "{fn}",
  "message": "「原来如此……好像比我做的还好吃」"
 },
 {
  "message": "大概是因为味觉恢复了，蕾蒂做饭越来越好吃。"
 },
 {
  "name": "蕾蒂",
  "message": "「您过奖了」"
 },
 {
  "message": "她抿着嘴笑，耳朵尖有点红。"
 },
 {
  "name": "{fn}",
  "message": "「真的真的。你也尝下，啊——」"
 },
 {
  "message": "我也学着她的样子，将三明治递到她嘴边。"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯……啊呜……」"
 },
 {
  "message": "她张嘴咬住三明治的样子……总觉得有点色。"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯……唔，哈啊……好奇怪，感觉比之前尝的时候要好吃」"
 },
 {
  "name": "蕾蒂",
  "message": "「一定是因为，这是主人喂的吧」"
 },
 {
  "name": "{fn}",
  "message": "「那就好」"
 },
 {
  "message": "听她这么说，我也开心地咬了一口。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……主人，酱汁沾在脸上了」"
 },
 {
  "name": "蕾蒂",
  "message": "「……唔，哧溜」"
 },
 {
  "message": "蕾蒂舔了舔我的嘴角。"
 },
 {
  "message": "蕾蒂柔软的舌尖，舔在脸上很舒服，不过……"
 },
 {
  "name": "{fn}",
  "message": "「蕾蒂？」"
 },
 {
  "name": "蕾蒂",
  "message": "「我听说这样弄干净比较好，是我哪里弄错了吗？」"
 },
 {
  "name": "{fn}",
  "message": "「只要别对其他人这样……就行」"
 },
 {
  "name": "蕾蒂",
  "message": "「怎么会……除了主人，我不会对任何人这样的」"
 },
 {
  "message": "看着蕾蒂那害羞的样子，连我都跟着开心了起来。"
 },
 {
  "name": "蕾蒂",
  "message": "「请把，枕在这里就好」"
 },
 {
  "message": "午饭后，在树荫下，她让我枕着她的大腿休息。"
 },
 {
  "name": "{fn}",
  "message": "「谢谢……哈啊，真舒服」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯，我也感觉暖洋洋的，很安心」"
 },
 {
  "message": "她笑眯眯地摸着我的头。"
 },
 {
  "name": "{fn}",
  "message": "「嗯，而且这个角度看，你穿自己的衣服也很好看」"
 },
 {
  "name": "蕾蒂",
  "message": "「是、是吗？」"
 },
 {
  "name": "{fn}",
  "message": "「真的很适合你啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯……虽然大家都是这么说，可我还是不太习惯」"
 },
 {
  "name": "{fn}",
  "message": "「不过，努力习惯这些的你，也很迷人啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「我这样，像主人的女朋友吗？」"
 },
 {
  "name": "{fn}",
  "message": "「你会想这些，我也很开心」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯……♪」"
 },
 {
  "name": "{fn}",
  "message": "「女仆装的你我喜欢，现在的你我同样很喜欢」"
 },
 {
  "message": "我微微抬起头。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人？嗯……啾？」"
 },
 {
  "message": "我主动吻了上去。"
 },
 {
  "name": "蕾蒂",
  "message": "「低头吻主人的感觉……好奇怪」"
 },
 {
  "name": "{fn}",
  "message": "「我也觉得挺奇怪的」"
 },
 {
  "name": "蕾蒂",
  "message": "「而且，不行，您现在就好好享受膝枕吧」"
 },
 {
  "message": "蕾蒂轻轻把我的头放回她腿上。"
 },
 {
  "name": "{fn}",
  "message": "「那我想亲你了怎么办？」"
 },
 {
  "name": "蕾蒂",
  "message": "「那我——嗯嗯？」"
 },
 {
  "message": "噗扭。"
 },
 {
  "name": "{fn}",
  "message": "「唔哦」"
 },
 {
  "message": "蕾蒂的巨乳挡住了我的视线。"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯嗯……好像不太方便呢」"
 },
 {
  "message": "看来是因为胸夹在中间，她没法亲到我。"
 },
 {
  "name": "{fn}",
  "message": "「没事，这样就很舒服了」"
 },
 {
  "name": "蕾蒂",
  "message": "「我明白了，既然如此，那这样也……♪」"
 },
 {
  "message": "噗扭，噗扭。"
 },
 {
  "message": "她把胸贴得更近了。"
 },
 {
  "message": "享受着如此奢华的膝枕，我心里都有点过意不去了。"
 },
 {
  "name": "蕾蒂",
  "message": "「……♪」"
 },
 {
  "message": "可看她那满足的表情，明显很喜欢这样。"
 }
]