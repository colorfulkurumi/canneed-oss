[
 {
  "name": "{fn}",
  "message": "「真好啊，大晴天……」"
 },
 {
  "message": "虽然还很热，但空气里已经有点夏末的味道了。"
 },
 {
  "name": "{fn}",
  "message": "「怪不得没人，真好」"
 },
 {
  "name": "蕾蒂",
  "message": "「是……啊」"
 },
 {
  "message": "她依旧穿着那身泳装……不，感觉比之前更勾人了。"
 },
 {
  "message": "大概是她现在这副不好意思的样子，看着更带劲吧。"
 },
 {
  "name": "{fn}",
  "message": "「怎么了？」"
 },
 {
  "name": "蕾蒂",
  "message": "「那个……怎么说呢，怪难为情的」"
 },
 {
  "message": "明明之前穿的时候还没这么拘谨的。"
 },
 {
  "name": "蕾蒂",
  "message": "「露这么多……我觉得，不太好」"
 },
 {
  "name": "{fn}",
  "message": "「不过，真的特别可爱」"
 },
 {
  "name": "蕾蒂",
  "message": "「您、您这么夸的话……」"
 },
 {
  "message": "她显得更慌乱了。"
 },
 {
  "name": "{fn}",
  "message": "「让我好好看看」"
 },
 {
  "name": "蕾蒂",
  "message": "「……是」"
 },
 {
  "message": "她乖乖站好，腿并得紧紧的，有点不自在地把自己穿泳装的样子展现在我面前。"
 },
 {
  "message": "她这副模样格外色情，让我忍不住想看她害羞的样子。我直勾勾地盯着她看。"
 },
 {
  "name": "蕾蒂",
  "message": "「主、主人……请别这样一直盯着我看了」"
 },
 {
  "name": "{fn}",
  "message": "「好啦，该涂防晒霜了」"
 },
 {
  "message": "再逗下去她真要害羞坏了，我干脆提议给她涂防晒霜。"
 },
 {
  "name": "蕾蒂",
  "message": "「说、说的是呢，我一晒皮肤就发红……」"
 },
 {
  "name": "{fn}",
  "message": "「啊，是吗……这边的阳光确实很晒啊，后背我帮你涂吧」"
 },
 {
  "name": "蕾蒂",
  "message": "「是……麻烦主人了」"
 },
 {
  "message": "蕾蒂依言转过身，我便开始为她涂防晒霜。"
 },
 {
  "name": "蕾蒂",
  "message": "「唔……嗯……」"
 },
 {
  "name": "{fn}",
  "message": "「痒吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「主人的手指……感觉，好舒服……」"
 },
 {
  "name": "{fn}",
  "message": "「那就好」"
 },
 {
  "message": "白皙的后背沐浴在耀眼的阳光下，涂上防晒霜后，更显得闪闪发光。"
 },
 {
  "name": "{fn}",
  "message": "「……真美啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「是吗……啊……嗯，啊、啊……」"
 },
 {
  "message": "蕾蒂忍不住叫出了声，也不知道是羞的还是怎么，她的皮肤慢慢透出了淡淡的粉色。"
 },
 {
  "name": "蕾蒂",
  "message": "「已、已经涂好了吗……？」"
 },
 {
  "name": "{fn}",
  "message": "「还没呢，要涂得匀一点才行」"
 },
 {
  "message": "她的反应很有趣，我忍不住继续涂抹。"
 },
 {
  "name": "蕾蒂",
  "message": "「……嗯，那个，应该涂匀了吧」"
 },
 {
  "name": "蕾蒂",
  "message": "「您这样摸……哈啊……虽然很开心，但这样下去……会受不了的」"
 },
 {
  "message": "蕾蒂猛地拉开距离，回过头看着我。虽然也不是真生气，但她这样表达不满的样子还真是少见。"
 },
 {
  "message": "……也是，是我玩过头了。"
 },
 {
  "name": "{fn}",
  "message": "「抱歉，我们下海吧」"
 },
 {
  "message": "总不能一直欺负她。我牵起她的手，走向大海。"
 },
 {
  "name": "蕾蒂",
  "message": "「呀，浪……好像，有点大」"
 },
 {
  "name": "{fn}",
  "message": "「不过，正好可以迎着浪玩」"
 },
 {
  "message": "我们顺着浪头，漂在海上晃悠着。"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯……」"
 },
 {
  "message": "蕾蒂紧紧地向我靠了过来。"
 },
 {
  "message": "在水里贴贴时，感觉和平常不一样，心跳得更快了。"
 },
 {
  "name": "{fn}",
  "message": "「蕾蒂，你不是会游泳吗」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯，但是……我想这样挨着主人」"
 },
 {
  "name": "{fn}",
  "message": "「想和我黏在一起？」"
 },
 {
  "name": "蕾蒂",
  "message": "「因为……我喜欢和主人贴在一起的感觉」"
 },
 {
  "message": "她轻轻敲了敲我的胸口，红着脸笑了。"
 },
 {
  "name": "{fn}",
  "message": "「嗯，我也很开心」"
 },
 {
  "message": "我把她被海水打湿的头发撩到一边。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人？」"
 },
 {
  "name": "{fn}",
  "message": "「没什么，只是觉得平时很少见你把额头露出来」"
 },
 {
  "name": "蕾蒂",
  "message": "「是、是吗？」"
 },
 {
  "name": "{fn}",
  "message": "「可以亲一下吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「……当然」"
 },
 {
  "message": "蕾蒂闭上眼，我在她额头上亲了一下。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……亲的是额头吗？」"
 },
 {
  "name": "{fn}",
  "message": "「那你是更想让我亲这里吗？」"
 },
 {
  "message": "说着，我吻住了她的唇。"
 },
 {
  "name": "蕾蒂",
  "message": "「……嗯，啾……哈啊……♪ 吓我一跳……不过，哪样我都喜欢」"
 },
 {
  "message": "她满足地微笑着。"
 },
 {
  "name": "{fn}",
  "message": "「蕾蒂，我感觉你现在的心思越来越好懂了」"
 },
 {
  "name": "蕾蒂",
  "message": "「是吗？」"
 },
 {
  "name": "{fn}",
  "message": "「嗯……感觉比以前更懂你在想什么了」"
 },
 {
  "name": "蕾蒂",
  "message": "「……我很开心，那么……啾」"
 },
 {
  "message": "她也吻了我一下。"
 },
 {
  "name": "{fn}",
  "message": "「哦……」"
 },
 {
  "name": "蕾蒂",
  "message": "「我也，稍微能明白主人想要什么了」"
 },
 {
  "message": "她颇为自得地说道。"
 },
 {
  "message": "回到遮阳伞下，我们吃起了在海之家买的拉面。"
 },
 {
  "name": "蕾蒂",
  "message": "「吸溜……这面，稍微有点泡软了呢」"
 },
 {
  "name": "{fn}",
  "message": "「在这种地方，也只能将就了」"
 },
 {
  "message": "毕竟是速食拉面，从海之家端到这里，免不了会坨。"
 },
 {
  "name": "蕾蒂",
  "message": "「不过……我觉得味道很不错」"
 },
 {
  "name": "{fn}",
  "message": "「游完泳饿了吧，吃啥都香。而且这酱油味儿的，包括这里的氛围」"
 },
 {
  "name": "蕾蒂",
  "message": "「在海边吃东西感觉会更香……吗，呼、呼……吸溜」"
 },
 {
  "name": "蕾蒂",
  "message": "「我好像明白了……吸溜」"
 },
 {
  "message": "她吃得津津有味的模样，也像是一幅画。"
 },
 {
  "name": "蕾蒂",
  "message": "「……？」"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……呼、呼，主人，啊——」"
 },
 {
  "message": "她似乎察觉到了我想干嘛，夹起面递了过来。"
 },
 {
  "name": "{fn}",
  "message": "「谢谢，吸溜」"
 },
 {
  "message": "既然她都喂到嘴边了，我吃了一口。"
 },
 {
  "name": "{fn}",
  "message": "「嗯，感觉越吃越香了」"
 },
 {
  "name": "蕾蒂",
  "message": "「原来，好吃也有这么多种啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「那么，请您把背转过来吧」"
 },
 {
  "message": "饭后小憩，蕾蒂开始为我按摩。"
 },
 {
  "name": "{fn}",
  "message": "「呼……好舒服……」"
 },
 {
  "message": "肩膀让她这么一揉，整个人都放松了。"
 },
 {
  "name": "蕾蒂",
  "message": "「要不要再帮您揉揉腿？」"
 },
 {
  "name": "{fn}",
  "message": "「谢谢，麻烦你了」"
 },
 {
  "name": "蕾蒂",
  "message": "「那么……」"
 },
 {
  "message": "蕾蒂随即开始为我揉腿。"
 },
 {
  "message": "噗扭……"
 },
 {
  "name": "{fn}",
  "message": "「唔……」"
 },
 {
  "message": "她按摩得很用心，胸也贴得很近。"
 },
 {
  "name": "蕾蒂",
  "message": "「唔……」"
 },
 {
  "message": "那认真的喘气声，听着让人浮想联翩。"
 },
 {
  "name": "{fn}",
  "message": "（有点，受不了……）"
 },
 {
  "message": "下面一下子热了起来。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "她显然是发现了。"
 },
 {
  "message": "她的脸颊泛起了淡淡的粉色，但还是继续着手上的按摩。"
 },
 {
  "name": "蕾蒂",
  "message": "「您感觉如何？」"
 },
 {
  "name": "{fn}",
  "message": "「谢谢……接下来换我吧，我也想帮你按按」"
 },
 {
  "name": "蕾蒂",
  "message": "「欸，可是……」"
 },
 {
  "name": "{fn}",
  "message": "「没事的……让我来吧」"
 },
 {
  "message": "她大概已经知道了。"
 },
 {
  "name": "蕾蒂",
  "message": "「……好的」"
 },
 {
  "message": "她红着脸，小声应了一句。"
 }
]