[
 {
  "name": "{fn}",
  "message": "「哇哇？！」"
 },
 {
  "message": "黄昏时分的宿舍，只有我和斑鸠学姐两人。天说变就变，转眼就下起雨来。"
 },
 {
  "name": "{fn}",
  "message": "「不好，得赶紧把晾的衣服收进来！」"
 },
 {
  "name": "蕾蒂",
  "message": "「好、好的」"
 },
 {
  "message": "我俩赶紧把衣服收了回来。"
 },
 {
  "name": "{fn}",
  "message": "「呼……总算是收完了呢」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯……」"
 },
 {
  "message": "斑鸠学姐也松了口气。"
 },
 {
  "message": "可这天气……怕是要打雷了。"
 },
 {
  "message": "果然，雷响了。"
 },
 {
  "name": "蕾蒂",
  "message": "「？！」"
 },
 {
  "message": "雷声离得还远，可斑鸠学姐的脸一下子白了。"
 },
 {
  "message": "看来就算心境变了，她还是会怕打雷。"
 },
 {
  "name": "{fn}",
  "message": "「斑鸠学姐」"
 },
 {
  "message": "虽然自知有些大胆，我还是伸手抱住了她。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "name": "{fn}",
  "message": "「没事的，有我……我在呢」"
 },
 {
  "name": "蕾蒂",
  "message": "「主人……」"
 },
 {
  "message": "我抱得挺笨拙，她却卸了力气，软软地靠了过来。"
 },
 {
  "name": "{fn}",
  "message": "「没事的，没事的」"
 },
 {
  "name": "蕾蒂",
  "message": "「……嗯，虽然还是会怕，但好像比以前好多了」"
 },
 {
  "message": "斑鸠学姐也伸出双臂，环住了我的后背。"
 },
 {
  "name": "蕾蒂",
  "message": "「多亏这里很温暖……」"
 },
 {
  "message": "她的声音听起来镇定了许多。"
 },
 {
  "message": "窗外还在打雷。"
 },
 {
  "name": "蕾蒂",
  "message": "「……呼」"
 },
 {
  "message": "耳边只剩我们俩的呼吸，近得仿佛贴在一起。"
 },
 {
  "message": "咚、咚、咚。"
 },
 {
  "message": "我轻轻地敲了敲斑鸠学姐的后背。"
 },
 {
  "name": "蕾蒂",
  "message": "「……♪」"
 },
 {
  "message": "咚、咚、咚。"
 },
 {
  "message": "斑鸠学姐也轻轻地拍着我的背。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人正在敲打我的心呢」"
 },
 {
  "name": "{fn}",
  "message": "「是吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯……主人，敲开了我的心扉」"
 },
 {
  "message": "说完，斑鸠学姐凝视着我。"
 },
 {
  "message": "四目相对，她眼里清清楚楚地映着我。"
 },
 {
  "message": "我眼里，一定也全是她。"
 },
 {
  "name": "{fn}",
  "message": "「因为我想夺走你的心」"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "听我再次说出那句话，斑鸠学姐……轻轻叹了口气。"
 },
 {
  "message": "她脸红了，挨在一起的身子也越来越烫。"
 },
 {
  "name": "蕾蒂",
  "message": "「那个……真是的」"
 },
 {
  "message": "明明雷声依旧，我却什么也听不见。"
 },
 {
  "message": "我晕乎乎的，耳边只剩她的呼吸。"
 },
 {
  "name": "蕾蒂",
  "message": "「……啾」"
 },
 {
  "message": "我不由自主地亲了上去。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人……？」"
 },
 {
  "message": "斑鸠学姐惊讶地睁大眼，我这才回过神来。"
 },
 {
  "name": "{fn}",
  "message": "「抱、抱歉……我这是在做什么——」"
 },
 {
  "message": "咚、咚、咚。"
 },
 {
  "message": "我正要移开视线，她却伸出食指，在我嘴唇上轻轻敲了三下。"
 },
 {
  "name": "蕾蒂",
  "message": "「为什么要道歉呢？我感觉非常充实」"
 },
 {
  "message": "她笑了，有点害羞的样子。"
 },
 {
  "message": "那样子，实在可爱得不行。"
 },
 {
  "name": "{fn}",
  "message": "「那……还能再来吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯……请」"
 },
 {
  "message": "斑鸠学姐微微闭眼，那模样让人心痒痒。"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯啾……啾……啾……」"
 },
 {
  "message": "我们啄了一下、又一下。"
 },
 {
  "message": "随后，我们凝视着彼此。"
 },
 {
  "name": "蕾蒂",
  "message": "「哈啊……♪」"
 },
 {
  "message": "斑鸠学姐长舒一口气，听着软软的。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊，我明白了」"
 },
 {
  "message": "斑鸠学姐有些不好意思地笑了。"
 },
 {
  "name": "蕾蒂",
  "message": "「……原来，这就是……开心」"
 },
 {
  "message": "她笑起来还是那样纯洁，可又多了点女人味。"
 },
 {
  "name": "{fn}",
  "message": "「……学姐」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯」"
 },
 {
  "message": "感觉她的眼睛像无底洞。"
 },
 {
  "name": "{fn}",
  "message": "「我能叫你的名字吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「当然，您怎么顺口怎么叫」"
 },
 {
  "name": "{fn}",
  "message": "「……斯卡蕾特？」"
 },
 {
  "message": "不对，感觉还是太见外了。"
 },
 {
  "name": "{fn}",
  "message": "「蕾蒂」"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……♪」"
 },
 {
  "message": "斑鸠学姐笑得像个小女孩，好看得让人移不开眼。"
 },
 {
  "name": "蕾蒂",
  "message": "「谢谢……请像平常那样跟我说话吧。不，是我希望您这样」"
 },
 {
  "name": "{fn}",
  "message": "「好的……不对，嗯，蕾蒂」"
 },
 {
  "name": "蕾蒂",
  "message": "「……谢谢您」"
 },
 {
  "name": "{fn}",
  "message": "「该说谢谢的是我……嗯」"
 },
 {
  "name": "蕾蒂",
  "message": "「啾……哈啊，啾噗……♪」"
 },
 {
  "message": "说着，我又吻了上去。蕾蒂也欣然回应。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人」"
 },
 {
  "message": "晚些时候，我正打算关好门窗回房间，蕾蒂却叫住了我。"
 },
 {
  "name": "{fn}",
  "message": "「怎么了……有事吗？」"
 },
 {
  "message": "虽然还不习惯，但能用这么亲近的语气跟她说话，总觉得心里有点发痒。"
 },
 {
  "name": "蕾蒂",
  "message": "「那个……如果您方便的话，今晚……能继续让我陪着您一起睡吗？」"
 },
 {
  "name": "{fn}",
  "message": "「欸……可以吗？」"
 },
 {
  "message": "面对这求之不得的提议，我忍不住傻乎乎地反问。"
 },
 {
  "name": "蕾蒂",
  "message": "「当然，只要您想，我……也会很开心」"
 },
 {
  "name": "{fn}",
  "message": "「那……就拜托你了」"
 },
 {
  "name": "蕾蒂",
  "message": "「好的，我这就去准备」"
 },
 {
  "message": "蕾蒂像是松了口气，轻轻点了点头。"
 },
 {
  "name": "{fn}",
  "message": "（嗯……准备？）"
 },
 {
  "name": "蕾蒂",
  "message": "「让您久等了」"
 },
 {
  "name": "{fn}",
  "message": "「欸，那、那身衣服是……」"
 },
 {
  "message": "蕾蒂只穿了一件白衬衫，是一身很随性的打扮。"
 },
 {
  "name": "蕾蒂",
  "message": "「是的，我听说这样睡觉更好」"
 },
 {
  "name": "{fn}",
  "message": "「是、是吗……」"
 },
 {
  "message": "该不会是叶梦她们教她的吧？"
 },
 {
  "name": "{fn}",
  "message": "（这简直……简直是天上掉馅饼啊！！）"
 },
 {
  "message": "怪不得之前找不着这件衬衫，既然蕾蒂在穿，那就完全没问题了。"
 },
 {
  "name": "{fn}",
  "message": "「那、那……请进」"
 },
 {
  "name": "蕾蒂",
  "message": "「那我就打扰了」"
 },
 {
  "message": "说着，蕾蒂也钻进了我的被窝。"
 },
 {
  "name": "{fn}",
  "message": "（唔哇……）"
 },
 {
  "message": "之前她穿着女仆装陪我睡时已经够让我心跳不已了，这身清凉的衬衫更是别有一番风味。"
 },
 {
  "name": "{fn}",
  "message": "（胸……好大……）"
 },
 {
  "message": "蕾蒂一躺下，胸便随之剧烈地晃动起来。"
 },
 {
  "name": "蕾蒂",
  "message": "「您怎么了？」"
 },
 {
  "name": "{fn}",
  "message": "「没、没事……只是在想，会不会太挤了？睡着不难受吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「不会……反而……感觉很舒服」"
 },
 {
  "message": "她放松地笑了。"
 },
 {
  "message": "看到她露出这般从未有过的神情，我心里又高兴又激动。"
 },
 {
  "name": "蕾蒂",
  "message": "「我倒是没事，主人您会不会睡不着？」"
 },
 {
  "name": "{fn}",
  "message": "「我没关系」"
 },
 {
  "message": "话虽如此，蕾蒂身上飘来的幽香，简直让人受不了。"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "message": "蕾蒂凝视着我，伸出手，在我的胸口上咚咚地敲了三下。"
 },
 {
  "name": "{fn}",
  "message": "「蕾蒂？」"
 },
 {
  "name": "蕾蒂",
  "message": "「您好像有点紧张，我想这样或许能让您放松下来」"
 },
 {
  "name": "{fn}",
  "message": "「谢谢」"
 },
 {
  "message": "作为回应，我也轻轻叩了叩蕾蒂的手。"
 },
 {
  "name": "蕾蒂",
  "message": "「……那个」"
 },
 {
  "message": "蕾蒂先是看了看我的手，然后抬眼望向我，像是在确认什么。"
 },
 {
  "name": "蕾蒂",
  "message": "「只是……手吗？」"
 },
 {
  "name": "{fn}",
  "message": "「欸？」"
 },
 {
  "name": "蕾蒂",
  "message": "「不能，像我对您一样吗？」"
 },
 {
  "name": "{fn}",
  "message": "「像你一样……」"
 },
 {
  "message": "蕾蒂又在我的胸口上敲了敲。"
 },
 {
  "name": "{fn}",
  "message": "「不是，可，这样……」"
 },
 {
  "message": "那不就等于……要碰那里了吗。"
 },
 {
  "name": "蕾蒂",
  "message": "「不行吗？」"
 },
 {
  "name": "{fn}",
  "message": "「呜……」"
 },
 {
  "message": "她一脸失落，可这种提议我哪会讨厌，反倒巴不得呢。"
 },
 {
  "name": "{fn}",
  "message": "「那、那就……」"
 },
 {
  "message": "我伸出手，在蕾蒂的胸前轻轻敲了一下。"
 },
 {
  "message": "噗扭，噗扭，噗扭。"
 },
 {
  "name": "{fn}",
  "message": "「哇……」"
 },
 {
  "message": "手心软软的，像被什么东西托住了，还带着点回弹。"
 },
 {
  "name": "蕾蒂",
  "message": "「哈啊……哈啊……是，谢谢主人」"
 },
 {
  "message": "蕾蒂随即露出一副满足的表情。"
 },
 {
  "name": "{fn}",
  "message": "「我才应该说谢谢……」"
 },
 {
  "name": "蕾蒂",
  "message": "「被主人这样碰着，心里暖洋洋的，像有什么东西化开了」"
 },
 {
  "name": "{fn}",
  "message": "「……是吗」"
 },
 {
  "message": "看她笑得那么纯粹，我刚才那些下流的念头一下子散了，只剩下想好好疼她的念头。"
 },
 {
  "name": "{fn}",
  "message": "「那，敲到困为止？」"
 },
 {
  "name": "蕾蒂",
  "message": "「……嗯♪」"
 },
 {
  "message": "于是，就这么互相敲着对方的胸口，直到困意袭来。"
 }
]