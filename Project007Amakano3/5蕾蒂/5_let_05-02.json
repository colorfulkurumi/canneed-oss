[
 {
  "message": "期末考试顺利结束，今天能早点回去。"
 },
 {
  "message": "除斑鸠学姐外，其他人放学后好像都有事。两个人一起吃完午饭后，我就回房休息了一会儿。"
 },
 {
  "name": "{fn}",
  "message": "「唔……」"
 },
 {
  "message": "不经意间看向窗外，庭院里的床单正随风飘动。应该是斑鸠学姐洗的吧。"
 },
 {
  "message": "纯白的床单在蓝天下格外显眼。"
 },
 {
  "name": "{fn}",
  "message": "「啊……」"
 },
 {
  "message": "只见斑鸠学姐正在收床单。"
 },
 {
  "name": "{fn}",
  "message": "「辛苦了」"
 },
 {
  "name": "蕾蒂",
  "message": "「主人，有什么事吗？」"
 },
 {
  "name": "{fn}",
  "message": "「我来帮忙吧，床单不好抱，两个人一起收快一点」"
 },
 {
  "name": "蕾蒂",
  "message": "「不用，这是我该做的，请交给我吧」"
 },
 {
  "message": "她态度这么坚定，看来是不会让步了。"
 },
 {
  "message": "大概是她作为女仆的执着吧。虽然做饭的事交给了我，但其他杂务她还是想自己来。"
 },
 {
  "name": "{fn}",
  "message": "「我明白了」"
 },
 {
  "message": "看她也不是在勉强自己，我一般就由着她了。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "message": "女仆收床单……怎么说呢，还挺有那味的。"
 },
 {
  "message": "今天大家都不在，此时的宿舍里只有我们两个人。"
 },
 {
  "name": "{fn}",
  "message": "「说起来，今天晚饭做炖菜怎么样？」"
 },
 {
  "message": "我趁机琢磨起晚饭做什么。"
 },
 {
  "name": "蕾蒂",
  "message": "「……炖菜吗，我听说那是祖母大人亲手教的」"
 },
 {
  "name": "{fn}",
  "message": "「是的」"
 },
 {
  "name": "蕾蒂",
  "message": "「做那道菜，大家应该都会很高兴吧？」"
 },
 {
  "name": "{fn}",
  "message": "「那当然。炖菜要煮久一点才入味，等衣服收好——」"
 },
 {
  "message": "——啪嗒。"
 },
 {
  "name": "{fn}",
  "message": "「咦？」"
 },
 {
  "message": "天色说变就变，雨点噼里啪啦地砸了下来。"
 },
 {
  "name": "{fn}",
  "message": "「糟了，雷阵雨？！」"
 },
 {
  "name": "蕾蒂",
  "message": "「这……」"
 },
 {
  "name": "{fn}",
  "message": "「快把衣服收进来！」"
 },
 {
  "name": "蕾蒂",
  "message": "「是」"
 },
 {
  "message": "这时候斑鸠学姐也没再坚持，急忙收拾起晾着的衣服。"
 },
 {
  "name": "{fn}",
  "message": "「哇哇，糟了！」"
 },
 {
  "message": "转眼间就下起了倾盆大雨。"
 },
 {
  "name": "{fn}",
  "message": "（这天气变得也太快了吧！）"
 },
 {
  "name": "{fn}",
  "message": "「斑鸠学姐，你还好吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯，把这件收完就——」"
 },
 {
  "name": "蕾蒂",
  "message": "「？！」"
 },
 {
  "name": "{fn}",
  "message": "「哇……」"
 },
 {
  "message": "刚才那声雷……好近。"
 },
 {
  "name": "{fn}",
  "message": "「学姐，你没事——」"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "斑鸠学姐突然腿一软，跌坐在地上。"
 },
 {
  "name": "{fn}",
  "message": "「斑、斑鸠学姐？」"
 },
 {
  "message": "我把手里的衣服往屋里一扔，冲到了学姐身边。"
 },
 {
  "message": "刚才那声雷确实吓人。对烟花声都怕的斑鸠学姐来说，这定可怕极了——"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……啊……」"
 },
 {
  "name": "{fn}",
  "message": "「欸？」"
 },
 {
  "message": "不对劲。"
 },
 {
  "message": "和之前不一样，这次彻底不对了。"
 },
 {
  "message": "掉在地上的床单被雨水打湿，转眼就沾满了泥。"
 },
 {
  "name": "蕾蒂",
  "message": "「……啊……啊……」"
 },
 {
  "message": "斑鸠学姐僵在那儿，浑身抖个不停。"
 },
 {
  "name": "{fn}",
  "message": "「！对不起！！」"
 },
 {
  "message": "我也管不了那么多了，半扶半抱地把她弄进了屋里。"
 },
 {
  "name": "{fn}",
  "message": "「呜哇」"
 },
 {
  "message": "窗外电光一闪，紧接着一声炸雷，像要把天撕开一样。"
 },
 {
  "message": "闪电和雷声几乎是同时的……？"
 },
 {
  "name": "{fn}",
  "message": "「床单只好重洗了，还好别的东西没事……」"
 },
 {
  "message": "我尽量让自己的声音平稳一些。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊、啊、啊……」"
 },
 {
  "message": "可斑鸠学姐还是那样。"
 },
 {
  "name": "{fn}",
  "message": "「学姐？学姐？」"
 },
 {
  "message": "我怎么叫她都没反应，眼中空空的，一点光都没有。"
 },
 {
  "message": "她平时就像人偶一样精致，而此刻，那双眼睛就像玻璃珠一样，仿佛失去了灵魂——"
 },
 {
  "name": "蕾蒂",
  "message": "「噫！」"
 },
 {
  "message": "她猛地一抽，整个人都在哆嗦。脸上全是恐惧。"
 },
 {
  "name": "蕾蒂",
  "message": "「A……oh……」"
 },
 {
  "name": "{fn}",
  "message": "「斑鸠学姐！！」"
 },
 {
  "message": "我摇了摇她的肩膀，她还是一点反应都没有。"
 },
 {
  "name": "蕾蒂",
  "message": "「？！」"
 },
 {
  "message": "她整个人又狠狠抖了一下。"
 },
 {
  "name": "蕾蒂",
  "message": "「No,no……」"
 },
 {
  "message": "她像在自言自语，声音轻得几乎听不见。"
 },
 {
  "name": "{fn}",
  "message": "「没事的，雷不会打到这儿来。没事的，没事的……」"
 },
 {
  "message": "看她怕成这样，我一把将她搂进怀里。"
 },
 {
  "message": "把她抱在怀里，我才真切感觉到她抖得多厉害、多害怕。"
 },
 {
  "name": "{fn}",
  "message": "「没事的……没事的……」"
 },
 {
  "message": "我一遍遍说着没事的，手在她后背轻轻拍了两下。像之前那样，用我们那个暗号。"
 },
 {
  "name": "蕾蒂",
  "message": "「Sorry……Sorry……」"
 },
 {
  "name": "{fn}",
  "message": "「学姐……？」"
 },
 {
  "name": "蕾蒂",
  "message": "「……Forgive me」"
 },
 {
  "message": "她翻来覆去念叨着什么……英语吗？是在道歉？"
 },
 {
  "message": "是在道歉吗……对了，她确实像外国人。"
 },
 {
  "name": "{fn}",
  "message": "「没事的……没事的……呃，Don't worry？」"
 },
 {
  "message": "我像哄小孩似的抱着她，在她背上轻轻拍了两下。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……啊……唔……」"
 },
 {
  "message": "可斑鸠学姐没有反应。"
 },
 {
  "name": "蕾蒂",
  "message": "「呼……呼……」"
 },
 {
  "message": "雷声慢慢小了，斑鸠学姐大概是累坏了，靠在我怀里没了动静。"
 },
 {
  "name": "{fn}",
  "message": "「斑鸠学姐……」"
 },
 {
  "message": "不喜欢巨大的响声……是因为雷声吗。"
 },
 {
  "message": "烟花的声音，和落雷的轰鸣声确实很像。"
 },
 {
  "message": "而且之前暴雨天盘子摔碎那次，动静也跟打雷差不多。"
 },
 {
  "message": "……大概，就是这样吧。"
 },
 {
  "message": "可她怕成那副样子……"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "斑鸠学姐睁开了眼睛。"
 },
 {
  "name": "蕾蒂",
  "message": "「……主……人？」"
 },
 {
  "name": "{fn}",
  "message": "「啊，不好意思」"
 },
 {
  "message": "我这才意识到，自己一直下意识地抱着她。"
 },
 {
  "name": "蕾蒂",
  "message": "「不，该道歉的是我」"
 },
 {
  "message": "斑鸠学姐从我怀里退开，低头行了一礼。看样子已经恢复了平时的状态。"
 },
 {
  "name": "{fn}",
  "message": "「你没事吧……感觉怎么样？」"
 },
 {
  "name": "蕾蒂",
  "message": "「是的，劳您挂心，实在愧疚」"
 },
 {
  "name": "{fn}",
  "message": "「那个……你怕打雷？」"
 },
 {
  "message": "我犹豫着不知该如何组织措辞，最后还是决定直接问出口。"
 },
 {
  "name": "蕾蒂",
  "message": "「……是的，方才在您面前失态，深感抱歉」"
 },
 {
  "message": "在我看来，那远不止失态这么简单……"
 },
 {
  "name": "{fn}",
  "message": "「不用道歉，斑鸠学姐你没事就好」"
 },
 {
  "name": "{fn}",
  "message": "「那个，虽然情况特殊，但这样抱住你还是不好意思了」"
 },
 {
  "message": "仔细想想，这几天我跟斑鸠学姐来来回回都在互相道歉。"
 },
 {
  "name": "蕾蒂",
  "message": "「不……感谢您」"
 },
 {
  "name": "{fn}",
  "message": "「这样啊……那就好」"
 },
 {
  "name": "蕾蒂",
  "message": "「好……吗？」"
 },
 {
  "message": "她静静想了一会儿。"
 },
 {
  "message": "然后主动抱住了我。"
 },
 {
  "name": "{fn}",
  "message": "「欸……？斑鸠学姐？」"
 },
 {
  "name": "蕾蒂",
  "message": "「……这样，好吗？」"
 },
 {
  "message": "她小心翼翼地问了一句。"
 },
 {
  "message": "湿透的女仆装贴在身上，我能感觉到她的体温。再抬头，她的脸近在眼前。"
 },
 {
  "message": "斑鸠学姐的碧瞳里，映着小小的我。"
 },
 {
  "name": "{fn}",
  "message": "「……嗯」"
 },
 {
  "message": "咚、咚、咚。"
 },
 {
  "message": "我点点头，手在她背上轻轻敲了三下。"
 },
 {
  "name": "蕾蒂",
  "message": "「……啊，既然如此，再抱一会儿吧」"
 },
 {
  "message": "她这次好像明白了，话虽如此——"
 },
 {
  "name": "{fn}",
  "message": "「这、这样吗……」"
 },
 {
  "name": "蕾蒂",
  "message": "「如果您不介意，这样，很有意义」"
 },
 {
  "message": "被她这么抱着，我脸上有点发烫。但看她变回平常的样子，心里那块石头总算落了地。"
 }
]