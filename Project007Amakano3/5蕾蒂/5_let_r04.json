[
 {
  "message": "……海。"
 },
 {
  "message": "而且今天不是来钓鱼的，是来游泳的。"
 },
 {
  "message": "——不，老实说，游泳也只是顺带的。"
 },
 {
  "message": "毕竟，斑鸠学姐要穿泳装给我看啊。"
 },
 {
  "message": "她平时总是穿着女仆装，包得严严实实的。"
 },
 {
  "message": "硬要说例外，也就运动服那次……不对，那身其实也够猛了。"
 },
 {
  "message": "她现在正在海之家换衣服……我已经等不及了。"
 },
 {
  "name": "{fn}",
  "message": "「……唔」"
 },
 {
  "message": "淡定淡定。"
 },
 {
  "message": "光是想象一下，嘴角就快压不住了。可不能给女朋友看笑话。"
 },
 {
  "message": "总之，先活动活动身体——"
 },
 {
  "message": "嗯……？"
 },
 {
  "message": "不知怎的，周围忽然一阵嘈杂。"
 },
 {
  "message": "游客们的视线全往同一个方向飘去。"
 },
 {
  "name": "海水浴游客甲",
  "message": "「那、那个人是谁……模特吗？哪个大明星偷偷跑出来玩了？」"
 },
 {
  "name": "海水浴游客乙",
  "message": "「美、美得不像真人啊……」"
 },
 {
  "message": "莫非是——斑鸠学姐？"
 },
 {
  "name": "蕾蒂",
  "message": "「主人，让您久等了」"
 },
 {
  "name": "{fn}",
  "message": "「没有，我也刚——」"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "message": "我刚才那些胡思乱想，在她面前根本不够看。"
 },
 {
  "message": "美得叫人喘不上气。那身白得近乎透明的肌肤，在阳光下亮得晃眼。"
 },
 {
  "message": "明艳之外，还带着点健康的性感。"
 },
 {
  "name": "{fn}",
  "message": "（这、这就是我的女朋友吗……我真有福消受吗）"
 },
 {
  "name": "蕾蒂",
  "message": "「您怎么了？」"
 },
 {
  "name": "{fn}",
  "message": "「不，这也太好看了，好看得不像真的，好有魅力……」"
 },
 {
  "name": "蕾蒂",
  "message": "「这样可以吗？」"
 },
 {
  "name": "{fn}",
  "message": "「当然可以！简直完美！！」"
 },
 {
  "message": "我不由自主地拔高了音量。"
 },
 {
  "name": "蕾蒂",
  "message": "「也就是说，您很喜欢吗？」"
 },
 {
  "name": "{fn}",
  "message": "「嗯……那个，谢谢你为了我穿这身」"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "她眼睛微微睁大了些。"
 },
 {
  "name": "蕾蒂",
  "message": "「……那，大家没白帮我挑这一趟」"
 },
 {
  "message": "她朝我轻轻鞠了一躬。说真的，我真该谢谢宿舍那帮家伙。"
 },
 {
  "name": "海水浴游客甲",
  "message": "「欸，那男的是她男朋友吗……」"
 },
 {
  "name": "海水浴游客乙",
  "message": "「也、也太让人嫉妒了吧……！」"
 },
 {
  "message": "果然，所有人的目光都集中在我们身上。"
 },
 {
  "name": "{fn}",
  "message": "「那、那个，我们去海里吧！」"
 },
 {
  "message": "我实在受不了被这么盯着看，拉起她的手就往海边走。"
 },
 {
  "name": "{fn}",
  "message": "「说起来，你以前来过海边吗……？」"
 },
 {
  "message": "浪花拍打在我们脚边。我开口问道。"
 },
 {
  "name": "蕾蒂",
  "message": "「几乎，没来过」"
 },
 {
  "name": "蕾蒂",
  "message": "「唔……」"
 },
 {
  "message": "浪花打湿她的脚，她惊得后退一步，攥紧了我的手。"
 },
 {
  "name": "{fn}",
  "message": "「没事吧？」"
 },
 {
  "name": "蕾蒂",
  "message": "「……嗯，吓了一跳」"
 },
 {
  "message": "她低头盯着没过脚踝的浪花，眼神里全是好奇。可爱得要命。"
 },
 {
  "name": "{fn}",
  "message": "「既然这样，就别勉强自己了。我们就在水边走走吧？」"
 },
 {
  "name": "蕾蒂",
  "message": "「不，我们再往里走走吧，主人也想的吧」"
 },
 {
  "name": "{fn}",
  "message": "「好，那就再往里走一点」"
 },
 {
  "message": "她都这么说了，而且被她这么依靠，我心里一阵窃喜。"
 },
 {
  "name": "蕾蒂",
  "message": "「啊……」"
 },
 {
  "message": "走到水深及腰的地方，她果然紧紧靠了过来。到底还是不习惯在水里站着。"
 },
 {
  "message": "好软。"
 },
 {
  "name": "{fn}",
  "message": "「哦哇……」"
 },
 {
  "message": "她的胸正抵着我的胳膊。我第一次这么真实地感受到她肌肤的柔软。"
 },
 {
  "message": "说是柔软，倒不如说滑溜溜的……人的皮肤，真能细腻到这种程度？"
 },
 {
  "message": "我心里只剩惊叹。"
 },
 {
  "name": "{fn}",
  "message": "「……太棒了」"
 },
 {
  "name": "蕾蒂",
  "message": "「主人？」"
 },
 {
  "name": "{fn}",
  "message": "「啊，没什么……谢谢」"
 },
 {
  "name": "蕾蒂",
  "message": "「？」"
 },
 {
  "message": "她歪了歪头……不是，我在胡说八道些什么啊。"
 },
 {
  "name": "{fn}",
  "message": "「既然不习惯在水里站着，那游泳……？」"
 },
 {
  "name": "蕾蒂",
  "message": "「也没有游过」"
 },
 {
  "name": "{fn}",
  "message": "「这、这样啊……」"
 },
 {
  "message": "不过，以她的运动天赋……"
 },
 {
  "name": "{fn}",
  "message": "「想学学看吗？我可以教你」"
 },
 {
  "name": "蕾蒂",
  "message": "「如果我学会游泳，能让主人高兴的话」"
 },
 {
  "message": "就这样，我开始教她游泳。"
 },
 {
  "name": "{fn}",
  "message": "「……开玩笑的吧」"
 },
 {
  "message": "我才教了她没多久，她就已经游得像模像样了。"
 },
 {
  "name": "蕾蒂",
  "message": "「噗哈……您看如何？」"
 },
 {
  "message": "她从稍远的地方游了过来，呼吸都没乱，开口问我。"
 },
 {
  "name": "{fn}",
  "message": "「太、太强了……你确定这真是第一次游泳？」"
 },
 {
  "name": "蕾蒂",
  "message": "「是的，都是主人您教得好」"
 },
 {
  "name": "{fn}",
  "message": "「是这样吗……」"
 },
 {
  "message": "说真的，我不太信。"
 },
 {
  "name": "{fn}",
  "message": "「游起来感觉怎么样？」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯，心情很舒畅……水族馆里那些海兽，平时也是这种感觉吗？」"
 },
 {
  "name": "{fn}",
  "message": "「我想应该差不多吧」"
 },
 {
  "message": "水族馆里那些海兽区的家伙们，游泳的时候看上去确实总是一副很享受的样子。"
 },
 {
  "name": "蕾蒂",
  "message": "「这样啊……」"
 },
 {
  "message": "她大概是在想乙姬那些海狗们吧。"
 },
 {
  "name": "{fn}",
  "message": "「下次去水族馆，记得把你的感受告诉它们哦」"
 },
 {
  "name": "蕾蒂",
  "message": "「……是」"
 },
 {
  "message": "她点点头，表情比平时柔和不少，看起来挺期待的。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "message": "平时就好看，穿泳装也好看，但这个样子的她，最让我心动。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人？」"
 },
 {
  "name": "{fn}",
  "message": "「……那个，我觉得你刚才的表情……特别好看」"
 },
 {
  "name": "蕾蒂",
  "message": "「我的表情？」"
 },
 {
  "message": "她愣了一下。"
 },
 {
  "name": "{fn}",
  "message": "「看到你露出那样的表情，我很高兴」"
 },
 {
  "name": "蕾蒂",
  "message": "「那是……什么样的表情……？」"
 },
 {
  "message": "她疑惑地摸了摸脸，意识到的瞬间，表情都僵住了。"
 },
 {
  "name": "{fn}",
  "message": "「啊……我们再去游会儿吧」"
 },
 {
  "message": "我想那样或许能让她放松下来。"
 },
 {
  "name": "蕾蒂",
  "message": "「我明白了」"
 },
 {
  "message": "看来她确实喜欢游泳，立即点了点头。"
 },
 {
  "name": "{fn}",
  "message": "「哈啊……游得真痛快……」"
 },
 {
  "message": "回到遮阳伞下，我长舒了一口气。"
 },
 {
  "message": "看她游得越来越好，我自己也跟着游上了瘾。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人，喝点水吧」"
 },
 {
  "message": "斑鸠学姐从冷藏箱里取出矿泉水递给我。"
 },
 {
  "name": "{fn}",
  "message": "「谢谢」"
 },
 {
  "name": "蕾蒂",
  "message": "「不，您教了我这么久，也活动了很久，一定累了吧」"
 },
 {
  "name": "{fn}",
  "message": "「你才是，刚才游得那么起劲」"
 },
 {
  "name": "蕾蒂",
  "message": "「是的，感觉舒畅了不少」"
 },
 {
  "message": "看来她不讨厌游泳本身，一脸满足。"
 },
 {
  "message": "……嗯，就是这个表情。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人，您玩得尽兴吗？」"
 },
 {
  "name": "{fn}",
  "message": "「当然了，托你的福」"
 },
 {
  "name": "蕾蒂",
  "message": "「是吗……」"
 },
 {
  "message": "她思考了一下。"
 },
 {
  "name": "蕾蒂",
  "message": "「如果您累了，枕在我腿上吧」"
 },
 {
  "name": "{fn}",
  "message": "「欸？」"
 },
 {
  "name": "蕾蒂",
  "message": "「请」"
 },
 {
  "message": "她理所当然地拍了拍自己的大腿。"
 },
 {
  "name": "{fn}",
  "message": "「呃，这……不太好吧……」"
 },
 {
  "name": "蕾蒂",
  "message": "「以前我也枕着主人的腿睡着过。所以，也请主人不要客气」"
 },
 {
  "message": "她说的应该是我第一次发现她站着睡着那次吧。"
 },
 {
  "message": "然而，她现在穿着泳装，大腿就这么光着。"
 },
 {
  "name": "蕾蒂",
  "message": "「您……不喜欢吗？」"
 },
 {
  "message": "她那一脸失落，谁受得了啊。"
 },
 {
  "name": "{fn}",
  "message": "「我怎么会讨厌呢」"
 },
 {
  "name": "{fn}",
  "message": "「我……我……」"
 },
 {
  "message": "我紧张地把头枕到了她的腿上。"
 },
 {
  "message": "海水味里，混着她身上的气息。而且，她的大腿是那么柔软。"
 },
 {
  "message": "皮肤还是海里那样，滑溜溜的。"
 },
 {
  "message": "不知是天太热，还是刚游完泳，她的肌肤透着一股温热。"
 },
 {
  "name": "蕾蒂",
  "message": "「感觉怎么样？」"
 },
 {
  "name": "{fn}",
  "message": "「非常……舒服」"
 },
 {
  "message": "视线只要稍稍上移，就能看到那巍峨的山峰随着她的动作微微摇曳。"
 },
 {
  "name": "{fn}",
  "message": "（好近……好大……）"
 },
 {
  "message": "这谁顶得住啊，心跳快得要命。"
 },
 {
  "name": "蕾蒂",
  "message": "「主人，怎么了？」"
 },
 {
  "name": "{fn}",
  "message": "「没什么，谢谢你……」"
 },
 {
  "name": "蕾蒂",
  "message": "「能帮上您就好」"
 },
 {
  "message": "她用手轻轻揉了揉我的头。"
 },
 {
  "name": "{fn}",
  "message": "「唔……」"
 },
 {
  "name": "蕾蒂",
  "message": "「不喜欢吗？」"
 },
 {
  "name": "{fn}",
  "message": "「不，继续吧」"
 },
 {
  "message": "我轻轻敲了敲她抚摸着我的手。"
 },
 {
  "name": "蕾蒂",
  "message": "「好的……」"
 },
 {
  "message": "她知道我『感觉可以』，继续缓缓地摸着我的头。"
 },
 {
  "message": "心跳得厉害，又害羞又舒服……根本受不住。"
 },
 {
  "name": "蕾蒂",
  "message": "「您睡一会儿午觉也可以」"
 },
 {
  "message": "我真想就这么睡过去……可她自己呢？"
 },
 {
  "message": "总是顾着我。"
 },
 {
  "name": "{fn}",
  "message": "「你呢，感觉怎么样，累了没……」"
 },
 {
  "name": "蕾蒂",
  "message": "「主人开心，我就幸福」"
 },
 {
  "name": "{fn}",
  "message": "「那你自己呢？开心吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「这个……我不太清楚」"
 },
 {
  "name": "{fn}",
  "message": "「这、这样啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「但是……我想，我现在应该是开心的」"
 },
 {
  "message": "我抬起头，见她正生硬地朝我笑。"
 },
 {
  "message": "她这么说，是怕我不高兴，还是真的不懂什么叫开心？"
 },
 {
  "message": "明明已经交往了，我还是摸不透她在想什么。"
 },
 {
  "message": "不过，只要她有一丁点开心，我就够了。"
 },
 {
  "name": "{fn}",
  "message": "「下次去做点你想做的事吧」"
 },
 {
  "name": "蕾蒂",
  "message": "「只要做主人想做的，就好」"
 },
 {
  "name": "{fn}",
  "message": "「但是……」"
 },
 {
  "name": "蕾蒂",
  "message": "「能陪在您身边，于我而言就是最幸福的」"
 },
 {
  "name": "{fn}",
  "message": "「这算梦想吗？」"
 },
 {
  "message": "这是身为女仆……还是身为恋人？我将心中的疑问模棱两可地问出了口。"
 },
 {
  "name": "蕾蒂",
  "message": "「大概……算吧」"
 },
 {
  "message": "她含糊地回答道。"
 },
 {
  "name": "蕾蒂",
  "message": "「只是，能再……这样……多待一会儿吗？」"
 },
 {
  "message": "哪怕不清楚，她也很珍惜现在的时光。"
 },
 {
  "name": "{fn}",
  "message": "「当然，谢谢」"
 },
 {
  "message": "光是这样，我已经很高兴了。"
 }
]