[
 {
  "message": "期末考总算结束，暑假也跟着来了。"
 },
 {
  "message": "而我们高二的头等大事，就是修学旅行。"
 },
 {
  "message": "我们已经到了这次修学旅行的目的地，古都。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "name": "地藏",
  "message": "「喂～发什么呆呢？」"
 },
 {
  "name": "{fn}",
  "message": "「啊，没什么……」"
 },
 {
  "message": "阿藏拍了我肩膀一下，我这才回过神来。"
 },
 {
  "message": "对了，我现在正和小组一起在古都的街道上玩呢。"
 },
 {
  "name": "地藏",
  "message": "「你傻站着干嘛，热傻了吗？」"
 },
 {
  "name": "{fn}",
  "message": "「啊……确实挺热的。要不找个地方歇会儿？」"
 },
 {
  "message": "我连忙岔开话题。"
 },
 {
  "name": "纱由美",
  "message": "「你最近一直和蕾蒂黏在一起吧。蕾蒂不在身边，寂寞了？」"
 },
 {
  "name": "{fn}",
  "message": "「才、才没有」"
 },
 {
  "message": "纱由半开玩笑地逗我，我下意识想反驳……却没多少底气。"
 },
 {
  "name": "诗梦",
  "message": "「……一看就懂」"
 },
 {
  "name": "冬桦",
  "message": "「嗯，好舍不得的样子」"
 },
 {
  "message": "柳木和冬桦也这么觉得。"
 },
 {
  "name": "{fn}",
  "message": "「是、是吗？」"
 },
 {
  "message": "嘴上再不承认，我也知道没说服力。"
 },
 {
  "message": "毕竟最近一直跟斑鸠学姐形影不离。就像她们说的，她不在旁边，我确实觉得少了点什么……说白了就是寂寞。"
 },
 {
  "name": "{fn}",
  "message": "（也就是说……这样啊）"
 },
 {
  "name": "纱由美",
  "message": "「哇♪ 这个泥人好可爱——♪」"
 },
 {
  "name": "冬桦",
  "message": "「是只小狐狸呢。唔……要是做成海豹大人的样子，肯定更可爱」"
 },
 {
  "name": "纱由美",
  "message": "「冬冬，至于跟个泥人较劲吗……？」"
 },
 {
  "message": "我们走进一家卖伴手礼的小店。"
 },
 {
  "name": "{fn}",
  "message": "（……斑鸠学姐看到这种东西，会怎么想呢？）"
 },
 {
  "message": "还是给她买点什么带回去吧。"
 },
 {
  "name": "地藏",
  "message": "「……又～想什么呢」"
 },
 {
  "name": "{fn}",
  "message": "「我、我哪有！」"
 },
 {
  "name": "地藏",
  "message": "「我说你啊，心思全都写在脸上了……」"
 },
 {
  "message": "阿藏一脸无奈地说道，有那么明显吗？"
 },
 {
  "name": "冬桦",
  "message": "「你是在担心蕾蒂她们吗？」"
 },
 {
  "name": "纱由美",
  "message": "「放心啦。多亏了你，她现在都会做饭了。你来之前，她不也自己照顾自己的嘛」"
 },
 {
  "name": "{fn}",
  "message": "「这我当然知道」"
 },
 {
  "name": "纱由美",
  "message": "「不过看你的表情，也不像是在担心呢……呵呵呵」"
 },
 {
  "message": "纱由若有所思。"
 },
 {
  "name": "{fn}",
  "message": "「不，我这是担心家人」"
 },
 {
  "name": "诗梦",
  "message": "「胆小鬼」"
 },
 {
  "name": "{fn}",
  "message": "「呜」"
 },
 {
  "name": "诗梦",
  "message": "「拿家人当挡箭牌，躲得挺舒服啊」"
 },
 {
  "message": "诗梦冷冷地说道。"
 },
 {
  "name": "冬桦",
  "message": "「这是什么意思呀？」"
 },
 {
  "name": "诗梦",
  "message": "「谁知道呢？」"
 },
 {
  "message": "冬桦好像没听懂……但我听得明白。"
 },
 {
  "name": "{fn}",
  "message": "（……说得没错）"
 },
 {
  "message": "我心里清楚。并不是因为斑鸠学姐是家人，或者她想当女仆。"
 },
 {
  "message": "我跟她待在一起，才不是因为这些。说白了，原因简单得很。"
 },
 {
  "message": "我就是有目的——"
 },
 {
  "name": "蕾蒂",
  "message": "「还合您胃口吗？」"
 },
 {
  "message": "今天晚饭，我点名让她做了回锅肉。"
 },
 {
  "name": "叶梦",
  "message": "「嗯，味道棒棒的——♪」"
 },
 {
  "message": "特别下饭，香得很。"
 },
 {
  "name": "叶梦",
  "message": "「不过要是能再辣一点就更好了——」"
 },
 {
  "name": "蕾蒂",
  "message": "「辣味不足……我记下了」"
 },
 {
  "message": "斑斑边听边往本子上记。"
 },
 {
  "message": "明明从不试菜，还能做得这么好，简直了。"
 },
 {
  "name": "叶梦",
  "message": "「斑斑你这手艺进步也太快了吧～」"
 },
 {
  "name": "蕾蒂",
  "message": "「不敢当」"
 },
 {
  "name": "叶梦",
  "message": "「这会儿，姐姐她们应该正在吃古都特色吧——」"
 },
 {
  "name": "叶梦",
  "message": "「听说那边的汤豆腐很有名，但我查了一下，好像还有拉面店呢！」"
 },
 {
  "name": "叶梦",
  "message": "「是不是很好奇的——」"
 },
 {
  "name": "蕾蒂",
  "message": "「您想吃拉面吗？」"
 },
 {
  "name": "叶梦",
  "message": "「拉面是挺想吃的啦，但更想她们啊——！」"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "message": "斑斑沉思了片刻。"
 },
 {
  "name": "蕾蒂",
  "message": "「也许，是的」"
 },
 {
  "name": "叶梦",
  "message": "「哦哦……」"
 },
 {
  "name": "蕾蒂",
  "message": "「？」"
 },
 {
  "name": "叶梦",
  "message": "「嘻嘻，斑斑也舍不得啦？毕竟学长也跟着去古都了嘛——」"
 },
 {
  "name": "蕾蒂",
  "message": "「这个……我不清楚。只是，有点奇妙」"
 },
 {
  "name": "叶梦",
  "message": "「奇妙？这是什么感觉？」"
 },
 {
  "name": "蕾蒂",
  "message": "「以前，是有些为难……但现在，总觉得缺了点什么」"
 },
 {
  "name": "叶梦",
  "message": "「那就是寂寞啦！！」"
 },
 {
  "name": "蕾蒂",
  "message": "「这就是，寂寞……？」"
 },
 {
  "message": "听我这么说，她轻轻地拍了拍自己的胸口。"
 },
 {
  "message": "嗯，怎么看都是寂寞了。"
 },
 {
  "name": "叶梦",
  "message": "「嘻嘻嘻～斑斑你现在，可比以前好多了」"
 },
 {
  "name": "蕾蒂",
  "message": "「好……吗？」"
 },
 {
  "name": "叶梦",
  "message": "「嗯，就是……超级好！」"
 },
 {
  "name": "蕾蒂",
  "message": "「是、是吗……」"
 },
 {
  "name": "叶梦",
  "message": "（斑斑该不会喜欢上学长了吧……？恋爱了？）"
 },
 {
  "name": "叶梦",
  "message": "（随便啦，都挺好的）"
 },
 {
  "name": "叶梦",
  "message": "「嘻嘻♪ 有意思～♪」"
 }
]