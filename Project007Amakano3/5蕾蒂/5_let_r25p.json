[
 {
  "name": "蕾蒂",
  "message": "「……太羞耻了」"
 },
 {
  "name": "{fn}",
  "message": "「蕾蒂……棒死了」"
 },
 {
  "name": "蕾蒂",
  "message": "「居然发出了那么羞耻的声音……我……」"
 },
 {
  "message": "蕾蒂大概是又想起了刚才那档子事，羞得把脸埋了下去。"
 },
 {
  "name": "{fn}",
  "message": "「别这么说，我求之不得呢」"
 },
 {
  "name": "蕾蒂",
  "message": "「是，吗……？」"
 },
 {
  "name": "{fn}",
  "message": "「因为那个样子的你只属于我」"
 },
 {
  "name": "蕾蒂",
  "message": "「只属于主人……我很高兴，可心里……有点乱」"
 },
 {
  "name": "{fn}",
  "message": "「我也很喜欢下流的你啊……嗯，啾」"
 },
 {
  "message": "我亲上去，想让她别多想。"
 },
 {
  "name": "{fn}",
  "message": "「淫乱成那副样子……真的很棒」"
 },
 {
  "name": "蕾蒂",
  "message": "「既然，主人说喜欢……嗯啾」"
 },
 {
  "message": "她也亲了我一下。"
 },
 {
  "message": "她好像还有点放不开，但多少是接受了。"
 },
 {
  "message": "歇到太阳快落山，我和她才沿着岸边慢慢走。"
 },
 {
  "name": "{fn}",
  "message": "「真美啊……」"
 },
 {
  "name": "蕾蒂",
  "message": "「黄昏时的大海……真好啊」"
 },
 {
  "name": "{fn}",
  "message": "「你觉得美吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯，很明亮……」"
 },
 {
  "name": "{fn}",
  "message": "「嗯……你跟这里也挺配的」"
 },
 {
  "name": "蕾蒂",
  "message": "「<r绯红>斯卡蕾特</r>的世界……」"
 },
 {
  "name": "{fn}",
  "message": "「嗯」"
 },
 {
  "message": "在这<r绯红>斯卡蕾特</r>的世界里，蕾蒂显得格外耀眼。"
 },
 {
  "name": "蕾蒂",
  "message": "「……又到，这个时间了呢」"
 },
 {
  "name": "{fn}",
  "message": "「这是你的时间」"
 },
 {
  "name": "蕾蒂",
  "message": "「我的……嗯，是主人让我明白了它的美」"
 },
 {
  "name": "蕾蒂",
  "message": "「是主人造就了现在的我」"
 },
 {
  "message": "她把身子靠了过来。"
 },
 {
  "name": "蕾蒂",
  "message": "「所以……主人想让我什么样，我就什么样。这就是，我的幸福」"
 },
 {
  "name": "蕾蒂",
  "message": "「……嗯，啾」"
 },
 {
  "message": "蕾蒂主动亲了上来。"
 },
 {
  "name": "蕾蒂",
  "message": "「不过，我现在也变得有些任性了」"
 },
 {
  "name": "{fn}",
  "message": "「任性？」"
 },
 {
  "name": "蕾蒂",
  "message": "「就是……啾」"
 },
 {
  "message": "她又凑上来亲了一下。"
 },
 {
  "name": "蕾蒂",
  "message": "「我跟主人做这些，其实是我自己也想，舒服舒服」"
 },
 {
  "name": "蕾蒂",
  "message": "「不过，很开心」"
 },
 {
  "message": "她表情迷离地说道。"
