[
 {
  "message": "暑假结束，我和诗梦，还有宿舍的大家一起走在上学的路上。"
 },
 {
  "message": "走在身边的诗梦，自然是穿着一身校服。"
 },
 {
  "name": "诗梦",
  "message": "「……你看什么？」"
 },
 {
  "name": "{fn}",
  "message": "「没什么，就是觉得好久没见你穿校服了。感觉……还挺好看的」"
 },
 {
  "name": "诗梦",
  "message": "「……变态」"
 },
 {
  "message": "又是这句话，不过我早就听习惯了。"
 },
 {
  "name": "叶梦",
  "message": "「嘻嘻……♪」"
 },
 {
  "message": "叶梦看着我俩，一脸开心。"
 },
 {
  "name": "诗梦",
  "message": "「干嘛？」"
 },
 {
  "name": "叶梦",
  "message": "「因为——♪ 姐姐和哥哥，现在完全就是热恋中的小情侣呀！」"
 },
 {
  "message": "如她所说，诗梦正紧紧地挽着我的胳膊。"
 },
 {
  "name": "诗梦",
  "message": "「哪有……那么夸张」"
 },
 {
  "name": "蕾蒂",
  "message": "「不过……在我看来二位的确是情侣」"
 },
 {
  "name": "纱由美",
  "message": "「对呀，甜甜蜜蜜的♪」"
 },
 {
  "name": "冬桦",
  "message": "「两位感情真好……真叫人羡慕♪」"
 },
 {
  "name": "诗梦",
  "message": "「你们要这样，我就先走了」"
 },
 {
  "name": "{fn}",
  "message": "「哎呀呀」"
 },
 {
  "message": "诗梦拉着我，加快了脚步。"
 },
 {
  "name": "叶梦",
  "message": "「哎呀，姐姐害羞了呢♪」"
 },
 {
  "name": "诗梦",
  "message": "「真是的，好能闹腾」"
 },
 {
  "message": "她叹了口气，正准备松开我的手臂，我却顺势握住了她的手。当然，是十指相扣。"
 },
 {
  "name": "诗梦",
  "message": "「喂，你这样又要被她们笑了」"
 },
 {
  "name": "{fn}",
  "message": "「我不在乎」"
 },
 {
  "name": "诗梦",
  "message": "「……笨蛋」"
 },
 {
  "message": "也许她也想牵手，只是嘟囔了一句，便任由我牵着了。"
 },
 {
  "name": "诗梦",
  "message": "「今天放学后怎么安排？」"
 },
 {
  "message": "课间休息的时候，诗梦向我问道。"
 },
 {
  "name": "{fn}",
  "message": "「我得去买点东西，要不要一起？」"
 },
 {
  "name": "诗梦",
  "message": "「……我正想这么说」"
 },
 {
  "name": "{fn}",
  "message": "「行」"
 },
 {
  "name": "地藏",
  "message": "「哦哦～～～」"
 },
 {
  "name": "亚子",
  "message": "「这、这不就是……」"
 },
 {
  "name": "美纱",
  "message": "「嘿嘿～」"
 },
 {
  "name": "{fn}",
  "message": "「嗯？」"
 },
 {
  "message": "我们聊着聊着，发现周围都在看我们。"
 },
 {
  "name": "亚子",
  "message": "「我说～你们两个一个暑假不见，关系突飞猛进啊？」"
 },
 {
  "name": "地藏",
  "message": "「嗨，我之前都见过了，懂的懂的」"
 },
 {
  "name": "美纱",
  "message": "「少在那装过来人，你第一次看到的时候也吓了一跳吧」"
 },
 {
  "name": "地藏",
  "message": "「呃」"
 },
 {
  "name": "亚子",
  "message": "「诗诗都这么主动了……嘿嘿。呐、呐，纱由——」"
 },
 {
  "name": "纱由美",
  "message": "「嗯，怎么了？」"
 },
 {
  "name": "亚子",
  "message": "「其实啊——」"
 },
 {
  "message": "她们几个跑到稍远的地方，开始嘀嘀咕咕地商量着什么。"
 },
 {
  "name": "诗梦",
  "message": "「干嘛呢……？」"
 },
 {
  "message": "诗梦望着她们，不解地蹙起了眉头。"
 },
 {
  "name": "冬桦",
  "message": "「哇，这真是个绝妙的主意！」"
 },
 {
  "name": "纱由美",
  "message": "「冬冬，小声、小声点！」"
 },
 {
  "message": "御所院根本藏不住事，不过我还是没弄懂她们在干嘛。"
 },
 {
  "message": "——至少现在。"
 },
 {
  "name": "{fn}",
  "message": "「这样啊……」"
 },
 {
  "name": "诗梦",
  "message": "「唉……」"
 },
 {
  "message": "班会课上突然要换座位，还没等我反应过来，就跟诗梦成了同桌。"
 },
 {
  "name": "{fn}",
  "message": "「这怎么想都是故意的吧……」"
 },
 {
  "name": "诗梦",
  "message": "「嗯，真是多管闲事」"
 },
 {
  "message": "诗梦显然也看穿了她们的把戏，耸了耸肩。"
 },
 {
  "name": "亚子",
  "message": "「嗯！」"
 },
 {
  "message": "为首的那个正得意地朝我们比着大拇指。"
 },
 {
  "name": "纱由美",
  "message": "「呵呵呵，那要不要换回来？」"
 },
 {
  "name": "诗梦",
  "message": "「懒得折腾，就这样吧」"
 },
 {
  "message": "诗梦叹着气，向纱由回答道。"
 },
 {
  "name": "纱由美",
  "message": "「那就行——♪」"
 },
 {
  "name": "冬桦",
  "message": "「呵呵呵……♪」"
 },
 {
  "message": "御所院也一脸高兴，想必这是出于纯粹的好意吧。"
 },
 {
  "name": "地藏",
  "message": "「嗯嗯……挺好的嘛」"
 },
 {
  "name": "诗梦",
  "message": "「真是的……」"
 },
 {
  "message": "诗梦看着周围一圈不怀好意的笑脸，叹了口气，没好气地扭过了头。"
 }
]