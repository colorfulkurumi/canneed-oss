[
 {
  "message": "约会当天。"
 },
 {
  "message": "我们约在宿舍的中庭碰头。"
 },
 {
  "name": "{fn}",
  "message": "「应该……没问题吧」"
 },
 {
  "message": "我虽然是按纱由教我的方法打扮的……但效果究竟如何，自己也完全没底。"
 },
 {
  "message": "况且，最后打分的不是我，而是诗梦。"
 },
 {
  "message": "我正坐立不安地等着，主楼那边传来了说话声。"
 },
 {
  "name": "诗梦",
  "message": "「这样真可以吗？」"
 },
 {
  "name": "叶梦",
  "message": "「安啦安啦♪」"
 },
 {
  "message": "话音刚落，诗梦就走了出来——"
 },
 {
  "name": "{fn}",
  "message": "「啊……」"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "诗梦有些紧张地站在我面前，眼神飘忽不定。"
 },
 {
  "name": "{fn}",
  "message": "「诗梦……？」"
 },
 {
  "message": "我不禁唤出她的名字。眼前的诗梦，与平日里相比简直判若两人。"
 },
 {
  "message": "看得出来，无论是妆容还是穿搭，她都下了一番苦心。"
 },
 {
  "message": "我一直觉得她很可爱，可没想到，她竟然能这么可爱……"
 },
 {
  "name": "叶梦",
  "message": "「嘻嘻，怎么样怎么样？」"
 },
 {
  "name": "{fn}",
  "message": "「……太漂亮了」"
 },
 {
  "name": "诗梦",
  "message": "「！」"
 },
 {
  "name": "诗梦",
  "message": "「……真肤浅，化点妆就把你骗到了」"
 },
 {
  "message": "她扭过头去，但看样子并不讨厌这句夸奖。"
 },
 {
  "name": "诗梦",
  "message": "「真是的，快走吧」"
 },
 {
  "message": "说着，她回过头来看向我。"
 },
 {
  "name": "诗梦",
  "message": "「欸……？」"
 },
 {
  "message": "和平时不同的我，在她眼中会是什么样的呢？"
 },
 {
  "name": "诗梦",
  "message": "「……哼，是么，看来你也下了一番功夫嘛」"
 },
 {
  "name": "{fn}",
  "message": "「算是，努力了一下」"
 },
 {
  "name": "叶梦",
  "message": "「哥哥也超帅的～♪ 帅炸了～！」"
 },
 {
  "name": "{fn}",
  "message": "「是吗？」"
 },
 {
  "message": "能得到她这个读者模特的肯定，感觉不坏。"
 },
 {
  "name": "诗梦",
  "message": "「跟你平时差得也太多了吧」"
 },
 {
  "name": "{fn}",
  "message": "「是啊」"
 },
 {
  "message": "我是不是有点嘚瑟了？"
 },
 {
  "name": "诗梦",
  "message": "「不算难看」"
 },
 {
  "message": "反应还可以啊，那就让我嘚瑟嘚瑟吧。"
 },
 {
  "name": "{fn}",
  "message": "「那我们走吧」"
 },
 {
  "message": "我顺势牵起她的手。"
 },
 {
  "name": "叶梦",
  "message": "「一路顺风——！」"
 },
 {
  "name": "冬桦",
  "message": "「要玩的开心哦♪」"
 },
 {
  "name": "纱由美",
  "message": "「路上小心～♪」"
 },
 {
  "message": "不止叶梦，大家都在为我们送行。"
 },
 {
  "name": "诗梦",
  "message": "「她们真是爱凑热闹」"
 },
 {
  "name": "{fn}",
  "message": "「谢谢他们了」"
 },
 {
  "message": "话是这么说，可被大家这样看着去约会，还真有点不好意思。"
 },
 {
  "message": "走在路上，我又一次凝视起身旁的诗梦。"
 },
 {
  "name": "{fn}",
  "message": "「这身打扮真的很适合你，太可爱了」"
 },
 {
  "name": "诗梦",
  "message": "「……是吗」"
 },
 {
  "message": "虽然语气冷淡……"
 },
 {
  "name": "诗梦",
  "message": "「那个……你的，也挺好看的」"
 },
 {
  "name": "{fn}",
  "message": "「我这身吗？」"
 },
 {
  "name": "诗梦",
  "message": "「别什么都要问」"
 },
 {
  "name": "{fn}",
  "message": "「……谢谢」"
 },
 {
  "message": "能得到她的称赞，我打心底里感到高兴。"
 },
 {
  "name": "{fn}",
  "message": "「明明走的路和平时一样，感觉却完全不同」"
 },
 {
  "message": "可能是因为打扮得太正式了吧，总觉得浑身不自在。"
 },
 {
  "name": "诗梦",
  "message": "「你太紧张了」"
 },
 {
  "name": "{fn}",
  "message": "「被你发现我手心出汗啦？」"
 },
 {
  "name": "诗梦",
  "message": "「谁知道呢？」"
 },
 {
  "message": "怎么可能不知道嘛，我的手心都湿透了。"
 },
 {
  "message": "然而，诗梦却把我的手握得更紧了些。"
 },
 {
  "name": "诗梦",
  "message": "「我也和你一样」"
 },
 {
  "message": "原来，她也很紧张啊。"
 },
 {
  "message": "我们选定的约会地点，是海边的圆山水族馆。"
 },
 {
  "message": "诗梦不喜欢人多的地方，安安静静地逛水族馆刚好。"
 },
 {
  "name": "诗梦",
  "message": "「……欸」"
 },
 {
  "name": "{fn}",
  "message": "「这里的东西还真不少啊——」"
 },
 {
  "name": "诗梦",
  "message": "「你以前来过？」"
 },
 {
  "name": "{fn}",
  "message": "「小时候经常来，我奶奶以前是这里的馆长」"
 },
 {
  "name": "诗梦",
  "message": "「啊啊，这么说来，婆婆是提过」"
 },
 {
  "message": "退休之后又开起了宿舍，我奶奶这精力也太旺盛了。"
 },
 {
  "name": "{fn}",
  "message": "（但也多亏于此，我才能和诗梦相遇……）"
 },
 {
  "message": "缘分这东西，还真是奇妙。"
 },
 {
  "name": "诗梦",
  "message": "「这边……是本地的鱼吗？」"
 },
 {
  "message": "眼前是展示本地鱼类的展区。"
 },
 {
  "name": "诗梦",
  "message": "「这里面有你钓过的鱼吗？」"
 },
 {
  "name": "{fn}",
  "message": "「要说我钓过的——」"
 },
 {
  "message": "她这么一问，我顺势看向水族箱里的鱼。"
 },
 {
  "name": "{fn}",
  "message": "「那可多了，沙尖钓过，黑鲷也钓过……啊啊，还有乌贼啊……」"
 },
 {
  "name": "诗梦",
  "message": "「嗯——」"
 },
 {
  "name": "{fn}",
  "message": "「欸，连鬼头刀都有啊……不过既然是要放进水族箱的……应该不是钓上来的吧」"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "name": "{fn}",
  "message": "「哦，比目鱼……这个倒是没钓过。真想钓一次试试啊——啊」"
 },
 {
  "message": "我不知不觉就看得入了神。"
 },
 {
  "name": "{fn}",
  "message": "「抱歉，光顾着说我自己的事了」"
 },
 {
  "name": "诗梦",
  "message": "「反正你一直这样，而且听你叽叽喳喳地讲这些也不坏」"
 },
 {
  "name": "{fn}",
  "message": "「这不是在夸我吧」"
 },
 {
  "name": "诗梦",
  "message": "「没什么。反正我还没看腻你说话时的样子，嗯……」"
 },
 {
  "message": "诗梦盯着我的脸……不，是我的嘴角看了一眼，然后立刻将视线移回了水族箱。"
 },
 {
  "name": "{fn}",
  "message": "（嗯……？我刚才笑得那么开心吗？）"
 },
 {
  "name": "诗梦",
  "message": "「你不仅喜欢钓鱼，也喜欢看鱼啊」"
 },
 {
  "name": "{fn}",
  "message": "「还比较喜欢吧」"
 },
 {
  "name": "诗梦",
  "message": "「喜欢……」"
 },
 {
  "name": "{fn}",
  "message": "「嗯、嗯」"
 },
 {
  "message": "她重复了一遍我的话，我只好点了点头。"
 },
 {
  "message": "这时候，是不是该说一句『我也喜欢你』？不行，她肯定会说别把我和鱼相提并论。"
 },
 {
  "name": "{fn}",
  "message": "「和你一起来看真好」"
 },
 {
  "name": "诗梦",
  "message": "「说什么呢，我也很开心」"
 },
 {
  "message": "她握紧了我的手，脸上露出一丝微笑。虽然只是浅浅一笑，但那温柔的表情，让我感到无比幸福。"
 },
 {
  "name": "{fn}",
  "message": "「你笑起来跟这身衣服真配」"
 },
 {
  "name": "诗梦",
  "message": "「……专心看鱼」"
 },
 {
  "message": "她飞快地别过头去，显然是在掩饰害羞。"
 },
 {
  "message": "我心里暖洋洋的。继续四处闲逛。"
 },
 {
  "message": "心满意足地逛了一大圈后，我们来到了海兽区。"
 },
 {
  "message": "这里有海豹、海狗和海狮，确实是『海兽』们的地盘。"
 },
 {
  "message": "圆山水族馆致力于海兽的饲养，尤其是海豹，因此这里格外受欢迎。"
 },
 {
  "name": "{fn}",
  "message": "「游得真自在啊……」"
 },
 {
  "message": "海豹在陆地上还显得笨拙，可一入水，动作就变得无比轻快。"
 },
 {
  "message": "而且看它们的样子，别提多惬意了。"
 },
 {
  "name": "诗梦",
  "message": "「唔……」"
 },
 {
  "message": "她的视线，牢牢地粘在了畅游的海豹身上。"
 },
 {
  "name": "诗梦",
  "message": "「海豹……长这个样子啊」"
 },
 {
  "name": "{fn}",
  "message": "「你第一次见到真的海豹？」"
 },
 {
  "name": "诗梦",
  "message": "「怎么可能。我只是最近……老在看别的东西」"
 },
 {
  "name": "{fn}",
  "message": "「别的？」"
 },
 {
  "name": "诗梦",
  "message": "「……海豹玩偶」"
 },
 {
  "name": "{fn}",
  "message": "「啊啊，是我之前送你的那个啊，你把它摆在房间里了？」"
 },
 {
  "name": "诗梦",
  "message": "「……放在能看见的地方了」"
 },
 {
  "name": "{fn}",
  "message": "「是吗，那我可真高兴。叶梦她也喜欢那个玩偶吗？」"
 },
 {
  "name": "诗梦",
  "message": "「哼……」"
 },
 {
  "message": "我感觉自己被瞪了一下。约会的时候提起别的女生确实不好。"
 },
 {
  "name": "{fn}",
  "message": "「你把她摆出来我也很高兴」"
 },
 {
  "name": "诗梦",
  "message": "「补救起来了？」"
 },
 {
  "name": "{fn}",
  "message": "「也是真心话」"
 },
 {
  "name": "诗梦",
  "message": "「说得脸不红心不跳的」"
 },
 {
  "message": "话虽如此，她却将手牵得更紧了些。"
 },
 {
  "message": "今天的她比平时要主动、老实得多，仿佛在用行动告诉我，她也很想牵手。"
 },
 {
  "message": "真叫人高兴。"
 },
 {
  "name": "诗梦",
  "message": "「啊……你看那个」"
 },
 {
  "name": "{fn}",
  "message": "「嗯嗯？」"
 },
 {
  "message": "到了喂食时间，水族箱前很快就聚满了游客。"
 },
 {
  "message": "我们站得稍远了一些，诗梦忽然拉了拉我的袖子。"
 },
 {
  "name": "蕾蒂",
  "message": "「是，大家都有份，请排好队」"
 },
 {
  "name": "{fn}",
  "message": "「斑鸠学姐？」"
 },
 {
  "message": "只见穿着运动服的斑鸠学姐正在给海狗喂鱼。她今天不是吃完早饭就出门了吗……"
 },
 {
  "message": "是在水族馆打工吗？还是来帮忙的……？"
 },
 {
  "message": "说起来，她好像是提过，在水族馆做志愿者是生物社的活动。"
 },
 {
  "name": "{fn}",
  "message": "「感觉，那些海狗都围着她转啊」"
 },
 {
  "name": "诗梦",
  "message": "「是、是啊……」"
 },
 {
  "name": "蕾蒂",
  "message": "「嗯，不行哦。现在是就餐时间，不可以淘气」"
 },
 {
  "message": "海狗们不光是为了讨食，似乎还很黏她，一个劲地跟她撒娇。"
 },
 {
  "name": "{fn}",
  "message": "（斑鸠学姐的表情，似乎也比平时柔和了许多……）"
 },
 {
  "message": "她很喜欢海狗吧。"
 },
 {
  "name": "诗梦",
  "message": "「……啊」"
 },
 {
  "name": "{fn}",
  "message": "「怎么了？」"
 },
 {
  "name": "诗梦",
  "message": "「刚才，她看到我了……」"
 },
 {
  "name": "{fn}",
  "message": "「欸」"
 },
 {
  "message": "喂食活动那么受欢迎，周围挤得水泄不通。我们站得这么远，她真的能看到吗？"
 },
 {
  "name": "蕾蒂",
  "message": "「主人，诗梦大人」"
 },
 {
  "message": "喂食时间结束，我们正准备回去看海豹，斑鸠学姐却主动过来跟我们打招呼。"
 },
 {
  "name": "{fn}",
  "message": "「斑鸠学姐，辛苦了」"
 },
 {
  "name": "蕾蒂",
  "message": "「不，这也是我想做的」"
 },
 {
  "name": "诗梦",
  "message": "「你在水族馆做志愿者？」"
 },
 {
  "name": "蕾蒂",
  "message": "「是的，我是生物社的志愿者」"
 },
 {
  "message": "又要当女仆，又要当志愿者……真是个大忙人啊。"
 },
 {
  "name": "蕾蒂",
  "message": "「……」"
 },
 {
  "message": "忽然，斑鸠学姐朝我们眼前的海豹挥了挥手。"
 },
 {
  "name": "海豹",
  "message": "「……」"
 },
 {
  "message": "紧接着，那只正在游泳的海豹像是回应她一样，在水中转了一圈。"
 },
 {
  "name": "诗梦",
  "message": "「欸，斑鸠学姐，你还教它表演杂技吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「不，这只是打招呼」"
 },
 {
  "name": "{fn}",
  "message": "「啊，是吗……」"
 },
 {
  "message": "虽然她嘴上说得轻松，但看得出来她和海豹之间很有默契。"
 },
 {
  "name": "{fn}",
  "message": "「真厉害啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「您过奖了」"
 },
 {
  "name": "诗梦",
  "message": "「……唔」"
 },
 {
  "name": "{fn}",
  "message": "「哦……」"
 },
 {
  "message": "诗梦拽着我的手把我拉走了。是我跟斑鸠学姐聊得太投入了吗？"
 },
 {
  "message": "她这毫不掩饰的醋意，虽然有点对不起她，但心里却不禁窃喜。"
 },
 {
  "name": "蕾蒂",
  "message": "「刚才喂食的时候我就看到两位了，果然是主人你们」"
 },
 {
  "name": "诗梦",
  "message": "「你那时候真的看到我们了啊」"
 },
 {
  "name": "蕾蒂",
  "message": "「不，当时还不敢确定，因为两位看上去就像是出来约会的情侣」"
 },
 {
  "name": "蕾蒂",
  "message": "「二位给人的感觉和往常很不一样，所以我才过来确认一下」"
 },
 {
  "name": "诗梦",
  "message": "「欸，这……」"
 },
 {
  "name": "{fn}",
  "message": "「我们看起来像情侣吗？」"
 },
 {
  "name": "蕾蒂",
  "message": "「是的」"
 },
 {
  "name": "诗梦",
  "message": "「……是吗」"
 },
 {
  "message": "听到向来诚实的斑鸠学姐这么说，诗梦的脸上也多云转晴了。"
 },
 {
  "name": "蕾蒂",
  "message": "「请二位约会玩的开心」"
 },
 {
  "message": "就这样，斑鸠学姐目送我们离开。"
 },
 {
  "message": "天气炎热，我们便找了个地方一起吃冰淇淋。"
 },
 {
  "name": "诗梦",
  "message": "「……嘶溜」"
 },
 {
  "message": "诗梦选的，果不其然是抹茶味的。"
 },
 {
  "name": "{fn}",
  "message": "「欸——原来是这个味儿啊」"
 },
 {
  "message": "我点的则是『斑海豹软冰淇淋（芝麻味）』。"
 },
 {
  "message": "既然这里致力于饲养海豹，会推出这种文创产品也不足为奇。"
 },
 {
  "name": "诗梦",
  "message": "「你这个奇奇怪怪的，怎么样？」"
 },
 {
  "name": "{fn}",
  "message": "「还挺好吃的。你要不要尝一口？」"
 },
 {
  "name": "诗梦",
  "message": "「欸？」"
 },
 {
  "message": "……啊，可这不就是间接接吻吗。"
 },
 {
  "name": "{fn}",
  "message": "「不，你要不想就算了……」"
 },
 {
  "name": "诗梦",
  "message": "「哧溜」"
 },
 {
  "message": "诗梦伸出舌头，舔了一下我手中的冰淇淋。"
 },
 {
  "message": "她的脸凑得极近，能看见舌尖轻轻划过我手里的冰淇淋。"
 },
 {
  "message": "精心打扮过的她比平时更美，此刻就凑在我面前舔着冰淇淋。"
 },
 {
  "message": "看着她红润的舌尖卷走冰淇淋，我的心跳不由得加快了。"
 },
 {
  "name": "诗梦",
  "message": "「嗯……味道果然怪怪的，不过不难吃」"
 },
 {
  "name": "{fn}",
  "message": "「是、是吗……」"
 },
 {
  "name": "诗梦",
  "message": "「哼……」"
 },
 {
  "message": "她看到我的反应，笑了一下。"
 },
 {
  "name": "诗梦",
  "message": "「一个间接接吻，你就害羞了？」"
 },
 {
  "message": "她说完就后退两步，把脸扭向一旁。"
 },
 {
  "name": "诗梦",
  "message": "（……羞死了）"
 },
 {
  "message": "还好，没让他看见我脸红的样子。"
 },
 {
  "name": "诗梦",
  "message": "（我刚才是不是表现得太明显了……他会不会察觉到我想接吻了？还是我想多了？）"
 },
 {
  "message": "我能感到心脏在胸口怦怦直跳。"
 },
 {
  "name": "诗梦",
  "message": "（他今天穿得也太帅了）"
 },
 {
  "message": "明明我也好好打扮了，他却比我还……好狡猾。"
 },
 {
  "name": "诗梦",
  "message": "（不过，要是亲上了，脸会贴得比刚才吃冰淇淋时更近吧……）"
 },
 {
  "message": "那也太难为情了。"
 },
 {
  "message": "如果他发现我想接吻，会主动亲过来的吧？"
 },
 {
  "message": "那，要不要试着营造一下这种气氛？"
 },
 {
  "name": "诗梦",
  "message": "（欸，那种气氛，要怎么营造啊……）"
 },
 {
  "name": "诗梦",
  "message": "「好了，我们去下一个地方吧」"
 },
 {
  "message": "我想来想去，还是故作镇定。"
 },
 {
  "message": "傍晚，我们离开水族馆，朝防波堤走去。"
 },
 {
  "name": "{fn}",
  "message": "「不知不觉就走到这里来了呢，是因为这里充满了回忆吧」"
 },
 {
  "name": "诗梦",
  "message": "「还不是你把我带到这儿来的」"
 },
 {
  "name": "{fn}",
  "message": "「说得也是」"
 },
 {
  "message": "是我提议『走走吧』，然后把她带到这儿的，她说的确实没错。"
 },
 {
  "message": "毕竟这里是我们关系变好的地方，第一次约会无论如何都想来这儿看看。"
 },
 {
  "name": "{fn}",
  "message": "「而且，这也是我们交往后第一次一起来这儿」"
 },
 {
  "message": "上次来这儿，还是我四处寻找诗梦的时候。从那以后，我们的关系已经完全不一样了。"
 },
 {
  "name": "诗梦",
  "message": "「……感觉，又踏出了一步呢」"
 },
 {
  "message": "诗梦望着夕阳沉入大海，轻声自语。"
 },
 {
  "name": "{fn}",
  "message": "「何止一步啊。你为了约会特意打扮得这么漂亮……我真的特别开心」"
 },
 {
  "name": "诗梦",
  "message": "「你不也一样」"
 },
 {
  "name": "{fn}",
  "message": "「哈哈，确实花了点心思」"
 },
 {
  "name": "诗梦",
  "message": "「自己说出来就不帅了」"
 },
 {
  "name": "{fn}",
  "message": "「这倒是真的」"
 },
 {
  "name": "诗梦",
  "message": "「……呵」"
 },
 {
  "message": "我们相视一笑。诗梦只是浅浅地弯了弯嘴角，但对我来说已经足够了。"
 },
 {
  "name": "{fn}",
  "message": "「说起来，前几天你在AZ上向我道歉了啊」"
 },
 {
  "name": "诗梦",
  "message": "「欸？嗯……」"
 },
 {
  "name": "{fn}",
  "message": "「那次是我太没情商了，你根本不用道歉。让你担心了，对不起」"
 },
 {
  "name": "诗梦",
  "message": "「我用道歉」"
 },
 {
  "name": "{fn}",
  "message": "「欸？」"
 },
 {
  "name": "诗梦",
  "message": "「因为那时候，比起做……那种事，我更想要别的」"
 },
 {
  "name": "{fn}",
  "message": "「更想要别的……」"
 },
 {
  "message": "比起做色色的事，还有更让他期待的？"
 },
 {
  "name": "诗梦",
  "message": "「就是……接吻」"
 },
 {
  "message": "听到这话，我的视线不由得落在了诗梦的嘴唇上，想起了那个将嘴唇贴上去的行为。"
 },
 {
  "name": "诗梦",
  "message": "「做那种事之前，不应该先是这个吗？」"
 },
 {
  "message": "即使在黄昏的微光里，也能看出她的脸颊涨得通红，声音也比平时弱了几分。"
 },
 {
  "name": "{fn}",
  "message": "「啊……」"
 },
 {
  "message": "说得对。上次我跳过了接吻，直接就想做那种色色的事了。"
 },
 {
  "name": "{fn}",
  "message": "（说的也是……既然是恋人，理应先从接吻开始）"
 },
 {
  "message": "虽然有些出乎意料，但也说明了他是多么认真地看待我们之间的关系。"
 },
 {
  "name": "{fn}",
  "message": "「……对不起」"
 },
 {
  "name": "诗梦",
  "message": "「有比道歉更重要的事吧」"
 },
 {
  "name": "{fn}",
  "message": "「你说得对」"
 },
 {
  "message": "四周空无一人，只有海浪声在耳边回响。"
 },
 {
  "name": "{fn}",
  "message": "「那，我亲了」"
 },
 {
  "name": "诗梦",
  "message": "「别、别什么都问」"
 },
 {
  "message": "话虽这么说，她的嘴唇却在微微颤抖。那是紧张与期待交织的证明。"
 },
 {
  "name": "{fn}",
  "message": "「那……」"
 },
 {
  "message": "我的心脏狂跳不止，血液仿佛在沸腾，手心也渗出了冷汗。"
 },
 {
  "message": "哪怕紧张得浑身僵硬，也没有不亲的选择。"
 },
 {
  "name": "诗梦",
  "message": "「……嗯」"
 },
 {
  "message": "我轻轻地将自己的唇贴住她的唇。"
 },
 {
  "message": "或许是涂了唇膏的缘故，她的嘴唇比想象中还要柔软。"
 },
 {
  "message": "再来一次。"
 },
 {
  "name": "诗梦",
  "message": "「啾……嗯，啾」"
 },
 {
  "message": "双唇相接的瞬间，我感受到她的吐息，不由自主地吸入了她呼出的气息。"
 },
 {
  "message": "那甜美的气息令我沉醉。"
 },
 {
  "name": "诗梦",
  "message": "「嗯……啾……唔啾……」"
 },
 {
  "message": "又这样重复几次，我们才缓缓分开。"
 },
 {
  "name": "{fn}",
  "message": "「……哈」"
 },
 {
  "name": "诗梦",
  "message": "「……呼」"
 },
 {
  "message": "分开后，我们凝视着对方。"
 },
 {
  "name": "{fn}",
  "message": "「对不起，是我没注意」"
 },
 {
  "name": "诗梦",
  "message": "「反正你一向迟钝，我也没指望你能注意到」"
 },
 {
  "message": "她沐浴在夕阳下，嘴上还是一如既往地不饶人，但通红的额角已有汗珠顺着脸颊滑落。"
 },
 {
  "message": "其实我也一样，夏日的暑气和内心的紧张交织在一起，早已是满头大汗。"
 },
 {
  "name": "诗梦",
  "message": "「糟糕……流了这么多汗，妆都要花了」"
 },
 {
  "name": "{fn}",
  "message": "「那，回去？」"
 },
 {
  "name": "诗梦",
  "message": "「不要，再来……一次」"
 },
 {
  "name": "{fn}",
  "message": "「太好了」"
 },
 {
  "name": "诗梦",
  "message": "「好什么」"
 },
 {
  "name": "{fn}",
  "message": "「因为我也还想亲啊」"
 },
 {
  "name": "诗梦",
  "message": "「色鬼」"
 },
 {
  "name": "{fn}",
  "message": "「没错……嗯……」"
 },
 {
  "name": "诗梦",
  "message": "「……啾」"
 },
 {
  "message": "我吻上了刚刚还在骂我色鬼的唇。"
 },
 {
  "name": "诗梦",
  "message": "「唔……啾，啾……」"
 },
 {
  "message": "诗梦也主动地亲了过来。"
 },
 {
  "name": "{fn}",
  "message": "「唔……当个色鬼，也不赖吧」"
 },
 {
  "name": "诗梦",
  "message": "「也就这次是了……哈啊……啾噗，唔啾」"
 },
 {
  "message": "再次亲吻之后，我们将额头抵在一起。"
 },
 {
  "name": "{fn}",
  "message": "「哈哈」"
 },
 {
  "name": "诗梦",
  "message": "「哼」"
 },
 {
  "message": "感觉这是今天笑得最自然的一次。"
 }
]