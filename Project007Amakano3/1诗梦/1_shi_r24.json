[
 {
  "message": "——十年后。"
 },
 {
  "name": "{fn}",
  "message": "「……哎呀」"
 },
 {
  "message": "我伸手抓住被风吹跑的草帽。"
 },
 {
  "name": "{fn}",
  "message": "「来，实梦，把帽子戴戴好」"
 },
 {
  "name": "实梦",
  "message": "「谢谢爸爸～♪」"
 },
 {
  "message": "我将帽子戴在诗梦怀中女儿的头上。"
 },
 {
  "name": "{fn}",
  "message": "「换我来抱吧？」"
 },
 {
  "name": "诗梦",
  "message": "「不用，她最喜欢我抱了」"
 },
 {
  "name": "实梦",
  "message": "「嗯，最喜欢妈妈了！」"
 },
 {
  "message": "实梦也更加用力地抱紧了诗梦。"
 },
 {
  "name": "诗梦",
  "message": "「瞧见没♪」"
 },
 {
  "message": "她一脸得意。"
 },
 {
  "name": "实梦",
  "message": "「嗯～？我也最喜欢爸爸呀」"
 },
 {
  "name": "{fn}",
  "message": "「听见了吧」"
 },
 {
  "name": "诗梦",
  "message": "「真是的，怎么连这个都要争个输赢……」"
 },
 {
  "message": "诗梦无奈地耸了耸肩，与我并肩走着。"
 },
 {
  "name": "{fn}",
  "message": "「话说续约的事，考虑得怎么样了？」"
 },
 {
  "name": "诗梦",
  "message": "「续约……？啊、啊啊，已经过去这么久了啊？」"
 },
 {
  "name": "{fn}",
  "message": "「是啊，我在想下个十年，你是怎么打算的」"
 },
 {
  "name": "{fn}",
  "message": "「顺便说一句，我对你的爱可是一如既往哦」"
 },
 {
  "name": "诗梦",
  "message": "「孩子还在，说什么呢……真是的」"
 },
 {
  "message": "看来当着孩子的面，她也不好意思说得太难听了。"
 },
 {
  "name": "诗梦",
  "message": "「再说，都有实梦在了，哪能说分就分啊」"
 },
 {
  "name": "{fn}",
  "message": "「真是现实啊」"
 },
 {
  "name": "诗梦",
  "message": "「当然了，再说……啾」"
 },
 {
  "name": "实梦",
  "message": "「哦哦？」"
 },
 {
  "message": "她讲我乱说话，自己当着实梦的面倒是挺大胆。"
 },
 {
  "name": "{fn}",
  "message": "「这算续约成功了？」"
 },
 {
  "name": "诗梦",
  "message": "「才不是……啾」"
 },
 {
  "message": "她又亲了我一下。"
 },
 {
  "name": "诗梦",
  "message": "「现在这么幸福，你还问那种愚蠢的问题」"
 },
 {
  "name": "诗梦",
  "message": "「——所以，下一个十年，也要让我过得如梦似幻哦」"
 }
]