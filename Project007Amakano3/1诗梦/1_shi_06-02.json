[
 {
  "message": "第二天。"
 },
 {
  "name": "纱由美",
  "message": "「那，我们走这边喽♪」"
 },
 {
  "name": "{fn}",
  "message": "「你们？」"
 },
 {
  "message": "分组行动才刚开始，纱由就冷不丁地冒出这么一句。"
 },
 {
  "name": "冬桦",
  "message": "「嗯，你和她就走那边吧」"
 },
 {
  "name": "冬桦",
  "message": "「嗯，你和她就走那边吧」"
 },
 {
  "name": "诗梦",
  "message": "「欸，什么……？」"
 },
 {
  "message": "御所院推了推柳木的后背，把她送到了我身边。"
 },
 {
  "name": "{fn}",
  "message": "「什么意思？」"
 },
 {
  "name": "地藏",
  "message": "「这还用问嘛，下午五点准时在这儿集合」"
 },
 {
  "name": "纱由美",
  "message": "「集合前，记得好好聊聊哦♪」"
 },
 {
  "message": "她对我俏皮地眨了下眼，接着大家便各自散去了。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "message": "秘密会议的成果就是这？到头来还得靠我自己搞定？"
 },
 {
  "name": "{fn}",
  "message": "（……不过，确实啊）"
 },
 {
  "message": "与其犹豫不决，不如主动把握机会。"
 },
 {
  "name": "诗梦",
  "message": "「什么意思？」"
 },
 {
  "name": "{fn}",
  "message": "「大概，是字面意思」"
 },
 {
  "name": "诗梦",
  "message": "「……是吗，那时间到了在这集合」"
 },
 {
  "message": "看来柳木并不想跟我待在一起。"
 },
 {
  "name": "{fn}",
  "message": "「不，我们一起走吧」"
 },
 {
  "name": "诗梦",
  "message": "「欸……」"
 },
 {
  "name": "{fn}",
  "message": "「不过，如果你真的一秒钟都不想跟我待在一起，那就直说」"
 },
 {
  "name": "{fn}",
  "message": "「那个，我知道你讨厌我」"
 },
 {
  "message": "……唔，这话从自己嘴里说出来，反而更扎心。"
 },
 {
  "name": "诗梦",
  "message": "「……什么意思」"
 },
 {
  "name": "{fn}",
  "message": "「欸？」"
 },
 {
  "name": "诗梦",
  "message": "「别擅自替我下定论」"
 },
 {
  "message": "柳木瞪了我一眼。"
 },
 {
  "name": "{fn}",
  "message": "「那就是说，可以一起走喽？」"
 },
 {
  "name": "诗梦",
  "message": "「别让我说第二遍」"
 },
 {
  "message": "柳木冷冷地回了一句。"
 },
 {
  "message": "……这样啊。"
 },
 {
  "message": "我总算是松了口气。"
 },
 {
  "name": "{fn}",
  "message": "「既然这样，我有想去的地方，走吧」"
 },
 {
  "message": "我迈开步子，柳木也默默地跟了上来。"
 },
 {
  "name": "{fn}",
  "message": "「哦，真凉快啊」"
 },
 {
  "message": "走进那家甜品店，冷气扑面而来。古都实在太热，空调简直是救星。"
 },
 {
  "name": "诗梦",
  "message": "「你想去的地方，就是这里？」"
 },
 {
  "name": "{fn}",
  "message": "「对啊」"
 },
 {
  "name": "诗梦",
  "message": "「……真意外」"
 },
 {
  "name": "{fn}",
  "message": "「男生偶尔也想吃点甜的嘛。而且天这么热，这种时候就得吃刨冰」"
 },
 {
  "name": "{fn}",
  "message": "「你看，光是抹茶味的就有好几种，选一个吧」"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "她一言不发地瞪着我。"
 },
 {
  "name": "{fn}",
  "message": "「怎、怎么了？」"
 },
 {
  "name": "诗梦",
  "message": "「小叶告诉你的？」"
 },
 {
  "name": "{fn}",
  "message": "「这就猜到了？」"
 },
 {
  "name": "诗梦",
  "message": "「我又不是笨蛋。再说，这地方怎么看都不像你会来的」"
 },
 {
  "name": "{fn}",
  "message": "「是叶梦告诉我的没错。我觉得既然你喜欢抹茶，也会喜欢这里吧」"
 },
 {
  "name": "诗梦",
  "message": "「特地为我？真是眼泪都要掉出来了」"
 },
 {
  "name": "{fn}",
  "message": "「……虽然我确实把你弄哭过」"
 },
 {
  "name": "诗梦",
  "message": "「呜……」"
 },
 {
  "message": "糟了。真不该说这种话，把气氛都弄僵了。"
 },
 {
  "name": "{fn}",
  "message": "「那、那个，快选吧。听说宇治金时很好吃……哦，还有加冰淇淋的」"
 },
 {
  "name": "{fn}",
  "message": "「你选哪个？」"
 },
 {
  "name": "诗梦",
  "message": "「给我看看」"
 },
 {
  "message": "看样子，她至少是同意在这儿吃了。"
 },
 {
  "name": "诗梦",
  "message": "「……真好吃」"
 },
 {
  "message": "她本来一直默默看着窗外，尝了一口刨冰后，惊讶地瞪圆了眼睛。"
 },
 {
  "name": "{fn}",
  "message": "「啊呜……好吃……」"
 },
 {
  "message": "没有想象中那么甜，口感很清爽。这么热的天，吃这种清爽点的正好。"
 },
 {
  "message": "回头得好好感谢下叶梦才行……"
 },
 {
  "name": "诗梦",
  "message": "「……那个」"
 },
 {
  "message": "柳木小口吃着刨冰，轻声开口道。"
 },
 {
  "name": "诗梦",
  "message": "「……我不讨厌」"
 },
 {
  "name": "{fn}",
  "message": "「不是，什么讨厌啊，你不是最喜欢抹茶吗？」"
 },
 {
  "name": "诗梦",
  "message": "「我不是说那个」"
 },
 {
  "message": "她直勾勾地盯着我。"
 },
 {
  "name": "{fn}",
  "message": "「……你说我吗？」"
 },
 {
  "name": "诗梦",
  "message": "「那你呢，不讨厌吗？」"
 },
 {
  "name": "{fn}",
  "message": "「讨厌什么？」"
 },
 {
  "name": "诗梦",
  "message": "「我啊」"
 },
 {
  "name": "{fn}",
  "message": "「怎么会？非但不讨厌，我反而还挺享受现在这样的」"
 },
 {
  "name": "诗梦",
  "message": "「明明我一直那副态度，你真是个大好人」"
 },
 {
  "name": "{fn}",
  "message": "「这我已经习惯了」"
 },
 {
  "name": "诗梦",
  "message": "「……没在勉强？」"
 },
 {
  "name": "{fn}",
  "message": "「完全没有，跟你在一起很开心，怎么可能勉强」"
 },
 {
  "message": "我认真地强调道。"
 },
 {
  "name": "诗梦",
  "message": "「无法理解，真是有毛病」"
 },
 {
  "name": "{fn}",
  "message": "「你也不是第一天知道我这人有毛病了吧？」"
 },
 {
  "name": "诗梦",
  "message": "「没想到毛病这么大」"
 },
 {
  "message": "她看着我的笑容，无奈地叹了口气。"
 },
 {
  "name": "{fn}",
  "message": "「那太好了」"
 },
 {
  "name": "诗梦",
  "message": "「好？」"
 },
 {
  "name": "{fn}",
  "message": "「如果你都能想到，那我，应该才真是无可救药了吧」"
 },
 {
  "name": "诗梦",
  "message": "「谁知道呢，超出预期也不见得都是好事」"
 },
 {
  "name": "{fn}",
  "message": "「是吗？」"
 },
 {
  "name": "诗梦",
  "message": "「是啊……」"
 },
 {
  "message": "她猛地别过脸，用勺子没好气地戳着刨冰。"
 },
 {
  "name": "诗梦",
  "message": "「现在……别一直盯着我看」"
 },
 {
  "name": "{fn}",
  "message": "「哦、哦哦……」"
 },
 {
  "message": "现在？"
 },
 {
  "message": "难道说，还有可以盯着看的时候吗？"
 },
 {
  "message": "我心里犯着嘀咕，挖了一勺开始融化的宇治金时送入口中。"
 },
 {
  "name": "{fn}",
  "message": "「难得来一趟，又离集合还早，再四处转转吧」"
 },
 {
  "name": "诗梦",
  "message": "「……嗯」"
 },
 {
  "message": "柳木也点了点头，于是我们两人便一同在古都漫步起来。"
 },
 {
  "name": "{fn}",
  "message": "「这儿的街景，果然别有一番风味啊」"
 },
 {
  "name": "诗梦",
  "message": "「单说街景，日和山温泉也挺有味道的」"
 },
 {
  "name": "{fn}",
  "message": "「没想到，你还挺喜欢那条温泉街的？」"
 },
 {
  "name": "诗梦",
  "message": "「毕竟是自己住的地方，多少有点感情」"
 },
 {
  "name": "{fn}",
  "message": "「这样啊……」"
 },
 {
  "message": "叶梦之前好像说柳木一直在忍，不过看来，她本人不讨厌这样。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "name": "{fn}",
  "message": "「要来个冰淇淋吗？」"
 },
 {
  "message": "看到她在卖抹茶冰淇淋的摊位前停下了脚步，我开口问道。"
 },
 {
  "name": "诗梦",
  "message": "「……因为天热？」"
 },
 {
  "name": "{fn}",
  "message": "「因为我知道你喜欢，所以才问你吃不吃」"
 },
 {
  "name": "诗梦",
  "message": "「……呜，别特意说出来」"
 },
 {
  "message": "柳木刷地一下把脸扭了过去。"
 },
 {
  "message": "这么不坦率，倒也合她的脾气。"
 },
 {
  "name": "诗梦",
  "message": "「……啊唔」"
 },
 {
  "name": "{fn}",
  "message": "「……嗯」"
 },
 {
  "message": "我们俩人就这么吃着冰淇淋，在街上闲逛着。"
 },
 {
  "message": "彼此之间保持着一段微妙的距离，不远不近，刚好不会走散。"
 },
 {
  "message": "谁都没有再靠近一步，也没有开口说话。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "但看她的样子，仿佛是在细细咀嚼这一刻。"
 },
 {
  "message": "该怎么说呢。"
 },
 {
  "message": "她看上去很高兴，可我从她的身影中，又感受到了那天在防波堤上看见的脆弱。"
 },
 {
  "name": "诗梦",
  "message": "（我都这样对他了，他居然一点都不讨厌我……好狡猾）"
 },
 {
  "message": "我不禁自嘲，自己竟会因为这种事而感到开心，真是单纯得可笑。"
 },
 {
  "name": "诗梦",
  "message": "（你就尽管高兴吧？反正……他什么都不知道）"
 },
 {
  "message": "『没想到才好』"
 },
 {
  "message": "他虽然这么说了，可这又怎么可能好呢。"
 },
 {
  "name": "诗梦",
  "message": "（要是让他知道了我做过的事，他肯定会看不起我……然后讨厌我吧）"
 },
 {
  "message": "像这样一起散步，也会是最后一次。"
 },
 {
  "name": "诗梦",
  "message": "（……果然）"
 },
 {
  "message": "我能迈出这一步，全都是因为他。"
 },
 {
  "name": "诗梦",
  "message": "（我一个人，就是连被人讨厌的勇气都没有的胆小鬼）"
 },
 {
  "name": "诗梦",
  "message": "（这肯定……是我们最后的时间了）"
 },
 {
  "message": "我明明一清二楚。"
 },
 {
  "name": "诗梦",
  "message": "（……别结束啊）"
 },
 {
  "message": "临近集合时间，我们动身前往神社。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "柳木也正一脸认真地参拜着。"
 },
 {
  "message": "她是在许什么愿吗？不，她应该不是会相信这种东西的人。"
 },
 {
  "message": "但即便如此，她还是祈祷了相当长的时间。"
 },
 {
  "name": "诗梦",
  "message": "「……我，真可笑」"
 },
 {
  "message": "参拜结束，柳木突然自言自语地轻笑起来。"
 },
 {
  "message": "然而，那笑容中充满了自嘲。"
 },
 {
  "name": "诗梦",
  "message": "「果然，我还是这么渺小」"
 },
 {
  "name": "{fn}",
  "message": "「欸……」"
 },
 {
  "message": "难道她不觉得自己已经向前迈出了一步，已经有些改变了吗？"
 },
 {
  "name": "诗梦",
  "message": "「……这段时光也该结束了」"
 },
 {
  "message": "她转过身去。"
 },
 {
  "message": "我从中感受到了——拒绝。"
 },
 {
  "name": "诗梦",
  "message": "「集合时间快到了——再见」"
 },
 {
  "message": "我有一种预感，如果现在不叫住她，一切都将无可挽回。"
 },
 {
  "name": "{fn}",
  "message": "「等一下！」"
 },
 {
  "message": "我拉住她，让她转过身来。"
 },
 {
  "name": "诗梦",
  "message": "「干嘛？」"
 },
 {
  "message": "被我强行拉住，她也没有瞪我。"
 },
 {
  "message": "只是一直不看我。"
 },
 {
  "name": "诗梦",
  "message": "「……好痛」"
 },
 {
  "name": "{fn}",
  "message": "「抱歉。但是，你已经不渺小了」"
 },
 {
  "name": "诗梦",
  "message": "「真的吗？」"
 },
 {
  "name": "{fn}",
  "message": "「至少我是这么认为的。如果你也觉得自己有那么一丁点改变，就请听我说」"
 },
 {
  "name": "诗梦",
  "message": "「说什么？」"
 },
 {
  "message": "柳木依旧别着脸，轻声问道。"
 },
 {
  "message": "我必须说些什么。"
 },
 {
  "message": "不然的话，这段时光，以及我和柳木之间的关系，就真的要『结束』了。"
 },
 {
  "name": "{fn}",
  "message": "「——我喜欢你」"
 },
 {
  "name": "诗梦",
  "message": "「……欸？」"
 },
 {
  "message": "柳木转向我，脸上满是错愕。"
 },
 {
  "message": "……啊嘞？"
 },
 {
  "message": "我刚才，说了什么？"
 },
 {
  "name": "诗梦",
  "message": "「喜欢……你脑子坏掉了吗？」"
 },
 {
  "message": "……没错，我说了『喜欢』。"
 },
 {
  "message": "我……表白了。"
 },
 {
  "name": "{fn}",
  "message": "「说我傻也行。但我是真的喜欢你，柳木，我想和你交往」"
 },
 {
  "name": "{fn}",
  "message": "「我想了解你的想法，你在意的事情，想跟你互相理解」"
 },
 {
  "message": "话匣子一打开就停不下来了。不过这也难怪，因为这些全都是我的真心话。"
 },
 {
  "name": "{fn}",
  "message": "「你呢？又是怎么看我的」"
 },
 {
  "name": "诗梦",
  "message": "「……不行」"
 },
 {
  "name": "{fn}",
  "message": "「不行？」"
 },
 {
  "message": "是说我不行吗？还是——"
 },
 {
  "name": "诗梦",
  "message": "「我……差劲」"
 },
 {
  "message": "她是说她自己不行。"
 },
 {
  "name": "诗梦",
  "message": "「我根本配不上，喜欢谁这种美好的感情」"
 },
 {
  "name": "{fn}",
  "message": "「这是……因为我吗？」"
 },
 {
  "name": "诗梦",
  "message": "「所以，我的感情，肯定不是喜欢」"
 },
 {
  "name": "{fn}",
  "message": "「什么意思？」"
 },
 {
  "name": "诗梦",
  "message": "「之前，我们在温泉里撞见了吧」"
 },
 {
  "name": "{fn}",
  "message": "「嗯、嗯……」"
 },
 {
  "message": "那正是我们现在气氛变这么尴尬的导火索。"
 },
 {
  "name": "诗梦",
  "message": "「在那之后……我想着你，做了」"
 },
 {
  "name": "{fn}",
  "message": "「做了……？做了？难道说……」"
 },
 {
  "name": "诗梦",
  "message": "「……就是你想的那样」"
 },
 {
  "name": "{fn}",
  "message": "「不，这……」"
 },
 {
  "message": "面对这出人意料的坦白，我难免吃惊。"
 },
 {
  "message": "不过我也终于明白了。如果她之后自己弄了，当然会觉得尴尬吧。"
 },
 {
  "name": "诗梦",
  "message": "「很卑微，很下流吧？」"
 },
 {
  "name": "诗梦",
  "message": "「一边骂着你是变态，一边用你自慰到爽」"
 },
 {
  "message": "也许是破罐子破摔了吧，她居然说出了这么露骨的词语。"
 },
 {
  "message": "……可是。"
 },
 {
  "name": "{fn}",
  "message": "「我很高兴」"
 },
 {
  "name": "诗梦",
  "message": "「你、你在说什么啊？真是变态吗？」"
 },
 {
  "name": "{fn}",
  "message": "「只要你也喜欢我，变态就变态吧」"
 },
 {
  "name": "诗梦",
  "message": "「所以，我的感情——」"
 },
 {
  "name": "{fn}",
  "message": "「不论形式如何，你依旧向前迈出了一步吧」"
 },
 {
  "name": "诗梦",
  "message": "「没你说的那么高尚」"
 },
 {
  "name": "{fn}",
  "message": "「但无论形式如何，你渴求我。所以，我很开心哦」"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "她似乎有些不知所措。"
 },
 {
  "name": "{fn}",
  "message": "「就算知道了这些，我的心意也不会动摇」"
 },
 {
  "name": "诗梦",
  "message": "「……真是，有毛病」"
 },
 {
  "name": "{fn}",
  "message": "「嗯，确实」"
 },
 {
  "message": "我冲她笑了笑。"
 },
 {
  "name": "{fn}",
  "message": "「柳木，我喜欢你」"
 },
 {
  "message": "我再次向她诉说了我的心意。"
 },
 {
  "name": "诗梦",
  "message": "「……『柳木』？」"
 },
 {
  "message": "柳木轻轻叹了口气，如此问道。"
 },
 {
  "message": "也就是说——"
 },
 {
  "name": "{fn}",
  "message": "「……诗梦」"
 },
 {
  "name": "诗梦",
  "message": "「答对了，变态<fn>」"
 },
 {
  "message": "听到我叫她，她也用名字称呼了我。"
 },
 {
  "name": "诗梦",
  "message": "「算你及格了，变态先生」"
 },
 {
  "name": "{fn}",
  "message": "「……你爱怎么叫怎么叫吧」"
 },
 {
  "message": "既然柳木——不，诗梦已经接受了我，那无论她说什么，我都觉得无所谓了。"
 },
 {
  "name": "诗梦",
  "message": "「……再说几遍」"
 },
 {
  "name": "{fn}",
  "message": "「我喜欢你，诗梦」"
 },
 {
  "name": "诗梦",
  "message": "「……嗯」"
 },
 {
  "name": "{fn}",
  "message": "「我喜欢你」"
 },
 {
  "name": "诗梦",
  "message": "「嗯」"
 },
 {
  "name": "{fn}",
  "message": "「最喜欢你了」"
 },
 {
  "name": "诗梦",
  "message": "「说个没完了你」"
 },
 {
  "message": "她猛地转过身去，我顺势握住了她的手。"
 },
 {
  "name": "{fn}",
  "message": "「那，可以牵手吗」"
 },
 {
  "name": "诗梦",
  "message": "「不是已经牵上了吗……随你的便」"
 },
 {
  "message": "诗梦嘴上这么说，却也像是答应了一般，用力握住我的手。"
 },
 {
  "name": "冬桦",
  "message": "「啊，两位回来了！」"
 },
 {
  "name": "纱由美",
  "message": "「看来是谈妥——啊」"
 },
 {
  "name": "地藏",
  "message": "「哦哦～」"
 },
 {
  "message": "走到在此等候的众人面前，大家的目光不约而同地落在了我们握在一起的手上。"
 },
 {
  "name": "冬桦",
  "message": "「呵呵，看来两位已经好好聊过了呢♪」"
 },
 {
  "name": "纱由美",
  "message": "「太好啦……真是的」"
 },
 {
  "message": "纱由都有点忘了装样子，怪罪了两句，一副放下心来的样子。"
 },
 {
  "name": "地藏",
  "message": "「真叫人羡慕啊。这就是青春啊～不过，真想不到柳木会……」"
 },
 {
  "name": "诗梦",
  "message": "「……我自己才是最不敢相信的那个」"
 },
 {
  "name": "纱由美",
  "message": "「啊呀呀」"
 },
 {
  "name": "冬桦",
  "message": "「哎呀，又开始害羞了……♪」"
 },
 {
  "name": "诗梦",
  "message": "「不过，谢谢你们给我们时间」"
 },
 {
  "name": "冬桦",
  "message": "「呵呵，不客气」"
 },
 {
  "name": "纱由美",
  "message": "「被诗诗道谢，感觉都不太习惯呢」"
 },
 {
  "name": "地藏",
  "message": "「这下皆大欢喜啦！」"
 },
 {
  "message": "看来大家已经心领神会，纷纷祝福我们。"
 },
 {
  "name": "纱由美",
  "message": "「那・么～♪ 你们俩是怎么走到一起的呀？」"
 },
 {
  "name": "冬桦",
  "message": "「是呢，这可真让人好奇！」"
 },
 {
  "message": "熄灯前，一回到房间，鸿就一脸八卦地凑过来问。"
 },
 {
  "name": "亚子",
  "message": "「欸，不是吧？！诗诗谈恋爱了？」"
 },
 {
  "name": "美纱",
  "message": "「这情况还能跟那家伙谈上……厉害啊……」"
 },
 {
  "name": "诗梦",
  "message": "「那家伙……你们知道是谁？」"
 },
 {
  "name": "亚子",
  "message": "「这还用问，除了<ln>还能是谁」"
 },
 {
  "name": "亚子",
  "message": "「也就只有他有机会了吧，另一个修学旅行组织委员」"
 },
 {
  "name": "诗梦",
  "message": "「嗯……」"
 },
 {
  "message": "我表现得有那么明显吗？"
 },
 {
  "name": "纱由美",
  "message": "「毕竟诗诗你平常会理睬的男生，也就他一个嘛」"
 },
 {
  "name": "亚子",
  "message": "「可不是嘛。所以所以，你们到底怎么成的？」"
 },
 {
  "name": "美纱",
  "message": "「快快从实招来！！」"
 },
 {
  "message": "她们兴致盎然地逼问着我。"
 },
 {
  "name": "诗梦",
  "message": "「这有什么好说的」"
 },
 {
  "name": "纱由美",
  "message": "「欸～就是没什么好说的才更要听嘛～♪」"
 },
 {
  "name": "冬桦",
  "message": "「是啊，传说中的恋爱八卦……真好呢！」"
 },
 {
  "name": "纱由美",
  "message": "「谁先表的白？」"
 },
 {
  "name": "冬桦",
  "message": "「谈恋爱到底是什么感觉呀？」"
 },
 {
  "name": "亚子",
  "message": "「果然是因为住在一起才日久生情了？」"
 },
 {
  "name": "美纱",
  "message": "「还・是・说～♪ 当了修学旅行组织委员才？」"
 },
 {
  "message": "面对这连珠炮似的发问……"
 },
 {
  "name": "诗梦",
  "message": "「……我自己都还稀里糊涂的」"
 },
 {
  "name": "纱由美",
  "message": "「哇，这种不知所措的感觉……不就是恋爱的感觉嘛」"
 },
 {
  "name": "诗梦",
  "message": "「只是开始交往了而已，跟恋爱什么的还差得远呢」"
 },
 {
  "name": "冬桦",
  "message": "「欸，交往了……还不算恋爱吗？」"
 },
 {
  "name": "亚子",
  "message": "「这是在害羞呢」"
 },
 {
  "name": "美纱",
  "message": "「真好啊……好纯情」"
 },
 {
  "name": "纱由美",
  "message": "「好可爱～～♪」"
 },
 {
  "name": "冬桦",
  "message": "「原来如此……呵呵，真是让人会心一笑呢」"
 },
 {
  "name": "诗梦",
  "message": "「……别闹了」"
 },
 {
  "message": "我感觉自己的脸正阵阵发烫。"
 },
 {
  "message": "话虽如此，我也明白，能有今天，也多亏了身边这些人的支持与推动。"
 },
 {
  "message": "事已至此，也只能这样了。"
 },
 {
  "name": "冬桦",
  "message": "「呼……呼……呵呵呵……♪」"
 },
 {
  "name": "纱由美",
  "message": "「呼……呼……呼……」"
 },
 {
  "name": "诗梦",
  "message": "「呼……」"
 },
 {
  "message": "熄灯之后，她们依然问个没完，但大概是说累了，最后都睡着了。"
 },
 {
  "message": "明明我都没怎么回话，她们居然也能自顾自地聊那么久。"
 },
 {
  "name": "诗梦",
  "message": "（……这群人，还真是一个比一个爱操心）"
 },
 {
  "name": "诗梦",
  "message": "「啊……」"
 },
 {
  "name": "叶梦",
  "message": "这是今天拍的照片哟～！"
 },
 {
  "name": "叶梦",
  "message": " "
 },
 {
  "message": "是叶梦发来的，大概是她在读者模特那边拍的照片。"
 },
 {
  "message": "还没睡啊……"
 },
 {
  "message": "不过她向来是个夜猫子，倒也不奇怪。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "我蹑手蹑脚地走到外面，以免吵醒她们。"
 },
 {
  "name": "诗梦",
  "message": "「……喂」"
 },
 {
  "name": "叶梦",
  "message": "『啊，姐姐？我、我正要睡啦！！』"
 },
 {
  "message": "是怕我说她熬夜吗？"
 },
 {
  "name": "诗梦",
  "message": "「不是……你那边还好吗？」"
 },
 {
  "name": "叶梦",
  "message": "『欸？吃饭可以买便当点外卖，没问题的，斑斑也好得很——』"
 },
 {
  "name": "叶梦",
  "message": "『不过家里就我一个，好冷清啊——』"
 },
 {
  "message": "妹妹这种直率的性子，既让人羡慕，又可爱得不行。"
 },
 {
  "name": "诗梦",
  "message": "「我觉得，还是直接告诉你吧」"
 },
 {
  "name": "叶梦",
  "message": "『欸，怎么了？要买伴手礼？我想吃八桥饼——』"
 },
 {
  "name": "诗梦",
  "message": "「会给你买的……那个」"
 },
 {
  "message": "……奇怪，明明都决定要说了，怎么临到头这么害臊。"
 },
 {
  "name": "诗梦",
  "message": "「……我跟他交往了」"
 },
 {
  "name": "诗梦",
  "message": "「就是……<fn>」"
 },
 {
  "name": "诗梦",
  "message": "「就是……他」"
 },
 {
  "name": "叶梦",
  "message": "『欸？交往……和学长……就是说！你们成一对儿啦？！』"
 },
 {
  "name": "诗梦",
  "message": "「……是吧」"
 },
 {
  "message": "经小叶这么一说，真是感觉害羞得不行。"
 },
 {
  "name": "诗梦",
  "message": "（这样啊……我真的，和他在一起了啊）"
 },
 {
  "message": "感觉直到现在，才有了点真实感。"
 },
 {
  "name": "叶梦",
  "message": "『哇哇哇？！绝了！太棒了！！哇，哇！！』"
 },
 {
  "name": "诗梦",
  "message": "「……会吵到邻居的」"
 },
 {
  "name": "叶梦",
  "message": "『啊哇哇，对不起！不过，这样啊……嘿嘿嘿～姐姐，恭喜你呀～！』"
 },
 {
  "name": "诗梦",
  "message": "「嗯」"
 },
 {
  "name": "叶梦",
  "message": "『我早就有这种感觉了……不过，真为你开心呀』"
 },
 {
  "name": "诗梦",
  "message": "「又不是你的事，你开心什么」"
 },
 {
  "name": "叶梦",
  "message": "『才不是呢——你们能在一起我超开心的，姐姐特地打电话告诉我、我也超开心的——！！』"
 },
 {
  "name": "诗梦",
  "message": "「因为我想跟你说一声」"
 },
 {
  "name": "叶梦",
  "message": "『哇哇，姐姐突然这么老实……难、难道这就是恋爱的魔力……？』"
 },
 {
  "name": "诗梦",
  "message": "「好了好了，说完了，赶紧睡觉去」"
 },
 {
  "name": "叶梦",
  "message": "『啊，嗯……那个，姐姐』"
 },
 {
  "name": "诗梦",
  "message": "「怎么了？」"
 },
 {
  "name": "叶梦",
  "message": "『真是太好了。谢谢你告诉我，最喜欢姐姐了♪』"
 },
 {
  "name": "诗梦",
  "message": "「……我也一样，晚安」"
 },
 {
  "message": "我简短地回应道，挂了电话。"
 },
 {
  "name": "诗梦",
  "message": "「……真是的」"
 },
 {
  "message": "我凝视着黑下去的手机屏幕。"
 },
 {
  "name": "诗梦",
  "message": "「连我自己都觉得……太直白了」"
 },
 {
  "message": "脸颊一阵阵发烫。虽然不想承认，但这可能就是她口中恋爱的魔力吧。"
 },
 {
  "name": "诗梦",
  "message": "「今晚要是睡不着全都怪他」"
 },
 {
  "name": "诗梦",
  "message": "「今晚睡不着全都怪他」"
 },
 {
  "message": "我想着他——我的男朋友，小声嘀咕了一句，回了房间。"
 }
]