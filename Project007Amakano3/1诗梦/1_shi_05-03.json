[
 {
  "name": "{fn}",
  "message": "「啊，柳木——」"
 },
 {
  "message": "我出声叫她，可今天的柳木却连看都没看我一眼，径直走开了。"
 },
 {
  "message": "也难怪……"
 },
 {
  "name": "{fn}",
  "message": "「毕竟我一错再错……肯定会被人家躲着啊……」"
 },
 {
  "name": "{fn}",
  "message": "（我也被她看了个精光……）"
 },
 {
  "message": "而我也把她浑身上下看了个遍。"
 },
 {
  "message": "……不行了。"
 },
 {
  "message": "明明知道不该想，可脑子一空闲下来，那幅景象就会自动浮现。"
 },
 {
  "message": "柳木那赤裸的身体——"
 },
 {
  "name": "{fn}",
  "message": "「……真美啊」"
 },
 {
  "message": "不、不对。"
 },
 {
  "name": "{fn}",
  "message": "（……太色了）"
 },
 {
  "message": "糟糕，身体好像又开始有反应了。"
 },
 {
  "name": "{fn}",
  "message": "「不行不行」"
 },
 {
  "message": "我怎么非但没有反省，还在回味个没完啊。"
 },
 {
  "name": "{fn}",
  "message": "「这是被讨厌了……吧」"
 },
 {
  "message": "所谓信赖，瓦解起来不过是一瞬间的事。"
 },
 {
  "name": "{fn}",
  "message": "「唉……」"
 },
 {
  "message": "去学校准备修学旅行的时候，柳木也一次都没跟我对上过视线。"
 },
 {
  "message": "就算我主动跟她说话——"
 },
 {
  "name": "{fn}",
  "message": "「柳木——」"
 },
 {
  "name": "诗梦",
  "message": "「御所院，关于分组行动的事……」"
 },
 {
  "name": "冬桦",
  "message": "「嗯，有什么问题吗？」"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "message": "不知道是时机凑巧，还是她故意的。总之我被她无视得彻彻底底。"
 },
 {
  "message": "既然如此，机会就只剩——"
 },
 {
  "name": "一组组织委员",
  "message": "「——综上，当天在日和山温泉站集合，各班在车站清点人数」"
 },
 {
  "message": "放学后的修学旅行组织委员会上，我们俩会碰面。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "话虽如此，但周围都是人，根本没法搭话，何况那种事也实在开不了口。"
 },
 {
  "message": "必须在会议结束后，找机会跟她单独谈谈。"
 },
 {
  "name": "一组组织委员",
  "message": "「那么，会议到此结束。各位今天辛苦了」"
 },
 {
  "message": "会议刚一结束，柳木就像逃命一样冲出了教室。"
 },
 {
  "name": "{fn}",
  "message": "「——啊」"
 },
 {
  "message": "比我想的还要快。"
 },
 {
  "name": "{fn}",
  "message": "「柳木，等一下！」"
 },
 {
  "name": "诗梦",
  "message": "「唔！」"
 },
 {
  "message": "我能感觉到柳木屏住了呼吸，脚下的步子也更快了。"
 },
 {
  "message": "我不想一直被她这么讨厌下去，绝对不能让她跑了。"
 },
 {
  "name": "{fn}",
  "message": "「跑哪儿去了……」"
 },
 {
  "message": "刚想到这，人就跟丢了。她的动作比我想象的还快。"
 },
 {
  "name": "{fn}",
  "message": "「啊」"
 },
 {
  "message": "找到了。"
 },
 {
  "message": "她大概是想找地方躲起来，闪身进了一间空教室。"
 },
 {
  "name": "{fn}",
  "message": "「柳木……？」"
 },
 {
  "name": "诗梦",
  "message": "「啊……」"
 },
 {
  "name": "{fn}",
  "message": "「辛苦了」"
 },
 {
  "message": "我也知道这句开场白很蠢，但实在想不出别的话。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "name": "{fn}",
  "message": "「等一下！」"
 },
 {
  "message": "虽然很抱歉，可眼看柳木又要跑，我只好伸手抓住了她的胳膊。"
 },
 {
  "name": "{fn}",
  "message": "「我知道你很生气，但请听我解释」"
 },
 {
  "message": "她将脸扭到一边，我只能将她转过来。"
 },
 {
  "name": "诗梦",
  "message": "「……不要」"
 },
 {
  "name": "{fn}",
  "message": "「欸——柳木？」"
 },
 {
  "message": "我完全没想到她会是这副表情。"
 },
 {
  "message": "她没有生气。"
 },
 {
  "message": "她的眼眶里噙满了泪水——她在哭。"
 },
 {
  "name": "诗梦",
  "message": "「对不起，别看我……」"
 },
 {
  "message": "柳木擦掉眼泪，声音颤抖地说道。"
 },
 {
  "name": "{fn}",
  "message": "「……嗯、嗯」"
 },
 {
  "message": "她对我说的，不是拒绝也不是愤怒，而是带着歉意的恳求。"
 },
 {
  "name": "{fn}",
  "message": "（为什么要道歉？）"
 },
 {
  "message": "我缓缓松开了手。"
 },
 {
  "name": "{fn}",
  "message": "「我没有生气，你也没做什么需要道歉的事。真要说道歉，也该是我才对——」"
 },
 {
  "name": "诗梦",
  "message": "「不对，我……不」"
 },
 {
  "message": "这、这是怎么回事。"
 },
 {
  "message": "她说话含糊不清，完全不像平时那个干脆利落的她。"
 },
 {
  "name": "{fn}",
  "message": "「我来是想为浴室的事道歉，真的非常对不起」"
 },
 {
  "name": "诗梦",
  "message": "「？！」"
 },
 {
  "message": "她的肩膀剧烈地抖了一下。"
 },
 {
  "name": "诗梦",
  "message": "「不要……别，这样」"
 },
 {
  "name": "{fn}",
  "message": "「啊？」"
 },
 {
  "name": "诗梦",
  "message": "「因为我……太差劲了……」"
 },
 {
  "message": "我大概是第一次见到这样语无伦次的柳木。"
 },
 {
  "name": "{fn}",
  "message": "「什、什么意思？」"
 },
 {
  "name": "诗梦",
  "message": "「……我不想说」"
 },
 {
  "message": "她的声音在颤抖，将脸扭向一边。"
 },
 {
  "name": "诗梦",
  "message": "「……对不起」"
 },
 {
  "message": "我只能呆立在原地，目送她离去。"
 },
 {
  "name": "{fn}",
  "message": "「怎么回事啊……？」"
 },
 {
  "message": "柳木的言行举止让我一头雾水。"
 },
 {
  "message": "换作平时，她肯定会生气或是鄙夷地看着我，但现在却完全没有。"
 },
 {
  "message": "反而一个劲地向我道歉。"
 },
 {
  "message": "那件事从某种意义上说只是意外，我们双方都有责任。"
 },
 {
  "name": "{fn}",
  "message": "「可，为什么……？」"
 },
 {
  "name": "诗梦",
  "message": "（我……真傻）"
 },
 {
  "message": "我摆出那副态度，就像故意惹他讨厌一样。"
 },
 {
  "name": "诗梦",
  "message": "（……不要）"
 },
 {
  "message": "可是，我根本不敢正眼看他，连这都做不到。"
 },
 {
  "name": "诗梦",
  "message": "（我……居然用他……做了这种事……）"
 },
 {
  "message": "明明满心愧疚，可每当回想起那阵令人发麻的感觉，身体就忍不住燥热起来。"
 },
 {
  "name": "诗梦",
  "message": "（下流……）"
 },
 {
  "name": "诗梦",
  "message": "（我这样的人——可是，我不想被他讨厌。不要……不要……）"
 },
 {
  "name": "诗梦",
  "message": "「唉……」"
 },
 {
  "message": "原来我是这么任性的人吗？净想着自己好。"
 },
 {
  "name": "诗梦",
  "message": "「真是，不……」"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "name": "叶梦",
  "message": "「……」"
 },
 {
  "message": "回到房间，我发现姐姐一副我从没见过的样子。"
 },
 {
  "message": "她正紧紧抱着那只海豹玩偶，不知道在想些什么。"
 },
 {
  "message": "那只玩偶怎么了吗……？"
 },
 {
  "message": "不，现在不是想这个的时候。"
 },
 {
  "name": "叶梦",
  "message": "「那个，姐姐……？」"
 },
 {
  "name": "诗梦",
  "message": "「……怎么？」"
 },
 {
  "name": "叶梦",
  "message": "「发生什么事了吗？」"
 },
 {
  "name": "诗梦",
  "message": "「不用你管」"
 },
 {
  "name": "叶梦",
  "message": "「嗯、嗯……可是」"
 },
 {
  "name": "诗梦",
  "message": "「……行了，睡吧」"
 },
 {
  "message": "她紧紧地抱着玩偶，把自己埋进了被子里。"
 },
 {
  "name": "叶梦",
  "message": "（这要怎么放心啊……）"
 },
 {
  "message": "绝对是出什么事了。"
 },
 {
  "message": "每当这种时候，姐姐总是把事都憋在心里。"
 },
 {
  "name": "叶梦",
  "message": "（……有了）"
 },
 {
  "message": "先上AZ问问大家吧……"
 }
]