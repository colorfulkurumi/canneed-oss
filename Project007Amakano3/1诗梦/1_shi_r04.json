[
 {
  "name": "{fn}",
  "message": "（这到底是……）"
 },
 {
  "name": "语怡",
  "message": "『对呀对呀，选防晒霜真的很头疼呢～最近太阳这么毒，人家也在找好用的遮阳伞～』"
 },
 {
  "name": "语怡",
  "message": "『让我用妖术解决？你太不懂人家啦～！』"
 },
 {
  "name": "语怡",
  "message": "『用妖术也是很累的好不好～有方便省事的东西干嘛不用，这样更轻松呀～』"
 },
 {
  "message": "我看着语怡的直播，心里直犯嘀咕。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "因为诗梦正坐在我身边，和我一起看。"
 },
 {
  "message": "——事情要从午饭后说起。"
 },
 {
  "name": "诗梦",
  "message": "「下午有安排吗？」"
 },
 {
  "message": "午饭过后，我洗着碗，诗梦问我下午准备做什么。"
 },
 {
  "name": "{fn}",
  "message": "「想去哪儿吗？」"
 },
 {
  "message": "这是在约我？诗梦居然会主动开口，真叫人高兴。"
 },
 {
  "name": "诗梦",
  "message": "「不是，我只是问你平时这个时间都做些什么」"
 },
 {
  "name": "{fn}",
  "message": "「平时啊……？」"
 },
 {
  "name": "{fn}",
  "message": "「今天有语怡的直播，所以多半是看直播，或者打打游戏」"
 },
 {
  "name": "{fn}",
  "message": "「再不然就是保养一下钓具之类的吧」"
 },
 {
  "name": "诗梦",
  "message": "「语怡……？」"
 },
 {
  "name": "{fn}",
  "message": "「就是那个在AZ上直播的夏乃语怡」"
 },
 {
  "name": "诗梦",
  "message": "「小叶也看的那个人？」"
 },
 {
  "name": "{fn}",
  "message": "「是她是她」"
 },
 {
  "message": "而且，还是刚才跟我们一起吃素面的那个人。"
 },
 {
  "name": "诗梦",
  "message": "「那我也要看」"
 },
 {
  "name": "{fn}",
  "message": "「欸？」"
 },
 {
  "message": "这出乎意料的提议，让我不禁叫出了声。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "name": "语怡",
  "message": "『有款游戏人家想下次直播玩，正在问可不可以哦～』"
 },
 {
  "message": "电脑连着房里的电视，整个房间里只回响着语怡的声音。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "我偷偷瞥了眼身旁，只见她面无表情地盯着直播画面。"
 },
 {
  "name": "{fn}",
  "message": "「……你有兴趣？」"
 },
 {
  "message": "因为叶梦是她的铁杆粉丝，所以她也想了解一下？"
 },
 {
  "name": "诗梦",
  "message": "「完全没有」"
 },
 {
  "name": "{fn}",
  "message": "「哦，是吗」"
 },
 {
  "message": "这语气，听着真是一点兴趣都没有。"
 },
 {
  "name": "诗梦",
  "message": "「不过，你和小叶不都很喜欢她吗」"
 },
 {
  "name": "{fn}",
  "message": "「因为看着很治愈，还很好玩啊」"
 },
 {
  "name": "诗梦",
  "message": "「是么」"
 },
 {
  "name": "{fn}",
  "message": "「她玩游戏的时候，反应也特别有意思」"
 },
 {
  "name": "诗梦",
  "message": "「这个我好像听小叶说过」"
 },
 {
  "name": "{fn}",
  "message": "「那、那倒是……所以呢？」"
 },
 {
  "name": "诗梦",
  "message": "「我还是无法理解……现在也」"
 },
 {
  "name": "{fn}",
  "message": "「……是吗」"
 },
 {
  "message": "既然如此，她又为什么要提议一起看呢。"
 },
 {
  "name": "诗梦",
  "message": "「你喜欢这个叫『语怡』的？」"
 },
 {
  "name": "{fn}",
  "message": "「喜欢……只能算粉丝吧」"
 },
 {
  "message": "说到这儿，我猛地反应了过来。"
 },
 {
  "name": "{fn}",
  "message": "「啊～～～我看这种东西，你会不会不高兴？」"
 },
 {
  "message": "毕竟，有些女生会介意男朋友追星的。"
 },
 {
  "name": "诗梦",
  "message": "「只要你别陷得太深，就无所谓」"
 },
 {
  "name": "{fn}",
  "message": "「是、是吗……」"
 },
 {
  "message": "平时也就看看语怡的直播，应该不要紧吧。不对，『语花石』里似乎也有不少狂热分子？"
 },
 {
  "message": "再说，如果中之人是纱由，诗梦的心情恐怕会很复杂吧。"
 },
 {
  "name": "语怡",
  "message": "『说起海边，总觉得海之家的拉面特别好吃～就像是海风……给拉面施加了美味的魔法～』"
 },
 {
  "name": "诗梦",
  "message": "「……嗯嗯？」"
 },
 {
  "message": "她刚还心不在焉地看着直播，忽然就陷入了沉思。"
 },
 {
  "name": "{fn}",
  "message": "「怎么了？」"
 },
 {
  "name": "诗梦",
  "message": "「总觉得这个人，我好像认识……」"
 },
 {
  "name": "{fn}",
  "message": "「是叶梦给你看过，你才会有印象吧？」"
 },
 {
  "name": "诗梦",
  "message": "「不是，是这种说话的腔调，总觉得在什么地方……嗯？」"
 },
 {
  "message": "难道说。"
 },
 {
  "name": "诗梦",
  "message": "「……不是长相？她中之人很有名吗？」"
 },
 {
  "name": "{fn}",
  "message": "「不、不是，官方没公布过，我也不知道……」"
 },
 {
  "name": "诗梦",
  "message": "「不是声优啊……唔——」"
 },
 {
  "message": "不妙。"
 },
 {
  "message": "诗梦的直觉一向很准。"
 },
 {
  "message": "再让她看下去，搞不好真会被她发现中之人是纱由。"
 },
 {
  "name": "{fn}",
  "message": "「直播好像也快完了，我们不如去做点别的吧？」"
 },
 {
  "message": "现在还是打住比较好，我伸手去拿鼠标。"
 },
 {
  "name": "诗梦",
  "message": "「让我再看一会儿」"
 },
 {
  "name": "{fn}",
  "message": "「你不是没兴趣吗？那做点别的呗？」"
 },
 {
  "message": "看她伸手要来抢，我赶紧把鼠标移开。"
 },
 {
  "name": "诗梦",
  "message": "「我现在突然有兴趣了」"
 },
 {
  "name": "{fn}",
  "message": "「可我还有别的事想做」"
 },
 {
  "name": "诗梦",
  "message": "「……你是不是知道什么？」"
 },
 {
  "message": "唔，真敏锐。"
 },
 {
  "name": "{fn}",
  "message": "「我什么都不知道」"
 },
 {
  "message": "我拼命装出一副若无其事的样子。"
 },
 {
  "name": "诗梦",
  "message": "「……可疑。快点，鼠标给我」"
 },
 {
  "message": "反而更让她起疑了吗？她抢鼠标的动作愈发来劲，我则拼命闪躲。"
 },
 {
  "name": "{fn}",
  "message": "「别靠这么近啊……」"
 },
 {
  "message": "身体要失去平衡了……"
 },
 {
  "name": "诗梦",
  "message": "「既然这样你就乖乖交出来——拿到了」"
 },
 {
  "name": "{fn}",
  "message": "「啊」"
 },
 {
  "message": "鼠标被她抢走了。"
 },
 {
  "name": "{fn}",
  "message": "「还给我」"
 },
 {
  "name": "诗梦",
  "message": "「就再看一会儿又不会——嗯嗯？！」"
 },
 {
  "message": "她想要拉开距离的时候，身体失去了平衡——"
 },
 {
  "name": "{fn}",
  "message": "「危险！！」"
 },
 {
  "message": "我一把抓住她的手。"
 },
 {
  "name": "{fn}",
  "message": "「哇啊？！」"
 },
 {
  "message": "结果连我也跟着失去了平衡。"
 },
 {
  "message": "噗扭！"
 },
 {
  "name": "诗梦",
  "message": "「嗯嗯？！」"
 },
 {
  "name": "{fn}",
  "message": "「……欸？」"
 },
 {
  "message": "感觉，现在，有什么软乎乎的东西……"
 },
 {
  "name": "诗梦",
  "message": "「等——」"
 },
 {
  "message": "不对，毋庸置疑——我现在正把诗梦压在身下。"
 },
 {
  "message": "而且，我的手正陷在她的胸里。"
 },
 {
  "message": "……怎么回事，好软……"
 },
 {
  "message": "虽隔着衣料，那里依旧弹性十足。"
 },
 {
  "name": "诗梦",
  "message": "「～～～！」"
 },
 {
  "message": "刚才摔倒时似乎碰掉了电源，屏幕熄灭，房中霎时归于寂静。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "message": "屋里只剩下我们对视时发出的呼吸声。"
 },
 {
  "name": "{fn}",
  "message": "「抱、抱歉……」"
 },
 {
  "message": "正当我打算起身时，诗梦却一把抓住了我。"
 },
 {
  "name": "{fn}",
  "message": "「诗梦？」"
 },
 {
  "name": "诗梦",
  "message": "「我没有躲开……你应该明白吧」"
 },
 {
  "message": "诗梦的声音细若蚊蚋。她脸颊绯红，神情中并无半分厌恶。"
 },
 {
  "message": "……也就是说。"
 },
 {
  "message": "我按在她胸前的手指，稍稍用了几分力。"
 },
 {
  "name": "诗梦",
  "message": "「嗯、嗯嗯……哈啊」"
 },
 {
  "message": "她紧闭双眼，口中漏出的呻吟却甜得醉人。"
 },
 {
  "name": "诗梦",
  "message": "「哈啊……哈啊……哈啊……」"
 },
 {
  "message": "那娇媚的声音，仿佛要将我的理智熔断，指尖的力道也不由得加重了几分。"
 },
 {
  "message": "……超级软啊。"
 },
 {
  "name": "诗梦",
  "message": "「哈啊，嗯嗯，啊……哈啊……」"
 },
 {
  "message": "诗梦非但没有抗拒，反而一脸迷离地允许了这一切。"
 },
 {
  "message": "她明明对自己的胸自惭形秽，但这柔软的触感却有着令人沉沦的魔力。"
 },
 {
  "message": "仅仅是隔着衣物抚摸，我的下半身便已滚烫如火，大脑也因兴奋而濒临短路。"
 },
 {
  "name": "{fn}",
  "message": "「诗梦……」"
 },
 {
  "message": "我一边揉着她的胸，另一只手则隔着衣服抚过她的小腹，指尖顺势滑向她的身下。"
 },
 {
  "message": "这里……又会是什么样呢？"
 },
 {
  "name": "{fn}",
  "message": "「……可以吗？」"
 },
 {
  "name": "诗梦",
  "message": "「欸」"
 },
 {
  "message": "诗梦一直紧闭的双眸，倏地睁开了。"
 },
 {
  "message": "她的眼神里满是惊诧与困惑，仿佛眼前的一切都超乎了她的预料……"
 },
 {
  "name": "诗梦",
  "message": "「就是」"
 },
 {
  "message": "难道，是我会错意了？"
 },
 {
  "name": "诗梦",
  "message": "「……不行」"
 },
 {
  "name": "{fn}",
  "message": "「啊……」"
 },
 {
  "message": "糟糕，是我太心急了。能摸到胸就该见好就收了。"
 },
 {
  "name": "{fn}",
  "message": "「说、说得也是，哈哈……」"
 },
 {
  "message": "我讪笑着拉开距离，诗梦也缓缓坐起身来。"
 },
 {
  "name": "诗梦",
  "message": "「……笨蛋」"
 },
 {
  "name": "{fn}",
  "message": "「对不起」"
 },
 {
  "name": "诗梦",
  "message": "「啊……不是」"
 },
 {
  "message": "不是？"
 },
 {
  "message": "诗梦的反应很是慌乱。"
 },
 {
  "name": "{fn}",
  "message": "「那你是说——」"
 },
 {
  "name": "诗梦",
  "message": "「我……我还要去打工……！」"
 },
 {
  "message": "她慌慌张张地站起来，逃也似的跑出了房间。"
 },
 {
  "name": "{fn}",
  "message": "「这……这都叫什么事啊」"
 },
 {
  "message": "我究竟该怎么做才好，到底怎样才是对的，真是完全想不明白。"
 },
 {
  "name": "诗梦",
  "message": "「唉……」"
 },
 {
  "message": "我一边打扫神社，一边无精打采地叹着气。"
 },
 {
  "name": "诗梦",
  "message": "「笨蛋……说的是我」"
 },
 {
  "message": "刚才那种状况下。"
 },
 {
  "message": "明明是我自己暗示他，不躲开就是默许了。"
 },
 {
  "message": "明明自己主动挑逗他，事到临头又摆出那副样子。"
 },
 {
  "message": "我心里其实清楚得很。"
 },
 {
  "message": "被他摸固然开心，但除此之外——"
 },
 {
  "name": "诗梦",
  "message": "「比起直接做那种事，更希望他能先亲亲我……之类的」"
 },
 {
  "name": "诗梦",
  "message": "（一个会自慰的女的装什么纯情呢……）"
 },
 {
  "message": "真想就这么蹲下身，把脸埋进胳膊里。"
 },
 {
  "name": "诗梦",
  "message": "「～～～～～」"
 },
 {
  "message": "我只能用力挥舞扫帚。"
 },
 {
  "message": "真是丢死人了。"
 },
 {
  "message": "不过，他也是真听话，就这么打住了。"
 },
 {
  "name": "诗梦",
  "message": "「还是那么温柔，伪君子……滥好人」"
 },
 {
  "message": "如果是他的话，或许稍稍依赖一下这份温柔也无妨。"
 },
 {
  "name": "诗梦",
  "message": "「我……也可以像个少女一样吗……？」"
 },
 {
  "name": "{fn}",
  "message": "「我真是个……」"
 },
 {
  "message": "那种举动，简直和一头发情的野兽没什么两样。"
 },
 {
  "message": "虽然当面道歉很重要，但还是先在AZ上说声对不起吧。"
 },
 {
  "message": "幸好开始交往后我们加了好友。虽说头一次联络就是为了道歉，心情有些复杂，但也管不了那么多了。"
 },
 {
  "name": "{fn}",
  "message": "刚才对不起"
 },
 {
  "message": "她这会儿正在打工，想必不会立刻已读吧。"
 },
 {
  "message": "或许是下班了，手机嗡嗡地震动起来。"
 },
 {
  "message": "是她回消息了吗？"
 },
 {
  "name": "{fn}",
  "message": "「应、应该不要紧吧……」"
 },
 {
  "message": "她可能还在生气，或者对我很失望……"
 },
 {
  "name": "诗梦",
  "message": "我没放在心上"
 },
 {
  "name": "诗梦",
  "message": "该说对不起的人是我"
 },
 {
  "name": "{fn}",
  "message": "「欸……？」"
 },
 {
  "message": "她道歉了？"
 },
 {
  "message": "诗梦可不是会轻易低头的人。她的性格决定了她绝不会轻易妥协，更不会随口道歉。"
 },
 {
  "message": "可她居然道歉了……是在顾及我的感受？还是说，另有隐情？"
 },
 {
  "name": "{fn}",
  "message": "「不，与其在这里胡乱揣测，眼下有更要紧的事该做」"
 },
 {
  "message": "想让这段感情更进一步，光是道歉可不够。"
 },
 {
  "name": "{fn}",
  "message": "虽然算不上赔罪……下次要不要去约会？"
 },
 {
  "message": "这并非出于肉欲或冲动，而是我发自内心地想和她做些情侣间该做的事。"
 },
 {
  "message": "上次去海边是和大家一起。"
 },
 {
  "message": "修学旅行后，虽说也因委员会的工作，有过单独行动的机会，但还从未正经约出去玩过。"
 },
 {
  "message": "片刻之后。"
 },
 {
  "name": "诗梦",
  "message": "知道了，我看下时间"
 },
 {
  "message": "回复虽短，但她还是答应了。"
 }
]