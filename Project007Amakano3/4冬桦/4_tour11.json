[
 {
  "name": "冬桦",
  "message": "「唔……嗯……」"
 },
 {
  "message": "这一觉睡得格外香甜。"
 },
 {
  "message": "明明不是平时睡的床，却睡得相当踏实。"
 },
 {
  "name": "冬桦",
  "message": "（果然，是因为有他陪在身边一起睡吧——）"
 },
 {
  "message": "想到这里，我的目光落在了他的睡脸上——"
 },
 {
  "name": "冬桦",
  "message": "「咦……？」"
 },
 {
  "message": "晨光洒在他沉睡的脸庞上。不再是昏暗中那模糊的轮廓，而是清晰可见的……我的男友。"
 },
 {
  "name": "冬桦",
  "message": "「啊……」"
 },
 {
  "name": "冬桦",
  "message": "（我这是怎么了……明明都和他抱过，甚至还接了吻……）"
 },
 {
  "message": "倒不如说，正是因为接了吻，我们才算真正意义上的恋人吧。"
 },
 {
  "message": "感觉情绪难以平复。正是因为明白了这份爱意，才更觉得害羞。"
 },
 {
  "message": "鼻尖萦绕着一阵若有若无的幽香。"
 },
 {
  "name": "{fn}",
  "message": "「嗯……唔……嗯嗯」"
 },
 {
  "name": "冬桦",
  "message": "「啊……」"
 },
 {
  "message": "我一睁眼，看到冬桦正直勾勾地盯着我的脸。"
 },
 {
  "message": "啊……是冬桦身上的香气……"
 },
 {
  "name": "{fn}",
  "message": "「真好……」"
 },
 {
  "name": "冬桦",
  "message": "「欸？」"
 },
 {
  "name": "{fn}",
  "message": "「啊，没什么……早上好」"
 },
 {
  "message": "我都不知道自己刚才说了什么，脸颊一阵发烫。希望我没说什么奇怪的梦话。"
 },
 {
  "name": "冬桦",
  "message": "「贵安，早上好」"
 },
 {
  "name": "{fn}",
  "message": "「早上好……啊，对了，睡得怎么样？」"
 },
 {
  "message": "我厚着脸皮，开口问道。"
 },
 {
  "name": "冬桦",
  "message": "「睡得很踏实哦」"
 },
 {
  "name": "{fn}",
  "message": "「是吗，那就好」"
 },
 {
  "message": "没想到她适应得还挺快，换了张床也睡得这么安稳。"
 },
 {
  "name": "冬桦",
  "message": "「……」"
 },
 {
  "name": "{fn}",
  "message": "「嗯？」"
 },
 {
  "message": "冬桦没说话，只是目不转睛地盯着我看。"
 },
 {
  "name": "冬桦",
  "message": "「……唔」"
 },
 {
  "message": "刚和我对上视线，她就把脸扭到一边。"
 },
 {
  "name": "{fn}",
  "message": "「冬桦……？」"
 },
 {
  "name": "冬桦",
  "message": "「没什么！没事没事」"
 },
 {
  "name": "{fn}",
  "message": "「是吗……？」"
 },
 {
  "message": "难道说，她也害羞了？"
 },
 {
  "message": "我们都互啃过了……啊，不过，我记得她之前不是还觉得那很正常吗。"
 },
 {
  "message": "……咕噜。"
 },
 {
  "name": "冬桦",
  "message": "「啊……不、不是这样的」"
 },
 {
  "message": "声音虽小，但听起来是肚子叫了。"
 },
 {
  "name": "{fn}",
  "message": "「我去做早饭吧」"
 },
 {
  "name": "冬桦",
  "message": "「好、好的，那就麻烦你了」"
 },
 {
  "name": "冬桦",
  "message": "「今天吃面包呀」"
 },
 {
  "name": "{fn}",
  "message": "「嗯，感觉很普通吧」"
 },
 {
  "message": "烤吐司，煎蛋，香肠，配上沙拉，再加一碗清汤。"
 },
 {
  "name": "冬桦",
  "message": "「那么，我开动了」"
 },
 {
  "name": "{fn}",
  "message": "「吃吧」"
 },
 {
  "message": "冬桦像往常一样优雅地双手合十，然后开始用餐。"
 },
 {
  "message": "她用餐的样子明明和之前没什么两样……"
 },
 {
  "name": "冬桦",
  "message": "「啊呜……嗯嗯……」"
 },
 {
  "message": "我的目光，不由自主地落在了她咀嚼食物的嘴角上。"
 },
 {
  "name": "{fn}",
  "message": "（谁让……我们才刚接过吻呢……）"
 },
 {
  "message": "一想到昨晚的事，我的脸就有点发烫。"
 },
 {
  "name": "冬桦",
  "message": "「怎么了？一直盯着我的嘴看，很没礼貌哦」"
 },
 {
  "message": "冬桦用手掩住嘴，看起来有些为难。"
 },
 {
  "name": "{fn}",
  "message": "「啊，对、对不起」"
 },
 {
  "message": "的确，我不该这么盯着她看。"
 },
 {
  "name": "{fn}",
  "message": "「那，作为补偿……啊——」"
 },
 {
  "message": "我下意识地像以前那样，把食物递到她嘴边。"
 },
 {
  "name": "冬桦",
  "message": "「啊……不了！还是你自己吃吧！」"
 },
 {
  "message": "她下意识地张开嘴，又立刻反应过来，连忙用手捂住。"
 },
 {
  "name": "{fn}",
  "message": "「是、是吗？」"
 },
 {
  "message": "这果然是……害羞了？"
 },
 {
  "name": "冬桦",
  "message": "（为、为什么会变成这样啊……）"
 },
 {
  "message": "明明像这样喂来喂去，也不是一次两次了。"
 },
 {
  "name": "冬桦",
  "message": "（不对，仔细一想，这种行为本身是不是就很大胆……？）"
 },
 {
  "name": "冬桦",
  "message": "（难道说，我以前……太不知羞耻了吗……？）"
 },
 {
  "name": "冬桦",
  "message": "「呜呜呜……」"
 },
 {
  "message": "脸颊好烫。"
 },
 {
  "message": "我在害羞这件事，一定被他看穿了。"
 },
 {
  "name": "冬桦",
  "message": "（可是，这种害羞的感觉……真的控制不住啊……）"
 },
 {
  "name": "{fn}",
  "message": "（这怎么看……都是害羞了吧）"
 },
 {
  "message": "明明亲嘴的时候那么大胆，现在却因为这种小事脸红。"
 },
 {
  "message": "不，或许正因为我们成了『恋人』，才会这样吧。虽然有点出乎意料……"
 },
 {
  "name": "{fn}",
  "message": "（但她是真可爱啊）"
 },
 {
  "message": "能看到冬桦不同以往的一面，能真切感受到她已把我当成了恋人，我打心底里感到高兴。"
 },
 {
  "name": "{fn}",
  "message": "「冬桦，你果然是不好意思了？」"
 },
 {
  "message": "吃完午饭，我向正在洗碗的冬桦问道。"
 },
 {
  "name": "冬桦",
  "message": "「呜……」"
 },
 {
  "message": "冬桦的视线有些躲闪。"
 },
 {
  "name": "冬桦",
  "message": "「是……吧，总是会莫名其妙地在意……被你看着，心就静不下来」"
 },
 {
  "name": "{fn}",
  "message": "「是吗……要是你觉得实在太难为情，那今天我们就各做各的——」"
 },
 {
  "message": "虽然有点寂寞，不过还是让她先冷静一下比较好。"
 },
 {
  "name": "冬桦",
  "message": "「不，我马上就要回去了，不想浪费我们在一起的时间」"
 },
 {
  "name": "{fn}",
  "message": "「是、是吗？」"
 },
 {
  "message": "就算害羞也想和我待在一起啊，这也太可爱了。"
 },
 {
  "name": "冬桦",
  "message": "「啊……对了，像昨天那样，从身后抱着我吧」"
 },
 {
  "name": "{fn}",
  "message": "「可、可以吗？」"
 },
 {
  "message": "没想到她会主动提出这么大胆的要求。"
 },
 {
  "name": "冬桦",
  "message": "「嗯，只要看不到彼此的脸，应该就不要紧」"
 },
 {
  "message": "我很想说……这是问题所在吗。"
 },
 {
  "message": "不过能抱她，我当然没理由拒绝。"
 },
 {
  "name": "{fn}",
  "message": "「那、那我抱了哦」"
 },
 {
  "name": "冬桦",
  "message": "「请、请吧」"
 },
 {
  "message": "我绕到冬桦身后，轻轻地从后面抱住她。"
 },
 {
  "name": "冬桦",
  "message": "「嗯……哈啊……」"
 },
 {
  "message": "冬桦的身子绷得紧紧的，看来很紧张。"
 },
 {
  "name": "{fn}",
  "message": "「深、深呼吸」"
 },
 {
  "name": "冬桦",
  "message": "「嗯，好……嘶～～哈～～嘶～～哈～～」"
 },
 {
  "message": "她一脸认真地大口深呼吸。"
 },
 {
  "message": "深呼吸起了作用，她那紧绷的身体也随之舒缓了些许。"
 },
 {
  "name": "{fn}",
  "message": "「如何……？」"
 },
 {
  "name": "冬桦",
  "message": "「哈……哈啊……声音就在耳边呢」"
 },
 {
  "name": "{fn}",
  "message": "「彼此彼此……」"
 },
 {
  "message": "她身上还带着一丝僵硬，但怀里的躯体却那么柔软。暖意融融，让人心安。"
 },
 {
  "message": "这香气和早晨闻到的一样……真好闻。"
 },
 {
  "name": "{fn}",
  "message": "（不不，我可不是故意凑上去闻的！）"
 },
 {
  "message": "我不由得有些担心自己的呼吸听起来太粗重。"
 },
 {
  "name": "冬桦",
  "message": "「那个……抱着我，你……感觉怎么样？」"
 },
 {
  "name": "{fn}",
  "message": "「棒极了」"
 },
 {
  "name": "冬桦",
  "message": "「棒、棒极了……吗」"
 },
 {
  "name": "{fn}",
  "message": "「嗯」"
 },
 {
  "name": "冬桦",
  "message": "「……那我，肯定也觉得……棒极了」"
 },
 {
  "message": "冬桦将身体完全倚靠在我的怀里。"
 },
 {
  "name": "冬桦",
  "message": "「那个，虽然很不好意思……但我不讨厌，这样贴着」"
 },
 {
  "name": "{fn}",
  "message": "「我明白哦」"
 },
 {
  "name": "冬桦",
  "message": "「感觉还是好不可思议」"
 },
 {
  "name": "{fn}",
  "message": "「很不好意思？」"
 },
 {
  "name": "冬桦",
  "message": "「是的，怎么都静不下来，特别不好意思……可又想一直沉浸在这种感觉里」"
 },
 {
  "name": "{fn}",
  "message": "「我跟你一样」"
 },
 {
  "message": "明明害羞得要命，却又想一直沉浸在这种感觉里。"
 },
 {
  "name": "冬桦",
  "message": "「这……就是所谓的恋爱吧」"
 },
 {
  "name": "{fn}",
  "message": "「那还真是让人开心啊」"
 },
 {
  "name": "冬桦",
  "message": "「我也是……♪」"
 },
 {
  "message": "她说着，满足地眯起双眼，仰头望向我。"
 },
 {
  "name": "{fn}",
  "message": "「冬桦……？」"
 },
 {
  "name": "冬桦",
  "message": "「要把这种感觉表达出来……就需要这样吧」"
 },
 {
  "message": "也就是……那个意思了。"
 },
 {
  "name": "{fn}",
  "message": "「嗯，我喜欢你」"
 },
 {
  "message": "我低头吻住了冬桦。"
 },
 {
  "name": "冬桦",
  "message": "「嗯……啾……啾♪ 继续……♪」"
 },
 {
  "name": "{fn}",
  "message": "「当然」"
 },
 {
  "message": "面对她这么可爱的请求，我的吻一个接着一个。"
 },
 {
  "name": "冬桦",
  "message": "「啾……哈啊，啾……嗯♪ 嗯噜……咧……咧噜，咧咯♪」"
 },
 {
  "message": "明明那么害羞，却主动和我舌吻。"
 },
 {
  "message": "这份反差感简直让人欲罢不能。"
 },
 {
  "name": "冬桦",
  "message": "「啾啪，咧……咧咯，咧咯咯……哈啊，哈啊♪ 呵呵，脸好烫啊」"
 },
 {
  "message": "她满意地笑了。"
 },
 {
  "name": "{fn}",
  "message": "「只是脸烫吗？」"
 },
 {
  "name": "冬桦",
  "message": "「还，很舒服……哈呜」"
 },
 {
  "message": "她飞快地瞥了我一眼，红着脸转过头去，继续洗碗。"
 },
 {
  "message": "她这副害羞的模样实在太过可爱，我用力抱紧了她。"
 },
 {
  "name": "冬桦",
  "message": "「哈啊……果然还是会静不下来，感觉轻飘飘的……♪」"
 },
 {
  "name": "{fn}",
  "message": "「我也是……想多抱你一会儿」"
 },
 {
  "name": "冬桦",
  "message": "「嗯，请吧……呵呵」"
 },
 {
  "name": "{fn}",
  "message": "「嗯？」"
 },
 {
  "name": "冬桦",
  "message": "「感觉有点舍不得回家了呢」"
 },
 {
  "name": "{fn}",
  "message": "「……是啊」"
 },
 {
  "name": "冬桦",
  "message": "「到了那边，我也会联系你的」"
 },
 {
  "name": "{fn}",
  "message": "「我等你……我也会联系你的」"
 },
 {
  "name": "冬桦",
  "message": "「说定了哦♪」"
 },
 {
  "message": "冬桦紧紧贴着我，轻声道。"
 }
]