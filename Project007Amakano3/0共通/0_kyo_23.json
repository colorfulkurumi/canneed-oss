[
 {
  "name": "{fn}",
  "message": "「你好啊——！」"
 },
 {
  "name": "民宿大叔",
  "message": "「哟——来钓鱼啊？有阵子没见你了」"
 },
 {
  "name": "{fn}",
  "message": "「最近有点忙，一直没过来。还有沙蚕吗？」"
 },
 {
  "message": "我在防波堤附近的民宿大叔那儿买了些沙蚕。"
 },
 {
  "name": "民宿大叔",
  "message": "「给，二十五」"
 },
 {
  "name": "{fn}",
  "message": "「谢啦」"
 },
 {
  "name": "{fn}",
  "message": "「今天在啊——！」"
 },
 {
  "name": "渔夫大叔",
  "message": "「你好啊，别掉海里去了」"
 },
 {
  "name": "{fn}",
  "message": "「晓得啦——！」"
 },
 {
  "message": "跟本地的渔夫打过招呼，我便朝着一直去的防波堤进发。"
 },
 {
  "name": "{fn}",
  "message": "「……好嘞」"
 },
 {
  "message": "我拿出鱼竿，安上卷线器。"
 },
 {
  "message": "哦对，今天我打算慢慢钓，还得把椅子支起来。"
 },
 {
  "message": "准备工作差不多完成了。"
 },
 {
  "name": "{fn}",
  "message": "「就看你的了，小沙蚕」"
 },
 {
  "message": "我把还在扭来扭去的沙蚕挂到鱼钩上。"
 },
 {
  "message": "其实这家伙的牙齿还挺锋利的，得小心别被咬到。不过就算被咬了，也就跟被针扎一下似的。"
 },
 {
  "message": "它张嘴咬人的瞬间就是机会，趁机把钩子穿进它嘴里！！"
 },
 {
  "message": "好了，趁着它还活蹦乱跳，赶紧扔进海里去引鱼上钩吧。"
 },
 {
  "name": "{fn}",
  "message": "「嘿咻」"
 },
 {
  "message": "我将鱼钩垂入水中。"
 },
 {
  "message": "接下来，只有等待了。"
 },
 {
  "name": "{fn}",
  "message": "「……呼」"
 },
 {
  "message": "我很享受这段时间。"
 },
 {
  "message": "呆呆地望着海平面，感受下四周的绿意，看海浪起伏。"
 },
 {
  "message": "虽然是无意义的时光，不过这种放空的感觉真好。"
 },
 {
  "name": "{fn}",
  "message": "「哦呦」"
 },
 {
  "message": "这么快就有鱼咬钩了，这力道还不小。"
 },
 {
  "name": "{fn}",
  "message": "「可得把钩子吞牢了啊～」"
 },
 {
  "name": "{fn}",
  "message": "「哦，来了来了，好嘞好嘞……起～～～！」"
 },
 {
  "message": "这手感，八成是……"
 },
 {
  "name": "{fn}",
  "message": "「果然，是沙尖」"
 },
 {
  "message": "这附近最常见的就是它，我今天就是来钓它的。开心啊，看来今天开门红。"
 },
 {
  "message": "看来今个要满载而归了……！！"
 },
 {
  "message": "——可惜光起个头，就没了下文。"
 },
 {
  "name": "{fn}",
  "message": "「怎么没动静啊……」"
 },
 {
  "message": "自那之后，就再没鱼咬钩了。"
 },
 {
  "message": "算了……悠闲地等待，也是钓鱼的乐趣嘛。"
 },
 {
  "name": "诗梦",
  "message": "「这大热天的，真有闲情逸致」"
 },
 {
  "name": "{fn}",
  "message": "「欸，柳木？」"
 },
 {
  "message": "我被那个顺着防波堤走来的人影吓了一跳，宿舍离这儿可不近啊。"
 },
 {
  "name": "{fn}",
  "message": "「你怎么跑这儿来了？」"
 },
 {
  "name": "诗梦",
  "message": "「谁知道」"
 },
 {
  "name": "{fn}",
  "message": "「……找我有什么事吗？」"
 },
 {
  "name": "诗梦",
  "message": "「没事」"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "话虽如此，她却丝毫没有要走的意思。果然是有事找我吧……？"
 },
 {
  "name": "{fn}",
  "message": "「要是站累了，可以坐那个保温箱上，那玩意儿结实着呢」"
 },
 {
  "name": "诗梦",
  "message": "「这是怕我把它坐塌了？」"
 },
 {
  "name": "{fn}",
  "message": "「不是！我是让你别客气随便坐」"
 },
 {
  "name": "诗梦",
  "message": "「哼——」"
 },
 {
  "message": "看来我刚才那话有歧义啊。"
 },
 {
  "message": "……算了，既然她本人都说没事，那我也乐得清闲，继续钓我的鱼好了。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "message": "不对劲，她这是在干嘛？"
 },
 {
  "message": "虽然是我让她坐的，可她还真就坐下了，还一个劲儿地盯着我看。"
 },
 {
  "message": "可每当我想迎上她的视线——"
 },
 {
  "name": "诗梦",
  "message": "「干嘛？」"
 },
 {
  "message": "她便会瞪我一眼。这家伙到底想怎么样啊。"
 },
 {
  "name": "诗梦",
  "message": "「……呼」"
 },
 {
  "message": "柳木擦了下额头的汗。六月这天气，就算在现在这时间也已经相当热了。"
 },
 {
  "message": "更别说还是在这种毫无遮挡的水泥防波堤上了。"
 },
 {
  "name": "{fn}",
  "message": "「要吗？」"
 },
 {
  "message": "我把路上顺手买的瓶装运动饮料递了过去。"
 },
 {
  "name": "{fn}",
  "message": "「还没开盖。你万一中暑了，我也不好过」"
 },
 {
  "name": "诗梦",
  "message": "「这是你的吧」"
 },
 {
  "message": "不出所料，她立马就拒绝了。"
 },
 {
  "name": "{fn}",
  "message": "「没事，那边就有自动售货机，我再去买一瓶就是了」"
 },
 {
  "message": "而且那台售货机卖得还出奇地便宜，我常去光顾。"
 },
 {
  "name": "诗梦",
  "message": "「那我自己去买，不想莫名其妙欠你人情」"
 },
 {
  "name": "{fn}",
  "message": "「你要不想就不想吧」"
 },
 {
  "message": "我把鱼竿往椅子上的竿架里一插，转身就朝售货机走去。"
 },
 {
  "name": "诗梦",
  "message": "「等、等下，欸？！」"
 },
 {
  "message": "我回头一看，只见柳木手忙脚乱……？"
 },
 {
  "message": "——等等，啊嘞？鱼竿有反应，是鱼上钩了？"
 },
 {
  "name": "诗梦",
  "message": "「这、这怎么回事啊！」"
 },
 {
  "message": "柳木紧紧抓着鱼竿，一副不知如何是好的样子。"
 },
 {
  "name": "诗梦",
  "message": "「喂，回来」"
 },
 {
  "name": "{fn}",
  "message": "「不好意思，多谢！」"
 },
 {
  "message": "我接过鱼竿，脑子里突然冒出一个念头。"
 },
 {
  "name": "{fn}",
  "message": "「……要不试试把它钓上来？」"
 },
 {
  "name": "诗梦",
  "message": "「欸？你突然说什么呢」"
 },
 {
  "name": "{fn}",
  "message": "「机会难得嘛，抓紧了」"
 },
 {
  "message": "也许是还没缓过神来，她居然真的老老实实握住了鱼竿。"
 },
 {
  "name": "{fn}",
  "message": "「快摇卷线轮——不，先等等！」"
 },
 {
  "message": "这股劲儿，不像沙尖啊。"
 },
 {
  "message": "莫非——"
 },
 {
  "name": "诗梦",
  "message": "「到底要我干什么啊？」"
 },
 {
  "name": "{fn}",
  "message": "「别急着收线，先把竿子往后提。这样才能把钩子钩牢」"
 },
 {
  "name": "诗梦",
  "message": "「嘿，咻……」"
 },
 {
  "message": "柳木的动作虽然生疏，但还是使劲把鱼竿给提了起来。"
 },
 {
  "name": "{fn}",
  "message": "「没错没错。放心，鱼线结实着呢。等鱼挣扎到没力气就行……应该吧」"
 },
 {
  "name": "诗梦",
  "message": "「应该吧？含含糊糊的」"
 },
 {
  "name": "{fn}",
  "message": "「钓鱼没有定式。就是这样，再慢一点，一点点收线……」"
 },
 {
  "name": "诗梦",
  "message": "「这、这样吗？」"
 },
 {
  "name": "{fn}",
  "message": "「哦哦，有两下子嘛」"
 },
 {
  "name": "{fn}",
  "message": "「嘿咻」"
 },
 {
  "message": "我拿起网，将那条游到防波堤边的鱼一把捞了上来。"
 },
 {
  "name": "诗梦",
  "message": "「钓、钓到了……？」"
 },
 {
  "name": "{fn}",
  "message": "「哦哦！还真是黑鲷！！好大一条！！」"
 },
 {
  "name": "诗梦",
  "message": "「黑鲷？」"
 },
 {
  "name": "{fn}",
  "message": "「就是黑棘鲷！头一回钓鱼就钓上这种大家伙，你也太猛了吧！太强了！！」"
 },
 {
  "message": "况且现在已经过了季节，没那么好钓。这运气简直让人嫉妒。"
 },
 {
  "name": "诗梦",
  "message": "「好近……你太兴奋了」"
 },
 {
  "name": "{fn}",
  "message": "「啊、啊啊，不好意思……唉，真好啊」"
 },
 {
  "message": "我摘下鱼钩，又把那条黑鲷提溜起来给柳木看。"
 },
 {
  "name": "诗梦",
  "message": "「呜哇……感觉好恶心」"
 },
 {
  "name": "{fn}",
  "message": "「欸——我觉得挺帅的啊。是做黄油香煎呢……还是做成刺身？你想怎么吃？」"
 },
 {
  "name": "诗梦",
  "message": "「欸，要吃了它吗？」"
 },
 {
  "name": "{fn}",
  "message": "「这不钓都钓上来了吗」"
 },
 {
  "name": "诗梦",
  "message": "「……那做熟了吃吧」"
 },
 {
  "name": "{fn}",
  "message": "「OK」"
 },
 {
  "message": "我将这条大鱼放进了冷藏箱。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "name": "诗梦",
  "message": "<ef2>「……呼」</e>"
 },
 {
  "message": "柳木看着我，看上去似乎有些满足。"
 },
 {
  "name": "{fn}",
  "message": "「我也不能输啊……」"
 },
 {
  "message": "我重新挂好沙蚕，再次将钓线甩入海中。"
 },
 {
  "name": "诗梦",
  "message": "「呼……」"
 },
 {
  "message": "柳木啜了一口运动饮料，视线落在我的身上。"
 },
 {
  "name": "诗梦",
  "message": "「你很开心吗」"
 },
 {
  "name": "{fn}",
  "message": "「那是，毕竟爱好」"
 },
 {
  "name": "诗梦",
  "message": "「意思你平时就不开心？」"
 },
 {
  "message": "原来如此，她想问这个啊。"
 },
 {
  "name": "{fn}",
  "message": "「……看情况吧」"
 },
 {
  "message": "正因如此，我才如实作答。"
 },
 {
  "name": "诗梦",
  "message": "「也就是说，你也有不开心的时候」"
 },
 {
  "name": "{fn}",
  "message": "「那肯定」"
 },
 {
  "name": "诗梦",
  "message": "「就算这样，你也要逞强，装出一副好人的样子？」"
 },
 {
  "name": "{fn}",
  "message": "「……我不否认」"
 },
 {
  "name": "诗梦",
  "message": "「什么意思，你真是个伪君子啊？」"
 },
 {
  "name": "{fn}",
  "message": "「随你怎么想。说到底，我只是在做自己想做的事」"
 },
 {
  "name": "诗梦",
  "message": "「哪怕是逞强，么」"
 },
 {
  "name": "{fn}",
  "message": "「你很清楚嘛」"
 },
 {
  "name": "诗梦",
  "message": "「你和叶梦一样」"
 },
 {
  "message": "说着，她蹙起了眉头。"
 },
 {
  "name": "诗梦",
  "message": "「……把你和叶梦相提并论，真是糟糕」"
 },
 {
  "name": "{fn}",
  "message": "「明明是你自己说的」"
 },
 {
  "name": "诗梦",
  "message": "「什么？」"
 },
 {
  "name": "{fn}",
  "message": "「明明是你自己说的」"
 },
 {
  "name": "诗梦",
  "message": "「我让你别说，你就非要说出来？」"
 },
 {
  "name": "{fn}",
  "message": "「因为我是伪君子啊，所以偶尔也会使点坏嘛」"
 },
 {
  "name": "诗梦",
  "message": "「……是啊，你说出来也正常」"
 },
 {
  "name": "{fn}",
  "message": "「幻灭了？」"
 },
 {
  "name": "诗梦",
  "message": "「谈不上幻灭，我本来就没对你抱什么期待」"
 },
 {
  "name": "诗梦",
  "message": "「让自己去做不想做的事，真是神经。果然，我无法理解你」"
 },
 {
  "name": "{fn}",
  "message": "「人嘛，本来就很难真正理解另一个人」"
 },
 {
  "name": "诗梦",
  "message": "「嗯……」"
 },
 {
  "message": "听了我的回答，她露出了几分意外的神色。"
 },
 {
  "name": "{fn}",
  "message": "「怎么了？」"
 },
 {
  "name": "诗梦",
  "message": "「我还以为你会说出『正因为能够互相理解，人才是人』之类的呢」"
 },
 {
  "name": "{fn}",
  "message": "「我又不是什么圣人君子」"
 },
 {
  "name": "诗梦",
  "message": "「也对，你是个伪君子」"
 },
 {
  "message": "一阵海风拂过，吹乱了我们俩的头发。"
 },
 {
  "message": "方才因钓鱼而有些忙乱，此刻这阵凉风拂身，格外舒爽。"
 },
 {
  "name": "诗梦",
  "message": "「……跟个傻瓜似的」"
 },
 {
  "message": "她低声嘟囔了一句，又啜了一口运动饮料。"
 },
 {
  "name": "诗梦",
  "message": "「多谢」"
 },
 {
  "message": "她晃了晃手中的瓶子，转身走开了。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "message": "我目送着她远去。"
 },
 {
  "message": "……她最后那句话。"
 },
 {
  "message": "虽然腔调还和以前一样，但声音里却透着前所未有的温柔。"
 },
 {
  "name": "{fn}",
  "message": "「——哦」"
 },
 {
  "message": "手上传来一阵动静，我立刻把视线投向海面。又有鱼上钩了。"
 },
 {
  "message": "回到宿舍，发现柳木今天也在厨房准备晚饭。"
 },
 {
  "name": "蕾蒂",
  "message": "「欢迎回来，主人」"
 },
 {
  "name": "{fn}",
  "message": "「我回来了」"
 },
 {
  "message": "我朝斑鸠学姐点了点头，然后走到柳木旁边。"
 },
 {
  "name": "{fn}",
  "message": "「我做鱼可以吗？」"
 },
 {
  "name": "诗梦",
  "message": "「随你便」"
 },
 {
  "name": "{fn}",
  "message": "「那我就不客气了」"
 },
 {
  "name": "叶梦",
  "message": "「鱼？」"
 },
 {
  "name": "{fn}",
  "message": "「刚钓的，今天大丰收」"
 },
 {
  "message": "我打开冷藏箱，向她们展示今天的渔获。"
 },
 {
  "name": "叶梦",
  "message": "「欸？！这么多都是你钓的？也太牛了吧？！」"
 },
 {
  "name": "冬桦",
  "message": "「哎呀，这都是钓到的吗……真是厉害！准备做些什么呢？」"
 },
 {
  "name": "{fn}",
  "message": "「沙尖钓了不少……要不做天妇罗？」"
 },
 {
  "name": "叶梦",
  "message": "「要炸？那必须得让姐姐来啊！」"
 },
 {
  "name": "诗梦",
  "message": "「欸」"
 },
 {
  "message": "听叶梦这么一说，柳木愣了一下。"
 },
 {
  "name": "{fn}",
  "message": "「别的我会准备好，你能帮忙炸一下吗」"
 },
 {
  "name": "冬桦",
  "message": "「又有酥酥脆脆的吃了吗？！」"
 },
 {
  "name": "叶梦",
  "message": "「沙尖的话，应该是外酥里嫩吧～♪」"
 },
 {
  "name": "冬桦",
  "message": "「外酥里嫩……我已经等不及了！」"
 },
 {
  "name": "纱由美",
  "message": "「啊啦，大家好热闹啊♪」"
 },
 {
  "name": "蕾蒂",
  "message": "「我把桌子收拾一下吧」"
 },
 {
  "name": "纱由美",
  "message": "「蕾蒂，多谢啦♪」"
 },
 {
  "message": "感觉很少像这样全员到齐。热热闹闹的……倒也不坏。"
 },
 {
  "name": "诗梦",
  "message": "「……好吧，我只管炸」"
 },
 {
  "message": "柳木似乎是拗不过叶梦和御所院那期待的眼神，最后还是妥协了。"
 },
 {
  "message": "这样就够了。"
 },
 {
  "name": "纱由美",
  "message": "「啊嘞？今天，有六个碗……？」"
 },
 {
  "message": "纱由望着桌上摆好的饭菜，不解地歪了歪头。"
 },
 {
  "name": "诗梦",
  "message": "「……反正特意分开吃也麻烦」"
 },
 {
  "message": "柳木在座位上坐了下来。"
 },
 {
  "name": "叶梦",
  "message": "「姐姐？」"
 },
 {
  "name": "诗梦",
  "message": "「不吃吗？」"
 },
 {
  "name": "叶梦",
  "message": "「吃！当然要吃啦～♪ 我要坐姐姐旁边～！」"
 },
 {
  "name": "冬桦",
  "message": "「那我就坐你旁边吧」"
 },
