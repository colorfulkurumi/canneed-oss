[
 {
  "message": "大家聚在一起吃早饭的时候。"
 },
 {
  "name": "纱由美",
  "message": "「嗯……哈呣……」"
 },
 {
  "message": "我的视线不由自主地落在纱由美的唇上。"
 },
 {
  "name": "{fn}",
  "message": "（我亲的就是那对嘴唇啊……）"
 },
 {
  "message": "一想到这，我就莫名地坐立不安起来。"
 },
 {
  "name": "纱由美",
  "message": "「嗯嗯？啊……」"
 },
 {
  "message": "我和她对上视线，又下意识地撇开头。她似乎也一样。"
 },
 {
  "name": "纱由美",
  "message": "「唔」"
 },
 {
  "message": "她把脸转向了一边。"
 },
 {
  "name": "叶梦",
  "message": "「嗯嗯～？学长，怎么回事呀？」"
 },
 {
  "name": "冬桦",
  "message": "「纱由，没事吧？」"
 },
 {
  "name": "{fn}",
  "message": "「不，没事」"
 },
 {
  "name": "纱由美",
  "message": "「嗯，没事呀」"
 },
 {
  "name": "叶梦",
  "message": "「异口同声的……真可疑……♪」"
 },
 {
  "message": "直觉敏锐的叶梦好像立刻就看穿了我们之间有什么猫腻。"
 },
 {
  "name": "{fn}",
  "message": "「那、那个，大家今天有什么安排吗？我也好准备午饭和晚饭……」"
 },
 {
  "message": "连我自己都觉得这话题转得太生硬，但也只好如此。"
 },
 {
  "name": "诗梦",
  "message": "「打工，晚饭会回来吃」"
 },
 {
  "name": "{fn}",
  "message": "「打工？」"
 },
 {
  "name": "叶梦",
  "message": "「姐姐最近在神社当巫女哦——」"
 },
 {
  "name": "{fn}",
  "message": "「是、是吗……」"
 },
 {
  "message": "怪不得她最近老往外跑，原来是去打工了。"
 },
 {
  "name": "蕾蒂",
  "message": "「我稍后要去水族馆参加活动，之后……应该要清洁了」"
 },
 {
  "message": "斑鸠学姐还是一如既往。"
 },
 {
  "name": "冬桦",
  "message": "「对了对了，虽然算不上什么安排，但我很想知道BBQ是怎么一回事」"
 },
 {
  "message": "御所院忽然想起了什么，说道。"
 },
 {
  "name": "纱由美",
  "message": "「BBQ？」"
 },
 {
  "name": "冬桦",
  "message": "「嗯，我家办过户外餐会，但都是请厨师来现场烹饪的」"
 },
 {
  "name": "冬桦",
  "message": "「据说那根本不叫BBQ」"
 },
 {
  "name": "{fn}",
  "message": "「啊啊……那确实不算BBQ」"
 },
 {
  "message": "感觉更像是富人家的派对，或者是茶会之类的。"
 },
 {
  "name": "冬桦",
  "message": "「所以，我特别想知道真正的BBQ究竟是什么样的！」"
 },
 {
  "message": "BBQ……啊。"
 },
 {
  "name": "{fn}",
  "message": "「感觉可以在中庭BBQ啊？」"
 },
 {
  "message": "我觉得纱由美应该比较清楚，就问了问她。"
 },
 {
  "message": "如果她也不知道，那就只能去问奶奶了。"
 },
 {
  "name": "纱由美",
  "message": "「欸？嗯，只要最后收拾干净，应该没问题吧」"
 },
 {
  "name": "冬桦",
  "message": "「哎呀♪ 这么说，我们可以BBQ了吗！」"
 },
 {
  "name": "{fn}",
  "message": "「BBQ好啊……很有夏天的感觉」"
 },
 {
  "name": "叶梦",
  "message": "「BBQ？那不是有好多烤肉肉？」"
 },
 {
  "name": "{fn}",
  "message": "「对对，用炭火烤。烤肉烤串都行，再来个炒面也不错」"
 },
 {
  "name": "冬桦",
  "message": "「哎呀……真叫人期待呢♪」"
 },
 {
  "message": "她们俩兴致勃勃。"
 },
 {
  "message": "至于柳木和斑鸠学姐……"
 },
 {
  "name": "诗梦",
  "message": "「嗯，定好日子的话，我不反对」"
 },
 {
  "name": "蕾蒂",
  "message": "「有什么我能帮忙的吗」"
 },
 {
  "message": "看来大家都没有意见。"
 },
 {
  "name": "{fn}",
  "message": "「那得做点准备了，折叠椅和冷藏箱都有吧」"
 },
 {
  "message": "之前钓鱼的时候用过。"
 },
 {
  "name": "{fn}",
  "message": "「搞不好连BBQ用具都有？」"
 },
 {
  "name": "纱由美",
  "message": "「嗯……我记得仓库里好像有烧烤炉和烤网，我去找找看」"
 },
 {
  "name": "{fn}",
  "message": "「那我也来帮忙」"
 },
 {
  "name": "纱由美",
  "message": "「好、好……麻烦你了」"
 },
 {
  "message": "我帮忙不过是分内之事，但她或许是意识到了要和我独处，反应慢了半拍。"
 },
 {
  "name": "叶梦",
  "message": "「……哦——嘻嘻♪」"
 },
 {
  "message": "结果，叶梦似乎又察觉到了什么。"
 },
 {
  "name": "纱由美",
  "message": "「啊，这边」"
 },
 {
  "message": "我正要走向之前放晾过东西的仓库，却被她叫住了。"
 },
 {
  "name": "{fn}",
  "message": "「不是那边吗？」"
 },
 {
  "name": "纱由美",
  "message": "「那边是放室内杂物的，这边才是储物间」"
 },
 {
  "name": "{fn}",
  "message": "「欸……」"
 },
 {
  "message": "虽然不免有些积灰，但她带我来的储物间里收拾得整整齐齐。"
 },
 {
  "name": "{fn}",
  "message": "「你记得真清楚啊」"
 },
 {
  "name": "纱由美",
  "message": "「还行吧，啊……积了好多灰，得找时间打扫一下才行」"
 },
 {
  "message": "折叠椅因为之前用过，就放在入口附近。"
 },
 {
  "name": "{fn}",
  "message": "「冷藏箱也在这」"
 },
 {
  "name": "纱由美",
  "message": "「还有，折叠桌也……啊，找到了，这个也搬出去比较好吧」"
 },
 {
  "name": "{fn}",
  "message": "「收到，我搬到外面去」"
 },
 {
  "name": "纱由美",
  "message": "「BBQ用具的话……啊，应该在这边」"
 },
 {
  "name": "{fn}",
  "message": "「好，那个也搬到外面去。交给我吧」"
 },
 {
  "name": "纱由美",
  "message": "「麻烦你了」"
 },
 {
  "name": "{fn}",
  "message": "「剩下就是烤炉、烤网和铁板了」"
 },
 {
  "name": "纱由美",
  "message": "「嗯，我找找看」"
 },
 {
  "name": "{fn}",
  "message": "「找到了吗？」"
 },
 {
  "name": "纱由美",
  "message": "「嗯，烤炉在这。烤网那些在架子上面」"
 },
 {
  "name": "{fn}",
  "message": "「啊，我来拿」"
 },
 {
  "name": "纱由美",
  "message": "「没关系，我拿得到……」"
 },
 {
  "message": "她踮起脚尖，伸手去够架子上的东西——"
 },
 {
  "name": "纱由美",
  "message": "「——啊？！」"
 },
 {
  "message": "没放稳的铁板滑落下来——"
 },
 {
  "name": "{fn}",
  "message": "「小心！」"
 },
 {
  "message": "我俯身护住纱由美，将自己的手叠在她伸出的手上。"
 },
 {
  "name": "{fn}",
  "message": "「呼，没、没事吧……？」"
 },
 {
  "name": "纱由美",
  "message": "「嗯、嗯，谢谢……啊」"
 },
 {
  "message": "我们四目相对，这才意识到。"
 },
 {
  "message": "我现在的姿势，就像是在壁咚她。"
 },
 {
  "message": "我们的脸靠得极近，不由自主地凝视着对方。"
 },
 {
  "name": "{fn}",
  "message": "「纱由美……」"
 },
 {
  "message": "我不由自主地唤出了她的名字。"
 },
 {
  "name": "纱由美",
  "message": "「啊……那个……」"
 },
 {
  "message": "她却猛地把脸撇到了一边。"
 },
 {
  "name": "纱由美",
  "message": "（这样……会不会躲得太明显了？）"
 },
 {
  "name": "纱由美",
  "message": "（这难道是要亲上来的节奏……？）"
 },
 {
  "message": "说到底，我根本不知道该在什么时候接吻。"
 },
 {
  "name": "纱由美",
  "message": "（真是的，我到底在害羞些什么啊！）"
 },
 {
  "message": "她这是……不愿意吗？还是……"
 },
 {
  "name": "{fn}",
  "message": "「好了，铁板和烤网都拿下来了」"
 },
 {
  "message": "我把拿下来的铁板和烤网靠在墙边给她看。总之，正事要紧。"
 },
 {
  "name": "纱由美",
  "message": "「谢……谢谢」"
 },
 {
  "name": "{fn}",
  "message": "「所以……那个，我不会干嘛的」"
 },
 {
  "name": "纱由美",
  "message": "「什么，干嘛，我不是那个意思——」"
 },
 {
  "message": "她慌乱地动了动身子。"
 },
 {
  "name": "纱由美",
  "message": "「——啊疼？！」"
 },
 {
  "message": "她撞上了架子，紧接着，她头顶上的东西——"
 },
 {
  "name": "{fn}",
  "message": "「小心！」"
 },
 {
  "message": "我伸出手，但还是慢了一拍。一叠文件样的东西哗啦啦散了一地。"
 },
 {
  "name": "纱由美",
  "message": "「啊……对不起。你、你没事吧？没砸到头吧？」"
 },
 {
  "name": "{fn}",
  "message": "「嗯，好像只是一些纸和文件，不要紧」"
 },
 {
  "name": "纱由美",
  "message": "「那就好……」"
 },
 {
  "message": "她注视着我。"
 },
 {
  "message": "我们的脸又一次凑得极近，就像刚才那样。"
 },
 {
  "name": "{fn}",
  "message": "「……」"
 },
 {
  "name": "纱由美",
  "message": "「……」"
 },
 {
  "message": "这一次，她没有移开视线。而且，从她刚才的话里，我明白了。"
 },
 {
  "name": "{fn}",
  "message": "「我想亲你」"
 },
 {
  "message": "我把心里话说了出来。"
 },
 {
  "name": "纱由美",
  "message": "「？！」"
 },
 {
  "name": "纱由美",
  "message": "「……亲啊」"
 },
 {
  "message": "她满脸通红，小声嘀咕道。"
 },
 {
  "name": "{fn}",
  "message": "「那我亲了」"
 },
 {
  "message": "我毫不犹豫地吻了下去。"
 },
 {
  "name": "纱由美",
  "message": "「……嗯，啾，唔……呼……啾……」"
 },
 {
  "message": "这次的吻比第一次更久，我们慢慢地放开彼此的唇。"
 },
 {
  "name": "{fn}",
  "message": "「……怎么样？」"
 },
 {
  "message": "我按捺住擂鼓般的心跳，问道。"
 },
 {
  "name": "纱由美",
  "message": "「全是灰」"
 },
 {
  "name": "{fn}",
  "message": "「嗯……但，感觉不赖吧」"
 },
 {
  "name": "纱由美",
  "message": "「……也是」"
 },
 {
  "name": "{fn}",
  "message": "「那，再来一次吧」"
 },
 {
  "name": "纱由美",
  "message": "「欸……嘛，随你」"
 },
 {
  "message": "这次她闭上了眼睛，摆出一副索吻的姿态。"
 },
 {
  "message": "她这个样子实在太可爱，我又亲了上去。"
 },
 {
  "name": "纱由美",
  "message": "「嗯……啾，啾噗，哈啊」"
 },
 {
  "message": "这一次，纱由美也主动贴了过来。"
 },
 {
  "message": "原来她也想要接吻，一阵喜悦涌上我的心头。"
 },
 {
  "name": "纱由美",
  "message": "「嗯……哈啊，哈啊……」"
 },
 {
  "name": "{fn}",
  "message": "「哈啊，呼……」"
 },
 {
  "message": "亲的时候忘了呼吸，一分开，我们俩都大口地喘起气来。"
 },
 {
  "name": "纱由美",
  "message": "「哈啊……感觉储藏室挺凉快啊，怎么这么热」"
 },
 {
  "message": "她用手指按着自己的嘴唇，移开了视线。"
 },
 {
  "name": "{fn}",
  "message": "「果然会不好意思啊」"
 },
 {
  "name": "纱由美",
  "message": "「明明是你亲上来的？」"
 },
 {
  "name": "{fn}",
  "message": "「那肯定啊，我又没经验」"
 },
 {
  "name": "纱由美",
  "message": "「亲我，是因为喜欢我？」"
 },
 {
  "name": "{fn}",
  "message": "「那还用说」"
 },
 {
  "name": "纱由美",
  "message": "「那就别害羞啦……要不再多来几次？」"
 },
 {
  "name": "{fn}",
  "message": "「求之不得」"
 },
 {
  "name": "纱由美",
  "message": "「看你高兴的……唔……啾……啾——」"
 },
 {
  "message": "她话音未落，我又亲了上去。"
 },
 {
  "name": "纱由美",
  "message": "「哈啊……呼……好热……♪」"
 },
 {
  "message": "再次四目相对时，她的额上渗出汗珠，眼睛也水汪汪的。即便如此，她的嘴角依旧挂着幸福的微笑。"
 },
 {
  "name": "{fn}",
  "message": "「……东西撒了一地呢，得赶紧收拾一下」"
 },
 {
  "message": "我有些不好意思地松开了她。"
 },
 {
  "name": "{fn}",
  "message": "「嗯嗯？」"
 },
 {
  "message": "借着昏暗的光线，我注意到散落的纸张里夹着一张照片。"
 },
 {
  "name": "{fn}",
  "message": "「这是……」"
 },
 {
  "name": "纱由美",
  "message": "「啊——」"
 },
 {
  "message": "照片里的那个小女孩。"
 },
 {
  "message": "正在中庭参加BBQ，虽然年纪还小，但毫无疑问……"
 },
 {
  "name": "纱由美",
  "message": "「……嗯，看来是时候告诉你了」"
 },
 {
  "message": "我下意识看向她，她只是耸了耸肩。"
 },
 {
  "name": "纱由美",
  "message": "「你知道这里虽然是宿舍，但前身是一家旅馆吧」"
 },
 {
  "name": "纱由美",
  "message": "「那家旅馆，是我爸妈开的」"
 }
]