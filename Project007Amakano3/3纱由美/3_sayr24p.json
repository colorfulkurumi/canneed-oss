  "message": "「嗯……」"
 },
 {
  "name": "纱由美",
  "message": "「哈啊……」"
 },
 {
  "name": "{fn}",
  "message": "「啊啊……」"
 },
 {
  "message": "我们俩的体力都彻底耗尽了。"
 },
 {
  "message": "我用尽最后一点力气，把纱由美搂进怀里。"
 },
 {
  "name": "{fn}",
  "message": "「纱由美也……只属于我……」"
 },
 {
  "message": "说完这句话，我的意识就沉了下去。"
