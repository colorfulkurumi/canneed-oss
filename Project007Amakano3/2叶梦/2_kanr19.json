[
 {
  "name": "叶梦",
  "message": "「嗯……嗯！好嘞，姐姐！」"
 },
 {
  "message": "我关掉手机，跟姐姐搭话。"
 },
 {
  "name": "诗梦",
  "message": "「你从刚才起就在那哼哼唧唧的……干嘛呢？」"
 },
 {
  "name": "叶梦",
  "message": "「教我做菜嘛！」"
 },
 {
  "name": "诗梦",
  "message": "「你刚才在查菜谱？有什么想做的东西吗？」"
 },
 {
  "name": "叶梦",
  "message": "「是在查，可感觉看不太懂，怕自己会搞砸。感觉让姐姐来教我更学得会吧」"
 },
 {
  "name": "叶梦",
  "message": "「人家想做给喜欢的人吃嘛……」"
 },
 {
  "name": "诗梦",
  "message": "「做给他啊」"
 },
 {
  "name": "叶梦",
  "message": "「当然也想做给姐姐你吃啊」"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "name": "叶梦",
  "message": "「我也知道拜托姐姐这个有点不太对……但是求求啦！」"
 },
 {
  "name": "诗梦",
  "message": "「……喜欢的人，吗」"
 },
 {
  "name": "叶梦",
  "message": "「嗯、嗯」"
 },
 {
  "name": "诗梦",
  "message": "「反正都是给我吃，帮个忙也不是不可以」"
 },
 {
  "name": "叶梦",
  "message": "「欸，也就是说……」"
 },
 {
  "name": "诗梦",
  "message": "「就是我知道了」"
 },
 {
  "name": "叶梦",
  "message": "「尊嘟？那，我们快点开始吧——♪ 反正学长要到傍晚才回来」"
 },
 {
  "name": "诗梦",
  "message": "「……到头来，还是他优先」"
 },
 {
  "name": "诗梦",
  "message": "「那，就从最基础的饭团开始吧」"
 },
 {
  "name": "叶梦",
  "message": "「好耶，饭团！」"
 },
 {
  "name": "叶梦",
  "message": "「啊……不过，我也想吃肉肉」"
 },
 {
  "name": "诗梦",
  "message": "「……那，做香肠饭团怎么样？」"
 },
 {
  "name": "诗梦",
  "message": "「香肠得先煎过再调味，要开火」"
 },
 {
  "name": "叶梦",
  "message": "「哦哦，这个感觉我能行！！」"
 },
 {
  "name": "诗梦",
  "message": "「你本来不就是来学的吗」"
 },
 {
  "name": "叶梦",
  "message": "「欸嘿嘿……那调味要怎么弄？」"
 },
 {
  "name": "诗梦",
  "message": "「盐、胡椒……番茄酱也可以。啊啊，用咖喱粉调味也不错」"
 },
 {
  "name": "叶梦",
  "message": "「咖喱！原来还能这么用啊？」"
 },
 {
  "name": "诗梦",
  "message": "「你动手试试吧」"
 },
 {
  "name": "叶梦",
  "message": "「好烫」"
 },
 {
  "name": "诗梦",
  "message": "「别烫到了」"
 },
 {
  "name": "叶梦",
  "message": "「没事的♪ 好香——♪」"
 },
 {
  "message": "香肠下锅轻轻翻炒，撒上咖喱粉。转瞬间，浓郁的香气便扑鼻而来。"
 },
 {
  "name": "叶梦",
  "message": "「感觉只要是咖喱味的，不管什么东西都会变得很好吃呢」"
 },
 {
  "name": "诗梦",
  "message": "「……上次是煎蛋，这次又是这个。你怎么突然想学做饭了？」"
 },
 {
  "name": "叶梦",
  "message": "「欸？嗯——以前嘛，是想让学长开心」"
 },
 {
  "name": "诗梦",
  "message": "「以前……那现在呢？」"
 },
 {
  "name": "叶梦",
  "message": "「现在当然也是啦，不过我也想挑战一下新事物嘛——」"
 },
 {
  "name": "诗梦",
  "message": "「还挺积极的」"
 },
 {
  "name": "叶梦",
  "message": "「对呀，积极可是我的优点！」"
 },
 {
  "name": "诗梦",
  "message": "「这倒也是」"
 },
 {
  "name": "叶梦",
  "message": "「姐姐，谢谢你教我」"
 },
 {
  "name": "诗梦",
  "message": "「小事而已」"
 },
 {
  "message": "话虽如此，她其实一直很担心我。"
 },
 {
  "name": "诗梦",
  "message": "「……你和他，最近怎么样？」"
 },
 {
  "name": "叶梦",
  "message": "「欸嘿嘿……我们可甜蜜啦！」"
 },
 {
  "name": "叶梦",
  "message": "「上次去海边玩得超开心～祭典也好好玩！」"
 },
 {
  "name": "叶梦",
  "message": "「喂来喂去都成日常啦，最近还开始一起睡了～♪」"
 },
 {
  "name": "叶梦",
  "message": "「……啊，不过，是不是有点太腻歪了？」"
 },
 {
  "name": "叶梦",
  "message": "「姐姐你之前不是说，交往的时候要多注意吗……这样是不是不太好？」"
 },
 {
  "name": "诗梦",
  "message": "「你幸福，那就行」"
 },
 {
  "name": "叶梦",
  "message": "「姐姐呢？」"
 },
 {
  "name": "诗梦",
  "message": "「……看你在这儿秀恩爱，也挺有意思的」"
 },
 {
  "name": "叶梦",
  "message": "「呜呜，这算是在夸我吗——？」"
 },
 {
  "name": "诗梦",
  "message": "「谁知道」"
 },
 {
  "name": "叶梦",
  "message": "「唔——想捏成三角形好难啊，是因为戴着塑料手套吗？」"
 },
 {
  "name": "诗梦",
  "message": "「问题不在这。你这饭团捏得太大了，一只手都握不住，当然会是圆的」"
 },
 {
  "name": "叶梦",
  "message": "「因为大一点吃起来才过瘾嘛」"
 },
 {
  "name": "诗梦",
  "message": "「毕竟是给他做的啊」"
 },
 {
  "name": "叶梦",
  "message": "「啊哈哈……是啊」"
 },
 {
  "message": "果然什么都瞒不过姐姐呢。"
 },
 {
  "name": "叶梦",
  "message": "「好嘞，完成！姐姐，啊——♪」"
 },
 {
  "message": "我将刚捏好的饭团递到姐姐嘴边。"
 },
 {
  "name": "诗梦",
  "message": "「……算了，好吃就行……啊呜」"
 },
 {
  "message": "见我递过来，姐姐还是帮我尝了味道。"
 },
 {
  "name": "叶梦",
  "message": "「怎、怎么样？」"
 },
 {
  "name": "诗梦",
  "message": "「啊唔啊唔……我还在吃呢」"
 },
 {
  "name": "叶梦",
  "message": "「是、是啊」"
 },
 {
  "message": "我只好闭上嘴。"
 },
 {
  "name": "诗梦",
  "message": "「嗯唔……味道还行」"
 },
 {
  "name": "叶梦",
  "message": "「哇，好欸！我也尝尝～♪ 啊呜……嗯，好吃」"
 },
 {
  "message": "虽然味道有点重，但第一次做成这样算不错了吧？而且……"
 },
 {
  "name": "叶梦",
  "message": "「嘿嘿嘿～♪」"
 },
 {
  "name": "诗梦",
  "message": "「干嘛？」"
 },
 {
  "name": "叶梦",
  "message": "「和姐姐一起做饭一起吃，真好呀」"
 },
 {
  "name": "诗梦",
  "message": "「……也许吧」"
 },
 {
  "message": "看着姐姐这副模样，我突然想到。"
 },
 {
  "name": "叶梦",
  "message": "（我总是给姐姐添麻烦，一直要她帮忙……）"
 },
 {
  "name": "叶梦",
  "message": "（要是能再多为她做点什么就好了……）"
 }
]