[
 {
  "name": "叶梦",
  "message": "『那，我们就去看最赞的烟花吧！』"
 },
 {
  "message": "在叶梦的提议下，我们坐缆车登上山顶，准备欣赏烟花。"
 },
 {
  "message": "而烟花——"
 },
 {
  "name": "{fn}",
  "message": "「哦哦～！这还真是，不可思议啊」"
 },
 {
  "name": "叶梦",
  "message": "「对吧对吧——♪」"
 },
 {
  "message": "从山顶看去，烟花就像在眼前绽放一样。"
 },
 {
  "name": "叶梦",
  "message": "「好美啊——♪」"
 },
 {
  "name": "{fn}",
  "message": "「果然，祭典就得看烟花啊」"
 },
 {
  "name": "叶梦",
  "message": "「拍张照吧～♪」"
 },
 {
  "message": "叶梦举起手机，对准烟花按下了快门。"
 },
 {
  "name": "叶梦",
  "message": "「啊，差点意思……没拍好」"
 },
 {
  "name": "{fn}",
  "message": "「没想到抓拍这么难啊」"
 },
 {
  "name": "叶梦",
  "message": "「是啊。那些摄影师能拍得那么漂亮，真的太厉害了」"
 },
 {
  "name": "叶梦",
  "message": "「呐、呐，学长也来拍一张吧」"
 },
 {
  "name": "{fn}",
  "message": "「拍烟花？」"
 },
 {
  "name": "叶梦",
  "message": "「嗯！」"
 },
 {
  "name": "{fn}",
  "message": "「那就……」"
 },
 {
  "message": "按快门的时机……就是现在？"
 },
 {
  "name": "{fn}",
  "message": "「哦，感觉这张拍得还不错？」"
 },
 {
  "message": "我把拍下来的烟花拿给她看。"
 },
 {
  "name": "叶梦",
  "message": "「嗯……超好看」"
 },
 {
  "message": "她看着照片，点了点头。"
 },
 {
  "name": "叶梦",
  "message": "「……那，接下来也帮我拍一张吧」"
 },
 {
  "name": "{fn}",
  "message": "「欸？要把烟花拍进去吗？」"
 },
 {
  "name": "叶梦",
  "message": "「要是觉得难，只拍我也行哦」"
 },
 {
  "name": "{fn}",
  "message": "「好，我试试」"
 },
 {
  "name": "叶梦",
  "message": "「嗯，拜托啦」"
 },
 {
  "message": "要拍她啊……"
 },
 {
  "name": "叶梦",
  "message": "「别那么紧张嘛，学长只要拍下你眼里的我就好啦」"
 },
 {
  "name": "{fn}",
  "message": "「好，那……」"
 },
 {
  "message": "我要拍下我眼中，那个最好的叶梦——"
 },
 {
  "name": "{fn}",
  "message": "「……这张感觉怎么样？」"
 },
 {
  "name": "叶梦",
  "message": "「快给我看看！」"
 },
 {
  "message": "叶梦凑过脑袋，看了看我拍的照片。"
 },
 {
  "name": "叶梦",
  "message": "「……」"
 },
 {
  "message": "她凝视着照片，神情比刚才看烟花时还要专注。"
 },
 {
  "name": "叶梦",
  "message": "「……嗯……嗯！」"
 },
 {
  "message": "她不住地用力点头。"
 },
 {
  "name": "叶梦",
  "message": "「果然，绝了」"
 },
 {
  "name": "{fn}",
  "message": "「还行？」"
 },
 {
  "name": "叶梦",
  "message": "「何止是还行，是超级棒。我最喜欢学长给我拍的照片了」"
 },
 {
  "name": "叶梦",
  "message": "「好像能从里面感受到学长的心意」"
 },
 {
  "message": "她微微闭眼，一脸满足地说道。"
 },
 {
  "name": "{fn}",
  "message": "（啊……）"
 },
 {
  "message": "我的心意，或许已经被她察觉了……不过，也罢，反正也没必要再遮遮掩掩了。"
 },
 {
  "name": "{fn}",
  "message": "「因为你，真的很美」"
 },
 {
  "message": "我的声音，不自觉地微微颤抖起来。"
 },
 {
  "name": "{fn}",
  "message": "「哈哈……真是不像样子啊」"
 },
 {
  "name": "叶梦",
  "message": "「怎么会，我都听见了哦」"
 },
 {
  "message": "她莞尔一笑。"
 },
 {
  "name": "叶梦",
  "message": "「那个呀，我一直以为学长喜欢的是姐姐呢」"
 },
 {
  "name": "叶梦",
  "message": "「说实话，现在还有一点点这么觉得」"
 },
 {
  "message": "果然如此啊。"
 },
 {
  "name": "{fn}",
  "message": "「不是这样的」"
 },
 {
  "name": "{fn}",
  "message": "「对柳木……该怎么说呢，我觉得她是一个能和我产生共鸣的人」"
 },
 {
  "name": "叶梦",
  "message": "「共鸣啊……嗯，确实有那种感觉」"
 },
 {
  "message": "她带着几分羡慕，轻声说道。"
 },
 {
  "name": "{fn}",
  "message": "「或许是因为我们有些想法比较接近吧」"
 },
 {
  "name": "叶梦",
  "message": "「想法比较接近？」"
 },
 {
  "name": "{fn}",
  "message": "「比如都想要好好珍惜你」"
 },
 {
  "name": "叶梦",
  "message": "「是吗，这样啊……」"
 },
 {
  "message": "咦，感觉她好像有点失落。"
 },
 {
  "name": "叶梦",
  "message": "「那在学长眼里，我就像个妹妹？」"
 },
 {
  "name": "{fn}",
  "message": "「……当然不是」"
 },
 {
  "name": "{fn}",
  "message": "「你确实是我的学妹，我也曾把你当成妹妹，但现在……我已经不这么想了」"
 },
 {
  "name": "叶梦",
  "message": "「那……是什么？」"
 },
 {
  "name": "{fn}",
  "message": "「当然是，一个女孩子」"
 },
 {
  "name": "{fn}",
  "message": "「还有……我喜欢的人」"
 },
 {
  "name": "叶梦",
  "message": "「啊……」"
 },
 {
  "message": "一朵绚烂的烟花在夜空中轰然绽放。"
 },
 {
  "message": "刚才的话，没被烟花声盖住吧？她应该听见了吧？"
 },
 {
  "name": "{fn}",
  "message": "「叶梦，我喜欢你」"
 },
 {
  "message": "所以，我再一次开口。"
 },
 {
  "message": "也许很笨拙，也许很丢脸。但要传达真心，也只有这个办法了。"
 },
 {
  "name": "叶梦",
  "message": "「……真的，好开心啊～」"
 },
 {
  "message": "泪水从她的眼眶里涌了出来。"
 },
 {
  "message": "滑落的泪珠与摇曳的耳环，在烟火的映照下熠熠生辉。"
 },
 {
  "name": "叶梦",
  "message": "「我也是哦，才不要只把你当哥哥呢——！」"
 },
 {
  "name": "叶梦",
  "message": "「我喜欢你……学长，我喜欢你」"
 },
 {
  "message": "叶梦脸上挂着泪，却笑得无比幸福。"
 },
 {
  "name": "{fn}",
  "message": "（啊啊，真是）"
 },
 {
  "message": "我想起纱由曾说，她会这样含泪诉说自己的感情。"
 },
 {
  "message": "如此纯粹，如此直白。这是她吸引我的众多理由之一。"
 },
 {
  "name": "叶梦",
  "message": "「我喜欢你。所以不许看姐姐，只许看着我」"
 },
 {
  "message": "还提出了这样可爱又任性的要求。"
 },
 {
  "name": "{fn}",
  "message": "「那是当然……我的眼里只有你，小叶」"
 },
 {
  "name": "叶梦",
  "message": "「啊……」"
 },
 {
  "name": "叶梦",
  "message": "「小叶、小叶，吗……」"
 },
 {
  "message": "听到这个象征着关系更进一步的称呼，叶梦——小叶害羞地笑了。"
 },
 {
  "name": "{fn}",
  "message": "「所以，请和我交往吧」"
 },
 {
  "name": "叶梦",
  "message": "「嗯，当然啦！我也想做你的女朋友！！」"
 },
 {
  "message": "小叶笑了。"
 },
 {
  "message": "那张笑脸，比夜空中盛开的烟花还要璀璨。"
 }
]