[
 {
  "message": "——这是不久前的事了。"
 },
 {
  "name": "叶梦",
  "message": "「啊……掉了」"
 },
 {
  "name": "诗梦",
  "message": "「怎么了？」"
 },
 {
  "name": "叶梦",
  "message": "「我的耳环，坏了一只」"
 },
 {
  "name": "诗梦",
  "message": "「啊啊……就是你常戴的那对吧」"
 },
 {
  "name": "叶梦",
  "message": "「嘿嘿～这可是我人生中买的第一对耳环！我超喜欢的！」"
 },
 {
  "name": "叶梦",
  "message": "「可是，这可怎么办呀……买的时候店员就说已经没货了呢——」"
 },
 {
  "name": "诗梦",
  "message": "「那你还买？」"
 },
 {
  "name": "叶梦",
  "message": "「因为人家就是超喜欢嘛！简直就是，一见钟情！！」"
 },
 {
  "name": "诗梦",
  "message": "「是吗……」"
 },
 {
  "name": "叶梦",
  "message": "「那也没办法了」"
 },
 {
  "message": "要不把这只收起来，换一副新的吧。啊不过，毕竟还剩下一只……唔——"
 },
 {
  "name": "诗梦",
  "message": "「我看看」"
 },
 {
  "name": "叶梦",
  "message": "「欸？」"
 },
 {
  "name": "诗梦",
  "message": "「装饰还好好的，没必要非得当耳环戴吧？」"
 },
 {
  "name": "叶梦",
  "message": "「嗯、嗯……反正留着也只是摆设，可以哦」"
 },
 {
  "message": "姐姐拿出一些小零件，动手拼装起来。"
 },
 {
  "name": "诗梦",
  "message": "「喏」"
 },
 {
  "name": "叶梦",
  "message": "「这是……项链？」"
 },
 {
  "message": "她用耳环上的装饰，给我改造成了一条项链。"
 },
 {
  "name": "诗梦",
  "message": "「嗯，你不是那么喜欢它吗，这样不就能继续戴着了」"
 },
 {
  "name": "叶梦",
  "message": "「哇……谢谢姐姐！」"
 },
 {
  "message": "它看起来，似乎比还是耳环的时候更加耀眼了。"
 },
 {
  "name": "叶梦",
  "message": "「啊，对了！姐姐姐姐，你转过去一下嘛～」"
 },
 {
  "name": "诗梦",
  "message": "「干嘛？」"
 },
 {
  "name": "叶梦",
  "message": "「好啦好啦♪ 这样～～～完成！」"
 },
 {
  "message": "我把项链戴到了姐姐的脖子上。"
 },
 {
  "name": "诗梦",
  "message": "「……给我戴上做什么？」"
 },
 {
  "name": "叶梦",
  "message": "「嗯，送给姐姐了！」"
 },
 {
  "name": "诗梦",
  "message": "「欸……明明修好了」"
 },
 {
  "name": "叶梦",
  "message": "「对呀，就是因为姐姐费心帮我修好的嘛！」"
 },
 {
  "message": "姐姐的这份心意，真的让我太高兴了。"
 },
 {
  "name": "叶梦",
  "message": "「能和姐姐戴一样的款，我超开心的～！」"
 },
 {
  "message": "所以，比起自己戴，我觉得送给姐姐更好。"
 },
 {
  "name": "诗梦",
  "message": "「……」"
 },
 {
  "name": "诗梦",
  "message": "「开心，吗」"
 },
 {
  "message": "姐姐轻抚着项链，低声说道。"
 },
 {
  "name": "诗梦",
  "message": "「我知道了，不过戴不戴另说」"
 },
 {
  "name": "叶梦",
  "message": "「欸～要戴～你看我不也一直戴着那对耳环嘛～」"
 },
 {
  "name": "诗梦",
  "message": "「知道了知道了」"
 },
 {
  "message": "姐姐嘴上不饶人，但还是一直戴着它。"
 },
 {
  "message": "真的，姐姐一直都那么温柔。"
 },
 {
  "name": "叶梦",
  "message": "「哈啊……」"
 },
 {
  "message": "醒来时，离闹钟响起还有一小段时间。"
 },
 {
  "message": "大概是祭典上学长提到了耳环，才让我回想起了这段往事。"
 },
 {
  "name": "叶梦",
  "message": "「……」"
 },
 {
  "message": "我出神地看着自己手上的美甲。"
 },
 {
  "message": "正是它让我勇往直前。"
 },
 {
  "message": "但无论何时，在背后推我一把的，总是姐姐。"
 },
 {
  "message": "化妆不仅能点亮外表，还能让心情闪闪发亮。是姐姐教会了我，喜悦同样可以为心灵染上色彩。"
 },
 {
  "message": "我以为自己已经表达了足够多的感谢，但总觉得还缺点什么。"
 },
 {
  "name": "叶梦",
  "message": "「好嘞」"
 },
 {
  "message": "在闹钟响起前，先把它关掉吧。"
 },
 {
  "message": "今天起得早，要是不快点关掉，会吵醒姐姐的。"
 },
 {
  "message": "这可是姐姐好不容易教会我的。"
 },
 {
  "message": "得赶紧实践一下才行。"
 },
 {
  "name": "{fn}",
  "message": "「嗯嗯……？」"
 },
 {
  "message": "从今天起就是新学期了。"
 },
 {
  "message": "今天我为了做早饭特意早起，一走进客厅，就闻到了一股诱人的香味。"
 },
 {
  "name": "{fn}",
  "message": "「早上好——」"
 },
 {
  "name": "叶梦",
  "message": "「呀啊？！」"
 },
 {
  "name": "{fn}",
  "message": "「咦？」"
 },
 {
  "message": "我以为有人在做饭，可往厨房一看，却已经收拾得干干净净了。"
 },
 {
  "name": "叶梦",
  "message": "「啊哈哈～♪」"
 },
 {
  "message": "始作俑者本人明显一副惊慌失措的样子。"
 },
 {
  "name": "叶梦",
  "message": "「没什么，没事没事——♪」"
 },
 {
  "message": "她这明显是在转移话题。"
 },
 {
  "name": "{fn}",
  "message": "「小叶——唔唔？！」"
 },
 {
  "name": "叶梦",
  "message": "「啾……啾，呼啊，欸嘿嘿♪」"
 },
 {
  "message": "我刚想开口问个究竟，就被她亲住了。"
 },
 {
  "name": "叶梦",
  "message": "「放学后，中庭见哦～♪」"
 },
 {
  "message": "她只对我留下了这么一句话。"
 },
 {
  "name": "叶梦",
  "message": "「哼哼哼～♪」"
 },
 {
  "message": "上学的路上，小叶也一直紧紧地抱着我的胳膊。"
 },
 {
  "name": "冬桦",
  "message": "「两位感情真好呢」"
 },
 {
  "name": "叶梦",
  "message": "「那当然啦♪」"
 },
 {
  "name": "叶梦",
  "message": "「学长可是我的人，不宣示一下主权怎么行！」"
 },
 {
  "name": "诗梦",
  "message": "「这事儿已经人尽皆知了吧」"
 },
 {
  "name": "蕾蒂",
  "message": "「两位怎么看都是一对情侣」"
 },
 {
  "name": "叶梦",
  "message": "「对呀对呀♪ 要是不多秀秀恩爱，万一有人看上学长就麻烦了——」"
 },
 {
  "name": "诗梦",
  "message": "「根本不可能有人会看上这家伙」"
 },
 {
  "name": "叶梦",
  "message": "「怎么没有～我不就被他迷倒了嘛！」"
 },
 {
  "message": "她把我的胳膊抱得更紧了。"
 },
 {
  "message": "软软的暖暖的……被迷倒的人其实是我吧。"
 },
 {
  "name": "纱由美",
  "message": "「看你那一脸幸福的傻样～♪」"
 },
 {
  "name": "{fn}",
  "message": "「呜」"
 },
 {
  "message": "纱由看着我这副模样，一脸坏笑地调侃道。"
 },
 {
  "name": "地藏",
  "message": "「真腻歪啊～」"
 },
 {
  "message": "一进教室，阿藏就凑过来打趣。"
 },
 {
  "name": "{fn}",
  "message": "「你看见了？」"
 },
 {
  "name": "地藏",
  "message": "「你们又没藏着」"
 },
 {
  "name": "{fn}",
  "message": "「这我不否认。不过，确实感觉有点太张扬了」"
 },
 {
  "name": "冬桦",
  "message": "「不会，我觉得感情好是好事」"
 },
 {
  "name": "纱由美",
  "message": "「嗯，总比关系冷冰冰的好多啦♪」"
 },
 {
  "message": "周围的人似乎也都在善意地关注我们。"
 },
 {
  "name": "诗梦",
  "message": "「算了，别三分钟热度就好」"
 },
 {
  "message": "柳木在一旁小声嘀咕了一句。"
 },
 {
  "name": "纱由美",
  "message": "「真是的，诗诗你也太爱操心了啦」"
 },
 {
  "name": "诗梦",
  "message": "「我只是在陈述客观事实」"
 },
 {
  "message": "虽然语气严厉，但正如纱由所说，这应该也是出于担心吧。"
 },
 {
  "name": "{fn}",
  "message": "「谢谢，我心里有数」"
 },
 {
  "message": "所以，这份忠告我心领了。"
 },
 {
  "message": "开学典礼顺利结束后，我按约定前往中庭。"
 },
 {
  "name": "叶梦",
  "message": "「……好好好紧张」"
 },
 {
  "message": "先到一步的小叶，正如她嘴里念叨的那样，一副坐立不安的样子。"
 },
 {
  "name": "{fn}",
  "message": "「辛苦了」"
 },
 {
  "name": "叶梦",
  "message": "「啊，呀吼——♪」"
 },
 {
  "name": "{fn}",
  "message": "「辛苦了，按约好的，我来了」"
 },
 {
  "name": "叶梦",
  "message": "「嗯♪ 欸嘿嘿……其实呀——♪」"
 },
 {
  "name": "叶梦",
  "message": "「锵锵——！！」"
 },
 {
  "message": "她举起一个用锡纸包着的东西。"
 },
 {
  "name": "叶梦",
  "message": "「我做了便当哦，来尝尝吧——♪」"
 },
 {
  "message": "原来如此，她早上那么手忙脚乱就是为了这个啊。"
 },
 {
  "name": "{fn}",
  "message": "「便当？」"
 },
 {
  "name": "叶梦",
  "message": "「嗯！虽说是便当，其实是饭团啦」"
 },
 {
  "name": "{fn}",
  "message": "「哪里，这是特地为我做的吧？」"
 },
 {
  "name": "叶梦",
  "message": "「不过嘛，对天天做饭的学长来说，我这个可能有点拿不出手……」"
 },
 {
  "name": "{fn}",
  "message": "「能吃到小叶亲手做的饭，我已经等不及了」"
 },
 {
  "name": "叶梦",
  "message": "「你这么期待，人家会有压力的啦～♪」"
 },
 {
  "message": "她有些害羞地笑了起来。"
 },
 {
  "name": "{fn}",
  "message": "「那，我就不客气了？」"
 },
 {
  "name": "叶梦",
  "message": "「你想吃哪个？」"
 },
 {
  "name": "{fn}",
  "message": "「味道不一样吗？」"
 },
 {
  "name": "叶梦",
  "message": "「嗯！」"
 },
 {
  "name": "{fn}",
  "message": "「那……就这个好了……」"
 },
 {
  "message": "我干脆当盲盒，随手拿了一个。"
 },
 {
  "name": "叶梦",
  "message": "「那人家就吃这个好啦」"
 },
 {
  "name": "{fn}",
  "message": "「那我开动了……哦，份量不小嘛」"
 },
 {
  "name": "叶梦",
  "message": "「因为里面塞满了料嘛！」"
 },
 {
  "name": "{fn}",
  "message": "「啊呜……啊，是香肠？」"
 },
 {
  "name": "叶梦",
  "message": "「没错，是香肠饭团！」"
 },
 {
  "name": "{fn}",
  "message": "「欸……咖喱味的……嗯，还有芝士？」"
 },
 {
  "name": "叶梦",
  "message": "「被你尝出来啦？我还试着加了芝士进去哦♪ 怎么样？」"
 },
 {
  "name": "{fn}",
  "message": "「好吃」"
 },
 {
  "name": "叶梦",
  "message": "「尊嘟？」"
 },
 {
  "name": "{fn}",
  "message": "「香肠和芝士很配，而且特别有味，大热天吃这个感觉真不错」"
 },
 {
  "message": "既能补充盐分，咸淡又恰到好处。"
 },
 {
  "name": "叶梦",
  "message": "「好耶♪ 学长也尝尝这个～♪ 啊～」"
 },
 {
  "message": "小叶把她的饭团递到了我的嘴边。"
 },
 {
  "name": "{fn}",
  "message": "「啊——啊唔……哦，你这个是番茄酱味的？」"
 },
 {
  "name": "叶梦",
  "message": "「对吧！米饭和番茄酱其实超配的！」"
 },
 {
  "name": "{fn}",
  "message": "「感觉就像蛋包饭一样啊」"
 },
 {
  "name": "叶梦",
  "message": "「啊，对哦～没想到还是绝配呢♪」"
 },
 {
  "name": "{fn}",
  "message": "「那，你也尝尝我这个……啊——」"
 },
 {
  "name": "叶梦",
  "message": "「好～啊呜♪」"
 },
 {
  "message": "小叶也啊呜一口尝了尝我递过去的饭团。"
 },
 {
  "name": "叶梦",
  "message": "「嗯，像这样喂来喂去，感觉比平时更好吃了呢～♪」"
 },
 {
  "name": "{fn}",
  "message": "「是啊」"
 },
 {
  "name": "叶梦",
  "message": "「做这些情侣间的事，真开心」"
 },
 {
  "name": "{fn}",
  "message": "「我也是……啾」"
 },
 {
  "name": "叶梦",
  "message": "「唔……啾、啾噗……哈啊♪ 咖喱味♪」"
 },
 {
  "name": "{fn}",
  "message": "「啊，抱歉」"
 },
 {
  "name": "叶梦",
  "message": "「反正饭团是我做的，没关系啦！啾♪」"
 },
 {
  "message": "小叶也吻了我一下。"
 },
 {
  "name": "叶梦",
  "message": "「欸嘿嘿……得赶紧去跟姐姐报告大功告成♪」"
 },
 {
  "name": "{fn}",
  "message": "「是柳木教你的？」"
 },
 {
  "name": "叶梦",
  "message": "「对呀！姐姐特地帮我改良的，说这样我也能做～♪」"
 },
 {
  "name": "{fn}",
  "message": "「你们姐妹俩感情还是这么好啊」"
 },
 {
  "name": "叶梦",
  "message": "「啊哈哈，要是真像你说的那样就好了……」"
 },
 {
  "name": "{fn}",
  "message": "「欸，怎么了？」"
 },
 {
  "message": "看她反应有些不对，我忍不住追问。"
 },
 {
  "name": "叶梦",
  "message": "「唔，没什么啦。就是……感觉一直都是姐姐在照顾我」"
 },
 {
  "name": "叶梦",
  "message": "「就想着，是不是该做点什么来谢谢她……」"
 },
 {
  "name": "{fn}",
  "message": "「谢她啊……」"
 },
 {
  "message": "虽然口头表达感谢也够了，但她平时肯定没少说谢吧。"
 },
 {
  "name": "{fn}",
  "message": "（有没有什么办法，能像坦诚相待那次一样，让她把这份感谢更郑重地传达给她姐姐呢……）"
 },
 {
  "message": "我试着想了想，一时也没想出什么好主意。"
 }
]