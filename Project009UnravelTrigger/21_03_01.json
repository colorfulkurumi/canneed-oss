[
 {
  "message": "说来也巧，第二天索菲娅就叫我过去。"
 },
 {
  "name": " 阿利莎",
  "message": "「打扰了」"
 },
 {
  "message": "斯卢茨卡娅把我带进办公室后，那抹神秘的微笑一如既往地——"
 },
 {
  "name": " 索菲娅",
  "message": "「嗯——」"
 },
 {
  "message": "撤回前言，迎接我的是皱眉苦脸的她。"
 },
 {
  "message": "她甚至没注意到我进来了，还在房间中来回踱步。"
 },
 {
  "name": " 海",
  "message": "「怎么了？」"
 },
 {
  "name": " 索菲娅",
  "message": "「……啊，是你啊」"
 },
 {
  "name": " 索菲娅",
  "message": "「抱歉，我刚才在想事情」"
 },
 {
  "name": " 海",
  "message": "「你也会心不在焉啊，真是太阳从西边出来了」"
 },
 {
  "name": " 索菲娅",
  "message": "「我也有很多事情要操心哦」"
 },
 {
  "name": " 索菲娅",
  "message": "「非常抱歉，请稍等一会儿」"
 },
 {
  "message": "她停下脚步，一脸严肃地沉思着。"
 },
 {
  "name": " 索菲娅",
  "message": "「嗯——是不是应该再等等呢……」"
 },
 {
  "name": " 索菲娅",
  "message": "「不，但是……」"
 },
 {
  "message": "难得看见她拿不准主意。"
 },
 {
  "message": "……这样好像要没完没了了。"
 },
 {
  "message": "我朝她身后靠近。"
 },
 {
  "message": "然后，轻轻地推了一下她的背。\\@"
 },
 {
  "name": " 索菲娅",
  "message": "「怎、怎么了……？」"
 },
 {
  "name": " 海",
  "message": "「如果拿不准的话，不如先往前试试」"
 },
 {
  "name": " 海",
  "message": "「要是这件事根本不需要做，你连纠结都不会纠结吧。这可不像你啊」"
 },
 {
  "name": " 索菲娅",
  "message": "「不像我……确实，是啊」\\@"
 },
 {
  "name": " 索菲娅",
  "message": "「呵呵，没想到我会被你点醒呢」"
 },
 {
  "message": "索菲娅微笑着，再次转身面向我。"
 },
 {
  "name": " 索菲娅",
  "message": "「那么，我来说明一下委托内容吧」"
 },
 {
  "name": " 索菲娅",
  "message": "「这次委托特别重要。只有你能完成，请务必认真对待」"
 },
 {
  "name": " 海",
  "message": "「只要报酬跟得上我就没意见」"
 },
 {
  "name": " 索菲娅",
  "message": "「我会准备三千万Ｓ」"
 },
 {
  "name": " 海",
  "message": "「……挺大方啊」"
 },
 {
  "message": "考虑到她开出的价格，这毫无疑问是个难度相当高的任务。"
 },
 {
  "message": "看来刚从爆炸袭击中死里逃生，又要到地狱走一遭了啊。"
 },
 {
  "name": " 索菲娅",
  "message": "「那么，关于委托内容——」"
 },
 {
  "name": " 索菲娅",
  "message": "「你能和我结婚吗？」"
 },
 {
  "name": " 海",
  "message": "「……哈？」"
 }
]