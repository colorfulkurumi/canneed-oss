[
    {
        "name": "結梨",
        "message": "「呐，欧尼酱，想要上次的后续」"
    },
    {
        "name": "颯人",
        "message": "「嗯？什么啊？」"
    },
    {
        "name": "結梨",
        "message": "「约会的后续！真是的，给我记住呀！」"
    },
    {
        "message": "刚才不还在聊游戏吗，好歹给点铺垫吧……"
    },
    {
        "name": "結梨",
        "message": "「之前不是说过嘛，打工之前想去个地方」"
    },
    {
        "name": "颯人",
        "message": "「哦，好像是提过这么一嘴」"
    },
    {
        "name": "結梨",
        "message": "「现在又想去了，好嘛？」"
    },
    {
        "name": "颯人",
        "message": "「行啊，想去哪里？」"
    },
    {
        "name": "結梨",
        "message": "「泳池！」"
    },
    {
        "name": "颯人",
        "message": "「哈？！泳池？！」"
    },
    {
        "name": "結梨",
        "message": "「你不想看女朋友穿泳装的样子？」"
    },
    {
        "message": "这提议……确实有点诱惑力。"
    },
    {
        "message": "虽说从没想过，但说不定能发掘点Cosplay的乐趣来呢。"
    },
    {
        "name": "結梨",
        "message": "「欧尼酱，表情好色哦」"
    },
    {
        "name": "颯人",
        "message": "「又在损我吧」"
    },
    {
        "name": "結梨",
        "message": "「才不是呢，欧尼酱对我有色色的想法，人家很开心哦？」"
    },
    {
        "name": "颯人",
        "message": "「所以这是在夸我咯？」"
    },
    {
        "name": "結梨",
        "message": "「只要不对别的女生，懂～？」"
    },
    {
        "message": "……吓人。"
    },
    {
        "name": "颯人",
        "message": "「不过啊，这季节去泳池是不是早了点？你不会打算去健身房什么的吧？」"
    },
    {
        "message": "真那样，就得穿竞技泳衣了，倒也不赖就是了。"
    },
    {
        "name": "結梨",
        "message": "「人家早就调查好啦，有个超棒的地方呢♪」"
    },
    {
        "name": "颯人",
        "message": "「又要保密到当天吗？」"
    },
    {
        "name": "結梨",
        "message": "「正是正是。期待期待，欧尼酱！」"
    },
    {
        "name": "颯人",
        "message": "「这TM不是情趣酒店吗！」"
    },
    {
        "message": "在结梨的带领下，我们坐了一段电车，下车走了会儿，一看，这不是小情侣休息住的那种地方吗。"
    },
    {
        "name": "結梨",
        "message": "「哇——超棒！比我想的还要豪华好几倍呢？！」"
    },
    {
        "name": "颯人",
        "message": "「……你兴致倒挺高啊」"
    },
    {
        "name": "結梨",
        "message": "「人家早就想来见识一下嘛，感觉就像实现了一个梦想呢！」"
    },
    {
        "name": "颯人",
        "message": "「把情趣酒店当梦想算什么事啊」"
    },
    {
        "name": "結梨",
        "message": "「诶～这不是挺正常的嘛？现在女生闺蜜们开趴，这里也有相关套餐的呀？」"
    },
    {
        "name": "颯人",
        "message": "「那个我倒是听说过啊，不过真有人去啊？」"
    },
    {
        "name": "結梨",
        "message": "「好像有的呢，这里床和浴室都超大，隔音也很好，想怎么闹都行哦～」"
    },
    {
        "name": "結梨",
        "message": "「快看快看，吃的也超丰富！听说连甜点都有！」"
    },
    {
        "name": "颯人",
        "message": "「诶，厉害啊！看着确实好吃啊！」"
    },
    {
        "name": "結梨",
        "message": "「对吧！感觉肚子都饿了，等会我们点点看！」"
    },
    {
        "name": "結梨",
        "message": "「还能唱K，看电影，游戏机都能借呢。比普通酒店好玩太多了啦～」"
    },
    {
        "name": "颯人",
        "message": "「原来如此……确实有一定道理啊」"
    },
    {
        "message": "设施这么齐全，一个人来住估计也能玩得开心。不过嘛，得有那种无视周围气氛的钢铁心态才行。"
    },
    {
        "name": "颯人",
        "message": "「地方倒是不错，但泳池呢？」"
    },
    {
        "name": "結梨",
        "message": "「这房间就附带呢，包场哦！」"
    },
    {
        "name": "颯人",
        "message": "「诶，真的？」"
    },
    {
        "name": "結梨",
        "message": "「不是只有我们两个人，我哪不好意思说去泳池呢。穿泳装，挺害羞的～」"
    },
    {
        "message": "要是没有外人的目光，我可就来劲了，这样我和结梨都能尽情享受了。"
    },
    {
        "name": "結梨",
        "message": "「欧尼酱～你也觉得这样好吧？可以独占泳装版结梨了哦？」"
    },
    {
        "name": "颯人",
        "message": "「本来也不能让给别人看啊」"
    },
    {
        "name": "結梨",
        "message": "「……欧尼酱，你都不害羞吗？」"
    },
    {
        "name": "颯人",
        "message": "「还好吧？」"
    },
    {
        "message": "要说完全不害羞那是骗人的，先硬撑一下再说。"
    },
    {
        "name": "結梨",
        "message": "「你也就现在嘴硬了嗷，待会就让你忍不住～」"
    },
    {
        "name": "颯人",
        "message": "「好啊，那我就拭目以待了」"
    },
    {
        "name": "結梨",
        "message": "「那结梨先去换衣服啦！三十分钟后泳池见～」"
    },
    {
        "message": "结梨提着小包进了浴室，没在这里换，有点可惜……"
    },
    {
        "name": "結梨",
        "message": "「……」"
    },
    {
        "name": "颯人",
        "message": "「咦，你不走吗？」"
    },
    {
        "name": "結梨",
        "message": "「算了！没什么啦——」"
    },
    {
        "name": "結梨",
        "message": "「欧尼酱～」"
    },
    {
        "name": "颯人",
        "message": "「？怎么了？」"
    },
    {
        "name": "結梨",
        "message": "「不许偷看哦～？」"
    },
    {
        "name": "颯人",
        "message": "「……刚才，到底几个意思啊？」"
    },
    {
        "message": "是真不让看，还是故意引诱我呢？最近我真是越来越搞不懂她了……"
    },
    {
        "name": "結梨",
        "message": "「好舒服～欧尼酱！」"
    },
    {
        "message": "她坐在泳圈上浮着，笑得十分灿烂，看来是相当心满意足。"
    },
    {
        "name": "颯人",
        "message": "「地方是小了点，不过穿着泳装玩玩水也够了」"
    },
    {
        "name": "結梨",
        "message": "「对呀对呀，又不是真想来游泳嘛～」"
    },
    {
        "message": "看她那么兴高采烈的，估计真期待了挺久的。看她这个样子，我也不禁笑了起来。"
    },
    {
        "name": "結梨",
        "message": "「那个，欧尼酱，是不是忘了什么呀？」"
    },
    {
        "name": "颯人",
        "message": "「？什么？」"
    },
    {
        "name": "結梨",
        "message": "「……你认真的吗？」"
    },
    {
        "message": "啊，这下完蛋。"
    },
    {
        "message": "本想故意装傻逗逗她，看这架势，再不哄哄可就火山爆发了。"
    },
    {
        "name": "颯人",
        "message": "「开玩笑的啦。这泳装，你穿真好看」"
    },
    {
        "name": "結梨",
        "message": "「诶嘿嘿，是吧～？我特意挑了件可爱的」"
    },
    {
        "name": "颯人",
        "message": "「该不会，是为了我吧？」"
    },
    {
        "name": "結梨",
        "message": "「嘿嘿，开不开心？」"
    },
    {
        "message": "说实话，开心得要命。"
    },
    {
        "message": "女生为了自己而精心打扮，哪个男人能不为此心花怒放？"
    },
    {
        "name": "結梨",
        "message": "「这里既不担心晒黑，也没有别人盯着看，可以尽情享受哦！」"
    },
    {
        "name": "颯人",
        "message": "「怎么，这么想在水里和我腻歪吗？」"
    },
    {
        "name": "結梨",
        "message": "「嘿！」"
    },
    {
        "name": "颯人",
        "message": "「唔噗？！」"
    },
    {
        "name": "結梨",
        "message": "「嘴笨的人，可是要受惩罚的哦～」"
    },
    {
        "name": "颯人",
        "message": "「你……这玩意从哪儿掏出来的……？」"
    },
    {
        "name": "結梨",
        "message": "「要你管，我跟游泳圈一起借来的」"
    },
    {
        "name": "颯人",
        "message": "「瞧你这兴奋劲儿」"
    },
    {
        "name": "結梨",
        "message": "「惩罚光线～！」"
    },
    {
        "name": "颯人",
        "message": "「噗？！」"
    },
    {
        "name": "結梨",
        "message": "「这泳池里，结梨占据有利地形！你可要认清自己的位置哦」"
    },
    {
        "name": "颯人",
        "message": "「只有结梨有梨是吧」"
    },
    {
        "name": "結梨",
        "message": "「惩罚光线～！」"
    },
    {
        "name": "颯人",
        "message": "「呜？！」"
    },
    {
        "name": "結梨",
        "message": "「谐音梗扣钱～」"
    },
    {
        "name": "颯人",
        "message": "「喂，结梨，我非得赤手空拳的吗」"
    },
    {
        "name": "結梨",
        "message": "「梨只有一个哦」"
    },
    {
        "name": "颯人",
        "message": "「妈的……有点过于不利了吧」"
    },
    {
        "name": "結梨",
        "message": "「要时刻掌握战局，提前做好准备才行哦。欧尼酱，你太大意了」"
    },
    {
        "name": "颯人",
        "message": "「好啊你！让我等了半个小时，就准备这个去了是吧？」"
    },
    {
        "name": "結梨",
        "message": "「诶——？结梨不知道呢～」"
    },
    {
        "name": "颯人",
        "message": "「骗鬼去吧！你明明就在偷笑！」"
    },
    {
        "name": "結梨",
        "message": "「女生准备起来可是很花时间的哦，又不是换件衣服那么简单」"
    },
    {
        "name": "颯人",
        "message": "「反正就我在，随便一点有什么关系」"
    },
    {
        "name": "結梨",
        "message": "「就是欧尼酱在，才更要好好打扮呀！要是邋里邋遢被嫌弃了怎么办？」"
    },
    {
        "name": "颯人",
        "message": "「你那点私生活我还不是了如指掌，现在才在意晚喽」"
    },
    {
        "name": "結梨",
        "message": "「接受惩罚！」"
    },
    {
        "name": "颯人",
        "message": "「唔噗？！」"
    },
    {
        "name": "結梨",
        "message": "「就是想让欧尼酱看看我可爱的一面嘛！」"
    },
    {
        "name": "颯人",
        "message": "「我就说这个啊，现在还在意这个干嘛，本来就很可爱了」"
    },
    {
        "name": "結梨",
        "message": "「……」"
    },
    {
        "name": "颯人",
        "message": "「干嘛？！」"
    },
    {
        "name": "結梨",
        "message": "「开心，所以惩罚你！」"
    },
    {
        "name": "颯人",
        "message": "「太不讲理了吧……？」"
    },
    {
        "name": "結梨",
        "message": "「我以为欧尼酱也会高兴呢」"
    },
    {
        "name": "颯人",
        "message": "「我怎么高兴啊我！」"
    },
    {
        "name": "結梨",
        "message": "「呐呐欧尼酱，不管这个了，来帮人家拖一下这个啦？」"
    },
    {
        "name": "颯人",
        "message": "「拿你没办法……开始了哦，走！」"
    },
    {
        "name": "結梨",
        "message": "「呀啊！啊哈哈，动起来啦——！」"
    },
    {
        "message": "动归动，这泳池也没大到能游泳，在池边慢慢走走就是极限了。"
    },
    {
        "name": "結梨",
        "message": "「快一点——！快快，吁——！」"
    },
    {
        "name": "颯人",
        "message": "「哇啊？！喂，你拿水枪当马鞭子啊？！」"
    },
    {
        "name": "結梨",
        "message": "「那踢你总可以了吧？」"
    },
    {
        "name": "颯人",
        "message": "「可以个头啊！」"
    },
    {
        "name": "結梨",
        "message": "「我踢，我就说这样好吧」"
    },
    {
        "name": "颯人",
        "message": "「你、你这臭丫头……！」"
    },
    {
        "name": "結梨",
        "message": "「开不开心？」"
    },
    {
        "name": "颯人",
        "message": "「开心个头啊开心！」"
    },
    {
        "name": "結梨",
        "message": "「是吗——看来还得好好调教一下你呢」"
    },
    {
        "message": "还调教呢，这丫头，我看就是玩疯了吧……？！"
    },
    {
        "name": "結梨",
        "message": "「快点快点，使劲儿拉呀——咦？」"
    },
    {
        "name": "颯人",
        "message": "「？怎么？」"
    },
    {
        "name": "結梨",
        "message": "「水水用光光了」"
    },
    {
        "name": "颯人",
        "message": "「哼哼……弹药管理可是基本操作哦？」"
    },
    {
        "name": "結梨",
        "message": "「马上就装好啦，反正水下面多的是」"
    },
    {
        "name": "結梨",
        "message": "「啊、哎？要掉下去了……！」"
    },
    {
        "name": "颯人",
        "message": "「喂，没事吧你？」"
    },
    {
        "name": "結梨",
        "message": "「没、没、没事……不对，哎呀！」"
    },
    {
        "name": "颯人",
        "message": "「呼……比想的还累人啊」"
    },
    {
        "message": "在水里扑腾实在太费体力了。一股舒适的倦怠感袭来，让人眼皮都要打架了。"
    },
    {
        "name": "颯人",
        "message": "「这床也真够大的，说不定比普通酒店还舒服啊」"
    },
    {
        "message": "就算躺成个大字也绰绰有余。家里要是有这么宽敞的床就好了。"
    },
    {
        "name": "颯人",
        "message": "「那样的生活……感觉有搞头啊」"
    },
    {
        "message": "以前总觉得分开睡天经地义。不过现在，一起睡好像也没什么大不了的了。"
    },
    {
        "message": "我和结梨，已经变成那种关系了。"
    },
    {
        "name": "颯人",
        "message": "「晚些时候，找结梨商量一下吧，感觉不错」"
    },
    {
        "message": "为了平复体内的燥热，我努力放松全身，在结梨换好衣服回来前，就先眯会儿吧。"
    },
    {
        "name": "颯人",
        "message": "「啊——眼皮好沉」"
    },
    {
        "message": "这一夜还长着呢，对不住啦结梨，我还是先打个盹吧……"
    }
]