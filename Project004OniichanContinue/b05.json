[
  {
    "name": "結梨",
    "message": "「呐欧尼酱，今天可以一起睡觉觉吗？」"
  },
  {
    "name": "颯人",
    "message": "「……不是，怎么突然」"
  },
  {
    "message": "我下定决心，与结梨成为恋人后。当晚就收到了她大胆的邀请。"
  },
  {
    "name": "結梨",
    "message": "「一个人睡好寂寞的说，其实想了下，我想一直都和欧尼酱睡嘛」"
  },
  {
    "name": "颯人",
    "message": "「合着你一直在想啊！」"
  },
  {
    "name": "結梨",
    "message": "「呐呐，好不好嘛？求你了啦欧尼酱」"
  },
  {
    "name": "颯人",
    "message": "「啊这个……也行吧」"
  },
  {
    "name": "結梨",
    "message": "「好耶♪　待会带着枕头来哦」"
  },
  {
    "name": "颯人",
    "message": "「要我去你那啊」"
  },
  {
    "name": "結梨",
    "message": "「睡前要玩游戏的呀」"
  },
  {
    "name": "颯人",
    "message": "「你不会玩着玩着天亮了吧」"
  },
  {
    "name": "結梨",
    "message": "「嗯……绝对不会的～」"
  },
  {
    "name": "颯人",
    "message": "「？怎么？」"
  },
  {
    "name": "結梨",
    "message": "「那个那个……人家还要和欧尼酱一起睡呐」"
  },
  {
    "name": "颯人",
    "message": "「……」"
  },
  {
    "name": "結梨",
    "message": "「干什么——什么表情这是」"
  },
  {
    "name": "颯人",
    "message": "「不是……你，你变了啊」"
  },
  {
    "name": "結梨",
    "message": "「才没有变呢，只是不遮遮掩掩了而已——」"
  },
  {
    "name": "颯人",
    "message": "「我还是觉得不那么直接的样子更可爱？」"
  },
  {
    "name": "結梨",
    "message": "「大胆直接的女生不可爱吗？」"
  },
  {
    "message": "我说东她就说西啊，这小脾气怎么越来越任性了？"
  },
  {
    "name": "エルクロ",
    "message": "「啾～！啾啾！」"
  },
  {
    "name": "結梨",
    "message": "「啊，小黑要吃饭饭了吧，马上给你准备哟，等一下下～」"
  },
  {
    "name": "エルクロ",
    "message": "「呜啾！」"
  },
  {
    "message": "看着她开开心心照顾小黑的样子，我的思绪忽然飞远。"
  },
  {
    "name": "颯人",
    "message": "「……」"
  },
  {
    "message": "想象着自己被结梨悉心照料的样子。心里有点痒痒的，但也有股暖流弥漫开来。"
  },
  {
    "name": "結梨",
    "message": "「久等啦小黑～过来过来？」"
  },
  {
    "name": "エルクロ",
    "message": "「啾♪」"
  },
  {
    "name": "結梨",
    "message": "「吃晚饭啦。来，啊～」"
  },
  {
    "name": "エルクロ",
    "message": "「嗯呜……啊呜啊呜……啾～♪」"
  },
  {
    "name": "結梨",
    "message": "「呵呵，吃多多哦」"
  },
  {
    "name": "颯人",
    "message": "「……」"
  },
  {
    "message": "人生第一次嫉妒一只企鹅。"
  },
  {
    "name": "颯人",
    "message": "（难道……我潜意识中也想被结梨这样宠着……？）"
  },
  {
    "message": "怎么会……以前我压根就没有这种念头啊。"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱也想要？」"
  },
  {
    "name": "颯人",
    "message": "「啊？诶，什么啊？」"
  },
  {
    "name": "結梨",
    "message": "「你看小黑的眼神挺羡慕呀～还以为你想吃鱼了呢」"
  },
  {
    "name": "颯人",
    "message": "「不啊，没有的事啊」"
  },
  {
    "name": "結梨",
    "message": "「嗯～？是吗」"
  },
  {
    "name": "颯人",
    "message": "「做、做什么啊」"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱也想要我喂饭饭吗？」"
  },
  {
    "name": "颯人",
    "message": "「完、完全就没想过这种事情啊！」"
  },
  {
    "name": "結梨",
    "message": "「其实也行啦……不过我更喜欢这样哦」"
  },
  {
    "message": "她笑嘻嘻地跑到冰箱前，拿了冰淇淋就跑了回来；紧挨着我坐下，伸手将冰淇淋递向我。"
  },
  {
    "name": "結梨",
    "message": "「来，快吃吧？」"
  },
  {
    "name": "颯人",
    "message": "「哦、嗯」"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱，咬住冰淇淋后不要动哦」"
  },
  {
    "name": "颯人",
    "message": "「？干嘛？」"
  },
  {
    "name": "結梨",
    "message": "「别管啦～不许乱动哦？」"
  },
  {
    "message": "虽然满脑袋问号，还是照她说的做吧——我咬住冰棍后僵在原地。"
  },
  {
    "name": "結梨",
    "message": "「……嗯，啾」"
  },
  {
    "name": "颯人",
    "message": "「？！」"
  },
  {
    "message": "她突然从另一端咬住了冰淇淋。"
  },
  {
    "message": "我躲避不及，唇瓣的触感传来，是她灵巧的舌尖轻轻掠过。"
  },
  {
    "name": "結梨",
    "message": "「嘿嘿，好次」"
  },
  {
    "name": "颯人",
    "message": "「吓死人了……差点给我冰淇淋吓掉」"
  },
  {
    "name": "結梨",
    "message": "「早就想次了，草莓味Kiss」"
  },
  {
    "name": "颯人",
    "message": "「这也算Kiss吗？」"
  },
  {
    "name": "結梨",
    "message": "「没关系嘛～就算。不准再问了」"
  },
  {
    "message": "她乐颠颠地贴了过来。"
  },
  {
    "message": "当结梨这样紧贴在我身边时，我的保护欲又高涨起来。"
  },
  {
    "name": "颯人",
    "message": "「你这也太随便了吧」"
  },
  {
    "name": "結梨",
    "message": "「哦，欧尼酱你又这样。老钻牛角尖的人可没人要哦？」"
  },
  {
    "name": "颯人",
    "message": "「我无所谓啊，反正有你」"
  },
  {
    "name": "結梨",
    "message": "「……诶嘿嘿嘿～」"
  },
  {
    "message": "她还是老样子，又发出了古怪的笑声。可我还是越看越觉得她可爱。"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱，吃过冰淇淋来玩游戏吧？」"
  },
  {
    "name": "颯人",
    "message": "「好啊，今天玩什么？」"
  },
  {
    "name": "結梨",
    "message": "「嗯——要玩对战类的～我赢了就要欧尼酱亲亲」"
  },
  {
    "name": "颯人",
    "message": "「啊？」"
  },
  {
    "name": "結梨",
    "message": "「要是欧尼酱赢了，结梨就亲亲你」"
  },
  {
    "name": "颯人",
    "message": "「原来如此」"
  },
  {
    "message": "谈个恋爱都能拿来打赌。这是什么新型主导权争夺战吗。"
  },
  {
    "name": "結梨",
    "message": "「当然啦欧尼酱，要是现在就想亲我的话，也不是不可以～」"
  },
  {
    "name": "颯人",
    "message": "「你要想亲我，现在也可以哦？」"
  },
  {
    "name": "結梨",
    "message": "「今天就要让你主动亲我！」"
  },
  {
    "name": "颯人",
    "message": "「哼，那只能用实力让你认输了」"
  },
  {
    "name": "結梨",
    "message": "「那你坐这里」"
  },
  {
    "name": "颯人",
    "message": "「？现在这不行吗？」"
  },
  {
    "name": "結梨",
    "message": "「从今天开始欧尼酱的专属座位移到这里啦」"
  },
  {
    "message": "她指着自己常坐的位置，这是要和我交换座位？"
  },
  {
    "name": "颯人",
    "message": "「嘛，行吧」"
  },
  {
    "name": "結梨",
    "message": "「好耶～坐」"
  },
  {
    "name": "颯人",
    "message": "「哎、喂，你等等……？」"
  },
  {
    "name": "結梨",
    "message": "「诶嘿嘿，结梨的贵宾座～♪」"
  },
  {
    "message": "她欢快地坐在我眼前——正好挤在两腿之间的空隙。"
  },
  {
    "message": "虽然结梨小小的身体刚好被我双腿裹住，但这样打游戏肯定不方便。"
  },
  {
    "name": "颯人",
    "message": "「那个……结梨小姐？真要这样比？」"
  },
  {
    "name": "結梨",
    "message": "「对呀？」"
  },
  {
    "name": "颯人",
    "message": "「这是给我上强度吧……？」"
  },
  {
    "name": "結梨",
    "message": "「反正欧尼酱比较厉害嘛～让我一点点没关系的」"
  },
  {
    "name": "颯人",
    "message": "「你就这么想被亲吗？」"
  },
  {
    "name": "結梨",
    "message": "「……嗯」"
  },
  {
    "name": "颯人",
    "message": "「……」"
  },
  {
    "name": "結梨",
    "message": "「干嘛一脸意外嘛……这不是当然的吗」"
  },
  {
    "message": "防不胜防啊，被意料之外的反击直击要害，我一下节节败退。"
  },
  {
    "name": "結梨",
    "message": "「被我亲亲，欧尼酱也很开心吧？」"
  },
  {
    "name": "颯人",
    "message": "「话虽然是这么说」"
  },
  {
    "name": "結梨",
    "message": "「那就来打败我呀～不过我可不会输给你哦」"
  },
  {
    "message": "于是，以亲吻为赌注的新战役打响了。"
  },
  {
    "name": "颯人",
    "message": "「到底在干什么啊我……」"
  },
  {
    "message": "本次对决以一胜一负告终……准确说是被迫终止。"
  },
  {
    "name": "結梨",
    "message": "「呼啊……」"
  },
  {
    "message": "亲来亲去没两下，结梨就彻底化掉了。"
  },
  {
    "name": "颯人",
    "message": "「结梨，你没事吧？」"
  },
  {
    "name": "結梨",
    "message": "「哈啊……嗯，没系的……」"
  },
  {
    "message": "看起来一点不像没事的样子。完全就魂游天外了。"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱……游戏，不玩了」"
  },
  {
    "name": "颯人",
    "message": "「这就不玩了吗？」"
  },
  {
    "name": "結梨",
    "message": "「嗯……要补偿，我还要……」"
  },
  {
    "message": "我明白结梨想说什么，正打算回应她时，突然又顿住了。"
  },
  {
    "name": "結梨",
    "message": "「？欧尼酱？」"
  },
  {
    "name": "颯人",
    "message": "「我在想啊，你到底想要什么呢」"
  },
  {
    "name": "結梨",
    "message": "「……你明明知道……」"
  },
  {
    "name": "颯人",
    "message": "「想听你亲口说出来呢」"
  },
  {
    "name": "結梨",
    "message": "「呜～～～欧尼酱坏坏」"
  },
  {
    "name": "颯人",
    "message": "「说吧，想要什么？」"
  },
  {
    "name": "結梨",
    "message": "「……想、想要亲亲」"
  },
  {
    "name": "颯人",
    "message": "「乖，说得好」"
  },
  {
    "name": "結梨",
    "message": "「嗯……唔」"
  },
  {
    "message": "几个吻下来，我也摸清了她的喜好。"
  },
  {
    "message": "她最喜欢的，是全身依偎在我怀中，像只撒娇小猫般索吻。"
  },
  {
    "message": "从上往下轻轻覆住她的身子，她也会很开心。能慢慢发掘她这些小癖好，我也暗暗心喜。"
  },
  {
    "name": "結梨",
    "message": "「嗯……呐，人家还想要，还要」"
  },
  {
    "name": "颯人",
    "message": "「嗯呜……！」"
  },
  {
    "name": "結梨",
    "message": "「啾……嗯……唔嗯……！」"
  },
  {
    "message": "还有个新发现——她有点食髓知味，亲热几回后变得越来越贪心。"
  },
  {
    "message": "今天也不知道要持续多久，就陪到她心满意足为止吧。"
  },
  {
    "name": "颯人",
    "message": "「怎么给我干这来了」"
  },
  {
    "message": "我只是来接打工的结梨下班啊。"
  },
  {
    "message": "此刻却坐在Binary Angel Cafe店里啜着咖啡。"
  },
  {
    "name": "瑠々",
    "message": "「哎呀～在外面干等多无聊呀？来都来了，就一起回一起回嘛♪」"
  },
  {
    "message": "听说是突然有人来不了，代她班的人来之前，结梨得加班一会儿。"
  },
  {
    "name": "瑠々",
    "message": "「还有啊，大哥！有件事想问你！」"
  },
  {
    "name": "颯人",
    "message": "「？什么？」"
  },
  {
    "name": "瑠々",
    "message": "「听说你终于和结梨在一起啦？」"
  },
  {
    "name": "颯人",
    "message": "「噗？！」"
  },
  {
    "name": "瑠々",
    "message": "「哇啊？！喂，没事吧？！」"
  },
  {
    "name": "颯人",
    "message": "「你、你怎么知道的」"
  },
  {
    "name": "瑠々",
    "message": "「还能怎么知道，当然是问结梨的呀」"
  },
  {
    "name": "颯人",
    "message": "「那家伙……不会逢人就说吧」"
  },
  {
    "name": "瑠々",
    "message": "「啊，那倒没有。我觉得她只告诉了我哦～」"
  },
  {
    "name": "颯人",
    "message": "「……好吧，瑠瑠你倒是没关系」"
  },
  {
    "name": "瑠々",
    "message": "「我呀，可是真心希望结梨能幸福的哦」"
  },
  {
    "name": "颯人",
    "message": "「嗯？」"
  },
  {
    "name": "瑠々",
    "message": "「我和结梨都认识这么久了对吧？」"
  },
  {
    "name": "颯人",
    "message": "「是啊，你俩都闺蜜多少年了」"
  },
  {
    "name": "瑠々",
    "message": "「可她呢，眼里一直只有哥你一个哦。作为女人，我真挺佩服她的」"
  },
  {
    "name": "颯人",
    "message": "「这、这样啊」"
  },
  {
    "name": "瑠々",
    "message": "「哥，你可不准让结梨掉眼泪，要当个称职的男朋友哦！」"
  },
  {
    "name": "颯人",
    "message": "「当然，结梨幸福我就幸福」"
  },
  {
    "name": "瑠々",
    "message": "「哦～这么自信吗，真靠谱～♪」"
  },
  {
    "name": "颯人",
    "message": "「谢谢你啊，瑠瑠。陪她度过这么多年」"
  },
  {
    "name": "瑠々",
    "message": "「嘿嘿，下次要请我吃可丽饼哦！」"
  },
  {
    "message": "瑠瑠也真是个好姑娘。有她这样的朋友，我也挺替结梨开心的。"
  },
  {
    "name": "瑠々",
    "message": "「话说，你们已经……那个了吗？」"
  },
  {
    "name": "颯人",
    "message": "「哈？」"
  },
  {
    "name": "瑠々",
    "message": "「结梨啊，你可别小看她，其实心里可闷骚了。哥你一个不小心，说不定要被她推倒呢？」"
  },
  {
    "name": "颯人",
    "message": "「哈哈哈……我注意」"
  },
  {
    "message": "话说，我早就亲身体验过了，她能忍到现在也是挺难的。"
  },
  {
    "name": "結梨",
    "message": "「喂瑠酱！你乱说什么呢？！」"
  },
  {
    "name": "瑠々",
    "message": "「啊，要糟」"
  },
  {
    "name": "結梨",
    "message": "「你没跟欧尼酱说什么怪话吧？！」"
  },
  {
    "name": "瑠々",
    "message": "「没事没事，什～么都没说啦。就说了结梨超闷骚而已」"
  },
  {
    "name": "結梨",
    "message": "「才、才没有呢！我很正常的好吗！」"
  },
  {
    "name": "瑠々",
    "message": "「是～吗？每天也就算了，一天五次还不算夸张？」"
  },
  {
    "name": "結梨",
    "message": "「啊啊啊啊啊～～～～！」"
  },
  {
    "name": "瑠々",
    "message": "「呜哇～～～！」"
  },
  {
    "message": "被拖走了。"
  },
  {
    "name": "颯人",
    "message": "「……原来如此」"
  },
  {
    "message": "我又了解到了结梨不为人知的一面。话说，瑠瑠她怎么知道的……？"
  },
  {
    "name": "颯人",
    "message": "「闺蜜啊，估计也藏不住什么秘密」"
  },
  {
    "message": "我啜着咖啡，悠哉地等待着。"
  },
  {
    "name": "瑠々",
    "message": "「结～梨～我错了嘛～」"
  },
  {
    "name": "結梨",
    "message": "「……」"
  },
  {
    "name": "瑠々",
    "message": "「人家就是好奇嘛！想知道和男生交往是种什么感觉嘛～！」"
  },
  {
    "message": "回家的路上，瑠瑠一个劲儿地向结梨道歉。感觉就和我与结梨的日常一样。"
  },
  {
    "name": "結梨",
    "message": "「唉……瑠酱，我下次好好跟你说。等你来我家再慢慢聊」"
  },
  {
    "name": "颯人",
    "message": "「到时候提前说一声啊。我好准备晚饭」"
  },
  {
    "name": "瑠々",
    "message": "「真的？！哎呀怎么办～什么时候去呢～！」"
  },
  {
    "name": "結梨",
    "message": "「随时都可以，我们狠狠玩」"
  },
  {
    "name": "瑠々",
    "message": "「哥你没意见吧？我留下来住你不会生～气～吧？」"
  },
  {
    "name": "颯人",
    "message": "「怎么会呢。再说了，你以前又不是没来过，咋不早问」"
  },
  {
    "name": "瑠々",
    "message": "「可是～那个……你懂的？」"
  },
  {
    "name": "颯人",
    "message": "「？」"
  },
  {
    "name": "瑠々",
    "message": "「总觉得……会不会打扰到你们两个……」"
  },
  {
    "name": "結梨",
    "message": "「不、不会了啦！和以前一样就好啦！」"
  },
  {
    "name": "瑠々",
    "message": "「哥你要是嫌我碍事就直说哦！我麻溜回家！」"
  },
  {
    "name": "颯人",
    "message": "「怎么可能呢……」"
  },
  {
    "name": "瑠々",
    "message": "「那好啊，我也要好好问问你呢～」"
  },
  {
    "name": "颯人",
    "message": "「啊？」"
  },
  {
    "name": "瑠々",
    "message": "「情侣之间的事情嘛，只听一方的说法就太片面啦？特别是男生的事情我可感兴趣啦～！」"
  },
  {
    "name": "颯人",
    "message": "「我有权保持沉默」"
  },
  {
    "name": "瑠々",
    "message": "「诶～为什么嘛～？！告诉我嘛～！居然保密，狡猾～！」"
  },
  {
    "name": "颯人",
    "message": "「这种事不适合跟别人说吧」"
  },
  {
    "name": "結梨",
    "message": "「我也要适当地保持沉默。对吧，欧尼酱」"
  },
  {
    "message": "三人在一起的时候，气氛还是一样的轻松。结梨也没怎么见外，只是开心地笑着。"
  },
  {
    "name": "颯人",
    "message": "（这笑容，也是她重要的一部分吧）"
  },
  {
    "message": "她能开心就好啦，不单是与我独处的时光，还有与朋友共度的青春岁月。"
  },
  {
    "message": "我暗自庆幸，自己当哥的心态还是没变。"
  },
  {
    "name": "颯人",
    "message": "「呼～我回来了」"
  },
  {
    "name": "結梨",
    "message": "「嗯」"
  },
  {
    "name": "颯人",
    "message": "「嗯？」"
  },
  {
    "name": "結梨",
    "message": "「回来啦，要亲亲～」"
  },
  {
    "message": "与方才和瑠瑠在一起时判若两人，她扑进我怀里，微微踮起脚尖，撅起小嘴。"
  },
  {
    "name": "颯人",
    "message": "「好啦，啾」"
  },
  {
    "message": "吃不消她的撒娇，我将她搂在怀中，轻轻吻上她的唇。"
  },
  {
    "name": "結梨",
    "message": "「嗯……诶嘿嘿，满足了」"
  },
  {
    "name": "颯人",
    "message": "「那就好」"
  },
  {
    "name": "結梨",
    "message": "「下次要是什么都不说直接抱紧我亲亲，就给你120分！」"
  },
  {
    "name": "颯人",
    "message": "「评分标准有点严格了吧……？」"
  },
  {
    "name": "結梨",
    "message": "「要把欧尼酱养成结梨喜欢的样子，这样才能更幸福呢！」"
  },
  {
    "name": "颯人",
    "message": "「别胡搅蛮缠了啊……那我也要把你调教成我喜欢的样子咯？」"
  },
  {
    "name": "結梨",
    "message": "「好呀？能变成欧尼酱喜欢的样子我才更开心呢」"
  },
  {
    "message": "真可爱啊，她是已经摸透男人的弱点了吗？"
  },
  {
    "name": "結梨",
    "message": "「啊，对了。欧尼酱，我有要求」"
  },
  {
    "name": "颯人",
    "message": "「要求？」"
  },
  {
    "name": "結梨",
    "message": "「嗯，待会来我房间一下好吗？」"
  },
  {
    "name": "颯人",
    "message": "「哦，行啊。不过先吃饭吧」"
  },
  {
    "name": "結梨",
    "message": "「好～我在这里等你哦」"
  },
  {
    "name": "颯人",
    "message": "「？你要不先回自己房间？」"
  },
  {
    "name": "結梨",
    "message": "「不要，就要待这里」"
  },
  {
    "name": "颯人",
    "message": "「好、好吧」"
  },
  {
    "message": "感觉今天脑子有点乱，肚子也饿了，还是抓紧简单弄点吃的吧。"
  },
  {
    "name": "結梨",
    "message": "「嗯呼呼～」"
  },
  {
    "message": "我刚系上围裙准备做饭，结梨就从身后抱了上来。"
  },
  {
    "name": "颯人",
    "message": "「你、你干嘛呢」"
  },
  {
    "name": "結梨",
    "message": "「别管我呀，你继续做饭？」"
  },
  {
    "name": "颯人",
    "message": "「不，这没法不管吧」"
  },
  {
    "name": "結梨",
    "message": "「都说了别管啦——我不打扰你的」"
  },
  {
    "message": "现在这样活动都不方便了……"
  },
  {
    "message": "但背后传来一阵幸福又柔软的触感，让人实在不忍将她甩开。"
  },
  {
    "name": "颯人",
    "message": "「拿你没法子，别突然松手啊？」"
  },
  {
    "name": "結梨",
    "message": "「嗯，知道啦」"
  },
  {
    "name": "颯人",
    "message": "「你今天咋了？平时这个点不是早去打游戏了吗」"
  },
  {
    "name": "結梨",
    "message": "「唔——？今天就突然想这样嘛」"
  },
  {
    "name": "颯人",
    "message": "「我做饭有什么好看的」"
  },
  {
    "name": "結梨",
    "message": "「很有趣呀？」"
  },
  {
    "name": "颯人",
    "message": "「是、是吗」"
  },
  {
    "name": "結梨",
    "message": "「嗯哼哼～」"
  },
  {
    "message": "看她笑得这么满足，算啦，小心别伤到她就好。"
  },
  {
    "name": "結梨",
    "message": "「今天做什么菜呀？」"
  },
  {
    "name": "颯人",
    "message": "「这个嘛……做个皮卡塔吧」"
  },
  {
    "name": "結梨",
    "message": "「皮卡塔是什么呀？」"
  },
  {
    "name": "颯人",
    "message": "「简单点说，就是裹上蛋液用平底锅煎的东西。虽然是意大利菜，但做起来简单又好吃」"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱做的什么都好吃啦」"
  },
  {
    "name": "颯人",
    "message": "「咋了，突然这么捧场」"
  },
  {
    "name": "結梨",
    "message": "「人家说的都是实话嘛——」"
  },
  {
    "name": "颯人",
    "message": "「猪肉和鸡肉，要哪种？」"
  },
  {
    "name": "結梨",
    "message": "「嗯——那就猪肉！」"
  },
  {
    "name": "颯人",
    "message": "「其实蔬菜也能做哦」"
  },
  {
    "name": "結梨",
    "message": "「才不要，要吃肉肉」"
  },
  {
    "name": "颯人",
    "message": "「好好好，再给你配个水煮时蔬」"
  },
  {
    "name": "結梨",
    "message": "「嗯哼哼，那还差不多」"
  },
  {
    "name": "颯人",
    "message": "「怎么了这是，这么开心」"
  },
  {
    "name": "結梨",
    "message": "「有吗？以前都这样的呀？」"
  },
  {
    "message": "她看我做饭还是头一回呢，以前可不这样好吧。"
  },
  {
    "name": "颯人",
    "message": "（不过……这变化也忒大了点）"
  },
  {
    "message": "以前她都是游戏高于吃饭，为此我们可没少吵过。"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱，你笑什么呀？」"
  },
  {
    "name": "颯人",
    "message": "「我在想，你要不要也来帮帮忙」"
  },
  {
    "name": "結梨",
    "message": "「结梨只负责吃，还有夸夸欧尼酱」"
  },
  {
    "name": "颯人",
    "message": "「行吧～」"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱被夸夸也会开心吧？」"
  },
  {
    "name": "颯人",
    "message": "「那当然开心啦」"
  },
  {
    "name": "結梨",
    "message": "「现在呢？」"
  },
  {
    "name": "颯人",
    "message": "「诶？」"
  },
  {
    "name": "結梨",
    "message": "「结梨贴贴，开心吗？」"
  },
  {
    "name": "颯人",
    "message": "「嘛，倒也不碍事」"
  },
  {
    "name": "結梨",
    "message": "「不——对——我是问你开不开心呀——」"
  },
  {
    "message": "要再迟疑或转移话题，她肯定得闹脾气。但老实说真有点难为情……"
  },
  {
    "name": "颯人",
    "message": "「……开心」"
  },
  {
    "name": "結梨",
    "message": "「噗嘻嘻，开心吧，酱紫呀」"
  },
  {
    "message": "她声音都夹了起来，果然有点飘了。"
  },
  {
    "name": "結梨",
    "message": "「原来欧尼酱被结梨抱得很开心呀。来嘛来嘛，贴贴——」"
  },
  {
    "name": "颯人",
    "message": "「喂，别乱动啊你」"
  },
  {
    "name": "結梨",
    "message": "「嗯哼哼……诶嘿嘿嘿」"
  },
  {
    "name": "颯人",
    "message": "「所以，到底怎么了？」"
  },
  {
    "message": "晚饭后，我如约来到结梨房间。"
  },
  {
    "name": "結梨",
    "message": "「电脑看样子好像不太舒服呢。帮我修修嘛——」"
  },
  {
    "name": "颯人",
    "message": "「不舒服？怎么个不舒服法？」"
  },
  {
    "name": "結梨",
    "message": "「嗯——就是，它反应好慢哦」"
  },
  {
    "message": "结梨说得太含糊我一头雾水，还是自己检查下比较快。"
  },
  {
    "name": "颯人",
    "message": "「你没点过什么奇怪的链接吧？」"
  },
  {
    "name": "結梨",
    "message": "「嗯，没吧，扫描也没报病毒呀」"
  },
  {
    "name": "颯人",
    "message": "「那多半是太久没清C盘满了，我帮你整一下吧」"
  },
  {
    "message": "我开始清理不用的程序和数据，顺便也检查一下硬件。"
  },
  {
    "name": "颯人",
    "message": "「嗯……是时候换新的了，这电脑也用挺久了」"
  },
  {
    "name": "結梨",
    "message": "「不要」"
  },
  {
    "name": "颯人",
    "message": "「诶？」"
  },
  {
    "name": "結梨",
    "message": "「我就要它，它可是我的宝贝呢」"
  },
  {
    "name": "颯人",
    "message": "「对它感情这么深啊」"
  },
  {
    "name": "結梨",
    "message": "「因为是欧尼酱亲手给我装的呀？这可是结梨最重要的宝贝呢」"
  },
  {
    "name": "颯人",
    "message": "「我可以再给你组一台新的啊」"
  },
  {
    "name": "結梨",
    "message": "「这是欧尼酱送给我的第一份礼物，人家想好好珍惜嘛！」"
  },
  {
    "name": "颯人",
    "message": "「……这样啊」"
  },
  {
    "message": "我都不知道，结梨用这台电脑时居然是这样想的。虽然很开心，不过还是先专心修电脑吧。"
  },
  {
    "name": "颯人",
    "message": "「不过，机器总有使用寿命的。我觉得它在不久的将来很有可能坏掉」"
  },
  {
    "name": "結梨",
    "message": "「……那怎么办呀？」"
  },
  {
    "name": "颯人",
    "message": "「外观不变就行了吧？」"
  },
  {
    "name": "結梨",
    "message": "「嗯」"
  },
  {
    "name": "颯人",
    "message": "「那换掉内部配件就OK了，我们升级下配件试试？」"
  },
  {
    "name": "結梨",
    "message": "「真的吗？结梨不懂，就交给欧尼酱啦」"
  },
  {
    "name": "颯人",
    "message": "「很简单的哦？我教你？」"
  },
  {
    "name": "結梨",
    "message": "「算啦，全交给欧尼酱啦～」"
  },
  {
    "name": "颯人",
    "message": "「你也该学着自己动手了，小懒虫」"
  },
  {
    "name": "結梨",
    "message": "「诶嘿嘿，才不要」"
  },
  {
    "message": "事事都依赖别人真的好吗？为结梨的未来着想，我应该让她学会独立才是。"
  },
  {
    "message": "——换作从前的我，肯定会这么想吧。"
  },
  {
    "name": "颯人",
    "message": "「拿你没法子」"
  },
  {
    "name": "結梨",
    "message": "「谢谢欧尼酱，爱你♪」"
  },
  {
    "message": "身为兄长兼男友，被她依赖的感觉真不坏，甚至让我生出几分想表现的心思。"
  },
  {
    "name": "颯人",
    "message": "「总之这样暂时可以了。我瞅瞅，配置是啥来着？」"
  },
  {
    "name": "結梨",
    "message": "「看一眼就知道了诶」"
  },
  {
    "name": "颯人",
    "message": "「也就大概吧。这电脑也装很久了，记不太清了」"
  },
  {
    "message": "打开系统，检查硬件配置。搜了下CPU和内存的型号，扫了眼参数。"
  },
  {
    "name": "颯人",
    "message": "「啊……就是几年前的配置。玩最新的游戏可能会比较吃力了」"
  },
  {
    "name": "結梨",
    "message": "「一定要换吗？」"
  },
  {
    "name": "颯人",
    "message": "「暂时不换也行，但确实可以考虑下换了。只要主板和机箱的规格能对上就行」"
  },
  {
    "name": "結梨",
    "message": "「那我再用一段时间吧。再出问题我马上告诉你」"
  },
  {
    "name": "颯人",
    "message": "「我也会多留意的」"
  },
  {
    "name": "結梨",
    "message": "「嗯！那……玩游戏吗？」"
  },
  {
    "name": "颯人",
    "message": "「啊……抱歉，我还有工作要干」"
  },
  {
    "name": "結梨",
    "message": "「……是说今天不能陪我玩了？」"
  },
  {
    "name": "颯人",
    "message": "「嗯，抱歉」"
  },
  {
    "name": "結梨",
    "message": "「……啦」"
  },
  {
    "name": "颯人",
    "message": "「诶？」"
  },
  {
    "name": "結梨",
    "message": "「不要啦，人家好无聊」"
  },
  {
    "message": "难道，这就是传说中的——我和工作你要哪个的经典桥段？"
  },
  {
    "name": "結梨",
    "message": "「结梨要和欧尼酱玩，要和欧尼酱在一起」"
  },
  {
    "name": "颯人",
    "message": "「呜……」"
  },
  {
    "message": "一记重击，没想到她失落的表情杀伤力如此之大。"
  },
  {
    "name": "颯人",
    "message": "「那个……但，工作不能不做啊」"
  },
  {
    "name": "結梨",
    "message": "「……我知道」"
  },
  {
    "message": "这种场景在漫画和电视剧里都看厌了，每次我都嗤之以鼻。"
  },
  {
    "message": "然而，这下我再也没法嘲笑别人了。"
  },
  {
    "name": "結梨",
    "message": "「没关系，对不起啦。我可以忍住的」"
  },
  {
    "name": "颯人",
    "message": "「唔……」"
  },
  {
    "name": "結梨",
    "message": "「骗你的啦。我早就想好办法啦」"
  },
  {
    "name": "颯人",
    "message": "「哈？」"
  },
  {
    "name": "颯人",
    "message": "「……」"
  },
  {
    "name": "結梨",
    "message": "「嗯——这里该怎么打呢……是不是道具不够啊——」"
  },
  {
    "name": "結梨",
    "message": "「还有没探索过的地方，要不要回去一趟呢……为了保险起见，再查一下吧」"
  },
  {
    "message": "她把掌机带到我房间，躺在床上沉迷起了RPG。"
  },
  {
    "message": "说实话，搞得我完全无法集中精神。"
  },
  {
    "name": "結梨",
    "message": "「啊，对哦。在这里这样……嗯，搞定。结梨果然是天才♪」"
  },
  {
    "message": "结梨估计是想让我不那么内疚吧，但我一点都没法专心工作。"
  },
  {
    "name": "結梨",
    "message": "「呐欧尼酱，工作好了不？」"
  },
  {
    "name": "颯人",
    "message": "「啊，可能还要一会儿」"
  },
  {
    "name": "結梨",
    "message": "「真辛苦呀，不过结梨可以陪你熬夜哦！」"
  },
  {
    "name": "颯人",
    "message": "「哈？你胡说什么呢？」"
  },
  {
    "name": "結梨",
    "message": "「还说，你不是要通宵干完工作吗？」"
  },
  {
    "name": "颯人",
    "message": "「不会通宵啦」"
  },
  {
    "name": "結梨",
    "message": "「诶——我还以为IT行业都是边喝能量饮料边通宵呢」"
  },
  {
    "name": "颯人",
    "message": "「我司可不会安排那种杀人日程」"
  },
  {
    "message": "如今大家都在搞合规，劳动环境也在不断改善。原则上是禁止加班和节假日工作的。"
  },
  {
    "name": "結梨",
    "message": "「是吗？你不还是时不时就通宵吗？」"
  },
  {
    "name": "颯人",
    "message": "「……随机应变嘛」"
  },
  {
    "name": "結梨",
    "message": "「哼～反正我等你干完工作啦」"
  },
  {
    "name": "颯人",
    "message": "「等我？等什么？」"
  },
  {
    "name": "結梨",
    "message": "「洗澡」"
  },
  {
    "name": "颯人",
    "message": "「你先洗啊？」"
  },
  {
    "name": "結梨",
    "message": "「不要，我要欧尼酱帮我洗头——」"
  },
  {
    "name": "颯人",
    "message": "「你……要一起洗啊？」"
  },
  {
    "name": "結梨",
    "message": "「不行吗？」"
  },
  {
    "name": "颯人",
    "message": "「呃，也不是不行，就是……」"
  },
  {
    "name": "結梨",
    "message": "「那就是行啦」"
  },
  {
    "message": "她似乎吃了秤砣，说什么也要和我一起洗。"
  },
  {
    "message": "虽然我也想顺水推舟，但现在实在脱不开身啊……"
  },
  {
    "name": "颯人",
    "message": "「会弄很晚的，你还是先去洗吧」"
  },
  {
    "name": "結梨",
    "message": "「诶——？！欧尼酱大骗子——！」"
  },
  {
    "name": "颯人",
    "message": "「洗澡下次再说！乖乖，听话！」"
  },
  {
    "name": "結梨",
    "message": "「不要！就一起！」"
  },
  {
    "name": "颯人",
    "message": "「睡的时候我会来陪你的！你睡前总要花时间折腾嘛，先去洗了准备睡！」"
  },
  {
    "name": "結梨",
    "message": "「……好啦，拉钩哦？」"
  },
  {
    "name": "颯人",
    "message": "「嗯，拉钩——」"
  },
  {
    "name": "結梨",
    "message": "「嗯……啾」"
  },
  {
    "message": "脸颊传来一阵柔软的触感。"
  },
  {
    "name": "結梨",
    "message": "「加油哦，欧尼酱」"
  },
  {
    "message": "结梨留下一个温柔的微笑，转身走向浴室。"
  },
  {
    "name": "颯人",
    "message": "「……不得了啊她」"
  },
  {
    "message": "我还是太年轻了。干劲一下被结梨的话和吻弄出来了。"
  },
  {
    "name": "颯人",
    "message": "「既然都答应了就不能食言……打起精神快点搞定吧」"
  },
  {
    "name": "颯人",
    "message": "「久等了」"
  },
  {
    "name": "結梨",
    "message": "「啊，嗯，欢迎回来」"
  },
  {
    "message": "总觉得这对话透着一丝甜蜜的羞涩。"
  },
  {
    "message": "等我洗澡这事，以前也不是没有过。但之前她都是为了打游戏。"
  },
  {
    "name": "颯人",
    "message": "「你……不穿睡衣吗？」"
  },
  {
    "name": "結梨",
    "message": "「待会儿再换，现在这样挺好」"
  },
  {
    "name": "颯人",
    "message": "「这、这样啊」"
  },
  {
    "message": "她又推又搡，把我往里直推。"
  },
  {
    "message": "目的地是……结梨每天睡的那张床。"
  },
  {
    "name": "結梨",
    "message": "「那个那个，欧尼酱，要睡哪边？」"
  },
  {
    "name": "颯人",
    "message": "「哪边都行吧」"
  },
  {
    "name": "結梨",
    "message": "「那那，结梨可以选自己喜欢的位置吗？」"
  },
  {
    "name": "颯人",
    "message": "「嗯，随你」"
  },
  {
    "name": "結梨",
    "message": "「我想想……嗯，就这边」"
  },
  {
    "message": "她把枕头摆在靠墙那头，反复调整着位置。好像有些心神不宁。"
  },
  {
    "name": "結梨",
    "message": "「那……接下来呢？要睡吗？」"
  },
  {
    "name": "颯人",
    "message": "「是啊，今天就早点睡吧」"
  },
  {
    "name": "結梨",
    "message": "「嗯。啊，要关灯，要黑黑的」"
  },
  {
    "name": "颯人",
    "message": "「好好，那我关灯了」"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱，快点快点」"
  },
  {
    "name": "颯人",
    "message": "「知道啦知道啦，你冷静点」"
  },
  {
    "name": "結梨",
    "message": "「诶嘿嘿……总觉得怪怪的」"
  },
  {
    "name": "颯人",
    "message": "「理解，确实静不下心来」"
  },
  {
    "name": "結梨",
    "message": "「哼哼，小时候不是老这样的吗」"
  },
  {
    "name": "颯人",
    "message": "「和那会儿完全不同好吧」"
  },
  {
    "name": "結梨",
    "message": "「嗯，欧尼酱变帅了」"
  },
  {
    "name": "颯人",
    "message": "「没、没这回事吧」"
  },
  {
    "name": "結梨",
    "message": "「就有就有，欧尼酱专家结梨保证有哦」"
  },
  {
    "name": "颯人",
    "message": "「什么玩意儿啊」"
  },
  {
    "name": "結梨",
    "message": "「那结梨呢？呐呐，结梨怎么了呢？」"
  },
  {
    "name": "颯人",
    "message": "「怎么……你指什么？」"
  },
  {
    "name": "結梨",
    "message": "「问你我有没有变可爱呀。呐，怎么样？」"
  },
  {
    "message": "距离这么近问这种问题，我有点不好意思了……结梨她……还真敢说。"
  },
  {
    "name": "颯人",
    "message": "「当然变可爱了。要让从前的我看到，肯定都认不出来」"
  },
  {
    "name": "結梨",
    "message": "「意思就是以前不可爱咯？」"
  },
  {
    "name": "颯人",
    "message": "「不是啦，别老抓我小尾巴」"
  },
  {
    "name": "結梨",
    "message": "「呼嘻嘻，说话可要小心点哦」"
  },
  {
    "name": "颯人",
    "message": "「根本就是陷阱啊……」"
  },
  {
    "name": "結梨",
    "message": "「才没呢，这可是常识哦？」"
  },
  {
    "name": "颯人",
    "message": "「好好好，我尽量改进」"
  },
  {
    "name": "結梨",
    "message": "「说好只许说一声哦，呵呵呵」"
  },
  {
    "message": "我的紧张总算渐渐消散。多亏结梨和我说了这么多。"
  },
  {
    "name": "結梨",
    "message": "「……」"
  },
  {
    "message": "但我很快又意识到，她就近在眼前，毫无防备。"
  },
  {
    "name": "結梨",
    "message": "「嗯……呜……」"
  },
  {
    "message": "身体……不受控制地动了起来。"
  },
  {
    "name": "結梨",
    "message": "「诶嘿嘿，晚安亲亲」"
  },
  {
    "name": "颯人",
    "message": "「这样就能睡得香了？」"
  },
  {
    "name": "結梨",
    "message": "「唔……我也不造」"
  },
  {
    "name": "颯人",
    "message": "「干嘛，还不够啊？」"
  },
  {
    "name": "結梨",
    "message": "「不是啦……嗯，虽然确实不够。总觉得就这样睡着太可惜了」"
  },
  {
    "name": "颯人",
    "message": "「结梨……」"
  },
  {
    "name": "結梨",
    "message": "「其实呀，情侣都是花时间慢慢了解彼此，这才加深感情的」"
  },
  {
    "name": "結梨",
    "message": "「但我们……早就彼此了解了嘛，和普通情侣不太一样呀」"
  },
  {
    "name": "結梨",
    "message": "「结梨从小就和欧尼酱在一起了，可以放心把自己交给你」"
  },
  {
    "name": "颯人",
    "message": "「嗯，是啊。我也这么觉得」"
  },
  {
    "name": "結梨",
    "message": "「嗯，唔……」"
  },
  {
    "message": "我可以要结梨的。不，我必须说出来，说想要她。"
  },
  {
    "message": "既然这样，我还怎么能按捺得住。"
  },
  {
    "name": "颯人",
    "message": "「结梨，我们……当真正的男女朋友吧」"
  },
  {
    "name": "結梨",
    "message": "「……嗯」"
  }
]