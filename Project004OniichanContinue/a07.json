[
    {
        "name": "瑠々",
        "message": "「打扰啦～！」"
    },
    {
        "name": "結梨",
        "message": "「我来准备茶点，随便找地方坐吧」"
    },
    {
        "name": "瑠々",
        "message": "「啊，我也来帮忙！这儿我熟着呢！」"
    },
    {
        "name": "結梨",
        "message": "「嘻嘻，谢谢。那交给你啦？」"
    },
    {
        "name": "瑠々",
        "message": "「OK！点心我弄！」"
    },
    {
        "name": "結梨",
        "message": "「茶泡什么好呢……太高级的我也不会，就红茶茶包可以吧？」"
    },
    {
        "name": "瑠々",
        "message": "「当然可以啦～！都好喝的！」"
    },
    {
        "name": "結梨",
        "message": "「啊哈哈，那我就偷个懒啦」"
    },
    {
        "name": "瑠々",
        "message": "「现在吃太饱也不好吧～随便吃点垫垫啦」"
    },
    {
        "name": "結梨",
        "message": "「是呢，饭我们晚会儿吃」"
    },
    {
        "name": "瑠々",
        "message": "「嗯！哥亲手做的饭诶，期待～期待！」"
    },
    {
        "name": "結梨",
        "message": "「他做了汉堡肉和红烩牛肉哦」"
    },
    {
        "name": "瑠々",
        "message": "「真的？！那肯定巨好吃～！」"
    },
    {
        "name": "結梨",
        "message": "「要不我也做点什么吧」"
    },
    {
        "name": "瑠々",
        "message": "「诶？那个就……不、不用了吧？」"
    },
    {
        "name": "結梨",
        "message": "「……瑠酱，你在犹豫什么」"
    },
    {
        "name": "瑠々",
        "message": "「哈？！哪、哪有嘛？」"
    },
    {
        "name": "結梨",
        "message": "「那好，瑠酱那份我做给你吃」"
    },
    {
        "name": "瑠々",
        "message": "「诶诶？！等、等等，停停！那我不就次不到哥做的汉堡肉了？！」"
    },
    {
        "name": "結梨",
        "message": "「你这人怎么酱紫」"
    },
    {
        "name": "瑠々",
        "message": "「我们换一下，你肯定也酱！」"
    },
    {
        "name": "結梨",
        "message": "「嘻嘻，好像是哦」"
    },
    {
        "name": "瑠々",
        "message": "「吃哥做的饭～跟结梨一起玩～！今晚开心事这么多赚到赚到了～！」"
    },
    {
        "name": "結梨",
        "message": "「还不会被欧尼酱念叨『快去学习』『赶紧洗澡睡觉』什么的」"
    },
    {
        "name": "瑠々",
        "message": "「机会难得，来通宵不？」"
    },
    {
        "name": "結梨",
        "message": "「好啊，反正明天周日」"
    },
    {
        "name": "瑠々",
        "message": "「嗯哼哼，就知道你会同意，零食我带了一堆来！」"
    },
    {
        "name": "結梨",
        "message": "「哇，这么多。这么吃会长肉的哦？」"
    },
    {
        "name": "瑠々",
        "message": "「长了再操心啦。吃掉消耗掉不就好了，抵消了就是零卡啦！」"
    },
    {
        "name": "結梨",
        "message": "「确实，电子竞技也是体育嘛」"
    },
    {
        "name": "瑠々",
        "message": "「对对。先补充能量，准备通宵奋战！」"
    },
    {
        "name": "結梨",
        "message": "「嗯，那我们大吃一顿吧！」"
    },
    {
        "name": "瑠々",
        "message": "「哇啊啊～！气死我鸟～！对枪输了～！」"
    },
    {
        "name": "結梨",
        "message": "「打得不错呀瑠酱。可惜了，就差那么一点点」"
    },
    {
        "name": "瑠々",
        "message": "「好气～～～！FPS难～死了啦～喂结梨，有没有什么诀窍啊？」"
    },
    {
        "name": "結梨",
        "message": "「嗯……虽然确实有一些小套路，但正确答案也不是绝对的」"
    },
    {
        "name": "瑠々",
        "message": "「？什么意思嘛？」"
    },
    {
        "name": "結梨",
        "message": "「打个比方……在近距离脸贴脸一对一的时候」"
    },
    {
        "name": "結梨",
        "message": "「双方都是残血状态一枪就倒，瑠酱你会怎么做？」"
    },
    {
        "name": "瑠々",
        "message": "「干他！这还用问！」"
    },
    {
        "name": "結梨",
        "message": "「可是，周围说不定还有别队伍在蹲呢」"
    },
    {
        "name": "瑠々",
        "message": "「……会被瞬间集火秒掉的」"
    },
    {
        "name": "結梨",
        "message": "「是在空旷地带呀，还是在掩体多的地方呀。要观察周围的环境和自身的状态，再判断下一步该如何行动」"
    },
    {
        "name": "結梨",
        "message": "「这些东西你脑子里要一直有数」"
    },
    {
        "name": "瑠々",
        "message": "「呜呜……要想这么多东西啊？太难了～～～」"
    },
    {
        "name": "結梨",
        "message": "「剩下的，就是多练瞄准和身法这些基本功了。说起基础，我还能教你一点的」"
    },
    {
        "name": "瑠々",
        "message": "「又要多练啊……我最怕的就是这个～～～有没有什么别的法子，可以轻松变强的那种？」"
    },
    {
        "name": "結梨",
        "message": "「想要变强，最快的捷径就是练基本功哦？欧尼酱也这么说过」"
    },
    {
        "name": "瑠々",
        "message": "「啊哈哈，我可太懂啦！就像他会说的话～！」"
    },
    {
        "name": "結梨",
        "message": "「嘻嘻，那我们就从练枪开始吧」"
    },
    {
        "name": "瑠々",
        "message": "「好～！」"
    },
    {
        "name": "瑠々",
        "message": "「先捡个武器……诶，就这个！突击步枪敲好用！」"
    },
    {
        "name": "結梨",
        "message": "「先瞄准前面的靶子吧。啊，别站桩，试着边走边打」"
    },
    {
        "name": "瑠々",
        "message": "「收到～！上喽～！」"
    },
    {
        "name": "結梨",
        "message": "（一开始，欧尼酱好像也这样手把手带过结梨）"
    },
    {
        "name": "瑠々",
        "message": "「唔～～～！又要走又要打得准，也太～难了吧？」"
    },
    {
        "name": "結梨",
        "message": "「要结合自己移动的方向和枪的后坐力，去预判和调整准星」"
    },
    {
        "name": "瑠々",
        "message": "「诶诶～～～？这怎么可能嘛～～～！」"
    },
    {
        "name": "結梨",
        "message": "（她说的跟刚玩FPS那会儿的我一模一样。嘻嘻，加油哦，瑠酱）"
    },
    {
        "name": "瑠々",
        "message": "「你看嘛，子弹一打就飘了！打不中嘛～！」"
    },
    {
        "name": "結梨",
        "message": "（欧尼酱当时……也是这样想的吧）"
    },
    {
        "name": "瑠々",
        "message": "「喂结梨，你听见没有啊～？」"
    },
    {
        "name": "結梨",
        "message": "「啊？哦、抱歉。说到哪儿了？」"
    },
    {
        "name": "瑠々",
        "message": "「果然在走神。啊，莫非是在想哥的事情？」"
    },
    {
        "name": "結梨",
        "message": "「才、才没有啦？」"
    },
    {
        "name": "瑠々",
        "message": "「尊嘟假嘟～？刚刚还呆呆的一脸落寞的样子哦？」"
    },
    {
        "name": "結梨",
        "message": "「都说不是了！不说这个，刚才说到哪来着？」"
    },
    {
        "name": "瑠々",
        "message": "「我让你给我示范下呀」"
    },
    {
        "name": "結梨",
        "message": "「哦哦，这样啊，好呀」"
    },
    {
        "name": "瑠々",
        "message": "「让我好好学习一下结梨老师的模范动作～」"
    },
    {
        "name": "結梨",
        "message": "「切一下账号……好了。去训练场可以吧？」"
    },
    {
        "name": "瑠々",
        "message": "「嗯，好呀。那样看得更清楚！」"
    },
    {
        "name": "結梨",
        "message": "「要仔细观察画面——就是看视线移动的方式。会了之后，自然就能靠感觉操作了」"
    },
    {
        "name": "瑠々",
        "message": "「OK～！」"
    },
    {
        "name": "結梨",
        "message": "「在这里这样做……差不多就这样！怎么样瑠酱，这下明白了吗？」"
    },
    {
        "name": "瑠々",
        "message": "「呼……呼……」"
    },
    {
        "name": "結梨",
        "message": "「……睡着了啊，怪不得这么安静」"
    },
    {
        "name": "結梨",
        "message": "「哈啊……啊……天都亮了嘛」"
    },
    {
        "name": "結梨",
        "message": "「反正明天放假，睡醒了再洗澡，干脆也去睡了」"
    },
    {
        "name": "結梨",
        "message": "「……晚安，欧尼酱」"
    },
    {
        "name": "颯人",
        "message": "「没想到这么早就结束了」"
    },
    {
        "message": "还以为要被关到傍晚呢，没想到培训班中午不到就结业了。能早些脱身也是好事啊。"
    },
    {
        "name": "颯人",
        "message": "「总之先回家把行李放一下」"
    },
    {
        "message": "走最近的路直奔家里。"
    },
    {
        "message": "有瑠瑠陪她应该没什么事，不过还是有点想结梨了。"
    },
    {
        "name": "颯人",
        "message": "「我回来……嗯？怎么」"
    },
    {
        "message": "客厅没有半点有人待过的迹象。"
    },
    {
        "name": "颯人",
        "message": "「结梨？不在吗？」"
    },
    {
        "message": "除了玩游戏、学习和睡觉，她基本都泡在客厅。况且昨天瑠瑠应该也住下了。"
    },
    {
        "message": "这么说……是在自己房间里？"
    },
    {
        "name": "颯人",
        "message": "「喂——结梨——？瑠瑠——？」"
    },
    {
        "message": "……毫无回应。"
    },
    {
        "name": "颯人",
        "message": "「这俩还睡大觉呢？」"
    },
    {
        "message": "毕竟是周日，完全有可能，去瞧一眼吧。"
    },
    {
        "name": "結梨",
        "message": "「呼……呼……」"
    },
    {
        "name": "瑠々",
        "message": "「嗯嗯～～～呜喵……呼……」"
    },
    {
        "name": "颯人",
        "message": "「俩睡得也太死了」"
    },
    {
        "message": "等她俩醒了自然会嚷嚷「肚肚饿饿～」，也没必要硬拉她们起来。"
    },
    {
        "name": "颯人",
        "message": "「行，趁现在去趟超市吧」"
    },
    {
        "name": "結梨",
        "message": "「嗯……咦，回来啦……？早，欧尼酱……」"
    },
    {
        "name": "颯人",
        "message": "「早，快傍晚了都」"
    },
    {
        "name": "結梨",
        "message": "「那是……跟瑠酱玩了个通宵嘛……」"
    },
    {
        "name": "颯人",
        "message": "「晚上要好好睡觉。不然既伤皮肤又伤身体，知道吗？」"
    },
    {
        "name": "結梨",
        "message": "「不管那个啦，肚肚饿饿～～～」"
    },
    {
        "name": "颯人",
        "message": "「是是是，就知道你会喊饿」"
    },
    {
        "message": "拿出冷冻披萨，撒了点培根、芝士和鸡蛋碎，最后再来一把甜玉米，塞进烤箱。"
    },
    {
        "name": "瑠々",
        "message": "「结～梨～～～别抛下我～～～」"
    },
    {
        "name": "颯人",
        "message": "「哦，瑠瑠也醒了啊」"
    },
    {
        "name": "瑠々",
        "message": "「嗯……哥～肚肚饿～～～」"
    },
    {
        "name": "颯人",
        "message": "「马上马上，你俩去洗把脸」"
    },
    {
        "name": "瑠々",
        "message": "「尊嘟假嘟？！这就去～！」"
    },
    {
        "name": "颯人",
        "message": "「厉害，秒醒啊你」"
    },
    {
        "name": "結梨",
        "message": "「嗯嗯～～～瑠酱，等等我～～～」"
    },
    {
        "message": "结梨赖床的臭毛病从小到大就没变过，现在这样已经算有所长进了。"
    },
    {
        "name": "颯人",
        "message": "「小黑也一起来吃？」"
    },
    {
        "name": "エルクロ",
        "message": "「呜啾！」"
    },
    {
        "name": "颯人",
        "message": "「哈哈，知道了知道了。你的那份我也好好买回来了」"
    },
    {
        "message": "果然，像这样和家人围坐在一起吃饭，心情就会格外安宁。"
    },
    {
        "message": "虽说只在外面过了一夜，但这次的经历让我重新认识到了这一点。"
    },
    {
        "name": "颯人",
        "message": "「说不定，我这人还挺怕寂寞的」"
    },
    {
        "name": "瑠々",
        "message": "「哥～！我洗完脸回来啦～！」"
    },
    {
        "name": "結梨",
        "message": "「啊，好香的味道。你在做披萨吗？」"
    },
    {
        "name": "颯人",
        "message": "「答对了。晚饭前先给你们垫垫肚子」"
    },
    {
        "name": "瑠々",
        "message": "「啊，等一下，这不就等于要开披萨派对了吗！哥，家里有碳酸饮料吧？！」"
    },
    {
        "name": "颯人",
        "message": "「那当然。披萨和碳酸饮料不是天生一对吗？」"
    },
    {
        "name": "瑠々",
        "message": "「一百分！期待值拉满～♪」"
    },
    {
        "name": "結梨",
        "message": "「才刚睡醒就吃这么高热量的东西……总感觉会胖，好担心啊」"
    },
    {
        "name": "瑠々",
        "message": "「吃多少就运动多少呗～我们还年轻，不用在意这些！」"
    },
    {
        "name": "結梨",
        "message": "「诶——可是运动好麻烦……」"
    },
    {
        "name": "颯人",
        "message": "「现在不养成运动的习惯，以后可是会后悔的哦？」"
    },
    {
        "name": "瑠々",
        "message": "「哥也是～～～到了开始在意这块肉肉的年纪了？」"
    },
    {
        "name": "颯人",
        "message": "「呜咿？！」"
    },
    {
        "message": "腰间的软肋被指尖戳了戳。这完全是出其不意的偷袭，害我发出了一声怪叫。"
    },
    {
        "name": "瑠々",
        "message": "「啊哈哈！叫声好可爱哦～！」"
    },
    {
        "name": "颯人",
        "message": "「突然被人摸到那种地方，是个人都会吓一跳吧！肯定会叫出声啊！」"
    },
    {
        "name": "瑠々",
        "message": "「不过呀，手感硬邦邦的哦？嗯哼哼，真不愧是男生！」"
    },
    {
        "name": "颯人",
        "message": "「我平时多少还是有在注意锻炼的」"
    },
    {
        "message": "比如不坐电梯改走楼梯，或者提前一站下车走路回家。虽然都只是些日常生活中力所能及的小事。"
    },
    {
        "name": "結梨",
        "message": "「……欧尼酱，你好结实啊」"
    },
    {
        "name": "颯人",
        "message": "「我可是在你看不见的地方默默努力呢。结梨你也得加把劲了」"
    },
    {
        "name": "結梨",
        "message": "「哇，又开始说教了」"
    },
    {
        "name": "瑠々",
        "message": "「我们女生也在男生看不见的地方努力着呢～」"
    },
    {
        "name": "颯人",
        "message": "「这我当然知道。虽然也不是全部都了解啦」"
    },
    {
        "message": "结梨就是，美甲或者妆没化好，心情就会一落千丈。我偶尔也会被她莫名其妙地迁怒。"
    },
    {
        "name": "颯人",
        "message": "「哦，烤好了。结梨，能帮我拿一下盘子吗？」"
    },
    {
        "name": "結梨",
        "message": "「啊，好。你等一下哦」"
    },
    {
        "name": "エルクロ",
        "message": "「啾、啾啾！」"
    },
    {
        "name": "瑠々",
        "message": "「小黑可不能吃披萨哦～诶，企鹅不吃披萨的吧？」"
    },
    {
        "name": "颯人",
        "message": "「据我所知，是不吃的」"
    },
    {
        "name": "瑠々",
        "message": "「系吗，明明这么好吃，真可惜」"
    },
    {
        "name": "エルクロ",
        "message": "「呜啾～～～」"
    },
    {
        "name": "颯人",
        "message": "「你的点心在这边，都给你准备好了」"
    },
    {
        "name": "エルクロ",
        "message": "「呣啾♪」"
    },
    {
        "name": "瑠々",
        "message": "「啊，呐呐哥。那个让我喂可以吗？」"
    },
    {
        "name": "颯人",
        "message": "「啊，当然可以」"
    },
    {
        "name": "瑠々",
        "message": "「棒♪谢谢！」"
    },
    {
        "message": "我把喂小黑的小鱼递给瑠瑠。她常来家里，跟小黑也熟，她喂应该没问题。"
    },
    {
        "name": "瑠々",
        "message": "「来～小黑，点心时间到咯～」"
    },
    {
        "name": "エルクロ",
        "message": "「啾！啊呜啊呜……啾♪」"
    },
    {
        "name": "結梨",
        "message": "「呵呵，瑠酱和小黑的感情也这么好呀」"
    },
    {
        "name": "瑠々",
        "message": "「那是～！小企鹅敲可爱」"
    },
    {
        "name": "颯人",
        "message": "「它可是我家的小宝贝呢」"
    },
    {
        "name": "結梨",
        "message": "「喂喂欧尼酱，结梨也是值得骄傲的小宝贝呀？」"
    },
    {
        "name": "颯人",
        "message": "「骄傲，嗯……」"
    },
    {
        "name": "結梨",
        "message": "「结梨可是好学生哦」"
    },
    {
        "name": "瑠々",
        "message": "「没错没错～！大家可离不了结梨的照顾」"
    },
    {
        "name": "颯人",
        "message": "「哦？意思是我也可以让结梨照顾咯？」"
    },
    {
        "name": "結梨",
        "message": "「那不行」"
    },
    {
        "name": "颯人",
        "message": "「诶，为什么？」"
    },
    {
        "name": "結梨",
        "message": "「欧尼酱的任务就是照顾结梨呀」"
    },
    {
        "name": "颯人",
        "message": "「……哦，行吧」"
    },
    {
        "name": "瑠々",
        "message": "「哥，被女生依赖可是件幸福的事吖～」"
    },
    {
        "name": "颯人",
        "message": "「依赖和宠坏根本两码事吧……」"
    },
    {
        "name": "結梨",
        "message": "「别说了快吃吧。结梨肚肚饿饿！」"
    },
    {
        "name": "瑠々",
        "message": "「我也我也～！好久没吃披萨了～♪」"
    },
    {
        "name": "颯人",
        "message": "「好，都坐好，双手合十」"
    },
    {
        "name": "結梨",
        "message": "「我开动啦～！」"
    },
    {
        "name": "瑠々",
        "message": "「开动啦～！」"
    },
    {
        "message": "大家围着餐桌坐下，品尝着新鲜出炉的披萨。"
    },
    {
        "name": "颯人",
        "message": "「嗯，火候刚好，真香」"
    },
    {
        "name": "瑠々",
        "message": "「嗯嗯～♪　不得鸟，这芝士也太棒了！幸福～！」"
    },
    {
        "name": "結梨",
        "message": "「唔……啊——好好吃……芝士和培根的组合好神仙」"
    },
    {
        "name": "颯人",
        "message": "「想不想换换口味，用这个」"
    },
    {
        "name": "結梨",
        "message": "「这什么呀，蜂蜜？」"
    },
    {
        "name": "瑠々",
        "message": "「诶～披萨加这个真的好吃吗～？」"
    },
    {
        "name": "颯人",
        "message": "「好吃得很。你就当被我忽悠了，尝一口」"
    },
    {
        "name": "瑠々",
        "message": "「真的假的～～～？那……就一小口」"
    },
    {
        "message": "瑠瑠满脸狐疑地滴上一点蜂蜜，小心翼翼尝了一口。"
    },
    {
        "name": "瑠々",
        "message": "「嗯……嗯嗯？！嗯，肿么，这么好次！」"
    },
    {
        "name": "颯人",
        "message": "「我说吧？」"
    },
    {
        "name": "瑠々",
        "message": "「结梨你也尝尝！敲好次！」"
    },
    {
        "name": "結梨",
        "message": "「唔、嗯。那我……嗯」"
    },
    {
        "name": "結梨",
        "message": "「嗯……哇，真的诶。甜甜咸咸的，好好吃……！」"
    },
    {
        "name": "颯人",
        "message": "「我当初看菜谱的时候也犯嘀咕呢。结果一吃就停不下来，特别上头」"
    },
    {
        "name": "結梨",
        "message": "「呜呜……怎么办，要管不住嘴了」"
    },
    {
        "name": "瑠々",
        "message": "「结梨，忍着可伤身了。压力一大，皮肤可就遭殃了哦？」"
    },
    {
        "name": "結梨",
        "message": "「可要是长胖了，压力会更大呢……」"
    },
    {
        "name": "瑠々",
        "message": "「减肥就交给未来的自己，安啦安啦～♪」"
    },
    {
        "name": "颯人",
        "message": "「还真就人生得意须尽欢啊」"
    },
    {
        "name": "瑠々",
        "message": "「？那是啥，啥意思？」"
    },
    {
        "name": "颯人",
        "message": "「简单来说，就是活在当下，开心就完事了」"
    },
    {
        "name": "瑠々",
        "message": "「可不是嘛，怎么享受当下可是头等大事好吧？」"
    },
    {
        "name": "颯人",
        "message": "「哈哈，说的是啊」"
    },
    {
        "name": "結梨",
        "message": "「话是这么说，瑠酱你也太没心没肺了，马上要考试了喂？」"
    },
    {
        "name": "瑠々",
        "message": "「……明天开始！我要和结梨一起猛K书！」"
    },
    {
        "name": "結梨",
        "message": "「好好，就知道你会这么说，早给你备好了，保证给你教会」"
    },
    {
        "name": "瑠々",
        "message": "「不愧是结梨！爱你～♪」"
    },
    {
        "message": "欣赏女孩子们叽叽喳喳，对身心健康真是大有裨益啊。"
    },
    {
        "name": "瑠々",
        "message": "「那，明天开始就靠你咯！」"
    },
    {
        "name": "結梨",
        "message": "「欧尼酱，可以吧？」"
    },
    {
        "name": "颯人",
        "message": "「当然，你俩加油，拿个好分数回来」"
    },
    {
        "name": "瑠々",
        "message": "「嗯～～～呐呐，哥」"
    },
    {
        "name": "颯人",
        "message": "「嗯？」"
    },
    {
        "name": "瑠々",
        "message": "「有没有什么奖励，有的话我才更卖力对吧～」"
    },
    {
        "name": "颯人",
        "message": "「哈？」"
    },
    {
        "name": "結梨",
        "message": "「也有奖励给结梨的，对吧？欧尼酱？」"
    },
    {
        "message": "两道充满期待的视线齐齐射向我。这阵仗，我哪好意思摇头啊。"
    },
    {
        "name": "颯人",
        "message": "「……只要你们努力，也不是不能考虑」"
    },
    {
        "name": "瑠々",
        "message": "「尊嘟？那必须好好加油～！」"
    },
    {
        "name": "結梨",
        "message": "「哼哼，你刚才说得我可都记住了哦。这次结梨也冲个第一吧」"
    },
    {
        "name": "颯人",
        "message": "「你俩还挺现实啊……」"
    },
    {
        "name": "結梨",
        "message": "「说是奖励，又不会提过分的要求啦。就是带我们出去玩之类的，差不多这种」"
    },
    {
        "name": "颯人",
        "message": "「什么，就这点小事」"
    },
    {
        "name": "瑠々",
        "message": "「不过去玩的开销可要哥你全包哦」"
    },
    {
        "name": "颯人",
        "message": "「别小看大人啊」"
    },
    {
        "name": "瑠々",
        "message": "「哇哦，帅～！」"
    },
    {
        "name": "結梨",
        "message": "「这下有干劲了吧，瑠酱」"
    },
    {
        "name": "瑠々",
        "message": "「感觉能考出历史新高」"
    },
    {
        "name": "颯人",
        "message": "「那这奖励可算没白给」"
    },
    {
        "message": "看着干劲满满的结梨和瑠瑠。"
    },
    {
        "message": "不光是出成绩后的奖励，平时也多做些点心什么的，给俩姑娘加加油吧。"
    },
    {
        "name": "颯人",
        "message": "「好，总算收拾完了」"
    },
    {
        "message": "客厅出乎意料地干净。"
    },
    {
        "message": "毕竟我就走了周六一天，而且瑠瑠也在，想必结梨也是收敛了许多。"
    },
    {
        "message": "托她俩的福，稍微拾掇一下就完事了。"
    },
    {
        "name": "颯人",
        "message": "「接下来得把垃圾分好类，方便扔。然后——」"
    },
    {
        "name": "結梨",
        "message": "「欧～尼～酱～来我房间一下～」"
    },
    {
        "name": "颯人",
        "message": "「？怎么了，这么突然……啥事啊～？」"
    },
    {
        "name": "結梨",
        "message": "「别问了，快点啦～！」"
    },
    {
        "name": "颯人",
        "message": "「来啦来啦」"
    },
    {
        "name": "結梨",
        "message": "「喏，欧尼酱」"
    },
    {
        "name": "颯人",
        "message": "「诶？」"
    },
    {
        "message": "一踏进结梨的房间，一个吹风机突然杵到我面前。"
    },
    {
        "name": "結梨",
        "message": "「帮我吹」"
    },
    {
        "name": "颯人",
        "message": "「……干嘛？」"
    },
    {
        "name": "結梨",
        "message": "「人家吹头发很累的嘛」"
    },
    {
        "name": "颯人",
        "message": "「那倒也是……干嘛非要我来」"
    },
    {
        "name": "結梨",
        "message": "「是谁之前想瞒着结梨偷偷出差的」"
    },
    {
        "name": "颯人",
        "message": "「唔……还记着仇呢」"
    },
    {
        "name": "結梨",
        "message": "「嘿嘿嘿，这个把柄我要抓一阵子」"
    },
    {
        "name": "颯人",
        "message": "「行了行了……我帮你吹，这事就一笔勾销了啊」"
    },
    {
        "name": "結梨",
        "message": "「好～的」"
    },
    {
        "name": "結梨",
        "message": "「哈啊……真舒服」"
    },
    {
        "name": "颯人",
        "message": "「您还满意吗，我的大小姐」"
    },
    {
        "name": "結梨",
        "message": "「嗯，手艺还不赖嘛？」"
    },
    {
        "name": "颯人",
        "message": "「是是是」"
    },
    {
        "name": "結梨",
        "message": "「这可不是恭维你哦？是真心觉得你吹得好」"
    },
    {
        "name": "颯人",
        "message": "「看来我这手艺还没退步嘛」"
    },
    {
        "message": "结梨小姑娘那会儿，我常这样帮她吹头发。"
    },
    {
        "message": "所以我们早已心有灵犀，结梨总能顺着我手上的动作，恰到好处地歪过脑袋。"
    },
    {
        "name": "結梨",
        "message": "「要是每天都能这样多好啊」"
    },
    {
        "name": "颯人",
        "message": "「那不得把你惯坏了，总不能一辈子都指望我吧？」"
    },
    {
        "name": "結梨",
        "message": "「可结梨一辈子都是欧尼酱的妹妹呀？」"
    },
    {
        "name": "颯人",
        "message": "「……你这是赖上我了是吧」"
    },
    {
        "name": "結梨",
        "message": "「就赖一辈子～」"
    },
    {
        "message": "她拿我当靠垫，整个身体都靠了上来。嘴巴张了张，我硬是说不出一个重字。"
    },
    {
        "name": "颯人",
        "message": "（不过，她真的好轻，轻得都让人担心了）"
    },
    {
        "name": "結梨",
        "message": "「呐欧尼酱，再往右边一点点～」"
    },
    {
        "name": "颯人",
        "message": "「哦，抱歉，这里吗？」"
    },
    {
        "name": "結梨",
        "message": "「对对，风小一点好不好～」"
    },
    {
        "name": "颯人",
        "message": "「要求还不少呢……」"
    },
    {
        "name": "結梨",
        "message": "「会伤到的头发嘛，女生可是很娇贵的」"
    },
    {
        "name": "颯人",
        "message": "「我懂」"
    },
    {
        "name": "結梨",
        "message": "「诶～？真的懂吗～？」"
    },
    {
        "name": "颯人",
        "message": "「……你这么一问，搞得我还真没自信了」"
    },
    {
        "name": "結梨",
        "message": "「是吧？啊，里面也要吹好，不然会翘起来的」"
    },
    {
        "name": "颯人",
        "message": "「是是是，这样行了吧」"
    },
    {
        "name": "結梨",
        "message": "「对对对，就这样～」"
    },
    {
        "message": "每到这种时候，我总觉得结梨格外孩子气。她大概是故意将「爱撒娇的自己」展现在我面前吧。"
    },
    {
        "name": "結梨",
        "message": "「呐～欧尼酱，也帮我揉揉肩～」"
    },
    {
        "name": "颯人",
        "message": "「你又没干什么事，肩膀哪里会酸」"
    },
    {
        "name": "結梨",
        "message": "「女生胸前可是有负重的，当然会酸啦～」"
    },
    {
        "message": "我觉得结梨的尺寸还没那么可观，但要是说她很轻怕是会引发战争。"
    },
    {
        "message": "家里不能说的话，真是多到爆炸啊。所有家有姐妹的男同胞恐怕都感同身受吧。"
    },
    {
        "name": "颯人",
        "message": "「一晚上……不，感觉三天三夜也说不完啊」"
    },
    {
        "name": "結梨",
        "message": "「？说什么呀？」"
    },
    {
        "name": "颯人",
        "message": "「人际交往的艰难」"
    },
    {
        "name": "結梨",
        "message": "「说是人际，不就是和女生打交道吗？」"
    },
    {
        "name": "颯人",
        "message": "「……」"
    },
    {
        "name": "結梨",
        "message": "「欧尼酱就从结梨这里开始，好好学习一下女生的心思」"
    },
    {
        "name": "颯人",
        "message": "「从结梨身上学女生的心思……是吗……」"
    },
    {
        "name": "結梨",
        "message": "「啊，你又瞧不起人！」"
    },
    {
        "name": "颯人",
        "message": "「既然你也知道，那就拿出个女生的样子来」"
    },
    {
        "name": "結梨",
        "message": "「女生的样子，是什么样？」"
    },
    {
        "name": "颯人",
        "message": "「嗯？」"
    },
    {
        "name": "結梨",
        "message": "「结梨……不像女生的样子吗？」"
    },
    {
        "name": "颯人",
        "message": "「啊，不是，不是那个意思」"
    },
    {
        "name": "結梨",
        "message": "「……」"
    },
    {
        "message": "我没想到她会用这么认真的神情看着我。"
    },
    {
        "message": "本以为会像往常一样，斗几句嘴就过去了。"
    },
    {
        "name": "結梨",
        "message": "「欧尼酱……你有喜欢的人吗？」"
    },
    {
        "name": "颯人",
        "message": "「这个……」"
    },
    {
        "name": "結梨",
        "message": "「欧尼酱，你老把自己的事情放在一边对吧？你是在顾虑结梨……我都知道的」"
    },
    {
        "name": "颯人",
        "message": "「……」"
    },
    {
        "name": "結梨",
        "message": "「以后有什么重要的事一定要第一个告诉我哦，拉钩？」"
    },
    {
        "name": "颯人",
        "message": "「嗯，知道了」"
    },
    {
        "name": "結梨",
        "message": "「结梨也是，到那种时候，我第一个告诉欧尼酱」"
    },
    {
        "name": "颯人",
        "message": "「那我到时候是不是该生气『谁敢娶走我的宝贝妹妹』？」"
    },
    {
        "name": "結梨",
        "message": "「啊哈哈！嗯，要狠狠地为我生气哦」"
    },
    {
        "message": "像这样照顾结梨，我其实很乐在其中。"
    },
    {
        "message": "不过要是说出口，结梨肯定蹬鼻子上脸，所以我才不讲。但心底里，我还是希望能一直这样下去。"
    },
    {
        "name": "颯人",
        "message": "（因为结梨是我最爱的妹妹吗？又或者……）"
    }
]