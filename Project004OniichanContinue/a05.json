[
  {
    "name": "颯人",
    "message": "「……」"
  },
  {
    "message": "多亏了现在流行远程办公，我才能穿着睡衣懒洋洋地躺在家里上班。"
  },
  {
    "message": "当然免不了偶尔要去现场，不过每次待在家中时我还是庆幸自己选了这行。"
  },
  {
    "name": "颯人",
    "message": "「结梨也送走了，可以不紧不慢地开工了」"
  },
  {
    "message": "不用去公司，省去了出门前的各种准备，也少受早高峰人挤人的罪。"
  },
  {
    "message": "不过，对我来说最大的好处还不在此。"
  },
  {
    "name": "颯人",
    "message": "「能一边工作一边洗衣做饭……爽啊」"
  },
  {
    "message": "工作日的白天还能不慌不忙地炖上一锅菜，这是何等的奢侈。"
  },
  {
    "name": "颯人",
    "message": "「用鸡肉吊个高汤，把萝卜炖烂点吸饱汤汁。再放点竹轮进去估计也很好吃」"
  },
  {
    "message": "适度健康地摸鱼，干完最低限度的指标，这也是社畜的必备技能之一吧。"
  },
  {
    "name": "颯人",
    "message": "「好，先从洗衣服开始！」"
  },
  {
    "name": "颯人",
    "message": "「嗯，大功告成」"
  },
  {
    "message": "看着眼前这锅火候恰到好处的菜，我心满意足，就拿来当常备小菜吧。"
  },
  {
    "message": "那么，接下来——"
  },
  {
    "name": "颯人",
    "message": "「今天晚饭该吃点什么好呢……」"
  },
  {
    "message": "那锅炖菜终究只是一时兴起弄的，正餐又是另一回事了。"
  },
  {
    "message": "有时我也会先去超市看看什么东西打折再定，但事先打算一下买起来更快嘛。"
  },
  {
    "name": "颯人",
    "message": "「嗯？」"
  },
  {
    "message": "口袋里的手机震动起来。"
  },
  {
    "message": "刨去工作上的事，白天会联系我的人屈指可数……会是谁呢。"
  },
  {
    "name": "結梨",
    "message": "『要吃咖喱』"
  },
  {
    "name": "颯人",
    "message": "「这……难道她会读心术？」"
  },
  {
    "message": "有人点菜倒是正好。咖喱做起来简单，对钱包也友好。"
  },
  {
    "message": "炖菜跟咖喱不搭，不过放着隔夜更入味。"
  },
  {
    "name": "颯人",
    "message": "「收到」"
  },
  {
    "message": "好了，这下不用愁了，先把今天的工作干掉吧。"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱」"
  },
  {
    "name": "颯人",
    "message": "「咦，你回来啦」"
  },
  {
    "name": "結梨",
    "message": "「晚饭买菜我也想一起去」"
  },
  {
    "name": "颯人",
    "message": "「诶？」"
  },
  {
    "name": "結梨",
    "message": "「喂，干嘛那么惊讶」"
  },
  {
    "name": "颯人",
    "message": "「不是，就是没想到你会主动提这个」"
  },
  {
    "message": "还以为一回来就要瘫着打游戏呢。"
  },
  {
    "name": "結梨",
    "message": "「哈？我也能帮家里做点事的好不好！」"
  },
  {
    "name": "颯人",
    "message": "「等你真帮了再说吧」"
  },
  {
    "name": "結梨",
    "message": "「所以才说要一起去买菜嘛」"
  },
  {
    "name": "颯人",
    "message": "「去买菜行啊，但我这边活儿还没干完呢」"
  },
  {
    "name": "結梨",
    "message": "「我可以等你做完呀？」"
  },
  {
    "message": "这时候劝她也是白费劲，最好提一个她能接受的折中方案。"
  },
  {
    "name": "結梨",
    "message": "「那我先玩游戏等你咯」"
  },
  {
    "name": "颯人",
    "message": "「那倒没问题，但我估计要搞一阵子哦？中途也许会卡住，说不定还会加派工作呢」"
  },
  {
    "name": "結梨",
    "message": "「嗯～～～那……也没问题吧？」"
  },
  {
    "name": "颯人",
    "message": "「？ 啊？」"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱答应我的事就一定会做到的」"
  },
  {
    "message": "她说着好听话，还朝我甜甜一笑。"
  },
  {
    "message": "身为兄长的我可不会让她白期待，这小坏蛋就是明知这样才说的。"
  },
  {
    "name": "颯人",
    "message": "（挺会给我上强度啊……）"
  },
  {
    "message": "工作当然重要，干完后也挺有成就感的，但我最重要的人还是她。"
  },
  {
    "name": "颯人",
    "message": "「知道了，我马上把工作搞定，稍等我一下」"
  },
  {
    "name": "結梨",
    "message": "「好～等你哦」"
  },
  {
    "message": "万一中途加了任务，也只能推掉或者明天再说了。"
  },
  {
    "message": "总之先尽快搞定，我匆匆跑回了房间。"
  },
  {
    "message": "工作告一段落后，我就和结梨一起出门买菜了。晚饭的菜单已经定了，买起来也挺快。"
  },
  {
    "name": "結梨",
    "message": "「好像很久都没吃欧尼酱做的咖喱了呢？期待」"
  },
  {
    "name": "颯人",
    "message": "「包我身上。保证好吃到掉牙」"
  },
  {
    "name": "結梨",
    "message": "「耶♪ 那我要吃好多好多」"
  },
  {
    "name": "颯人",
    "message": "「你不是买甜点了吗？吃得下吗？」"
  },
  {
    "name": "結梨",
    "message": "「那个和这个又不是一个胃」"
  },
  {
    "name": "颯人",
    "message": "「别到时候又嚷嚷什么胖了，不关我事啊」"
  },
  {
    "name": "結梨",
    "message": "「啊，过分～！怎么能对女生这样说话」"
  },
  {
    "name": "颯人",
    "message": "「这是过来人对你的忠告」"
  },
  {
    "name": "結梨",
    "message": "「就是因为嘴笨笨，欧尼酱才找不到女朋友的」"
  },
  {
    "name": "颯人",
    "message": "「我可没那闲工夫，拉倒了」"
  },
  {
    "name": "結梨",
    "message": "「……哼～」"
  },
  {
    "name": "颯人",
    "message": "「还一脸不以为然呢」"
  },
  {
    "name": "結梨",
    "message": "「身为你的妹妹人家很担心哦——」"
  },
  {
    "name": "颯人",
    "message": "「那还真是谢谢你了啊」"
  },
  {
    "name": "結梨",
    "message": "「嘻嘻，结梨可是天天为欧尼酱操心哟」"
  },
  {
    "name": "颯人",
    "message": "「彼此彼此」"
  },
  {
    "name": "結梨",
    "message": "「嗯，我知道」"
  },
  {
    "message": "结梨笑得眉眼弯弯。看来爱操心这点还真是爸妈遗传的。"
  },
  {
    "name": "結梨",
    "message": "「好啦，快回家！前胸贴后背啦！」"
  },
  {
    "name": "颯人",
    "message": "「好好好，知道了」"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱做饭的时候，我就打游戏等你。今天要好好练练枪法」"
  },
  {
    "name": "颯人",
    "message": "「你打FPS还挺上头啊」"
  },
  {
    "name": "結梨",
    "message": "「嗯！最近排位上大分了。现在在A段，马上就上S了！」"
  },
  {
    "name": "颯人",
    "message": "「诶，你入坑到现在也就两个月吧？」"
  },
  {
    "name": "結梨",
    "message": "「对呀，厉不厉害？人家说不定是天才！」"
  },
  {
    "name": "颯人",
    "message": "「S段才是真正的难关呢。你要能突破才算得上是有天赋」"
  },
  {
    "name": "結梨",
    "message": "「唔……你夸我一句要死嘛」"
  },
  {
    "name": "颯人",
    "message": "「等你上了S，为兄再好好夸你」"
  },
  {
    "message": "前几次我在旁边看过，以她的操作，上S段可没那么简单。"
  },
  {
    "message": "虽然运气也很重要，但她火候还没到，想上分相当难。"
  },
  {
    "name": "結梨",
    "message": "「说好了？我可都记住了哦？」"
  },
  {
    "name": "颯人",
    "message": "「你哥我说话算数」"
  },
  {
    "name": "結梨",
    "message": "「研究和复盘可是我的强项，别小看本学霸的实力哦～？」"
  },
  {
    "name": "颯人",
    "message": "「等你打上去了再说不迟」"
  },
  {
    "name": "結梨",
    "message": "「好——！燃起来了！冲鸭——！」"
  },
  {
    "message": "就算在外面，只要跟我待在一起她就原形毕露，这大概也是信任的体现吧。"
  },
  {
    "name": "颯人",
    "message": "「这股劲头不错，但修仙也要适可而止。生物钟乱了想恢复就麻烦了」"
  },
  {
    "name": "結梨",
    "message": "「有欧尼酱管我，不怕」"
  },
  {
    "name": "颯人",
    "message": "「你努力一下，自己起床好吧」"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱就是我的专属闹钟呀？」"
  },
  {
    "name": "颯人",
    "message": "「……要不，换你来叫我起床？」"
  },
  {
    "name": "結梨",
    "message": "「诶——是～吗～」"
  },
  {
    "name": "颯人",
    "message": "「干嘛」"
  },
  {
    "name": "結梨",
    "message": "「想和可爱的妹妹共度甜蜜的清晨时光？」"
  },
  {
    "name": "颯人",
    "message": "「那倒没有」"
  },
  {
    "name": "結梨",
    "message": "「干什么呀——！这时候就期待一下下啦！」"
  },
  {
    "name": "颯人",
    "message": "「对妹妹有那种想法，那我这个哥哥还能当吗！」"
  },
  {
    "name": "結梨",
    "message": "「哼！欧尼酱大笨蛋！」"
  },
  {
    "message": "女生真是——不对，是妹妹真是难伺候啊……"
  },
  {
    "name": "颯人",
    "message": "「不是，平时是谁老鬼叫『不许看』『大色狼』的？」"
  },
  {
    "name": "結梨",
    "message": "「那是两回事好不好」"
  },
  {
    "name": "颯人",
    "message": "「说白了不就是看你心情，尽耍我」"
  },
  {
    "name": "結梨",
    "message": "「被可爱的妹妹耍一耍，不也很幸福吗？」"
  },
  {
    "name": "颯人",
    "message": "「那纯属你的个人看法，要论证请拿出更全面的数据和依据来」"
  },
  {
    "name": "結梨",
    "message": "「哼～～～欧尼酱，你就是和我抬杠」"
  },
  {
    "name": "颯人",
    "message": "「还不是因为你老胡说八道」"
  },
  {
    "name": "結梨",
    "message": "「人家一直都很认真的——」"
  },
  {
    "name": "颯人",
    "message": "「你也知道你在很认真地耍我是吧」"
  },
  {
    "name": "結梨",
    "message": "「对欧尼酱胡说八道可是当妹妹的义务呀？」"
  },
  {
    "name": "颯人",
    "message": "「……别一本正经地说这种可怕的话好吧」"
  },
  {
    "name": "結梨",
    "message": "「没关系啦～一点都不可怕哟～」"
  },
  {
    "name": "結梨",
    "message": "「唔嗯，等一下欧尼酱，我够不到你的头啦～！乖乖低头嘛～！」"
  },
  {
    "name": "颯人",
    "message": "「少打摸我头的主意啊！」"
  },
  {
    "name": "結梨",
    "message": "「你害羞什么了啦」"
  },
  {
    "name": "颯人",
    "message": "「谁害羞了」"
  },
  {
    "name": "結梨",
    "message": "「那你干嘛这么抗拒？」"
  },
  {
    "name": "颯人",
    "message": "「你能不能站在路人的角度想一想，一个男的在大街上被妹妹摸头，这像样吗！」"
  },
  {
    "name": "結梨",
    "message": "「……不是很萌吗？」"
  },
  {
    "name": "颯人",
    "message": "「你认真……？」"
  },
  {
    "name": "結梨",
    "message": "「周围的人怎么想才不关我事。我们自己的感受才最重要呢？」"
  },
  {
    "name": "颯人",
    "message": "（……她又说这么直球）"
  },
  {
    "message": "能不加掩饰地表达自己的心声，她是真的强大，我不由有些羡慕和向往。"
  },
  {
    "name": "結梨",
    "message": "「再说了，谁知道我们是兄妹。在外人眼里，我们不就跟普通的情，情侣一样吗？」"
  },
  {
    "name": "颯人",
    "message": "「是吗？」"
  },
  {
    "name": "結梨",
    "message": "「你看，这样就完美啦」"
  },
  {
    "message": "她咻地探出手臂，轻轻地挽住了我。"
  },
  {
    "name": "結梨",
    "message": "「对不？」"
  },
  {
    "name": "颯人",
    "message": "「嗯……行吧，就算是」"
  },
  {
    "name": "結梨",
    "message": "「开心就直说嘛，干嘛嘴硬」"
  },
  {
    "name": "颯人",
    "message": "「我这是在陪你胡闹，你搞清楚」"
  },
  {
    "name": "結梨",
    "message": "「真是的，就硬装～」"
  },
  {
    "name": "颯人",
    "message": "「你怎么拱火都没用的」"
  },
  {
    "name": "結梨",
    "message": "「唔～～～没劲」"
  },
  {
    "message": "结梨赌气地鼓起双颊，但挽住我胳膊的手却丝毫没有松开的意思。"
  },
  {
    "name": "颯人",
    "message": "（她就是这方面比较……）"
  },
  {
    "name": "結梨",
    "message": "「干嘛，还板着脸」"
  },
  {
    "name": "颯人",
    "message": "「嗯？」"
  },
  {
    "name": "結梨",
    "message": "「不喜欢和结梨一起这样走吗？」"
  },
  {
    "name": "颯人",
    "message": "「我是感慨，你真的长大了」"
  },
  {
    "name": "結梨",
    "message": "「……是说胸吗？」"
  },
  {
    "name": "颯人",
    "message": "「不是！是・身・高！」"
  },
  {
    "name": "結梨",
    "message": "「明明是欧尼酱错了」"
  },
  {
    "name": "颯人",
    "message": "「嗯？」"
  },
  {
    "name": "結梨",
    "message": "「是『也』长高了，对吧？」"
  },
  {
    "name": "颯人",
    "message": "「……」"
  },
  {
    "name": "結梨",
    "message": "「啊哈哈！欧尼酱就是色色。明明心里美滋滋还不承认」"
  },
  {
    "name": "颯人",
    "message": "「唉……行吧行吧，你说是就是了」"
  },
  {
    "message": "结梨说的也没错。我确实有些欣喜，这是事实。"
  },
  {
    "message": "就在几年前，我们之间连话都很少说。"
  },
  {
    "message": "无论我说什么，她都只会用『吵死了』『知道了』『你好烦』这些话来顶我。"
  },
  {
    "message": "当初我可为此伤透了脑筋。"
  },
  {
    "message": "虽然我也想过随她去，但身为监护人我又不能真的放任自流。"
  },
  {
    "message": "即便是一家人，结梨终究是女生。男女思维的差异可不容易跨越。"
  },
  {
    "name": "結梨",
    "message": "「明明是我在陪欧尼酱，就这样了！」"
  },
  {
    "name": "颯人",
    "message": "「好，就是这样了，你开心就好」"
  },
  {
    "name": "結梨",
    "message": "「嗯哼哼，就是就是～」"
  },
  {
    "message": "此刻她开开心心地笑着，这就足够了。"
  },
  {
    "name": "結梨",
    "message": "「我吃饱啦！啊，真好吃～」"
  },
  {
    "name": "颯人",
    "message": "「还满意吧？」"
  },
  {
    "name": "結梨",
    "message": "「嗯！欧尼酱的咖喱世界第一！」"
  },
  {
    "name": "颯人",
    "message": "「那真是多谢了，承蒙夸奖，不胜荣幸」"
  },
  {
    "message": "我一边收拾碗筷，一边准备饭后的茶水。客厅里的茶会即将开张，这也是我们家庭和睦的小秘密。"
  },
  {
    "name": "颯人",
    "message": "「咖啡还是红茶？」"
  },
  {
    "name": "結梨",
    "message": "「红茶！要喝奶茶！」"
  },
  {
    "name": "颯人",
    "message": "「好嘞」"
  },
  {
    "message": "今天我还是喝红茶好了。茶叶就……随便选了。"
  },
  {
    "message": "我和结梨都没那种挑茶叶的高级舌头。"
  },
  {
    "name": "結梨",
    "message": "「呐欧尼酱，今天怎么办？」"
  },
  {
    "name": "颯人",
    "message": "「啊……能不能晚点？我白天的工作还留了个尾巴」"
  },
  {
    "name": "結梨",
    "message": "「嗯，那我先自己玩着，你忙完我们再一起！」"
  },
  {
    "name": "颯人",
    "message": "「嗯，好的，那你等等我」"
  },
  {
    "name": "結梨",
    "message": "「今天玩什么好呢……PVP，合作……派对游戏也不错呢」"
  },
  {
    "name": "結梨",
    "message": "「啊，欧尼酱你知道不？」"
  },
  {
    "name": "颯人",
    "message": "「嗯？知道什么？」"
  },
  {
    "name": "結梨",
    "message": "「最近复古游戏可火了！经常看到有人直播呢！」"
  },
  {
    "name": "颯人",
    "message": "「复古游戏啊。说起来，我以前好像也挺迷这种的」"
  },
  {
    "name": "結梨",
    "message": "「诶，是吗？」"
  },
  {
    "name": "颯人",
    "message": "「老爸把他那台游戏机连游戏一起丢给我了，那时我可没少玩」"
  },
  {
    "message": "几年前，那会儿的复古游戏远没有现在网上能下到的多。"
  },
  {
    "message": "或许是现在游戏的机制完善了吧，那些超高难度的游戏反而变得稀奇，于是又重新回到了玩家的视野中。"
  },
  {
    "name": "結梨",
    "message": "「用实体机玩的啊，真好」"
  },
  {
    "name": "颯人",
    "message": "「主机和卡带我都留着呢。要不试试？」"
  },
  {
    "name": "結梨",
    "message": "「嗯！想玩想玩！」"
  },
  {
    "name": "颯人",
    "message": "「行，那你等我一下下哈」"
  },
  {
    "name": "颯人",
    "message": "「我记得放最里头了……哦，有了有了」"
  },
  {
    "message": "这台老游戏机都吃灰好几年了，好在游戏卡带都收在一起。"
  },
  {
    "message": "机身没什么破损，配件也一个不少。不得不夸奖我自己，保存得还真不错。"
  },
  {
    "name": "颯人",
    "message": "「接上电应该就能开机了」"
  },
  {
    "message": "但愿线路没老化断掉，反正先通电试试。"
  },
  {
    "name": "颯人",
    "message": "「久等啦。看，就是这台」"
  },
  {
    "name": "結梨",
    "message": "「谢谢欧尼酱！诶……以前的游戏机都这么小啊」"
  },
  {
    "name": "颯人",
    "message": "「你会接吗？」"
  },
  {
    "name": "結梨",
    "message": "「唔～唔，不会，欧尼酱帮人家弄嘛——」"
  },
  {
    "name": "颯人",
    "message": "「行行，我来」"
  },
  {
    "message": "结梨对机器电器这方面一无所知。她现在用的那台电脑也是我给她装的。"
  },
  {
    "message": "感觉她不擅长摆弄机器，估计压根也没想过去学。一碰到这种事就全丢给我了。"
  },
  {
    "name": "颯人",
    "message": "「我看看，把这根线接到电视上……搞定，再把电源插上就大功告成了」"
  },
  {
    "name": "結梨",
    "message": "「哦～这么简单呀」"
  },
  {
    "name": "颯人",
    "message": "「这么简单，那你自己也能搞吧？」"
  },
  {
    "name": "結梨",
    "message": "「不要，就要欧尼酱帮我弄——」"
  },
  {
    "name": "颯人",
    "message": "「你干嘛……」"
  },
  {
    "name": "結梨",
    "message": "「因为人家才不一个人玩呢」"
  },
  {
    "name": "颯人",
    "message": "「……唉，随你吧」"
  },
  {
    "name": "結梨",
    "message": "「而且这个也不能联机玩吧？」"
  },
  {
    "name": "颯人",
    "message": "「嗯，毕竟这机器的年代网络对战还没普及呢」"
  },
  {
    "name": "結梨",
    "message": "「对吧？所以呀，玩这个就要和欧尼酱一起玩」"
  },
  {
    "name": "颯人",
    "message": "「知道了知道了。我先把手头的活忙完，你乖乖等我」"
  },
  {
    "name": "結梨",
    "message": "「好——！那我先自己玩玩看！」"
  },
  {
    "message": "两小时后——"
  },
  {
    "name": "結梨",
    "message": "「呼……呼……」"
  },
  {
    "name": "颯人",
    "message": "「居然睡着了」"
  },
  {
    "message": "看来我干活花的时间是太长了点……真有点对不住结梨。"
  },
  {
    "name": "颯人",
    "message": "「结梨，在这里睡觉会着凉的」"
  },
  {
    "name": "結梨",
    "message": "「唔……嗯……」"
  },
  {
    "name": "颯人",
    "message": "「还是老样子，一睡就叫不醒」"
  },
  {
    "message": "拿她没办法，还是把她抱回房间吧。"
  },
  {
    "name": "颯人",
    "message": "「嘿……咻」"
  },
  {
    "message": "我将结梨打横抱了起来。"
  },
  {
    "message": "她的身子很轻，抱起来不费什么力气。不过，这触感和男性的身体截然不同。"
  },
  {
    "name": "颯人",
    "message": "「虽然长大了……结梨还是个需要人照顾的妹妹啊」"
  },
  {
    "message": "我把她抱进房间，轻轻放在了床上。"
  },
  {
    "name": "結梨",
    "message": "「欧尼酱……」"
  },
  {
    "name": "颯人",
    "message": "「唔」"
  },
  {
    "message": "也许是在睡梦中察觉到了什么，她的小手揪住了我的衣角。"
  },
  {
    "name": "颯人",
    "message": "「嗯嗯，我在呢」"
  },
  {
    "name": "結梨",
    "message": "「唔嗯……」"
  },
  {
    "name": "颯人",
    "message": "「今天对不起呀，没能陪你玩」"
  },
  {
    "name": "結梨",
    "message": "「嗯……」"
  },
  {
    "message": "我也想挤出更多时间给她，也想好好陪在结梨的身边，一直守护她。"
  },
  {
    "message": "然而……我也是个大人了，要立足于社会，有太多不得不做的事。"
  },
  {
    "name": "颯人",
    "message": "「也都是为了更好地守护你啊」"
  },
  {
    "name": "結梨",
    "message": "「……」"
  },
  {
    "name": "颯人",
    "message": "「晚安，结梨」"
  },
  {
    "message": "我轻轻掰开她揪着衣角的手，摩挲着她的秀发，然后悄悄离开了房间。"
  }
]